---
/* Bánh mì thịt — ổ bánh NẰM NGANG, bổ dọc mở ngửa, thấy nguyên dải nhân nhiều
   tầng: pate nâu, lát chả lụa hồng nhạt, thịt nguội đỏ, đồ chua cam+trắng, thanh
   dưa leo xanh, nhánh ngò. Nắp bánh dựng ngả ra sau, vỏ có 3 vết rạch.
   Chống đụng: khác banh-mi-cha-ca (ổ dựng xéo, đĩa chả cá vàng tròn) và
   banh-mi-heo-quay (hai nửa cắt ngang dựng đứng, lộ mặt cắt). */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Ổ bánh mì thịt mở ngửa đầy nhân pate chả lụa thịt nguội đồ chua và ngò, bên cạnh có chén đồ chua">
  <circle cx="260" cy="250" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="250" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <ellipse cx="260" cy="392" rx="196" ry="26" fill="rgba(15,26,14,.32)"/>

  <!-- giấy gói lót dưới -->
  <g transform="rotate(-4 260 340)">
    <path d="M64 300 L436 292 L458 372 L48 380 Z" fill="#F7F2E4" stroke="#DCD3BC" stroke-width="2"/>
    <path d="M92 306 L84 372 M180 300 L176 376 M330 296 L332 374" fill="none" stroke="#E6DFCA" stroke-width="2"/>
  </g>

  <!-- NẮP BÁNH ngả ra sau: vỏ nâu vàng, 3 vết rạch nở -->
  <g transform="rotate(-3 260 250)">
    <path d="M84 258 C 110 226 172 210 250 208 C 330 206 400 218 428 242 C 440 253 436 268 418 273 C 380 262 320 254 250 255 C 180 256 122 265 92 274 C 76 272 74 266 84 258 Z"
          fill="#D9963F" stroke="#9B6021" stroke-width="3"/>
    <path d="M96 262 C 130 240 186 228 250 227 C 318 226 378 236 410 252" fill="none" stroke="#EBB566" stroke-width="5" stroke-linecap="round"/>
    <g fill="none" stroke="#8C5219" stroke-width="4" stroke-linecap="round">
      <path d="M148 246 L164 264"/><path d="M244 236 L258 256"/><path d="M340 240 L352 260"/>
    </g>
    <g fill="none" stroke="#F2CE92" stroke-width="2.4" stroke-linecap="round">
      <path d="M154 244 L168 260"/><path d="M250 234 L262 252"/><path d="M346 238 L356 256"/>
    </g>
  </g>

  <!-- ĐÁY BÁNH: thân thuyền, ruột xốp -->
  <path d="M70 312 C 92 294 146 284 210 281 C 286 277 358 281 412 290 C 444 296 460 306 456 316 C 450 334 404 348 336 353 C 258 359 178 356 124 345 C 84 337 62 326 70 312 Z"
        fill="#D9963F" stroke="#9B6021" stroke-width="3"/>
  <path d="M84 312 C 106 298 156 290 212 288 C 284 285 352 288 402 296 C 428 300 442 307 440 313 C 400 322 330 327 256 327 C 182 327 116 322 84 312 Z"
        fill="#F6E6C4" stroke="#DFC697" stroke-width="2"/>

  <!-- PATE quét sát ruột bánh -->
  <path d="M96 310 C 140 300 200 295 258 295 C 320 295 380 300 424 309 C 400 316 330 320 256 320 C 184 320 120 316 96 310 Z"
        fill="#7C4C2B"/>
  <g fill="#5E3620" opacity=".55">
    <circle cx="146" cy="308" r="2.4"/><circle cx="206" cy="304" r="2.1"/><circle cx="286" cy="304" r="2.4"/><circle cx="360" cy="308" r="2.2"/>
  </g>

  <!-- CHẢ LỤA: 3 lát hồng nhạt dựng nghiêng, gối lên nhau -->
  <g>
    <g transform="translate(150 288) rotate(-12)">
      <ellipse cx="0" cy="0" rx="30" ry="15" fill="#F7DFD4" stroke="#D6A48C" stroke-width="2.6"/>
      <g fill="#E9C3B2"><circle cx="-9" cy="-2" r="2"/><circle cx="6" cy="3" r="1.8"/><circle cx="14" cy="-4" r="1.6"/></g>
    </g>
    <g transform="translate(214 284) rotate(6)">
      <ellipse cx="0" cy="0" rx="31" ry="15.5" fill="#FAE6DC" stroke="#D6A48C" stroke-width="2.6"/>
      <g fill="#E9C3B2"><circle cx="-11" cy="2" r="1.9"/><circle cx="4" cy="-3" r="2"/><circle cx="15" cy="3" r="1.7"/></g>
    </g>
  </g>

  <!-- THỊT NGUỘI: hai nếp gấp đỏ hồng, mép lượn sóng -->
  <g>
    <path d="M262 296 C 276 276 306 270 330 276 C 352 282 358 296 344 304 C 322 314 288 312 268 306 C 258 303 257 299 262 296 Z"
          fill="#D9736A" stroke="#A6453E" stroke-width="2.6"/>
    <path d="M276 292 C 292 282 316 280 334 285" fill="none" stroke="#EFA098" stroke-width="3" stroke-linecap="round"/>
    <path d="M330 288 C 348 272 380 268 400 276 C 418 283 420 296 404 303 C 384 310 352 306 336 299 C 328 296 327 291 330 288 Z"
          fill="#C9635B" stroke="#A6453E" stroke-width="2.6"/>
    <path d="M344 285 C 360 277 382 276 398 282" fill="none" stroke="#E8938B" stroke-width="2.6" stroke-linecap="round"/>
  </g>

  <!-- ĐỒ CHUA: sợi cam + sợi trắng thò ra khỏi mép ổ bánh -->
  <g stroke-linecap="round">
    <g stroke="#E89A2E" stroke-width="5">
      <path d="M118 300 C 108 292 96 290 86 293"/>
      <path d="M186 296 C 178 286 166 282 154 284"/>
      <path d="M300 292 C 296 282 288 276 278 275"/>
      <path d="M392 296 C 392 286 386 278 376 275"/>
    </g>
    <g stroke="#F5EEDC" stroke-width="4.6">
      <path d="M140 298 C 132 288 120 284 110 286"/>
      <path d="M244 292 C 240 282 232 276 222 275"/>
      <path d="M356 294 C 354 284 346 277 336 276"/>
      <path d="M420 302 C 424 292 422 284 414 279"/>
    </g>
  </g>

  <!-- DƯA LEO: hai thanh dài xanh nằm dọc mép trước -->
  <g>
    <path d="M120 330 C 176 340 250 344 320 340 L 320 350 C 250 354 174 350 120 340 Z" fill="#B8D07A" stroke="#6F9440" stroke-width="2.4"/>
    <path d="M132 334 C 184 342 250 346 312 343" fill="none" stroke="#DCEBB4" stroke-width="2.2"/>
    <path d="M300 336 C 346 340 390 338 424 331 L 426 341 C 392 348 346 350 300 346 Z" fill="#A6C46A" stroke="#6F9440" stroke-width="2.4"/>
  </g>

  <!-- NGÒ RÍ nhánh nguyên nhô lên -->
  <g transform="translate(96 282)">
    <path d="M0 12 q 6 -14 20 -19" fill="none" stroke="#4E7B36" stroke-width="2.6" stroke-linecap="round"/>
    <g fill="#6F9C48">
      <ellipse cx="23" cy="-9" rx="6" ry="3.6" transform="rotate(-26 23 -9)"/>
      <ellipse cx="12" cy="-3" rx="5" ry="3" transform="rotate(22 12 -3)"/>
      <ellipse cx="27" cy="-1" rx="4.6" ry="2.8" transform="rotate(4 27 -1)"/>
    </g>
  </g>
  <g transform="translate(268 268)">
    <path d="M0 10 q 5 -12 17 -16" fill="none" stroke="#4E7B36" stroke-width="2.4" stroke-linecap="round"/>
    <g fill="#6F9C48">
      <ellipse cx="20" cy="-8" rx="5.4" ry="3.2" transform="rotate(-22 20 -8)"/>
      <ellipse cx="10" cy="-2" rx="4.6" ry="2.8" transform="rotate(26 10 -2)"/>
    </g>
  </g>

  <!-- ỚT lát đỏ điểm trên nhân -->
  <g fill="none" stroke="#C0392B" stroke-width="3.4">
    <circle cx="196" cy="306" r="4.4"/><circle cx="332" cy="312" r="4"/>
  </g>

  <!-- CHÉN ĐỒ CHUA bên phải (đạo cụ riêng của ổ này) -->
  <g transform="translate(430 352)">
    <ellipse cx="0" cy="46" rx="46" ry="13" fill="rgba(15,26,14,.28)"/>
    <path d="M-42 18 C -40 40 -24 50 0 50 C 24 50 40 40 42 18 Z" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2"/>
    <ellipse cx="0" cy="18" rx="42" ry="12" fill="#F3E2C4" stroke="#D8D0B6" stroke-width="2"/>
    <g stroke-linecap="round">
      <g stroke="#E89A2E" stroke-width="4.4">
        <path d="M-26 16 L -8 12"/><path d="M-4 20 L 16 15"/><path d="M6 10 L 26 13"/>
      </g>
      <g stroke="#F8F3E4" stroke-width="4">
        <path d="M-22 22 L -2 19"/><path d="M2 13 L 22 9"/>
      </g>
    </g>
  </g>
</svg>
