---
/* Bún đậu mắm tôm — hình DUY NHẤT của trang không dùng tô hay đĩa mà dùng
   MẸT TRE tròn nan đan, LÓT LÁ CHUỐI xanh sẫm. Bày quanh: bún lá cắt miếng vuông,
   đậu phụ rán vàng ruộm mép xém, thịt chân giò lát có viền bì, chả cốm lấm tấm hạt cốm xanh,
   dưa chuột lát, rau kinh giới + tía tô (mặt lá tím);
   CHÍNH GIỮA là chén MẮM TÔM tím sim ĐÁNH BÔNG nổi bọt trắng, có lát ớt;
   đạo cụ: mấy trái quất cắt đôi bên mép mẹt */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Mẹt bún đậu mắm tôm lót lá chuối: bún lá cắt miếng, đậu phụ rán vàng, thịt luộc, chả cốm, rau kinh giới tía tô, chén mắm tôm đánh bông ở giữa">
  <defs>
    <clipPath id="bdTray"><ellipse cx="258" cy="256" rx="188" ry="132"/></clipPath>
    <linearGradient id="bdDauG" x1="0" y1="0" x2="0.4" y2="1">
      <stop offset="0" stop-color="#F0C059"/><stop offset="1" stop-color="#C7871F"/>
    </linearGradient>
    <linearGradient id="bdMam" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#9E7BAE"/><stop offset="1" stop-color="#6B4880"/>
    </linearGradient>
    <!-- miếng đậu rán: khối vuông dày, mặt trên vàng nhạt, mép xém sẫm -->
    <g id="bdDau">
      <path d="M-22 8 L -22 -6 L 22 -12 L 22 2 Z" fill="#A96B12" stroke="#7C4A08" stroke-width="1.8" stroke-linejoin="round"/>
      <path d="M-24 -6 L -4 -16 L 24 -12 L 4 -2 Z" fill="url(#bdDauG)" stroke="#8E5A0E" stroke-width="1.8" stroke-linejoin="round"/>
      <path d="M-24 -6 L -22 8 L 2 12 L 4 -2 Z" fill="#D9A03B" stroke="#8E5A0E" stroke-width="1.8" stroke-linejoin="round"/>
      <path d="M-18 -7 L -2 -14 L 16 -12" fill="none" stroke="#F8DC9A" stroke-width="2" stroke-linecap="round" opacity=".85"/>
      <g stroke="#7C4A08" stroke-width="1.4" stroke-linecap="round" fill="none" opacity=".7">
        <path d="M-16 2 L -14 9"/><path d="M-6 4 L -4 11"/>
      </g>
    </g>
    <!-- miếng bún lá: khối trắng vuông, mặt trên có vệt sợi song song -->
    <g id="bdBun">
      <path d="M-22 6 L -22 -4 L 22 -10 L 22 0 Z" fill="#E8E0C6" stroke="#C8BC94" stroke-width="1.6" stroke-linejoin="round"/>
      <path d="M-24 -4 L -4 -14 L 24 -10 L 4 0 Z" fill="#FDFAF0" stroke="#C8BC94" stroke-width="1.6" stroke-linejoin="round"/>
      <g stroke="#DED3AE" stroke-width="1.3" stroke-linecap="round" fill="none">
        <path d="M-16 -5 L 6 -9"/><path d="M-11 -8 L 11 -11"/><path d="M-6 -10.6 L 15 -12"/><path d="M-20 -2 L 1 -6.4"/>
      </g>
    </g>
    <!-- lát thịt chân giò: nạc hồng nhạt, vệt mỡ trắng, VIỀN BÌ trong suốt ngoài rìa -->
    <g id="bdThit">
      <ellipse cx="0" cy="0" rx="21" ry="14" fill="#EFC9B4" stroke="#C79A80" stroke-width="1.9"/>
      <path d="M-21 0 A 21 14 0 0 1 21 0 L 17 0 A 17 11 0 0 0 -17 0 Z" fill="#F6E7D2" stroke="#C79A80" stroke-width="1.2"/>
      <ellipse cx="-3" cy="2" rx="9" ry="5" fill="#E2A891" opacity=".7"/>
      <path d="M-11 -3 C -4 -7 6 -7 12 -3" fill="none" stroke="#FBEEDC" stroke-width="2.4" stroke-linecap="round"/>
    </g>
    <!-- lá kinh giới: răng cưa nhẹ, xanh mát -->
    <g id="bdKinh">
      <path d="M0 0 C 3 -9 12 -14 21 -12 C 24 -4 18 4 8 6 C 3 7 0 4 0 0 Z" fill="#5C9440" stroke="#356123" stroke-width="1.5"/>
      <path d="M2 2 L 19 -10" stroke="#93C169" stroke-width="1.2" stroke-linecap="round"/>
      <g stroke="#356123" stroke-width="1" stroke-linecap="round" fill="none" opacity=".8">
        <path d="M7 -2 L 9 -6"/><path d="M12 -4 L 14 -8"/>
      </g>
    </g>
    <!-- lá tía tô: mặt trên xanh sẫm, MẶT DƯỚI TÍM lật lên -->
    <g id="bdTia">
      <path d="M0 0 C 2 -11 13 -18 24 -15 C 27 -6 19 4 8 7 C 3 8 -1 5 0 0 Z" fill="#4A6B34" stroke="#2C3F1E" stroke-width="1.5"/>
      <path d="M0 0 C 5 3 14 5 22 3 C 17 9 6 10 1 5 Z" fill="#7B4A87" stroke="#4A2A53" stroke-width="1.3"/>
      <path d="M2 2 L 22 -12" stroke="#8FB268" stroke-width="1.2" stroke-linecap="round"/>
    </g>
  </defs>
  <circle cx="258" cy="248" r="204" fill="rgba(255,255,255,.055)"/>
  <circle cx="258" cy="248" r="230" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <ellipse cx="258" cy="410" rx="196" ry="26" fill="rgba(15,26,14,.38)"/>

  <!-- ===== MẸT TRE: vành nan đan ===== -->
  <ellipse cx="258" cy="266" rx="200" ry="142" fill="#A97A38"/>
  <ellipse cx="258" cy="260" rx="200" ry="142" fill="#D9B36A" stroke="#8E6524" stroke-width="3"/>
  <ellipse cx="258" cy="256" rx="188" ry="132" fill="#C79B4E" stroke="#8E6524" stroke-width="2.4"/>
  <!-- nan đan: sọc chéo hai chiều, cắt trong lòng mẹt -->
  <g clip-path="url(#bdTray)" opacity=".55">
    <g stroke="#A97A38" stroke-width="3" fill="none">
      <path d="M60 100 L 460 320 M60 130 L 460 350 M60 160 L 460 380 M60 190 L 460 410 M60 70 L 460 290 M60 40 L 460 260"/>
    </g>
    <g stroke="#E5C88A" stroke-width="2.4" fill="none">
      <path d="M60 320 L 460 100 M60 350 L 460 130 M60 380 L 460 160 M60 290 L 460 70 M60 260 L 460 40 M60 410 L 460 190"/>
    </g>
  </g>
  <ellipse cx="258" cy="256" rx="188" ry="132" fill="none" stroke="#2C5234" stroke-width="4"/>
  <ellipse cx="258" cy="256" rx="176" ry="122" fill="none" stroke="#E0A32E" stroke-width="2.4" stroke-dasharray="2 11" stroke-linecap="round"/>

  <!-- ===== LÁ CHUỐI lót lòng mẹt ===== -->
  <defs><clipPath id="bdLeaf">
    <path d="M96 246 C 96 186 168 146 258 146 C 348 146 420 186 420 246 C 420 306 348 348 258 348 C 168 348 96 306 96 246 Z"/>
  </clipPath></defs>
  <path d="M96 246 C 96 186 168 146 258 146 C 348 146 420 186 420 246 C 420 306 348 348 258 348 C 168 348 96 306 96 246 Z"
        fill="#2F5D2A" stroke="#1E4218" stroke-width="2.6"/>
  <path d="M100 246 C 100 190 170 152 258 152 C 300 152 338 160 368 174 C 330 166 292 162 258 162 C 174 162 108 200 100 246 Z"
        fill="#3E7B3A" opacity=".55"/>
  <!-- gân lá: nan quạt cong nhẹ toả từ sống lá, cùng hệ màu nền nên chỉ thấy mờ mờ -->
  <g clip-path="url(#bdLeaf)">
    <g stroke="#3C6E33" stroke-width="2" stroke-linecap="round" fill="none" opacity=".8">
      <path d="M128 258 C 152 224 196 200 252 194"/>
      <path d="M148 288 C 172 250 214 224 266 218"/>
      <path d="M176 316 C 200 278 240 252 292 246"/>
      <path d="M212 338 C 234 302 272 278 322 272"/>
      <path d="M262 348 C 282 314 316 292 362 288"/>
      <path d="M118 226 C 148 200 194 182 246 176"/>
      <path d="M310 344 C 328 314 358 296 398 292"/>
    </g>
    <path d="M92 262 C 168 232 340 232 424 264" fill="none" stroke="#6C9A52" stroke-width="3.4" stroke-linecap="round" opacity=".6"/>
  </g>

  <!-- ===== BÚN LÁ cắt miếng — góc trên trái, xếp lợp chồng mí ===== -->
  <use href="#bdBun" transform="translate(152 196) rotate(-4)"/>
  <use href="#bdBun" transform="translate(200 184) rotate(3)"/>
  <use href="#bdBun" transform="translate(140 222) rotate(2) scale(.96)"/>
  <use href="#bdBun" transform="translate(188 210) rotate(-3) scale(.98)"/>
  <use href="#bdBun" transform="translate(232 200) rotate(5) scale(.94)"/>
  <use href="#bdBun" transform="translate(172 240) rotate(-2) scale(.92)"/>

  <!-- ===== ĐẬU PHỤ RÁN — góc trên phải ===== -->
  <use href="#bdDau" transform="translate(310 190) rotate(-3)"/>
  <use href="#bdDau" transform="translate(358 198) rotate(4) scale(.97)"/>
  <use href="#bdDau" transform="translate(328 220) rotate(2) scale(1.03)"/>
  <use href="#bdDau" transform="translate(376 230) rotate(-4) scale(.94)"/>
  <use href="#bdDau" transform="translate(288 216) rotate(6) scale(.9)"/>
  <use href="#bdDau" transform="translate(348 248) rotate(-2) scale(.88)"/>

  <!-- ===== THỊT CHÂN GIÒ LUỘC — mép trái ===== -->
  <use href="#bdThit" transform="translate(140 278) rotate(-12)"/>
  <use href="#bdThit" transform="translate(176 292) rotate(6) scale(.97)"/>
  <use href="#bdThit" transform="translate(144 310) rotate(-4) scale(.94)"/>
  <use href="#bdThit" transform="translate(184 322) rotate(9) scale(.88)"/>

  <!-- ===== CHẢ CỐM — mép phải, hạt cốm xanh lấm tấm ===== -->
  <g transform="translate(360 288) rotate(-6)">
    <ellipse cx="0" cy="3" rx="27" ry="17" fill="#B4762C" stroke="#7C4A08" stroke-width="2"/>
    <ellipse cx="0" cy="0" rx="27" ry="17" fill="#D8A44A" stroke="#8E5A0E" stroke-width="2"/>
    <g fill="#7FA83C" stroke="#5C7F26" stroke-width=".9">
      <ellipse cx="-13" cy="-3" rx="3" ry="2" transform="rotate(-20 -13 -3)"/>
      <ellipse cx="-3" cy="4" rx="3.2" ry="2.1" transform="rotate(14 -3 4)"/>
      <ellipse cx="8" cy="-5" rx="3" ry="2" transform="rotate(-8 8 -5)"/>
      <ellipse cx="15" cy="4" rx="2.8" ry="1.9" transform="rotate(24 15 4)"/>
      <ellipse cx="-8" cy="-8" rx="2.6" ry="1.8" transform="rotate(6 -8 -8)"/>
      <ellipse cx="4" cy="9" rx="2.6" ry="1.8" transform="rotate(-16 4 9)"/>
    </g>
    <path d="M-19 -6 C -10 -12 8 -13 18 -8" fill="none" stroke="#F0C673" stroke-width="2.2" stroke-linecap="round" opacity=".8"/>
  </g>
  <g transform="translate(392 322) rotate(8) scale(.86)">
    <ellipse cx="0" cy="3" rx="26" ry="16" fill="#B4762C" stroke="#7C4A08" stroke-width="2"/>
    <ellipse cx="0" cy="0" rx="26" ry="16" fill="#CE9A40" stroke="#8E5A0E" stroke-width="2"/>
    <g fill="#7FA83C" stroke="#5C7F26" stroke-width=".9">
      <ellipse cx="-10" cy="2" rx="3" ry="2" transform="rotate(10 -10 2)"/>
      <ellipse cx="4" cy="-4" rx="3" ry="2" transform="rotate(-14 4 -4)"/>
      <ellipse cx="12" cy="5" rx="2.8" ry="1.9" transform="rotate(20 12 5)"/>
    </g>
  </g>

  <!-- ===== RAU: kinh giới + tía tô, cụm dưới trái, xếp dày cho khỏi thưa ===== -->
  <use href="#bdKinh" transform="translate(196 322) rotate(-18)"/>
  <use href="#bdTia"  transform="translate(220 336) rotate(8)"/>
  <use href="#bdKinh" transform="translate(170 340) rotate(20) scale(.95)"/>
  <use href="#bdTia"  transform="translate(244 320) rotate(-10) scale(.92)"/>
  <use href="#bdKinh" transform="translate(228 352) rotate(-4) scale(.9)"/>
  <use href="#bdTia"  transform="translate(196 352) rotate(28) scale(.86)"/>
  <use href="#bdKinh" transform="translate(258 340) rotate(14) scale(.88)"/>
  <use href="#bdKinh" transform="translate(148 320) rotate(-6) scale(.84)"/>

  <!-- ===== DƯA CHUỘT lát — cụm dưới phải ===== -->
  <g>
    <g transform="translate(302 336)">
      <circle r="14" fill="#6F9C48" stroke="#41702C" stroke-width="2"/>
      <circle r="9.4" fill="#D6E8B4"/>
      <g fill="#9CB25C"><circle cx="-3" cy="-3" r="1.3"/><circle cx="4" cy="0" r="1.3"/><circle cx="-1" cy="4" r="1.3"/></g>
    </g>
    <g transform="translate(332 350)">
      <circle r="12.4" fill="#6F9C48" stroke="#41702C" stroke-width="2"/>
      <circle r="8.2" fill="#D6E8B4"/>
      <g fill="#9CB25C"><circle cx="-2.6" cy="-2" r="1.2"/><circle cx="3" cy="2" r="1.2"/></g>
    </g>
    <g transform="translate(276 352)">
      <circle r="11.4" fill="#6F9C48" stroke="#41702C" stroke-width="2"/>
      <circle r="7.6" fill="#D6E8B4"/>
      <g fill="#9CB25C"><circle cx="-2.4" cy="1.6" r="1.1"/><circle cx="2.6" cy="-1.6" r="1.1"/></g>
    </g>
    <g transform="translate(358 330)">
      <circle r="10.4" fill="#6F9C48" stroke="#41702C" stroke-width="2"/>
      <circle r="6.8" fill="#D6E8B4"/>
      <g fill="#9CB25C"><circle cx="-2.2" cy="-1.4" r="1.1"/><circle cx="2.4" cy="1.8" r="1.1"/></g>
    </g>
  </g>

  <!-- ===== CHÉN MẮM TÔM ĐÁNH BÔNG — chính giữa mẹt ===== -->
  <g transform="translate(258 274)">
    <ellipse cx="0" cy="30" rx="46" ry="12" fill="rgba(15,26,14,.35)"/>
    <path d="M-42 0 C -40 20 -24 32 0 32 C 24 32 40 20 42 0 Z" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2.4"/>
    <ellipse cx="0" cy="0" rx="42" ry="13" fill="#F6F1E1" stroke="#D8D0B6" stroke-width="2"/>
    <!-- mặt mắm tím sim -->
    <ellipse cx="0" cy="0" rx="35" ry="10.4" fill="url(#bdMam)"/>
    <!-- BỌT ĐÁNH BÔNG nổi trắng ngà -->
    <g fill="#EDE2F0" opacity=".95">
      <circle cx="-18" cy="-2" r="5"/><circle cx="-8" cy="-4.6" r="6.4"/><circle cx="3" cy="-2.4" r="5.6"/>
      <circle cx="13" cy="-4" r="4.8"/><circle cx="22" cy="-1.2" r="3.8"/><circle cx="-26" cy="0.6" r="3.6"/>
      <circle cx="-2" cy="2.6" r="4.2"/><circle cx="10" cy="3" r="3.4"/><circle cx="-16" cy="4" r="3"/>
    </g>
    <g fill="#FFFDF8" opacity=".85">
      <circle cx="-10" cy="-6" r="2.4"/><circle cx="5" cy="-4.4" r="2"/><circle cx="-21" cy="-3" r="1.7"/>
    </g>
    <!-- lát ớt đỏ nổi trên mặt bọt -->
    <g transform="translate(16 1)"><circle r="4.4" fill="#D64B33" stroke="#A83722" stroke-width="1.4"/><circle r="1.9" fill="#F28C6E"/></g>
    <g transform="translate(-24 3)"><circle r="3.8" fill="#D64B33" stroke="#A83722" stroke-width="1.3"/><circle r="1.6" fill="#F28C6E"/></g>
    <!-- vệt mỡ nóng vàng loang -->
    <path d="M-28 6 C -14 9 10 9 26 5" fill="none" stroke="#F0C673" stroke-width="2.4" stroke-linecap="round" opacity=".75"/>
  </g>

  <!-- ===== ĐẠO CỤ: quất cắt đôi + ớt bên mép mẹt ===== -->
  <g transform="translate(84 372)">
    <ellipse cx="0" cy="16" rx="30" ry="8" fill="rgba(15,26,14,.3)"/>
    <circle cx="-8" cy="4" r="14" fill="#E4B93C" stroke="#B4881C" stroke-width="2"/>
    <circle cx="-8" cy="4" r="9.4" fill="#F6DC8C"/>
    <g stroke="#D9AE38" stroke-width="1.3" fill="none">
      <path d="M-8 -5.4 L -8 13.4 M-17.4 4 L 1.4 4 M-14.6 -2.6 L -1.4 10.6 M-14.6 10.6 L -1.4 -2.6"/>
    </g>
    <circle cx="16" cy="10" r="10" fill="#4E8B3A" stroke="#35682A" stroke-width="2"/>
    <path d="M16 0 c 3 -3 7 -3 9 -1" fill="none" stroke="#35682A" stroke-width="2.4" stroke-linecap="round"/>
  </g>
  <g transform="translate(438 372) rotate(12)">
    <ellipse cx="0" cy="16" rx="32" ry="8" fill="rgba(15,26,14,.3)"/>
    <path d="M-22 8 C -8 2 10 0 24 2" fill="none" stroke="#C94434" stroke-width="8" stroke-linecap="round"/>
    <path d="M24 2 c 4 -3 9 -3 12 -1" fill="none" stroke="#3E6B2A" stroke-width="3.4" stroke-linecap="round"/>
    <path d="M-18 14 C -6 10 8 9 18 11" fill="none" stroke="#D2542E" stroke-width="6.4" stroke-linecap="round"/>
  </g>
</svg>
