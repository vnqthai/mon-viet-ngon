---
/* Canh bí đỏ thịt bằm — minh họa riêng: miếng bí vỏ xanh, thịt bằm, trái bí trên bàn */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Tô canh bí đỏ thịt bằm nóng hổi">
  <defs>
    <linearGradient id="bdBroth" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#F2B36A"/><stop offset="1" stop-color="#DE8838"/>
    </linearGradient>
    <linearGradient id="bdBowl" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#FDFAF0"/><stop offset="1" stop-color="#E9E2CC"/>
    </linearGradient>
  </defs>
  <circle cx="260" cy="240" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="240" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <g class="steam">
    <path d="M215 240 C 204 214 230 198 219 170 C 212 152 226 140 222 124"/>
    <path d="M285 236 C 275 210 301 196 290 168 C 283 150 297 138 293 122"/>
  </g>
  <ellipse cx="255" cy="420" rx="196" ry="24" fill="rgba(15,26,14,.35)"/>

  <!-- tô -->
  <path d="M67 296 C 73 370 157 414 255 414 C 353 414 437 370 443 296 Z" fill="url(#bdBowl)"/>
  <ellipse cx="255" cy="412" rx="62" ry="11" fill="#D8D0B6"/>
  <ellipse cx="255" cy="294" rx="188" ry="46" fill="#F6F1E1"/>
  <ellipse cx="255" cy="294" rx="188" ry="46" fill="none" stroke="#2C5234" stroke-width="5"/>
  <ellipse cx="255" cy="295" rx="174" ry="40" fill="none" stroke="#E0A32E" stroke-width="2.5" stroke-dasharray="2 11" stroke-linecap="round"/>

  <!-- nước canh ngọt -->
  <ellipse cx="255" cy="297" rx="158" ry="33" fill="url(#bdBroth)"/>
  <ellipse cx="205" cy="290" rx="58" ry="10" fill="#F5CB8C" opacity=".6"/>

  <!-- miếng bí đỏ: múi cong, vài miếng còn cạnh vỏ xanh -->
  <g transform="rotate(-6 182 292)">
    <path d="M150 282 C 154 270 174 264 194 268 C 210 271 218 280 214 292 C 196 300 166 298 150 282 Z" fill="#EF9440" stroke="#C96F1E" stroke-width="2.5"/>
    <path d="M152 280 C 150 288 154 294 162 297" fill="none" stroke="#4E7B36" stroke-width="5" stroke-linecap="round"/>
    <path d="M166 276 q18 -5 38 0" fill="none" stroke="#F6B36A" stroke-width="3" stroke-linecap="round"/>
  </g>
  <g transform="rotate(5 268 300)">
    <path d="M238 292 C 242 280 262 274 282 278 C 296 281 304 290 300 300 C 282 308 254 306 238 292 Z" fill="#F29A45" stroke="#C96F1E" stroke-width="2.5"/>
    <path d="M252 286 q16 -5 36 0" fill="none" stroke="#F6BE78" stroke-width="3" stroke-linecap="round"/>
  </g>
  <g transform="rotate(-3 336 288)">
    <path d="M312 284 C 315 274 331 269 347 272 C 359 275 365 282 362 291 C 348 298 326 296 312 284 Z" fill="#EF9440" stroke="#C96F1E" stroke-width="2.5"/>
    <path d="M358 290 C 362 284 362 278 358 273" fill="none" stroke="#4E7B36" stroke-width="4.6" stroke-linecap="round"/>
  </g>

  <!-- thịt bằm rắc từng cụm -->
  <g fill="#9C6238" stroke="#7E4A26" stroke-width="1">
    <circle cx="222" cy="288" r="3.4"/><circle cx="230" cy="292" r="2.8"/><circle cx="224" cy="296" r="2.4"/>
    <circle cx="296" cy="312" r="3.2"/><circle cx="304" cy="308" r="2.6"/><circle cx="300" cy="316" r="2.2"/>
    <circle cx="158" cy="306" r="3"/><circle cx="166" cy="310" r="2.4"/>
    <circle cx="352" cy="300" r="3"/><circle cx="358" cy="304" r="2.4"/>
  </g>

  <!-- hành lá + ngò + tiêu -->
  <g stroke="#6F9C48" stroke-width="3.6" stroke-linecap="round" fill="none">
    <path d="M196 314 l12 -3 M258 320 l11 -2 M330 314 l10 -2 M240 282 l10 -2"/>
  </g>
  <g fill="#4E7B36">
    <ellipse cx="276" cy="292" rx="6.5" ry="3" transform="rotate(-14 276 292)"/>
    <ellipse cx="206" cy="280" rx="6" ry="2.8" transform="rotate(12 206 280)"/>
  </g>
  <g fill="#2E2318"><circle cx="248" cy="304" r="1.6"/><circle cx="318" cy="296" r="1.6"/></g>

  <!-- muôi múc canh gác bên trái -->
  <g transform="rotate(-14 98 420)">
    <rect x="88" y="352" width="11" height="58" rx="5.5" fill="#F6F1E1" stroke="#D8D0B6" stroke-width="2"/>
    <ellipse cx="93" cy="424" rx="27" ry="15" fill="#F6F1E1" stroke="#D8D0B6" stroke-width="2"/>
    <ellipse cx="93" cy="424" rx="16" ry="8" fill="#F2A75C" opacity=".85"/>
  </g>

  <!-- trái bí đỏ hồ lô + miếng bí bổ sẵn trên bàn -->
  <g transform="translate(430 372)">
    <ellipse cx="0" cy="44" rx="56" ry="12" fill="rgba(15,26,14,.35)"/>
    <path d="M-44 12 C -44 -14 -24 -30 0 -30 C 24 -30 44 -14 44 12 C 44 32 24 46 0 46 C -24 46 -44 32 -44 12 Z" fill="#3E6428" stroke="#2C4A1E" stroke-width="2.5"/>
    <path d="M-24 -22 C -30 -6 -30 24 -22 40 M0 -30 C -2 -6 -2 22 0 44 M24 -22 C 30 -6 30 24 22 40" fill="none" stroke="#57833B" stroke-width="4" stroke-linecap="round"/>
    <path d="M-4 -30 C -6 -38 -2 -44 6 -46 C 10 -40 10 -34 6 -30 Z" fill="#8A5730" stroke="#6E4222" stroke-width="2"/>
  </g>
  <g transform="translate(346 414) rotate(-8)">
    <path d="M-34 10 A 36 36 0 0 1 34 10 L 26 16 A 27 27 0 0 0 -26 16 Z" fill="#EF9440" stroke="#C96F1E" stroke-width="2.4"/>
    <path d="M-34 10 A 36 36 0 0 1 34 10" fill="none" stroke="#4E7B36" stroke-width="5" stroke-linecap="round"/>
    <g fill="#F6DFA6" stroke="#D9B36A" stroke-width="1"><ellipse cx="-12" cy="8" rx="3.4" ry="2.2"/><ellipse cx="0" cy="6" rx="3.4" ry="2.2"/><ellipse cx="12" cy="8" rx="3.4" ry="2.2"/></g>
  </g>
</svg>
