    <path d="M0 0 L18 -13 L90 -13 L90 42 L72 55 L0 55 Z" fill="none" stroke="#5E2C1C" stroke-width="2.6"/>
    <path d="M0 0 L18 -13 L90 -13 L72 0 Z" fill="#E0A643" stroke="#8E5417" stroke-width="2.4"/>
    <g fill="#8E5417" opacity=".72"><circle cx="24" cy="-5" r="2.1"/><circle cx="41" cy="-9" r="1.9"/><circle cx="58" cy="-5" r="2.1"/><circle cx="73" cy="-9" r="1.8"/></g>
  </g>
  <!-- miếng 3 (phải) -->
  <g transform="translate(292 252) rotate(5)">
    <path d="M0 0 L16 -12 L82 -12 L82 38 L66 50 L0 50 Z" fill="#B87A5E" stroke="#5E2C1C" stroke-width="2.6"/>
