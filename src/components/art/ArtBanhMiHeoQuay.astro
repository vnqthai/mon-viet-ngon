---
/* Bánh mì heo quay — VẼ LẠI vòng 3 theo ý Thái: bỏ hẳn kiểu dựng đứng nửa ổ,
   dùng ĐÚNG bố cục của banh-mi-thit (ổ nằm ngang, bổ dọc, khoe nhân bên trong)
   vì bố cục đó đã đọc được. Khác nhau nằm ở NHÂN:
   · banh-mi-thit  → nhiều tầng hồng đỏ (chả lụa, thịt nguội) + đồ chua cam
   · banh-mi-heo-quay → ba MIẾNG HEO QUAY hình HỘP CHỮ NHẬT, mỗi miếng lộ đủ ba
     tầng (da vàng rỗ mỏng · mỡ trắng · nạc nâu hồng) + sốt tương đen sẫm.
   Miếng thịt vẽ thành khối hộp cạnh thẳng, KHÔNG bo tròn — heo quay chặt ra là
   miếng vuông vức chứ không tròn vo. */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Ổ bánh mì heo quay nằm ngang, nhân là miếng heo quay ba tầng da mỡ nạc rưới sốt tương đen">
  <circle cx="260" cy="250" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="250" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <ellipse cx="260" cy="392" rx="196" ry="26" fill="rgba(15,26,14,.32)"/>

  <!-- giấy gói lót dưới -->
  <g transform="rotate(-4 260 340)">
    <path d="M64 300 L436 292 L458 372 L48 380 Z" fill="#F7F2E4" stroke="#DCD3BC" stroke-width="2"/>
    <path d="M92 306 L84 372 M180 300 L176 376 M330 296 L332 374" fill="none" stroke="#E6DFCA" stroke-width="2"/>
  </g>

  <!-- NẮP BÁNH ngả ra sau -->
  <g transform="rotate(-3 260 250)">
    <path d="M84 258 C 110 226 172 210 250 208 C 330 206 400 218 428 242 C 440 253 436 268 418 273 C 380 262 320 254 250 255 C 180 256 122 265 92 274 C 76 272 74 266 84 258 Z"
