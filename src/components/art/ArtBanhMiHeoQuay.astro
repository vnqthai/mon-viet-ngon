    <ellipse cx="0" cy="44" rx="44" ry="12" fill="rgba(15,26,14,.28)"/>
    <path d="M-40 16 C -38 38 -22 48 0 48 C 22 48 38 38 40 16 Z" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2"/>
