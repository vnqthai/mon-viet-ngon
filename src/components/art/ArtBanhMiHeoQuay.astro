    <path d="M0 0 L16 -12 L82 -12 L66 0 Z" fill="#E0A643" stroke="#8E5417" stroke-width="2.4"/>
    <g fill="#8E5417" opacity=".7"><circle cx="21" cy="-4" r="2"/><circle cx="37" cy="-8" r="1.8"/><circle cx="53" cy="-4" r="2"/><circle cx="66" cy="-8" r="1.6"/></g>
  </g>

  <!-- SỐT TƯƠNG ĐEN rưới lên mặt thịt thành dòng dày -->
  <g fill="none" stroke="#3E2412" stroke-linecap="round">
    <path d="M126 264 C 176 250 292 246 376 258" stroke-width="9"/>
    <path d="M162 272 C 164 288 160 298 152 302" stroke-width="6"/>
    <path d="M256 264 C 260 282 256 292 248 296" stroke-width="6"/>
    <path d="M340 270 C 344 286 340 296 332 300" stroke-width="5"/>
  </g>

  <!-- ĐỒ CHUA sợi cam + trắng thò ra mép trước -->
  <g stroke-linecap="round">
    <g stroke="#E89A2E" stroke-width="5">
      <path d="M118 300 C 108 292 96 290 86 293"/>
      <path d="M392 296 C 392 286 386 278 376 275"/>
      <path d="M300 306 C 296 316 288 322 278 323"/>
    </g>
    <g stroke="#F5EEDC" stroke-width="4.6">
      <path d="M140 298 C 132 288 120 284 110 286"/>
      <path d="M420 302 C 424 292 422 284 414 279"/>
    </g>
  </g>

  <!-- DƯA LEO thanh xanh nằm dọc mép trước -->
  <g>
    <path d="M120 330 C 176 340 250 344 320 340 L 320 350 C 250 354 174 350 120 340 Z" fill="#B8D07A" stroke="#6F9440" stroke-width="2.4"/>
    <path d="M300 336 C 346 340 390 338 424 331 L 426 341 C 392 348 346 350 300 346 Z" fill="#A6C46A" stroke="#6F9440" stroke-width="2.4"/>
  </g>

  <!-- NGÒ RÍ nhánh nguyên nhô lên -->
  <g transform="translate(96 282)">
    <path d="M0 12 q 6 -14 20 -19" fill="none" stroke="#4E7B36" stroke-width="2.6" stroke-linecap="round"/>
    <g fill="#6F9C48">
      <ellipse cx="23" cy="-9" rx="6" ry="3.6" transform="rotate(-26 23 -9)"/>
      <ellipse cx="12" cy="-3" rx="5" ry="3" transform="rotate(22 12 -3)"/>
      <ellipse cx="27" cy="-1" rx="4.6" ry="2.8" transform="rotate(4 27 -1)"/>
