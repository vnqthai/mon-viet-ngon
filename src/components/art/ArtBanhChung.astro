  <path d="M430 306 L 448 336" fill="none" stroke="#2E5325" stroke-width="2.2"/>
  <!-- mặt trên: nếp XANH MƯỚT vì ăn màu lá, không phải trắng -->
  <path d="M330 330 L 422 292 L 454 344 Z" fill="#BCD095" stroke="#7A9048" stroke-width="3" stroke-linejoin="round"/>
  <g fill="#D2E0B0">
    <ellipse cx="368" cy="322" rx="7.4" ry="4.6" transform="rotate(-22 368 322)"/>
    <ellipse cx="402" cy="310" rx="7.4" ry="4.6" transform="rotate(-22 402 310)"/>
    <ellipse cx="406" cy="330" rx="7.2" ry="4.4" transform="rotate(-8 406 330)"/>
    <ellipse cx="428" cy="322" rx="7" ry="4.2" transform="rotate(18 428 322)"/>
    <ellipse cx="384" cy="336" rx="7" ry="4.2" transform="rotate(-10 384 336)"/>
  </g>
  <!-- mặt cắt: năm lớp NẰM NGANG, nếp – đậu – thịt – đậu – nếp -->
  <!-- vệt xanh sát mặt: lớp nếp ngoài cùng ăn màu lá, dày chừng vài milimét -->
  <path d="M330 330 L 454 344 L 454 350 L 330 336 Z" fill="#BCD095" stroke="#7A9048" stroke-width="2.2" stroke-linejoin="round"/>
  <path d="M330 336 L 454 350 L 454 358 L 330 344 Z" fill="#F1E7D2" stroke="#B39A6E" stroke-width="2.4" stroke-linejoin="round"/>
  <path d="M330 344 L 454 358 L 454 368 L 330 354 Z" fill="#DFB43A" stroke="#95761A" stroke-width="2.4" stroke-linejoin="round"/>
  <path d="M330 354 L 454 368 L 454 378 L 330 364 Z" fill="#C4705E" stroke="#8A3F30" stroke-width="2.4" stroke-linejoin="round"/>
  <path d="M330 364 L 454 378 L 454 388 L 330 374 Z" fill="#DFB43A" stroke="#95761A" stroke-width="2.4" stroke-linejoin="round"/>
  <path d="M330 374 L 454 388 L 454 398 L 330 384 Z" fill="#F1E7D2" stroke="#B39A6E" stroke-width="2.4" stroke-linejoin="round"/>
  <!-- dải mỡ trong nằm giữa lớp thịt -->
  <path d="M356 357 L 412 363 L 412 370 L 356 364 Z" fill="#EFD9C8" opacity=".92"/>
  <!-- hạt nếp gợn trên hai dải trắng -->
  <g fill="#FAF3E3" stroke="#C4B189" stroke-width="1.5">
    <ellipse cx="352" cy="336" rx="6.6" ry="3.8" transform="rotate(6 352 336)"/>
    <ellipse cx="400" cy="342" rx="6.6" ry="3.8" transform="rotate(6 400 342)"/>
    <ellipse cx="368" cy="382" rx="6.6" ry="3.8" transform="rotate(6 368 382)"/>
    <ellipse cx="420" cy="388" rx="6.6" ry="3.8" transform="rotate(6 420 388)"/>
  </g>
</svg>
