---
/* Bánh giầy — họ vàng "Cơm & bánh". VẼ LẠI vòng 3.
   Vòng 1: miếng dẹt, trắng tinh, bày bốn cái → CHỒNG BÁT ĐĨA SỨ.
   Vòng 2: phóng to và vồng lên, vẫn còn một miếng tròn nằm sau → vẫn đọc ra
   cái đĩa. Hai thứ chưa chữa được:
   · miếng vẫn quá BỀ NGANG so với bề dày. Bánh giầy thật nhỏ bằng lòng bàn
     tay mà dày gần 2 cm — tỉ lệ ngang/dọc mới là thứ nói ra "cục bánh dẻo" hay
     "cái đĩa", đúng như bài học ly chè đậu đỏ ở đợt 13 (vẽ thon thì thành ly
     rượu)
   · vệt bóng trắng dài kiểu men sứ. Mặt bánh giầy hấp chín BÓNG MỜ chứ không
     loáng, và có gợn hạt nếp lấm tấm
   Vòng 3: thu bề ngang còn chừng 2/3, tăng bề dày, bỏ hẳn miếng tròn nằm sau,
   đổi vệt bóng dài thành mảng sáng mờ + gợn hạt. Lát giò dày hẳn lên cho ba
   tầng trắng–hồng–trắng chiếm đủ chỗ ở 260px. */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Bánh giầy giò trên mẹt tre: hai miếng bánh trắng ngà dày dặn kẹp một lát giò lụa hồng">
  <circle cx="260" cy="240" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="240" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <g class="steam">
    <path d="M220 150 C 209 126 235 110 224 84 C 217 68 231 56 227 42"/>
    <path d="M296 146 C 286 122 312 108 301 82 C 294 66 308 54 304 40"/>
  </g>
  <ellipse cx="258" cy="408" rx="150" ry="24" fill="rgba(15,26,14,.35)"/>

  <!-- MẸT TRE làm nền sẫm cho miếng bánh nhạt nổi lên -->
  <ellipse cx="258" cy="382" rx="146" ry="42" fill="#7C5A2C" stroke="#4E3614" stroke-width="3"/>
  <ellipse cx="258" cy="374" rx="146" ry="42" fill="#BE9850" stroke="#4E3614" stroke-width="3"/>
  <ellipse cx="258" cy="374" rx="126" ry="34" fill="#D2B06C" stroke="#7C5A2C" stroke-width="2.6"/>
  <g fill="none" stroke="#A5843F" stroke-width="2.2">
    <path d="M146 366 C 184 356 332 356 370 366"/>
    <path d="M140 378 C 180 370 336 370 376 378"/>
    <path d="M156 392 C 192 386 324 386 360 392"/>
  </g>
  <g fill="none" stroke="#A5843F" stroke-width="2">
    <path d="M186 346 C 180 360 180 388 186 402"/>
    <path d="M234 342 C 230 358 230 392 234 406"/>
    <path d="M290 342 C 286 358 286 392 290 406"/>
    <path d="M336 346 C 332 360 332 388 336 402"/>
  </g>

  <!-- MIẾNG BÁNH DƯỚI: dày, bề ngang gọn, mép hơi méo do nặn tay -->
  <path d="M170 336 C 170 316 196 304 258 304 C 320 304 346 316 346 336
           C 346 358 320 372 258 372 C 196 372 170 358 170 336 Z"
        fill="#E6DAB9" stroke="#9C8C66" stroke-width="3"/>
  <path d="M184 348 C 204 364 312 364 332 348" fill="none" stroke="#CDBE97" stroke-width="4"/>

  <!-- LÁT GIÒ LỤA kẹp giữa: dày rõ, hồng xám, lỗ khí li ti -->
  <path d="M162 302 C 162 280 194 268 258 268 C 322 268 354 280 354 302
           C 354 322 322 334 258 334 C 194 334 162 322 162 302 Z"
        fill="#D9A093" stroke="#9A5546" stroke-width="3"/>
  <path d="M176 290 C 202 276 314 276 340 290" fill="none" stroke="#ECC2B6" stroke-width="5" stroke-linecap="round"/>
  <g fill="#EFC9BE">
    <ellipse cx="200" cy="304" rx="7.4" ry="4.6" transform="rotate(-10 200 304)"/>
    <ellipse cx="252" cy="312" rx="7.8" ry="4.8" transform="rotate(4 252 312)"/>
    <ellipse cx="306" cy="302" rx="7.4" ry="4.6" transform="rotate(10 306 302)"/>
    <ellipse cx="224" cy="318" rx="6.2" ry="4" transform="rotate(-4 224 318)"/>
    <ellipse cx="282" cy="318" rx="6.2" ry="4" transform="rotate(6 282 318)"/>
  </g>

  <!-- MIẾNG BÁNH TRÊN: dày dặn, vồng lên như cái gối nhỏ -->
  <path d="M162 264 C 162 226 194 206 258 206 C 322 206 354 226 354 264
           C 354 288 322 302 258 302 C 194 302 162 288 162 264 Z"
        fill="#F2E9D2" stroke="#9C8C66" stroke-width="3"/>
  <!-- mảng sáng MỜ, không phải vệt loáng kiểu men sứ -->
  <ellipse cx="248" cy="248" rx="62" ry="26" fill="#FBF6E7" opacity=".65"/>
  <!-- gợn hạt nếp lấm tấm: đây là thứ nói ra nó làm từ nếp giã, không phải đồ sứ -->
  <g fill="#E6DBBE">
    <ellipse cx="204" cy="238" rx="8" ry="5" transform="rotate(-16 204 238)"/>
    <ellipse cx="244" cy="228" rx="8.2" ry="5.2" transform="rotate(4 244 228)"/>
    <ellipse cx="288" cy="236" rx="8" ry="5" transform="rotate(12 288 236)"/>
    <ellipse cx="316" cy="256" rx="7.6" ry="4.8" transform="rotate(26 316 256)"/>
    <ellipse cx="192" cy="264" rx="7.6" ry="4.8" transform="rotate(-24 192 264)"/>
    <ellipse cx="230" cy="274" rx="8" ry="5" transform="rotate(-4 230 274)"/>
    <ellipse cx="282" cy="276" rx="8" ry="5" transform="rotate(8 282 276)"/>
    <ellipse cx="326" cy="280" rx="7.4" ry="4.6" transform="rotate(-20 326 280)"/>
  </g>
  <path d="M180 276 C 206 292 310 292 336 276" fill="none" stroke="#DED2B2" stroke-width="4" stroke-linecap="round"/>
</svg>
