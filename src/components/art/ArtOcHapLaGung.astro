      <ellipse cx="2" cy="19" rx="16" ry="12.4" transform="rotate(-8 2 19)" fill="#1C1206" stroke="#150C03" stroke-width="2"/>
      <ellipse cx="2" cy="19" rx="16" ry="12.4" transform="rotate(-8 2 19)" fill="none" stroke="#C8AC76" stroke-width="2.6"/>
    </g>
    <g transform="translate(258 266) rotate(8) scale(1.0)">
      <path d="M-35 8 C -35 -12 -25 -31 -2 -45 C 22 -32 37 -13 37 8 C 37 31 19 44 1 44 C -17 44 -35 31 -35 8 Z" fill="url(#ohgVo2)"/>
      <path d="M-19 -21 C -12 -31 -6 -40 -2 -45 C 22 -32 30 -25 25 -16 C 11 -9 -7 -11 -19 -21 Z" fill="#372612"/>
      <path d="M-32 2 C -17 -13 16 -13 35 1" fill="none" stroke="#9B7B4E" stroke-width="2.4" opacity=".9"/>
      <path d="M-19 -20 C -8 -28 15 -25 25 -15" fill="none" stroke="#9B7B4E" stroke-width="2" opacity=".8"/>
      <path d="M-27 -6 C -23 -20 -12 -33 -4 -40" fill="none" stroke="#9B7B4E" stroke-width="2.2" opacity=".55"/>
      <ellipse cx="2" cy="19" rx="16" ry="12.4" transform="rotate(-8 2 19)" fill="#1C1206" stroke="#150C03" stroke-width="2"/>
      <ellipse cx="2" cy="19" rx="16" ry="12.4" transform="rotate(-8 2 19)" fill="none" stroke="#C8AC76" stroke-width="2.6"/>
    </g>
    <g transform="translate(350 280) rotate(10) scale(0.9)">
      <path d="M-35 8 C -35 -12 -25 -31 -2 -45 C 22 -32 37 -13 37 8 C 37 31 19 44 1 44 C -17 44 -35 31 -35 8 Z" fill="url(#ohgVo)"/>
      <path d="M-19 -21 C -12 -31 -6 -40 -2 -45 C 22 -32 30 -25 25 -16 C 11 -9 -7 -11 -19 -21 Z" fill="#3E2C15"/>
      <path d="M-32 2 C -17 -13 16 -13 35 1" fill="none" stroke="#9B7B4E" stroke-width="2.4" opacity=".9"/>
      <path d="M-19 -20 C -8 -28 15 -25 25 -15" fill="none" stroke="#9B7B4E" stroke-width="2" opacity=".8"/>
      <path d="M-27 -6 C -23 -20 -12 -33 -4 -40" fill="none" stroke="#9B7B4E" stroke-width="2.2" opacity=".55"/>
      <ellipse cx="2" cy="19" rx="16" ry="12.4" transform="rotate(-8 2 19)" fill="#1C1206" stroke="#150C03" stroke-width="2"/>
      <ellipse cx="2" cy="19" rx="16" ry="12.4" transform="rotate(-8 2 19)" fill="none" stroke="#C8AC76" stroke-width="2.6"/>
    </g>
    <!-- hàng trước -->
    <g transform="translate(208 324) rotate(-5) scale(0.96)">
      <path d="M-35 8 C -35 -12 -25 -31 -2 -45 C 22 -32 37 -13 37 8 C 37 31 19 44 1 44 C -17 44 -35 31 -35 8 Z" fill="#5F462A"/>
      <path d="M-19 -21 C -12 -31 -6 -40 -2 -45 C 22 -32 30 -25 25 -16 C 11 -9 -7 -11 -19 -21 Z" fill="#46331B"/>
      <path d="M-32 2 C -17 -13 16 -13 35 1" fill="none" stroke="#B4956A" stroke-width="2.4" opacity=".9"/>
      <path d="M-19 -20 C -8 -28 15 -25 25 -15" fill="none" stroke="#B4956A" stroke-width="2" opacity=".8"/>
      <path d="M-27 -6 C -23 -20 -12 -33 -4 -40" fill="none" stroke="#B4956A" stroke-width="2.2" opacity=".55"/>
      <ellipse cx="2" cy="19" rx="16" ry="12.4" transform="rotate(-8 2 19)" fill="#1C1206" stroke="#150C03" stroke-width="2"/>
      <ellipse cx="2" cy="19" rx="16" ry="12.4" transform="rotate(-8 2 19)" fill="none" stroke="#DCC08A" stroke-width="2.6"/>
    </g>
    <g transform="translate(310 332) rotate(7) scale(0.94)">
      <path d="M-35 8 C -35 -12 -25 -31 -2 -45 C 22 -32 37 -13 37 8 C 37 31 19 44 1 44 C -17 44 -35 31 -35 8 Z" fill="#523A21"/>
      <path d="M-19 -21 C -12 -31 -6 -40 -2 -45 C 22 -32 30 -25 25 -16 C 11 -9 -7 -11 -19 -21 Z" fill="#3E2C15"/>
      <path d="M-32 2 C -17 -13 16 -13 35 1" fill="none" stroke="#B4956A" stroke-width="2.4" opacity=".9"/>
