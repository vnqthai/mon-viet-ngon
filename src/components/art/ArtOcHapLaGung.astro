    <path d="M0 0 C 20 -6 44 -8 66 -4" fill="none" stroke="#3B6520" stroke-width="3" stroke-linecap="round"/>
    <g fill="#4E7F2C" stroke="#3B6520" stroke-width="1.6">
      <path d="M8 -2 C 16 -16 32 -20 42 -14 C 32 -2 18 2 8 -2 Z"/>
      <path d="M30 -4 C 40 -18 56 -21 66 -15 C 55 -3 41 0 30 -4 Z"/>
    </g>
  </g>

  <!-- CHÉN NƯỚC MẮM GỪNG: nước trong hơi vàng, có sợi gừng và lá chanh chỉ -->
  <g transform="translate(422 356)">
    <ellipse cx="0" cy="16" rx="46" ry="12" fill="rgba(15,26,14,.3)"/>
    <path d="M-38 -6 C -36 12 -20 24 0 24 C 20 24 36 12 38 -6 Z" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2"/>
    <ellipse cx="0" cy="-6" rx="32" ry="10" fill="#EBC471" stroke="#C79E44" stroke-width="1.8"/>
    <g stroke="#F2E7B0" stroke-width="1.8" stroke-linecap="round" fill="none">
      <path d="M-18 -8 L -4 -5"/><path d="M6 -9 L 20 -6"/>
    </g>
    <g fill="#5E9436"><ellipse cx="-9" cy="-3" rx="7" ry="1.8"/><ellipse cx="12" cy="-2" rx="6" ry="1.7"/></g>
    <circle cx="-22" cy="-4" r="3" fill="#D64B33"/>
  </g>

  <!-- vài con ốc chưa nhồi để cạnh xửng, cho thấy vỏ tròn khi nhìn nghiêng -->
  <g transform="translate(96 398)" stroke="#150C03" stroke-width="2.2">
    <ellipse cx="0" cy="10" rx="34" ry="9" fill="rgba(15,26,14,.3)" stroke="none"/>
    <g transform="translate(-16 2) rotate(-14) scale(.46)">
      <path d="M-35 8 C -35 -12 -25 -31 -2 -45 C 22 -32 37 -13 37 8 C 37 31 19 44 1 44 C -17 44 -35 31 -35 8 Z" fill="#5A4227"/>
