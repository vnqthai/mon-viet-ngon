  <g stroke="#9A7A3A" stroke-width="2.4" fill="none" opacity=".8">
    <path d="M84 330 C 116 366 186 386 258 386 C 330 386 400 366 432 330"/>
    <path d="M76 312 C 110 352 184 372 258 372 C 332 372 406 352 440 312"/>
  </g>
  <g stroke="#9A7A3A" stroke-width="2.2" opacity=".7">
    <path d="M124 316 L 130 384"/><path d="M190 324 L 194 396"/>
    <path d="M258 326 L 258 400"/><path d="M326 324 L 322 396"/>
    <path d="M392 316 L 386 384"/>
