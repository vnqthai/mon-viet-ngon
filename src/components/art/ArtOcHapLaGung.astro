      <path d="M-27 -6 C -23 -20 -12 -33 -4 -40" fill="none" stroke="#B4956A" stroke-width="2.2" opacity=".55"/>
      <ellipse cx="2" cy="19" rx="16" ry="12.4" transform="rotate(-8 2 19)" fill="#1C1206" stroke="#150C03" stroke-width="2"/>
      <ellipse cx="2" cy="19" rx="16" ry="12.4" transform="rotate(-8 2 19)" fill="none" stroke="#DCC08A" stroke-width="2.6"/>
    </g>
  </g>

  <!-- ĐẦU LÁ GỪNG THÒ RA KHỎI MIỆNG VỎ — chữ ký của món. Gốc lá phải nằm ĐÚNG
       trong lòng miệng vỏ, không thì nhìn ra mấy cái lá rơi vãi lên trên. -->
  <g fill="#5E9436" stroke="#3B6520" stroke-width="2">
    <path d="M170 288 C 182 300 192 322 194 346 C 184 338 173 318 168 296 Z"/>
    <path d="M258 280 C 266 298 268 324 262 348 C 253 334 250 310 252 288 Z"/>
