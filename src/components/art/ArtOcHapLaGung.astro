    <linearGradient id="ohgVo2" x1="0.2" y1="0" x2="0.8" y2="1">
      <stop offset="0" stop-color="#4A3520"/><stop offset="1" stop-color="#1C1206"/>
    </linearGradient>
    <linearGradient id="ohgTre" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#E4C88C"/><stop offset="1" stop-color="#B8944F"/>
    </linearGradient>
  </defs>
  <circle cx="260" cy="244" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="244" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
