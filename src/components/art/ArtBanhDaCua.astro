    <path d="M154 262 c 12 -8 26 -6 32 2 c -12 7 -25 5 -32 -2 z"/>
  </g>

  <!-- ĐẠO CỤ dưới chân tô: miếng chanh và trái ớt -->
  <ellipse cx="424" cy="378" rx="30" ry="9" fill="rgba(15,26,14,.3)"/>
  <path d="M398 372 C 398 358 410 350 426 350 C 442 350 454 358 454 372 Z" fill="#D9E06A" stroke="#8A9420" stroke-width="2.6"/>
  <g fill="none" stroke="#A8B32E" stroke-width="1.8">
    <path d="M426 350 L 426 372"/>
    <path d="M410 355 L 418 371"/>
    <path d="M442 355 L 434 371"/>
  </g>
  <path d="M74 380 C 90 366 118 362 134 368 C 120 380 96 386 74 380 Z" fill="#C4381F" stroke="#7E2110" stroke-width="2.6"/>
  <path d="M132 366 L 146 358" fill="none" stroke="#3E7A2C" stroke-width="4" stroke-linecap="round"/>
</svg>
