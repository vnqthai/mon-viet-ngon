---
/* Bánh đa cua — họ teal "Chan & húp".
   Đây là họ chật nhất site (35 hình) và cả 35 dùng chung một khuôn: vật đựng
   đặt giữa, nhìn chếch từ trên, ba sợi khói, đạo cụ dưới chân. Đợt 14 đã thử
   phá khuôn đó bằng cách đổi GÓC NHÌN và bị trả lại cả hai lần — nên hình này
   giữ nguyên khuôn, và tách bằng RUỘT.
   Hàng xóm nguy hiểm nhất là BÚN RIÊU CUA: cùng nấu từ cua đồng giã lọc, cùng
   có tảng riêu và gạch cua. Ba thứ tách được:
   · SỢI BÁNH ĐA ĐỎ NÂU vun cao khỏi mặt nước — 35 tô kia không tô nào nhìn
     thấy sợi, sợi đều chìm dưới nước. Đây là chữ ký, và đúng thực tế
   · NƯỚC DÙNG VÀNG NÂU TRONG, không phải nước đỏ cà chua của bún riêu — món
     này không đánh chua
   · CHẢ LÁ LỐT: cuộn xanh sẫm, thứ chưa tô nào có
   Luật đợt 14 "đồ ăn nhô lên khỏi vành tô phải CHỒNG MÉP lên vành": đống sợi
   vẽ đè hẳn lên vành trước của tô, không để nổi tự do kẻo thành mấy cái lông
   chim bay như bún sứa bản 1. */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Tô bánh đa cua: sợi bánh đa đỏ nâu bản to vun trên nước dùng vàng, có tảng riêu cua, chả lá lốt, tôm và rau muống chần">
  <circle cx="260" cy="240" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="240" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <g class="steam">
    <path d="M198 152 C 187 128 213 112 202 86 C 195 70 209 58 205 44"/>
    <path d="M258 142 C 248 118 274 104 263 78 C 256 62 270 50 266 36"/>
    <path d="M318 152 C 308 128 334 114 323 88 C 316 72 330 60 326 46"/>
  </g>
  <ellipse cx="258" cy="412" rx="172" ry="26" fill="rgba(15,26,14,.35)"/>

  <!-- TÔ SỨ TRẮNG: đúng khuôn của họ teal -->
  <path d="M116 290 C 120 352 172 396 258 396 C 344 396 396 352 400 290 Z"
        fill="#F4EFE2" stroke="#8E8368" stroke-width="3"/>
  <path d="M140 330 C 164 366 202 384 258 384 C 314 384 352 366 376 330" fill="none" stroke="#D6CDB6" stroke-width="4"/>
  <ellipse cx="258" cy="398" rx="48" ry="10" fill="#E4DCC6" stroke="#8E8368" stroke-width="3"/>

  <!-- NƯỚC DÙNG: vàng nâu trong, KHÔNG đỏ như bún riêu -->
  <ellipse cx="258" cy="290" rx="142" ry="42" fill="#C9862E" stroke="#8E8368" stroke-width="3"/>
  <ellipse cx="258" cy="292" rx="124" ry="34" fill="#D89A3C"/>

  <!-- RAU MUỐNG CHẦN: vắt sang bên trái, dưới đống sợi -->
  <g fill="#3E7A2C" stroke="#26521A" stroke-width="2.2">
    <path d="M146 288 c 30 -12 62 -12 84 -2 c -24 10 -56 12 -84 2 z"/>
    <path d="M152 302 c 28 -10 58 -10 78 -1 c -22 9 -52 11 -78 1 z"/>
  </g>
  <g fill="none" stroke="#63A34E" stroke-width="2">
    <path d="M158 286 L 214 283"/>
    <path d="M162 300 L 216 298"/>
