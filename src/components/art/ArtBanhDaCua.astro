  </g>
  <path d="M292 306 L 306 298 L 304 310 Z" fill="#D2492A" stroke="#8E2A14" stroke-width="2.2"/>

  <!-- GẠCH CUA CHƯNG: thìa gạch đỏ cam thả giữa tô -->
  <path d="M212 262 C 216 252 232 248 244 252 C 252 258 250 270 240 274 C 228 278 214 272 212 262 Z"
        fill="#E08A2E" stroke="#9E5810" stroke-width="2.4"/>
  <g fill="#F0A64E">
    <ellipse cx="226" cy="260" rx="6" ry="4" transform="rotate(-12 226 260)"/>
    <ellipse cx="238" cy="266" rx="5" ry="3.4" transform="rotate(8 238 266)"/>
  </g>

  <!-- HÀNH PHI + hành lá rắc mặt -->
