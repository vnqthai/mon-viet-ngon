    <path d="M158 300 L 206 274 L 262 262 L 318 264 L 316 282 L 264 280 L 210 292 L 164 318 Z" fill="#9E4A28"/>
    <path d="M180 318 L 234 296 L 292 288 L 344 292 L 342 310 L 294 306 L 238 314 L 188 336 Z" fill="#8A3E20"/>
    <path d="M206 254 L 258 240 L 312 240 L 352 252 L 346 270 L 310 258 L 260 258 L 212 272 Z" fill="#B0552E"/>
