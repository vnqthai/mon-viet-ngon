---
/* Cà ri gà — TÔ SÂU trắng kem (không nồi, né bò kho): nước cà ri vàng nghệ ánh cam,
   xoáy nước cốt dừa trắng giữa mặt, đùi gà da vàng xương hai mấu, khoai lang cam +
   khoai môn chấm tím, sả khúc song song; đạo cụ: nửa ổ bánh mì lộ ruột góc trái xa
   + chén muối ớt chanh góc phải */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Tô cà ri gà vàng óng loang nước cốt dừa, đùi gà, khoai lang khoai môn, kèm nửa ổ bánh mì và chén muối ớt chanh">
  <defs>
    <linearGradient id="crgBroth" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#F2C245"/><stop offset="1" stop-color="#D98A2B"/>
    </linearGradient>
    <linearGradient id="crgBowl" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#FDFAF0"/><stop offset="1" stop-color="#E9E2CC"/>
    </linearGradient>
    <linearGradient id="crgGa" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#EAB558"/><stop offset="1" stop-color="#C07C24"/>
    </linearGradient>
    <linearGradient id="crgBread" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#EFC06A"/><stop offset="1" stop-color="#C9822E"/>
    </linearGradient>
  </defs>
  <circle cx="260" cy="240" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="240" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <g class="steam">
    <path d="M205 236 C 194 210 220 194 209 166 C 202 148 216 136 212 120"/>
    <path d="M318 238 C 308 214 332 198 322 172 C 316 156 328 144 324 130"/>
  </g>
  <ellipse cx="255" cy="420" rx="196" ry="24" fill="rgba(15,26,14,.35)"/>

  <!-- tô sâu -->
  <path d="M67 296 C 73 370 157 414 255 414 C 353 414 437 370 443 296 Z" fill="url(#crgBowl)"/>
  <ellipse cx="255" cy="412" rx="62" ry="11" fill="#D8D0B6"/>
  <ellipse cx="255" cy="294" rx="188" ry="46" fill="#F6F1E1"/>
  <ellipse cx="255" cy="294" rx="188" ry="46" fill="none" stroke="#2C5234" stroke-width="5"/>
  <ellipse cx="255" cy="295" rx="174" ry="40" fill="none" stroke="#E0A32E" stroke-width="2.5" stroke-dasharray="2 11" stroke-linecap="round"/>

  <!-- nước cà ri vàng nghệ ánh cam -->
  <ellipse cx="255" cy="297" rx="158" ry="33" fill="url(#crgBroth)"/>
  <ellipse cx="210" cy="286" rx="62" ry="9" fill="#F8DC7A" opacity=".6"/>

  <!-- khoai lang cam (chìm nửa) -->
  <g transform="rotate(-8 154 310)">
    <rect x="128" y="294" width="52" height="30" rx="9" fill="#E8862B" stroke="#AD5713" stroke-width="2.4"/>
    <path d="M133 302 C 140 296 153 293 165 295 L 173 299 C 161 297 146 299 138 305 Z" fill="#F5A94E"/>
    <path d="M146 315 L 162 317" stroke="#C96A1C" stroke-width="2" stroke-linecap="round" opacity=".7"/>
  </g>
  <!-- khoai môn trắng chấm tím -->
  <g transform="rotate(5 244 322)">
    <rect x="218" y="308" width="52" height="29" rx="8" fill="#F4EEDF" stroke="#C9B98E" stroke-width="2.2"/>
    <path d="M223 316 C 230 311 243 308 253 310 L 260 313 C 249 311 234 313 227 318 Z" fill="#FDFAF0"/>
    <g fill="#A985C9">
      <circle cx="230" cy="324" r="1.6"/><circle cx="238" cy="318" r="1.4"/><circle cx="247" cy="326" r="1.6"/>
      <circle cx="256" cy="317" r="1.3"/><circle cx="243" cy="331" r="1.3"/><circle cx="234" cy="313" r="1.2"/>
      <circle cx="252" cy="321" r="1.2"/><circle cx="261" cy="328" r="1.4"/>
    </g>
  </g>

  <!-- miếng gà thứ hai (đùi tỏi/má đùi) chìm nửa bên trái cho mặt tô đầy -->
  <g transform="rotate(-6 196 306)">
    <path d="M168 300 C 170 292 182 286 196 286 C 210 286 222 292 223 301
             C 224 309 212 315 196 315 C 181 315 167 309 168 300 Z"
          fill="url(#crgGa)" stroke="#8E5014" stroke-width="2.4"/>
    <path d="M176 294 C 183 290 194 288 204 289 L 210 292 C 200 290 188 292 181 296 Z" fill="#F2C27E"/>
    <path d="M186 305 L 202 307" stroke="#96551A" stroke-width="2" stroke-linecap="round" opacity=".8"/>
  </g>

  <!-- đùi gà: bầu giọt nước + xương ống thon hai mấu nhỏ chìa lên -->
  <g transform="rotate(12 312 292)">
    <path d="M296 280 L 258 248" stroke="#F6EFD8" stroke-width="9" stroke-linecap="round"/>
    <circle cx="253" cy="242" r="5.6" fill="#F6EFD8" stroke="#D8C8A8" stroke-width="1.6"/>
    <circle cx="247" cy="250" r="5" fill="#F6EFD8" stroke="#D8C8A8" stroke-width="1.6"/>
    <path d="M288 272
             C 285 278 285 286 290 292
             C 294 297 300 300 306 300
             C 310 308 322 313 335 311
             C 352 309 364 297 363 283
             C 362 268 348 258 330 259
             C 312 259 296 264 288 272 Z"
          fill="url(#crgGa)" stroke="#8E5014" stroke-width="2.5"/>
    <path d="M352 270 C 345 264 336 261 327 262 C 315 262 302 266 294 272 L 300 277 C 307 271 317 268 327 267 C 335 267 343 269 348 274 Z" fill="#F2C27E"/>
    <path d="M316 270 L 342 267" stroke="#F6D68C" stroke-width="2.6" stroke-linecap="round" opacity=".95"/>
    <path d="M300 294 q4 4 10 5 M357 292 q-8 8 -19 8" fill="none" stroke="#96551A" stroke-width="2.2" stroke-linecap="round"/>
    <path d="M294 277 C 291 281 291 287 294 291" fill="none" stroke="#96551A" stroke-width="2" stroke-linecap="round" opacity=".85"/>
  </g>

  <!-- vệt nước cốt dừa trắng loang hai lưỡi liềm (chữ ký cà ri) -->
  <g fill="none" stroke="#FDFAF0" stroke-linecap="round" opacity=".95">
    <path d="M236 280 C 248 272 272 270 290 276" stroke-width="5.5"/>
    <path d="M244 290 C 254 285 268 284 280 288" stroke-width="4"/>
    <path d="M252 316 C 262 312 276 312 286 316" stroke-width="3.4" opacity=".8"/>
  </g>

  <!-- sả khúc đập dập nổi trên mặt — trái trên, song song mặt nước -->
  <g stroke-linecap="round">
    <path d="M126 284 L 172 274" stroke="#D6E4A8" stroke-width="8"/>
    <path d="M130 283 L 168 275" stroke="#A9BC6A" stroke-width="2"/>
    <ellipse cx="122" cy="285" rx="4.8" ry="3.8" fill="#EFF4CE" stroke="#9CB25C" stroke-width="1.6" transform="rotate(-12 122 285)"/>
  </g>

  <!-- ớt lát trên mặt nước (né đùi gà) + bong bóng sôi -->
  <g>
    <circle cx="304" cy="328" r="6.2" fill="#D64B33" stroke="#A83722" stroke-width="1.8"/>
    <circle cx="304" cy="328" r="2.8" fill="#F28C6E"/>
    <circle cx="182" cy="320" r="5.4" fill="#D64B33" stroke="#A83722" stroke-width="1.6"/>
    <circle cx="182" cy="320" r="2.4" fill="#F28C6E"/>
  </g>
  <g fill="#F8DC7A" opacity=".85">
    <circle cx="266" cy="288" r="2.6"/><circle cx="382" cy="300" r="3"/>
  </g>

  <!-- nửa ổ bánh mì cắt xéo lộ ruột — góc trái xa (né baguette nguyên của bò kho) -->
  <g transform="translate(14 392) rotate(-13)">
    <ellipse cx="68" cy="46" rx="76" ry="12" fill="rgba(15,26,14,.3)"/>
    <path d="M0 21 C 10 6 40 -5 76 -5 L 118 -5 C 123 -5 126 -1 126 4 L 126 38 C 126 43 123 47 118 47 L 76 47 C 40 47 10 36 0 21 Z" fill="url(#crgBread)" stroke="#A96A24" stroke-width="2.5"/>
    <path d="M0 21 C 7 11 19 3 34 -2 C 21 7 12 15 8 21 C 12 27 21 35 34 44 C 19 39 7 31 0 21 Z" fill="#B3762A" opacity=".5"/>
    <ellipse cx="118" cy="21" rx="12" ry="25" fill="#F6E7C4" stroke="#A96A24" stroke-width="2.4"/>
    <ellipse cx="118" cy="21" rx="6" ry="15" fill="none" stroke="#E3CD9E" stroke-width="1.6"/>
    <g transform="rotate(-22 62 11)"><rect x="44" y="5" width="36" height="11" rx="5.5" fill="#F6E7C4" stroke="#B9853F" stroke-width="1.8"/></g>
    <path d="M26 5 q36 -12 74 -7" fill="none" stroke="#F6E3B2" stroke-width="3.4" stroke-linecap="round" opacity=".9"/>
  </g>

  <!-- chén muối ớt chanh — góc phải -->
  <g transform="translate(430 382)">
    <ellipse cx="0" cy="16" rx="44" ry="13" fill="rgba(15,26,14,.3)"/>
    <path d="M-36 -2 C -34 15 -19 25 0 25 C 19 25 34 15 36 -2 Z" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2"/>
    <ellipse cx="0" cy="-2" rx="29" ry="9" fill="#F6F1E1"/>
    <g fill="#D64B33">
      <circle cx="-11" cy="-3" r="2.6"/><circle cx="4" cy="-6" r="2.3"/><circle cx="14" cy="-1" r="2.1"/><circle cx="-2" cy="0" r="1.9"/>
    </g>
    <g fill="#2E2318">
      <circle cx="-17" cy="0" r="1.3"/><circle cx="9" cy="1" r="1.3"/>
    </g>
    <path d="M18 -10 A 13 13 0 0 1 31 -17 L 31 -10 A 6.5 6.5 0 0 0 22 -5 Z" fill="#E4ECB2" stroke="#9CB25C" stroke-width="1.8"/>
  </g>
</svg>
