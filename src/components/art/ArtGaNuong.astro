      <circle cx="220" cy="324" r="1.4"/><circle cx="318" cy="306" r="1.4"/><circle cx="244" cy="348" r="1.4"/>
      <circle cx="188" cy="338" r="1.4"/><circle cx="332" cy="338" r="1.4"/><circle cx="288" cy="262" r="1.4"/>
