---
/* Xôi mặn Sài Gòn — VẼ LẠI vòng 3. Vòng 2 dùng HỘP GIẤY nên Thái nhìn ra bánh
   gato / bánh kem. Tra lại: xôi mặn bản gốc là "một nắm xôi trắng trải rộng lên
   MIẾNG LÁ CHUỐI", phết mỡ hành rồi lớp pate mỏng, dằn thêm lát lạp xưởng đỏ,
   trứng chiên thái sợi, chà bông đánh tơi, trứng cút.
   Nên vòng này: lá chuối TRẢI PHẲNG (khác gói lá cong lên của xoi-xeo), nền nếp
   TRẮNG trải rộng chứ không vun cao, và đồ mặn rải khắp mặt chứ không chất
   thành đống — đúng cái dáng "gói xôi mở ra" chứ không phải cái bánh.
   Chống đụng xoi-xeo: bên kia nếp VÀNG NGHỆ vun gò, phủ tấm đậu xanh liền. */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Gói xôi mặn Sài Gòn mở trên lá chuối: nếp trắng phủ pate, lạp xưởng, trứng cút, chà bông và mỡ hành">
  <circle cx="260" cy="250" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="250" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <g class="steam">
    <path d="M216 178 C 205 154 231 138 220 112 C 213 96 227 84 223 70"/>
    <path d="M304 174 C 294 150 320 136 309 110 C 302 94 316 82 312 68"/>
  </g>
  <ellipse cx="258" cy="392" rx="196" ry="26" fill="rgba(15,26,14,.35)"/>

  <!-- LÁ CHUỐI trải phẳng, gân giữa chạy dọc, mép hơi vênh -->
  <g transform="rotate(-6 260 320)">
    <path d="M56 292 C 96 258 172 240 260 240 C 348 240 424 258 464 292 C 424 344 348 366 260 366 C 172 366 96 344 56 292 Z"
          fill="#3F6B33" stroke="#28491F" stroke-width="3"/>
    <path d="M70 292 C 108 264 176 248 260 248 C 344 248 412 264 450 292 C 412 334 344 354 260 354 C 176 354 108 334 70 292 Z"
          fill="#4E8340"/>
    <path d="M62 292 C 130 278 390 278 458 292" fill="none" stroke="#2F5626" stroke-width="3.4"/>
    <g fill="none" stroke="#3D6B31" stroke-width="1.8">
      <path d="M104 282 L 96 316"/><path d="M148 272 L 142 330"/><path d="M196 266 L 192 342"/>
      <path d="M248 262 L 246 348"/><path d="M300 262 L 302 348"/><path d="M352 268 L 358 340"/>
      <path d="M398 276 L 406 322"/>
    </g>
  </g>

  <!-- NỀN NẾP TRẮNG trải rộng, dẹt (không vun gò) -->
  <path d="M110 300 C 116 274 168 258 260 258 C 352 258 404 274 410 300 C 402 324 344 336 260 336 C 176 336 118 324 110 300 Z"
        fill="#EFE7D2" stroke="#CFC4A6" stroke-width="2.8"/>
  <g fill="#FBF6E8">
    <ellipse cx="152" cy="292" rx="8" ry="4.4" transform="rotate(-16 152 292)"/>
    <ellipse cx="186" cy="312" rx="7.6" ry="4.2" transform="rotate(14 186 312)"/>
    <ellipse cx="226" cy="286" rx="8" ry="4.4" transform="rotate(-6 226 286)"/>
    <ellipse cx="330" cy="312" rx="7.6" ry="4.2" transform="rotate(18 330 312)"/>
    <ellipse cx="368" cy="290" rx="7.8" ry="4.3" transform="rotate(-12 368 290)"/>
    <ellipse cx="128" cy="312" rx="7.2" ry="4" transform="rotate(22 128 312)"/>
    <ellipse cx="392" cy="312" rx="7.2" ry="4" transform="rotate(-24 392 312)"/>
  </g>

  <!-- PATE: mảng nâu hồng mịn phết lên nếp -->
  <path d="M146 288 C 160 274 200 266 250 266 C 300 266 344 272 366 284 C 344 296 300 302 250 302 C 198 302 160 298 146 288 Z"
        fill="#B0705A" stroke="#7A4128" stroke-width="2.4"/>
  <path d="M168 280 C 196 272 244 270 286 274" fill="none" stroke="#C98D6C" stroke-width="3" stroke-linecap="round"/>

  <!-- MỠ HÀNH: vệt xanh bóng loang trên nếp -->
  <g fill="#5C8B39">
    <ellipse cx="146" cy="306" rx="10" ry="3.6" transform="rotate(-12 146 306)"/>
    <ellipse cx="208" cy="318" rx="9.4" ry="3.4" transform="rotate(10 208 318)"/>
    <ellipse cx="292" cy="320" rx="10" ry="3.6" transform="rotate(-8 292 320)"/>
    <ellipse cx="356" cy="306" rx="9" ry="3.2" transform="rotate(16 356 306)"/>
    <ellipse cx="250" cy="326" rx="9.6" ry="3.4" transform="rotate(-16 250 326)"/>
  </g>

  <!-- LẠP XƯỞNG: 4 lát xéo đỏ sẫm, đốm mỡ trắng, mép cong vì đã chiên -->
  <g>
    <g transform="translate(160 272) rotate(-22)">
      <ellipse cx="0" cy="0" rx="26" ry="14" fill="#A8382B" stroke="#6E1F16" stroke-width="2.8"/>
      <g fill="#F2E2D2"><circle cx="-8" cy="-3" r="2.8"/><circle cx="5" cy="3" r="2.4"/><circle cx="12" cy="-4" r="2"/></g>
    </g>
    <g transform="translate(232 262) rotate(10)">
      <ellipse cx="0" cy="0" rx="27" ry="15" fill="#B23E2F" stroke="#6E1F16" stroke-width="2.8"/>
      <g fill="#F2E2D2"><circle cx="-10" cy="2" r="2.6"/><circle cx="3" cy="-4" r="2.8"/><circle cx="13" cy="3" r="2.2"/></g>
    </g>
    <g transform="translate(330 272) rotate(-8)">
      <ellipse cx="0" cy="0" rx="26" ry="14" fill="#A8382B" stroke="#6E1F16" stroke-width="2.8"/>
      <g fill="#F2E2D2"><circle cx="-8" cy="3" r="2.5"/><circle cx="6" cy="-3" r="2.7"/></g>
    </g>
    <g transform="translate(282 306) rotate(18)">
      <ellipse cx="0" cy="0" rx="24" ry="13" fill="#B23E2F" stroke="#6E1F16" stroke-width="2.8"/>
      <g fill="#F2E2D2"><circle cx="-7" cy="-2" r="2.4"/><circle cx="6" cy="3" r="2.2"/></g>
    </g>
  </g>

  <!-- TRỨNG CHIÊN thái sợi: dải vàng mỏng -->
  <g fill="#EFC454" stroke="#C89A2E" stroke-width="1.6">
    <path d="M180 300 C 206 292 240 290 262 294 L 260 302 C 238 298 206 300 180 308 Z"/>
    <path d="M300 296 C 324 288 352 288 370 292 L 368 300 C 350 296 324 296 300 304 Z"/>
    <path d="M204 320 C 228 313 256 312 274 316 L 272 324 C 254 320 228 321 204 328 Z"/>
  </g>

  <!-- TRỨNG CÚT: 3 trái trắng nguyên -->
  <g>
    <g transform="translate(196 288)">
      <ellipse cx="0" cy="0" rx="17" ry="21" fill="#FBF7EC" stroke="#CFC4A6" stroke-width="2.8"/>
      <ellipse cx="-5" cy="-7" rx="5.6" ry="4" fill="#FFFFFF" opacity=".9"/>
    </g>
    <g transform="translate(360 300)">
      <ellipse cx="0" cy="0" rx="16" ry="20" fill="#F7F2E4" stroke="#CFC4A6" stroke-width="2.8"/>
      <ellipse cx="-5" cy="-7" rx="5.2" ry="3.8" fill="#FFFFFF" opacity=".9"/>
    </g>
    <g transform="translate(126 292)">
      <ellipse cx="0" cy="0" rx="15" ry="19" fill="#FBF7EC" stroke="#CFC4A6" stroke-width="2.8"/>
      <ellipse cx="-4" cy="-7" rx="5" ry="3.6" fill="#FFFFFF" opacity=".9"/>
    </g>
  </g>

  <!-- CHÀ BÔNG: búi sợi vàng cam đánh tơi, nằm TRÊN CÙNG -->
  <g fill="none" stroke-linecap="round">
    <g stroke="#C4741A" stroke-width="4.4">
      <path d="M236 282 C 252 268 276 266 292 276"/>
      <path d="M242 292 C 260 278 284 277 300 286"/>
      <path d="M232 300 C 250 288 274 286 292 294"/>
      <path d="M300 286 C 318 272 342 272 356 282"/>
      <path d="M154 284 C 170 272 192 271 206 279"/>
      <path d="M160 296 C 178 284 200 283 214 291"/>
    </g>
    <g stroke="#F0A63C" stroke-width="2.6">
      <path d="M244 278 C 260 266 280 265 292 272"/>
      <path d="M238 296 C 256 284 278 283 292 290"/>
      <path d="M304 282 C 320 271 340 271 352 278"/>
      <path d="M158 290 C 174 279 194 278 206 284"/>
    </g>
  </g>

  <!-- HÀNH PHI rắc trên cùng -->
  <g fill="#C07A22" stroke="#8A5214" stroke-width="1.2">
    <path d="M214 268 c 6 -5 14 -5 18 0 c -6 4 -13 4 -18 0 z"/>
    <path d="M270 262 c 6 -5 14 -5 18 0 c -6 4 -13 4 -18 0 z"/>
    <path d="M318 292 c 6 -5 14 -5 18 0 c -6 4 -13 4 -18 0 z"/>
    <path d="M172 312 c 6 -5 14 -5 18 0 c -6 4 -13 4 -18 0 z"/>
    <path d="M246 316 c 6 -5 14 -5 18 0 c -6 4 -13 4 -18 0 z"/>
  </g>

  <!-- VẠCH TƯƠNG ỚT đỏ tươi -->
  <path d="M150 326 C 208 340 314 340 372 324" fill="none" stroke="#D8412C" stroke-width="6" stroke-linecap="round" opacity=".92"/>
</svg>
