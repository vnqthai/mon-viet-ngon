---
/* Bò lúc lắc — dĩa nền xà lách: KHỐI bò vuông xém cạnh bóng sốt (không thành viên tròn),
   hành tây múi + ớt chuông đỏ xanh quân cờ; đạo cụ: chén muối tiêu chanh + nĩa */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Dĩa bò lúc lắc khối bò xém cạnh, hành tây ớt chuông, nền xà lách, kèm muối tiêu chanh">
  <defs>
    <linearGradient id="blBo" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#9A5030"/><stop offset="1" stop-color="#5E2C1A"/>
    </linearGradient>
  </defs>
  <circle cx="260" cy="250" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="250" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <g class="steam">
    <path d="M242 216 C 231 192 257 176 246 150 C 239 134 253 122 249 108"/>
    <path d="M304 212 C 294 188 320 174 309 148 C 302 132 316 120 312 104"/>
  </g>
  <ellipse cx="260" cy="400" rx="200" ry="26" fill="rgba(15,26,14,.35)"/>

  <!-- dĩa -->
  <ellipse cx="260" cy="342" rx="204" ry="58" fill="#F6F1E1"/>
  <ellipse cx="260" cy="338" rx="204" ry="58" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2"/>
  <ellipse cx="260" cy="338" rx="204" ry="58" fill="none" stroke="#2C5234" stroke-width="4"/>
  <ellipse cx="260" cy="340" rx="168" ry="44" fill="none" stroke="#E0A32E" stroke-width="2.4" stroke-dasharray="2 11" stroke-linecap="round"/>

  <!-- nền xà lách viền -->
  <g fill="#C9DDA4" stroke="#8FBF4D" stroke-width="2">
    <path d="M108 322 C 104 310 116 300 130 302 C 142 292 160 296 164 308 C 152 318 126 322 108 322 Z"/>
    <path d="M356 316 C 356 304 370 296 384 300 C 398 294 412 302 410 314 C 396 322 370 322 356 316 Z"/>
    <path d="M170 348 C 160 340 164 328 178 326 C 188 318 204 322 206 332 C 198 342 182 348 170 348 Z"/>
    <path d="M330 344 C 326 334 336 326 348 328 C 360 322 372 330 368 340 C 356 346 340 348 330 344 Z"/>
  </g>
  <path d="M122 314 q10 -4 20 -2 M368 308 q12 -4 22 0 M182 334 q9 -3 16 0 M342 336 q9 -3 16 0" fill="none" stroke="#7FA95B" stroke-width="1.8" stroke-linecap="round"/>

  <!-- vũng sốt bóng dưới bò -->
  <ellipse cx="258" cy="320" rx="104" ry="24" fill="#5E2C1A" opacity=".3"/>

  <!-- KHỐI BÒ: vuông bo nhẹ, dải bóng sốt mép trên, vệt xém -->
  <g transform="rotate(-7 208 296)">
    <rect x="188" y="278" width="40" height="36" rx="7" fill="url(#blBo)" stroke="#3E1F10" stroke-width="2.5"/>
    <path d="M192 288 C 198 281 210 278 220 280 L 224 284 C 214 282 202 285 196 291 Z" fill="#C97B4A"/>
    <path d="M196 304 L 220 300" stroke="#3E1F10" stroke-width="3.4" stroke-linecap="round"/>
    <path d="M212 288 L 209 298" stroke="#F2B063" stroke-width="2.4" stroke-linecap="round" opacity=".95"/>
  </g>
  <g transform="rotate(6 262 288)">
    <rect x="242" y="270" width="42" height="38" rx="7" fill="url(#blBo)" stroke="#3E1F10" stroke-width="2.5"/>
    <path d="M246 280 C 253 273 266 270 276 272 L 280 276 C 269 274 256 277 250 283 Z" fill="#C97B4A"/>
    <path d="M250 298 L 276 294" stroke="#3E1F10" stroke-width="3.4" stroke-linecap="round"/>
    <path d="M268 280 L 265 292" stroke="#F2B063" stroke-width="2.4" stroke-linecap="round" opacity=".95"/>
  </g>
  <g transform="rotate(-3 314 300)">
    <rect x="296" y="284" width="38" height="34" rx="6.5" fill="#8A4526" stroke="#3E1F10" stroke-width="2.4"/>
    <path d="M300 293 C 306 287 317 284 326 286 L 329 290 C 320 288 309 291 304 296 Z" fill="#C97B4A"/>
    <path d="M303 308 L 326 305" stroke="#3E1F10" stroke-width="3.2" stroke-linecap="round"/>
  </g>
  <g transform="rotate(9 238 322)">
    <rect x="222" y="308" width="34" height="30" rx="6" fill="#8F4928" stroke="#3E1F10" stroke-width="2.3"/>
    <path d="M226 316 C 231 311 241 308 249 310 L 252 313 C 244 312 234 314 230 319 Z" fill="#C97B4A"/>
    <path d="M228 330 L 250 327" stroke="#3E1F10" stroke-width="3" stroke-linecap="round"/>
  </g>
  <g transform="rotate(-11 300 330)">
    <rect x="284" y="318" width="32" height="28" rx="6" fill="#94502C" stroke="#3E1F10" stroke-width="2.2"/>
    <path d="M288 325 C 293 320 302 318 309 320 L 312 323 C 304 322 295 324 291 328 Z" fill="#C97B4A"/>
    <path d="M290 339 L 310 336" stroke="#3E1F10" stroke-width="2.8" stroke-linecap="round"/>
  </g>

  <!-- hành tây múi trắng -->
  <g fill="none" stroke="#F6F1E1" stroke-width="5" stroke-linecap="round">
    <path d="M186 322 a 16 10 0 0 1 26 -6"/>
    <path d="M320 282 a 15 9 0 0 1 24 -5"/>
    <path d="M270 336 a 14 8 0 0 1 22 -5"/>
  </g>
  <g fill="none" stroke="#D8D0B6" stroke-width="2" stroke-linecap="round" opacity=".8">
    <path d="M190 318 a 13 8 0 0 1 20 -5"/>
    <path d="M324 279 a 12 7 0 0 1 19 -4"/>
  </g>

  <!-- ớt chuông đỏ + xanh quân cờ -->
  <g transform="rotate(-10 172 300)">
    <rect x="158" y="290" width="24" height="20" rx="5" fill="#D64B33" stroke="#A83722" stroke-width="2.2"/>
    <path d="M163 296 q6 -4 13 -2" fill="none" stroke="#F28C6E" stroke-width="2.4" stroke-linecap="round"/>
  </g>
  <g transform="rotate(12 338 320)">
    <rect x="326" y="310" width="22" height="19" rx="5" fill="#D64B33" stroke="#A83722" stroke-width="2.1"/>
    <path d="M331 316 q5 -3 11 -2" fill="none" stroke="#F28C6E" stroke-width="2.2" stroke-linecap="round"/>
  </g>
  <g transform="rotate(8 218 280)">
    <rect x="206" y="270" width="23" height="19" rx="5" fill="#4E8B3A" stroke="#35682A" stroke-width="2.2"/>
    <path d="M211 276 q6 -3 12 -2" fill="none" stroke="#8FBF4D" stroke-width="2.4" stroke-linecap="round"/>
  </g>
  <g transform="rotate(-14 286 312)">
    <rect x="274" y="302" width="21" height="18" rx="5" fill="#569441" stroke="#35682A" stroke-width="2.1"/>
    <path d="M279 308 q5 -3 11 -2" fill="none" stroke="#8FBF4D" stroke-width="2.2" stroke-linecap="round"/>
  </g>

  <!-- cà chua lát + tiêu -->
  <g>
    <circle cx="130" cy="352" r="13" fill="#E23B2E" stroke="#B22B20" stroke-width="2"/>
    <circle cx="130" cy="352" r="8" fill="#F26A50"/>
    <g fill="#F6C888"><circle cx="127" cy="349" r="1.4"/><circle cx="134" cy="352" r="1.4"/><circle cx="129" cy="356" r="1.4"/></g>
  </g>
  <g fill="#2E2318">
    <circle cx="234" cy="300" r="1.8"/><circle cx="290" cy="290" r="1.8"/><circle cx="262" cy="326" r="1.8"/>
  </g>

  <!-- chén muối tiêu chanh -->
  <g transform="translate(92 396)">
    <ellipse cx="0" cy="14" rx="42" ry="12" fill="rgba(15,26,14,.3)"/>
    <path d="M-34 -2 C -32 14 -18 23 0 23 C 18 23 32 14 34 -2 Z" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2"/>
    <ellipse cx="0" cy="-2" rx="28" ry="8.5" fill="#F6F1E1"/>
    <g fill="#2E2318">
      <circle cx="-10" cy="-3" r="1.6"/><circle cx="2" cy="-1" r="1.6"/><circle cx="12" cy="-4" r="1.6"/><circle cx="-2" cy="-5" r="1.4"/>
    </g>
    <path d="M18 -8 A 12 12 0 0 1 30 -14 L 30 -8 A 6 6 0 0 0 22 -4 Z" fill="#E4ECB2" stroke="#9CB25C" stroke-width="1.8"/>
  </g>

  <!-- nĩa góc bàn phải -->
  <g transform="translate(396 400) rotate(-16)">
    <rect x="14" y="0" width="92" height="9" rx="4.5" fill="#F6F1E1" stroke="#D8D0B6" stroke-width="1.6"/>
    <rect x="6" y="-3" width="14" height="15" rx="5" fill="#F6F1E1" stroke="#D8D0B6" stroke-width="1.6"/>
    <g fill="#F6F1E1" stroke="#D8D0B6" stroke-width="1.4">
      <rect x="-12" y="-3.5" width="20" height="4" rx="2"/>
      <rect x="-14" y="2.6" width="22" height="4" rx="2"/>
      <rect x="-12" y="8.7" width="20" height="4" rx="2"/>
    </g>
  </g>
</svg>
