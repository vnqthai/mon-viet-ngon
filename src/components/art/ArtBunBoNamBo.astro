---
/* Bún bò Nam Bộ — cùng nền xanh với bún thịt nướng nên CỐ Ý VẼ LỆCH HẲN:
   1) CÓ KHÓI — thịt bò vừa nhấc khỏi chảo đổ lên tô (bún thịt nướng cố ý không khói)
   2) thịt là DẢI BÒ XÀO CONG bóng sốt, lấm tấm sả băm (không phải lát nướng bản dẹt có vệt cháy chéo)
   3) có GIÁ ĐỖ trắng và XÀ LÁCH THÁI SỢI — bún thịt nướng không có
   4) LẠC RANG GIÃ DẬP thành mảnh to lởm chởm (không phải hạt đậu phộng tròn)
   đạo cụ: hũ lạc rang + hai nhánh sả (tránh trùng chén mắm + đũa của bún thịt nướng) */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Tô bún bò Nam Bộ: bún trắng, rau sống thái sợi, giá đỗ, đồ chua, thịt bò xào tỏi sả còn bốc khói, rắc lạc rang giã dập và hành phi">
  <defs>
    <linearGradient id="bnbBowl" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#FDFAF0"/><stop offset="1" stop-color="#E9E2CC"/>
    </linearGradient>
    <linearGradient id="bnbBo" x1="0" y1="0" x2="0.3" y2="1">
      <stop offset="0" stop-color="#9A522C"/><stop offset="1" stop-color="#5E2A12"/>
    </linearGradient>
    <!-- DẢI BÒ XÀO: lát mỏng DÀI, thân lượn sóng vì co lại trong chảo, hai đầu
         vát chéo, mặt cắt sáng chạy dọc mép trên, thớ dọc, sả băm bám lấm tấm.
         Cố ý dài và mỏng để không thành dáng viên tròn. -->
    <g id="bnbBo1">
      <path d="M-40 -2 C -30 -11 -14 -12 -2 -8 C 10 -4 22 -6 34 -13
               C 40 -16.4 45 -13 43 -7 C 40 2 30 8 18 9 C 6 10 -6 6 -16 6
               C -26 6 -34 8 -40 8 C -45 8 -45 1.4 -40 -2 Z"
            fill="url(#bnbBo)" stroke="#3A1706" stroke-width="2" stroke-linejoin="round"/>
      <!-- mặt cắt sáng dọc mép trên -->
      <path d="M-40 -2 C -30 -11 -14 -12 -2 -8 C 10 -4 22 -6 34 -13 C 39 -16 43 -14 42.4 -9.6
               C 32 -3 20 -1 8 -3 C -6 -5.4 -18 -6 -28 -3 C -34 -1.4 -38 0 -40 1 Z" fill="#C48156"/>
      <!-- thớ thịt chạy dọc -->
      <g stroke="#6E381A" stroke-width="1.4" stroke-linecap="round" fill="none" opacity=".8">
        <path d="M-34 3 C -22 1 -10 3 2 4 C 14 5 26 3 36 -2"/>
        <path d="M-30 6.4 C -18 5 -6 7 6 7.4"/>
      </g>
      <!-- đầu phải hớt cong sẫm -->
      <path d="M43 -7 C 40 2 30 8 18 9 C 29 3 36 -3 39 -11 Z" fill="#3A1706" opacity=".5"/>
      <!-- sả băm bám trên mặt thịt -->
      <g fill="#C8D98A" stroke="#8FA553" stroke-width=".8">
        <ellipse cx="-22" cy="-1" rx="2.6" ry="1.4" transform="rotate(-16 -22 -1)"/>
        <ellipse cx="-4" cy="1" rx="2.4" ry="1.3" transform="rotate(20 -4 1)"/>
        <ellipse cx="16" cy="-1.6" rx="2.4" ry="1.3" transform="rotate(-8 16 -1.6)"/>
        <ellipse cx="28" cy="-5" rx="2.2" ry="1.2" transform="rotate(28 28 -5)"/>
      </g>
      <circle cx="6" cy="-4" r="1.8" fill="#E2A472" opacity=".8"/>
    </g>
    <!-- giá đỗ -->
    <g id="bnbGia">
      <path d="M0 0 C 8 -4 18 -4 26 0" fill="none" stroke="#FBF6E6" stroke-width="4.2" stroke-linecap="round"/>
      <ellipse cx="27.4" cy="0.6" rx="3.8" ry="2.6" fill="#EFDFAC" stroke="#C9B47C" stroke-width="1.1"/>
    </g>
    <!-- mảnh lạc rang giã dập: nửa hạt lởm chởm, KHÔNG tròn -->
    <g id="bnbLac">
      <path d="M0 0 L 5 -4.6 L 10 -3 L 11 2 L 6 5.4 L 1 4 Z" fill="#D89A44" stroke="#9A611C" stroke-width="1.2" stroke-linejoin="round"/>
      <path d="M3 -1 L 8 -2.4" stroke="#F0C673" stroke-width="1.2" stroke-linecap="round"/>
    </g>
  </defs>
  <circle cx="260" cy="250" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="250" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <!-- KHÓI: bốc lên từ cụm bò xào bên phải, không phải giữa tô -->
  <g class="steam">
    <path d="M296 220 C 286 196 312 182 301 156 C 294 140 308 128 304 114"/>
    <path d="M348 228 C 338 204 364 190 353 164 C 346 148 360 136 356 122"/>
  </g>
  <ellipse cx="260" cy="404" rx="196" ry="25" fill="rgba(15,26,14,.35)"/>

  <!-- TÔ -->
  <path d="M100 270 C 108 348 172 392 260 392 C 348 392 412 348 420 270 Z" fill="url(#bnbBowl)"/>
  <ellipse cx="260" cy="390" rx="58" ry="10" fill="#D8D0B6"/>
  <ellipse cx="260" cy="268" rx="160" ry="44" fill="#F6F1E1"/>
  <ellipse cx="260" cy="268" rx="160" ry="44" fill="none" stroke="#2C5234" stroke-width="5"/>
  <ellipse cx="260" cy="269" rx="146" ry="38" fill="none" stroke="#E0A32E" stroke-width="2.4" stroke-dasharray="2 11" stroke-linecap="round"/>

  <!-- vũng nước mắm chua ngọt xâm xấp đáy tô -->
  <ellipse cx="258" cy="288" rx="132" ry="26" fill="#B8853A" opacity=".42"/>

  <!-- XÀ LÁCH THÁI SỢI: dải xanh trải nền trái, đậm hơn để đọc ra là rau -->
  <g fill="none" stroke="#4E7B36" stroke-width="7" stroke-linecap="round">
    <path d="M132 266 C 158 254 190 253 214 260"/>
    <path d="M124 284 C 150 272 182 271 204 278"/>
    <path d="M146 298 C 170 288 198 287 218 293"/>
  </g>
  <g fill="none" stroke="#7FB35B" stroke-width="6" stroke-linecap="round">
    <path d="M136 262 C 160 251 190 250 212 256"/>
    <path d="M128 280 C 152 269 182 268 202 274"/>
    <path d="M150 294 C 172 285 198 284 216 289"/>
    <path d="M162 250 C 184 241 210 240 228 245"/>
  </g>
  <g fill="none" stroke="#B4D48E" stroke-width="2.6" stroke-linecap="round" opacity=".95">
    <path d="M140 260 C 162 250 190 248 210 254"/>
    <path d="M154 292 C 174 284 198 283 214 287"/>
    <path d="M166 248 C 186 240 210 239 226 243"/>
  </g>

  <!-- BÚN trắng cuộn sợi, ba vắt phủ kín nửa trái + sợi rời vắt sang giữa -->
  <g transform="translate(172 254) rotate(-7)">
    <ellipse cx="0" cy="0" rx="35" ry="13.4" fill="#FBF5E3" stroke="#D2C494" stroke-width="2"/>
    <path d="M-28 -3 a 28 10 0 0 1 52 -2 M -20 4 a 22 8 0 0 1 40 -1 M -12 -9 a 14 5 0 0 1 26 -1 M -15 9 a 16 6 0 0 1 30 -1" fill="none" stroke="#D2C494" stroke-width="2.2" stroke-linecap="round"/>
  </g>
  <g transform="translate(220 274) rotate(4)">
    <ellipse cx="0" cy="0" rx="37" ry="14" fill="#FDFAF0" stroke="#D2C494" stroke-width="2"/>
    <path d="M-30 -3 a 30 10 0 0 1 56 -2 M -21 4 a 23 8 0 0 1 42 -1 M -13 -9 a 15 5 0 0 1 28 -1 M -16 10 a 17 6 0 0 1 32 -1" fill="none" stroke="#D2C494" stroke-width="2.2" stroke-linecap="round"/>
  </g>
  <g transform="translate(168 292) rotate(3)">
    <ellipse cx="0" cy="0" rx="32" ry="12.4" fill="#FFFDF6" stroke="#D2C494" stroke-width="2"/>
    <path d="M-26 -3 a 26 9 0 0 1 48 -2 M -18 4 a 20 7 0 0 1 36 -1 M -11 -8 a 13 5 0 0 1 24 -1" fill="none" stroke="#D2C494" stroke-width="2.1" stroke-linecap="round"/>
  </g>
  <g fill="none" stroke="#FBF5E3" stroke-width="5.4" stroke-linecap="round">
    <path d="M232 300 C 252 293 276 292 296 297"/>
    <path d="M244 308 C 262 302 282 301 298 305"/>
    <path d="M204 240 C 222 233 244 233 260 239"/>
  </g>
  <g fill="none" stroke="#E2D7B4" stroke-width="1.8" stroke-linecap="round" opacity=".9">
    <path d="M238 298 C 256 292 276 291 292 295"/>
    <path d="M208 238 C 224 232 244 232 258 237"/>
  </g>

  <!-- GIÁ ĐỖ trắng lấp ló mép bún -->
  <use href="#bnbGia" transform="translate(146 306) rotate(-12)"/>
  <use href="#bnbGia" transform="translate(174 316) rotate(6)"/>
  <use href="#bnbGia" transform="translate(206 306) rotate(-4) scale(.94)"/>
  <use href="#bnbGia" transform="translate(232 318) rotate(10) scale(.9)"/>

  <!-- ĐỒ CHUA: sợi đu đủ trắng ngà + cà rốt cam, trước giữa -->
  <g stroke-linecap="round" fill="none">
    <path d="M196 292 q 15 -6 30 -2 M208 300 q 15 -5 29 -1" stroke="#EF9440" stroke-width="5"/>
    <path d="M186 302 q 14 -5 27 -1 M216 288 q 14 -5 27 -1 M228 296 q 13 -4 25 0" stroke="#EFE7CC" stroke-width="4.6"/>
    <path d="M190 300 q 13 -4 25 -1" stroke="#CFC49E" stroke-width="1.6" opacity=".8"/>
  </g>

  <!-- bóng ấm dưới cụm bò -->
  <ellipse cx="316" cy="284" rx="82" ry="16" fill="#5E2A12" opacity=".22"/>

  <!-- DẢI BÒ XÀO xếp lợp bên phải, mỗi dải một hướng cho khỏi đều tăm tắp -->
  <use href="#bnbBo1" transform="translate(292 248) rotate(-11) scale(.86)"/>
  <use href="#bnbBo1" transform="translate(358 268) rotate(9) scale(.76)"/>
  <use href="#bnbBo1" transform="translate(282 282) rotate(-2) scale(.92)"/>
  <use href="#bnbBo1" transform="translate(344 302) rotate(6) scale(.68)"/>
  <use href="#bnbBo1" transform="translate(348 240) rotate(19) scale(.62)"/>

  <!-- hành tây múi trắng lẫn trong bò -->
  <g fill="none" stroke="#F6F1E1" stroke-width="5.4" stroke-linecap="round">
    <path d="M312 268 a 15 9 0 0 1 24 -5"/>
    <path d="M356 300 a 13 8 0 0 1 21 -5"/>
  </g>
  <g fill="none" stroke="#CBBF9C" stroke-width="1.8" stroke-linecap="round" opacity=".85">
    <path d="M316 265 a 12 7 0 0 1 19 -4"/>
  </g>

  <!-- HÀNH PHI vàng rắc trên bò -->
  <g fill="#D89A38" stroke="#A86E1C" stroke-width="1">
    <path d="M290 240 a 6.4 3.2 0 0 1 11 -1 a 6.4 3.2 0 0 1 -11 1 Z"/>
    <path d="M340 250 a 6 3 0 0 1 10 -1 a 6 3 0 0 1 -10 1 Z"/>
    <path d="M300 288 a 6 3 0 0 1 10 -1 a 6 3 0 0 1 -10 1 Z"/>
    <path d="M360 272 a 5.6 2.8 0 0 1 9.4 -1 a 5.6 2.8 0 0 1 -9.4 1 Z"/>
    <path d="M254 264 a 5.6 2.8 0 0 1 9.4 -1 a 5.6 2.8 0 0 1 -9.4 1 Z"/>
  </g>

  <!-- LẠC RANG GIÃ DẬP: mảnh to lởm chởm rắc khắp mặt -->
  <use href="#bnbLac" transform="translate(184 250) rotate(-14)"/>
  <use href="#bnbLac" transform="translate(232 244) rotate(22) scale(.92)"/>
  <use href="#bnbLac" transform="translate(268 262) rotate(-6)"/>
  <use href="#bnbLac" transform="translate(206 288) rotate(34) scale(.88)"/>
  <use href="#bnbLac" transform="translate(320 244) rotate(10) scale(.94)"/>
  <use href="#bnbLac" transform="translate(376 260) rotate(-24) scale(.86)"/>
  <use href="#bnbLac" transform="translate(160 292) rotate(6) scale(.9)"/>
  <use href="#bnbLac" transform="translate(344 312) rotate(-16) scale(.84)"/>
  <g fill="#EFC069">
    <circle cx="212" cy="266" r="1.6"/><circle cx="298" cy="234" r="1.5"/><circle cx="356" cy="290" r="1.5"/><circle cx="248" cy="292" r="1.4"/>
  </g>

  <!-- rau thơm ló lên giữa bún và bò -->
  <g transform="translate(258 240)">
    <path d="M0 4 L 2 -6" stroke="#2C5E2E" stroke-width="1.6"/>
    <path d="M0 -2 C -5 -10 -2 -20 6 -22 C 12 -15 10 -5 3 0 C 1 1 0 0 0 -2 Z" fill="#3E7B3A" stroke="#26521F" stroke-width="1.5"/>
    <path d="M-4 2 C -10 -3 -10 -12 -4 -16 C 2 -12 3 -4 -1 2 C -2 3 -3 3 -4 2 Z" fill="#4A8B3E" stroke="#26521F" stroke-width="1.4"/>
  </g>
  <!-- ớt lát đỏ -->
  <g>
    <g transform="translate(168 276)"><circle r="4.4" fill="#D64B33" stroke="#A83722" stroke-width="1.4"/><circle r="1.9" fill="#F28C6E"/></g>
    <g transform="translate(388 294)"><circle r="4" fill="#D64B33" stroke="#A83722" stroke-width="1.3"/><circle r="1.7" fill="#F28C6E"/></g>
  </g>

  <!-- ĐẠO CỤ TRÁI: hũ lạc rang giã dập -->
  <g transform="translate(92 396)">
    <ellipse cx="0" cy="32" rx="36" ry="10" fill="rgba(15,26,14,.3)"/>
    <path d="M-24 -12 L 24 -12 L 20 26 C 19.6 29.4 16.8 31 12 31 L -12 31 C -16.8 31 -19.6 29.4 -20 26 Z"
          fill="#F3EBD4" stroke="#C7B98E" stroke-width="2.2" opacity=".92"/>
    <rect x="-27" y="-20" width="54" height="10" rx="3.6" fill="#D9B36A" stroke="#B08A45" stroke-width="2"/>
    <use href="#bnbLac" transform="translate(-15 2) rotate(-12)"/>
    <use href="#bnbLac" transform="translate(0 10) rotate(20)"/>
    <use href="#bnbLac" transform="translate(-13 16) rotate(4)"/>
    <use href="#bnbLac" transform="translate(2 20) rotate(-22) scale(.9)"/>
    <use href="#bnbLac" transform="translate(-4 -4) rotate(14) scale(.92)"/>
    <path d="M-18 -6 C -8 -9 8 -9 18 -6" fill="none" stroke="#FFFDF4" stroke-width="2.4" stroke-linecap="round" opacity=".5"/>
  </g>

  <!-- ĐẠO CỤ PHẢI: hai nhánh sả -->
  <g transform="translate(410 400) rotate(-8)">
    <ellipse cx="16" cy="20" rx="52" ry="10" fill="rgba(15,26,14,.3)"/>
    <g transform="translate(0 0)">
      <path d="M0 6 C 4 -2 14 -6 24 -6 L 72 -8 C 78 -8.2 80 -4 76 -1 L 26 12 C 12 15 -2 13 0 6 Z"
            fill="#E7E2C4" stroke="#B3AE83" stroke-width="2"/>
      <path d="M6 6 C 16 2 30 0 46 -2" fill="none" stroke="#C6C199" stroke-width="1.6" stroke-linecap="round"/>
      <path d="M62 -6 C 74 -10 88 -12 98 -10 C 90 -4 76 -1 64 -2 Z" fill="#8FB35C" stroke="#65873C" stroke-width="1.6"/>
      <path d="M2 4 C 6 -1 12 -3 20 -4" fill="none" stroke="#9FA87A" stroke-width="1.4" stroke-linecap="round"/>
    </g>
    <g transform="translate(-6 16) rotate(6)">
      <path d="M0 6 C 4 -2 14 -6 24 -6 L 64 -7 C 70 -7.2 72 -3 68 0 L 26 12 C 12 15 -2 13 0 6 Z"
            fill="#DED9BB" stroke="#B3AE83" stroke-width="2"/>
      <path d="M6 6 C 16 2 28 0 42 -1" fill="none" stroke="#C6C199" stroke-width="1.5" stroke-linecap="round"/>
      <path d="M56 -5 C 68 -9 80 -10 88 -8 C 80 -3 68 0 58 -1 Z" fill="#7FA84F" stroke="#5C7F36" stroke-width="1.5"/>
    </g>
  </g>
</svg>
