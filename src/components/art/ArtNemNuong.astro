---
/* Nem nướng Nha Trang — nền XANH LÁ họ "Cuốn & trộn", đứng cạnh GỎI CUỐN và
   BÁNH TRÁNG CUỐN THỊT HEO. Ba món cuốn, phải tách bằng dáng chứ không bằng màu:

     gỏi cuốn      : ống TRẮNG ĐỤC nằm ngang, thấy tôm hồng qua lớp bánh
     bánh tráng cuốn: LÁT THỊT dựng lợp ngang như bộ bài xòe
     nem nướng     : XIÊN QUE — thanh tre chĩa chéo lên, đầu que lộ ra

   Cái que là thứ không hình nào khác trên site có, nên nó phải là thứ đọc ra
   đầu tiên: ba xiên chĩa chéo, que dài thò hẳn khỏi khối thịt.

   Chỗ dễ đụng thứ hai là ỐNG BÁNH TRÁNG CHIÊN — hình ống vàng, dễ lẫn với CHẢ
   GIÒ (dù chả giò nằm nền đỏ). Tách bằng ba việc: ống ở đây MẢNH hơn nhiều,
   RỖNG RUỘT (vẽ rõ miệng ống), và chỉ có hai cái, nằm nép bên chứ không thành
   đống. */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Dĩa nem nướng Nha Trang gồm ba xiên que tre thịt nướng nâu đỏ, hai ống bánh tráng chiên phồng, chén tương sánh màu cam nâu và rau sống">
  <defs>
    <linearGradient id="nnThit" x1="0" y1="0" x2="0.3" y2="1">
      <stop offset="0" stop-color="#C0623A"/><stop offset="1" stop-color="#7A3418"/>
    </linearGradient>
    <linearGradient id="nnOng" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#F6DFA8"/><stop offset="1" stop-color="#D9AC5C"/>
    </linearGradient>
    <linearGradient id="nnTuong" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#D98A3C"/><stop offset="1" stop-color="#A85C22"/>
    </linearGradient>
  </defs>
  <circle cx="260" cy="244" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="244" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <g class="steam">
    <path d="M226 214 C 215 190 241 174 230 148 C 223 132 237 120 233 106"/>
    <path d="M296 208 C 286 184 312 170 301 144 C 294 128 308 116 304 102"/>
  </g>
  <ellipse cx="258" cy="410" rx="196" ry="25" fill="rgba(15,26,14,.35)"/>

  <!-- DĨA -->
  <path d="M66 322 C 72 376 156 400 258 400 C 360 400 444 376 450 322 Z" fill="#EFE9D6"/>
  <ellipse cx="258" cy="320" rx="192" ry="52" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2"/>
  <ellipse cx="258" cy="320" rx="192" ry="52" fill="none" stroke="#2C5234" stroke-width="4.5"/>
  <ellipse cx="258" cy="321" rx="172" ry="44" fill="none" stroke="#E0A32E" stroke-width="2.4" stroke-dasharray="2 11" stroke-linecap="round"/>

  <!-- LÁ XÀ LÁCH lót dưới, ló ra mép dĩa -->
  <g fill="#6F9C48" stroke="#4E7B36" stroke-width="2.2">
    <path d="M96 316 C 104 288 148 272 194 278 C 164 298 148 322 148 342 C 124 340 104 330 96 316 Z"/>
    <path d="M420 320 C 412 294 374 280 334 286 C 360 304 372 324 372 342 C 394 340 412 332 420 320 Z"/>
  </g>
  <g stroke="#A8C46E" stroke-width="3.2" fill="none" stroke-linecap="round" opacity=".9">
    <path d="M110 314 q26 -18 62 -24"/><path d="M406 318 q-24 -18 -56 -24"/>
  </g>

  <!-- BA XIÊN NEM NƯỚNG — thứ phải đọc ra đầu tiên.
       Que tre dài thò hẳn ra, chĩa chéo lên; khối thịt là thỏi bo tròn hai đầu,
       mặt có vệt xém đen loang lổ của than. -->
  <g stroke="#4A2409" stroke-width="2.6" stroke-linejoin="round">
    <!-- xiên sau, chĩa trái -->
    <g transform="translate(180 250) rotate(-26)">
      <rect x="-104" y="-3.4" width="208" height="6.8" rx="3.4" fill="#A8834A" stroke="#6E5324" stroke-width="1.8"/>
      <path d="M104 -3.4 L 120 0 L 104 3.4 Z" fill="#A8834A" stroke="#6E5324" stroke-width="1.8"/>
      <rect x="-56" y="-22" width="112" height="44" rx="22" fill="url(#nnThit)"/>
      <g fill="#4E230C" opacity=".85">
        <ellipse cx="-30" cy="-8" rx="12" ry="5" transform="rotate(-8 -30 -8)"/>
        <ellipse cx="6" cy="7" rx="14" ry="5.4" transform="rotate(6 6 7)"/>
        <ellipse cx="36" cy="-6" rx="10" ry="4.4"/>
      </g>
      <g fill="#E8996A" opacity=".8">
        <ellipse cx="-16" cy="-13" rx="16" ry="4" transform="rotate(-4 -16 -13)"/>
        <ellipse cx="28" cy="12" rx="12" ry="3.4"/>
      </g>
    </g>
    <!-- xiên giữa, gần như ngang -->
    <g transform="translate(252 300) rotate(3)">
      <rect x="-108" y="-3.4" width="216" height="6.8" rx="3.4" fill="#B08E52" stroke="#6E5324" stroke-width="1.8"/>
      <path d="M108 -3.4 L 124 0 L 108 3.4 Z" fill="#B08E52" stroke="#6E5324" stroke-width="1.8"/>
      <rect x="-60" y="-23" width="120" height="46" rx="23" fill="#B5572F"/>
      <g fill="#4E230C" opacity=".85">
        <ellipse cx="-34" cy="6" rx="13" ry="5" transform="rotate(7 -34 6)"/>
        <ellipse cx="2" cy="-9" rx="15" ry="5.6" transform="rotate(-5 2 -9)"/>
        <ellipse cx="40" cy="8" rx="11" ry="4.6"/>
      </g>
      <g fill="#EDA478" opacity=".8">
        <ellipse cx="-12" cy="-14" rx="18" ry="4.2"/>
        <ellipse cx="34" cy="-8" rx="12" ry="3.4"/>
      </g>
    </g>
    <!-- xiên trước, chĩa phải -->
    <g transform="translate(288 348) rotate(18)">
      <rect x="-100" y="-3.4" width="200" height="6.8" rx="3.4" fill="#A8834A" stroke="#6E5324" stroke-width="1.8"/>
      <path d="M-100 -3.4 L -116 0 L -100 3.4 Z" fill="#A8834A" stroke="#6E5324" stroke-width="1.8"/>
      <rect x="-54" y="-21" width="108" height="42" rx="21" fill="#A94F2A"/>
      <g fill="#4E230C" opacity=".85">
        <ellipse cx="-28" cy="-7" rx="12" ry="4.8" transform="rotate(-6 -28 -7)"/>
        <ellipse cx="10" cy="6" rx="13" ry="5" transform="rotate(5 10 6)"/>
      </g>
      <g fill="#E8996A" opacity=".8"><ellipse cx="-6" cy="-12" rx="16" ry="3.8"/></g>
    </g>
  </g>

  <!-- HAI ỐNG BÁNH TRÁNG CHIÊN: mảnh, RỖNG RUỘT (vẽ rõ miệng ống), mặt phồng
       rỗ. Nép bên phải, cố ý không thành đống để khỏi đọc ra chả giò. -->
  <g stroke="#A87A2E" stroke-width="2.2" stroke-linejoin="round">
    <g transform="translate(402 292) rotate(-70)">
      <rect x="-42" y="-16" width="84" height="32" rx="16" fill="url(#nnOng)"/>
      <ellipse cx="42" cy="0" rx="8" ry="16" fill="#C89A48"/>
      <ellipse cx="42" cy="0" rx="4.6" ry="10" fill="#5E4210"/>
      <ellipse cx="-42" cy="0" rx="8" ry="16" fill="#C89A48"/>
      <ellipse cx="-42" cy="0" rx="4.6" ry="10" fill="#5E4210"/>
      <g fill="#FEF7E2" opacity=".95">
        <circle cx="-26" cy="-5" r="5.4"/><circle cx="-6" cy="5" r="4.6"/><circle cx="14" cy="-6" r="5"/><circle cx="30" cy="4" r="4"/>
      </g>
      <g fill="#C89A48" opacity=".6">
        <circle cx="-16" cy="7" r="3"/><circle cx="6" cy="-8" r="2.6"/><circle cx="24" cy="-3" r="2.4"/>
      </g>
    </g>
    <g transform="translate(430 340) rotate(-46)">
      <rect x="-36" y="-14" width="72" height="28" rx="14" fill="#F3D89E"/>
      <ellipse cx="36" cy="0" rx="7" ry="14" fill="#C89A48"/>
      <ellipse cx="36" cy="0" rx="4" ry="8.6" fill="#5E4210"/>
      <g fill="#FEF7E2" opacity=".95">
        <circle cx="-20" cy="4" r="4.6"/><circle cx="0" cy="-5" r="5"/><circle cx="18" cy="3" r="4"/>
      </g>
      <g fill="#C89A48" opacity=".6"><circle cx="-8" cy="-6" r="2.6"/><circle cx="10" cy="6" r="2.4"/></g>
    </g>
  </g>

  <!-- CHÉN TƯƠNG: sốt ĐỤC và SÁNH, vun thành gò chứ không phẳng mặt như chén
       nước mắm pha; màu cam nâu, rắc đậu phộng giã. -->
  <g transform="translate(112 372)">
    <ellipse cx="0" cy="18" rx="52" ry="13" fill="rgba(15,26,14,.32)"/>
    <path d="M-44 -8 C -42 12 -24 26 0 26 C 24 26 42 12 44 -8 Z" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2.2"/>
    <path d="M-38 -8 C -30 -20 -12 -25 0 -25 C 12 -25 30 -20 38 -8 C 30 -1 14 3 0 3 C -14 3 -30 -1 -38 -8 Z" fill="url(#nnTuong)" stroke="#8A4614" stroke-width="2"/>
    <g fill="#F0C98A"><circle cx="-16" cy="-12" r="3.2"/><circle cx="4" cy="-16" r="2.8"/><circle cx="20" cy="-9" r="3"/><circle cx="-4" cy="-7" r="2.4"/></g>
    <ellipse cx="-10" cy="-18" rx="12" ry="3.4" fill="#E9A257" opacity=".8"/>
  </g>

  <!-- XẤP BÁNH TRÁNG CUỐN nằm dưới, mép dĩa trái -->
  <g transform="translate(150 404) rotate(-8)">
    <ellipse cx="0" cy="6" rx="54" ry="9" fill="rgba(15,26,14,.28)"/>
    <ellipse cx="0" cy="0" rx="52" ry="12" fill="#F6F1E2" stroke="#D3CCB4" stroke-width="2"/>
    <ellipse cx="0" cy="-6" rx="52" ry="12" fill="#FBF7EC" stroke="#D3CCB4" stroke-width="2"/>
    <ellipse cx="0" cy="-6" rx="34" ry="6" fill="none" stroke="#E2DBC4" stroke-width="1.6"/>
  </g>

  <!-- CỌNG HẸ dài ló ra — dấu của mọi món cuốn, nhưng để mảnh và ít, không
       thành nhúm như gỏi cuốn -->
  <g stroke="#5E9436" stroke-width="4" stroke-linecap="round" fill="none">
    <path d="M334 380 C 372 372 404 376 428 388"/>
  </g>
  <g fill="#3F6A28" stroke="#2E5220" stroke-width="1.4">
    <path d="M214 244 C 222 234 236 230 244 234 C 238 244 224 248 214 244 Z" transform="rotate(-22 229 239)"/>
    <path d="M324 250 C 332 240 346 237 354 241 C 348 251 334 254 324 250 Z" transform="rotate(14 339 245)"/>
  </g>
</svg>
