---
/* Mắm ruốc xào thịt ba chỉ — họ "Mặn đưa cơm", nền NÂU, chung nhà với cá kho tộ,
   thịt kho hột vịt, gà kho gừng, sườn ram, bò kho. Cả năm món kia đều đựng TỘ ĐẤT
   NÂU, và đó đúng là chỗ Phần I phải đi chữa bằng quầng sáng.

   Nên món này cố ý ĐI HƯỚNG KHÁC: đựng ĐĨA SÂU LÒNG MEN TRẮNG. Trắng trên nền nâu
   thì bật ra ngay, khỏi trông cậy vào quầng sáng, mà lại tách hẳn khỏi cả cụm kho.

   Ba chữ ký nữa để không lẫn với món kho nào:
   · thịt xắt QUE có lằn mỡ trắng chạy dọc — không phải khối vuông hay lát mỏng
   · SẢ BĂM vàng nhạt phủ dày kín mặt, thứ không món kho nào có
   · HŨ MẮM RUỐC mở nắp lộ mắm nâu tím, cắm cái muỗng gỗ
   id prefix: mrx */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Đĩa mắm ruốc xào thịt ba chỉ: que thịt có lằn mỡ trắng phủ dày sả băm vàng và ớt lát, bên cạnh là hũ mắm ruốc mở nắp, tép sả tươi, dưa leo và chén cơm trắng">
  <defs>
    <linearGradient id="mrxThit" x1="0" y1="0" x2="0.2" y2="1">
      <stop offset="0" stop-color="#C0763A"/><stop offset="1" stop-color="#8A4614"/>
    </linearGradient>
    <linearGradient id="mrxDia" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#FDFAF0"/><stop offset="1" stop-color="#E7E0C8"/>
    </linearGradient>
    <linearGradient id="mrxMam" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#7E4E5C"/><stop offset="1" stop-color="#4E2C36"/>
    </linearGradient>
    <!-- QUE THỊT BA CHỈ: thanh dài có LẰN MỠ TRẮNG chạy dọc và mép da sẫm.
         Xắt que là chỗ khác hẳn mấy món kho (khối vuông) và món ram (lát mỏng). -->
    <g id="mrxQue">
      <path d="M-26 -8 L 26 -8 A 5 5 0 0 1 26 8 L -26 8 A 5 5 0 0 1 -26 -8 Z"
            fill="url(#mrxThit)" stroke="#68320A" stroke-width="2"/>
      <path d="M-24 -4.6 L 24 -4.6" stroke="#F0DCB4" stroke-width="3.6" stroke-linecap="round"/>
      <path d="M-24 -7.4 L 24 -7.4" stroke="#5E2C0C" stroke-width="2" stroke-linecap="round" opacity=".8"/>
      <path d="M-20 3 L 20 3" stroke="#E8CFA2" stroke-width="2.2" stroke-linecap="round" opacity=".7"/>
      <path d="M-14 -1 L -12 5 M2 -1 L 4 5 M16 -1 L 18 5" stroke="#7A3D10" stroke-width="1.5" stroke-linecap="round"/>
    </g>
    <!-- tép sả tươi nguyên cây -->
    <g id="mrxSaCay">
      <path d="M0 0 C 2 -22 6 -44 10 -64" stroke="#D6D9A8" stroke-width="11" stroke-linecap="round" fill="none"/>
      <path d="M0 0 C 2 -22 6 -44 10 -64" stroke="#EEF0CC" stroke-width="4.4" stroke-linecap="round" fill="none"/>
      <path d="M9 -60 C 14 -76 22 -88 30 -94" stroke="#8FA84E" stroke-width="5" stroke-linecap="round" fill="none"/>
      <path d="M10 -62 C 8 -80 6 -92 2 -102" stroke="#A8BE62" stroke-width="4.4" stroke-linecap="round" fill="none"/>
      <path d="M-1 -6 C 1 -3 4 -2 7 -2" stroke="#C4A87C" stroke-width="4" stroke-linecap="round" fill="none"/>
    </g>
  </defs>

  <circle cx="258" cy="242" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="258" cy="242" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <g class="steam">
    <path d="M212 214 C 201 190 227 174 216 148 C 209 132 223 120 219 106"/>
    <path d="M292 210 C 282 186 308 172 297 146 C 290 130 304 118 300 104"/>
  </g>
  <ellipse cx="256" cy="406" rx="200" ry="26" fill="rgba(15,26,14,.35)"/>

  <!-- ===== ĐĨA SÂU LÒNG MEN TRẮNG — không phải tộ đất, đó là cả chủ ý ===== -->
  <path d="M 92 288 C 100 344 168 376 254 376 C 340 376 408 344 416 288 Z" fill="url(#mrxDia)"/>
  <ellipse cx="254" cy="374" rx="56" ry="10" fill="#D8D0B6"/>
  <ellipse cx="254" cy="286" rx="162" ry="46" fill="#F6F1E1"/>
  <ellipse cx="254" cy="286" rx="162" ry="46" fill="none" stroke="#2C5234" stroke-width="5"/>
  <ellipse cx="254" cy="287" rx="146" ry="39" fill="none" stroke="#E0A32E" stroke-width="2.5" stroke-dasharray="2 11" stroke-linecap="round"/>

  <!-- vũng mỡ óng dưới đáy đĩa -->
  <ellipse cx="254" cy="296" rx="138" ry="34" fill="#B4661C" opacity=".22"/>
  <ellipse cx="200" cy="304" rx="46" ry="12" fill="#D98A3A" opacity=".2"/>

  <!-- ĐỐNG QUE THỊT — xếp chồng chéo, có lớp có lang -->
  <use href="#mrxQue" transform="translate(178 274) rotate(-16)"/>
  <use href="#mrxQue" transform="translate(232 266) rotate(6)"/>
  <use href="#mrxQue" transform="translate(290 270) rotate(-9)"/>
  <use href="#mrxQue" transform="translate(336 282) rotate(14)"/>
  <use href="#mrxQue" transform="translate(154 296) rotate(9)"/>
  <use href="#mrxQue" transform="translate(206 292) rotate(-6)"/>
  <use href="#mrxQue" transform="translate(262 288) rotate(12)"/>
  <use href="#mrxQue" transform="translate(314 300) rotate(-13)"/>
  <use href="#mrxQue" transform="translate(184 314) rotate(4)"/>
  <use href="#mrxQue" transform="translate(240 310) rotate(-11)"/>
  <use href="#mrxQue" transform="translate(296 318) rotate(8)"/>
  <use href="#mrxQue" transform="translate(352 306) rotate(-4) scale(.92)"/>
  <use href="#mrxQue" transform="translate(140 276) rotate(18) scale(.9)"/>

  <!-- SẢ BĂM phủ dày kín mặt — chữ ký không món kho nào có -->
  <g fill="#D8CE84" stroke="#A89E4E" stroke-width=".9">
    <ellipse cx="166" cy="266" rx="4.4" ry="2.4" transform="rotate(-24 166 266)"/>
    <ellipse cx="196" cy="258" rx="4" ry="2.2" transform="rotate(16 196 258)"/>
    <ellipse cx="226" cy="252" rx="4.6" ry="2.5" transform="rotate(-8 226 252)"/>
    <ellipse cx="258" cy="256" rx="4.2" ry="2.3" transform="rotate(28 258 256)"/>
    <ellipse cx="288" cy="252" rx="4.4" ry="2.4" transform="rotate(-16 288 252)"/>
    <ellipse cx="320" cy="264" rx="4" ry="2.2" transform="rotate(10 320 264)"/>
    <ellipse cx="350" cy="272" rx="4.4" ry="2.4" transform="rotate(-22 350 272)"/>
    <ellipse cx="150" cy="284" rx="4.2" ry="2.3" transform="rotate(20 150 284)"/>
    <ellipse cx="184" cy="288" rx="4.6" ry="2.5" transform="rotate(-12 184 288)"/>
    <ellipse cx="216" cy="280" rx="4" ry="2.2" transform="rotate(6 216 280)"/>
    <ellipse cx="248" cy="278" rx="4.4" ry="2.4" transform="rotate(-26 248 278)"/>
    <ellipse cx="282" cy="284" rx="4.2" ry="2.3" transform="rotate(14 282 284)"/>
    <ellipse cx="314" cy="286" rx="4.6" ry="2.5" transform="rotate(-6 314 286)"/>
    <ellipse cx="346" cy="292" rx="4" ry="2.2" transform="rotate(24 346 292)"/>
    <ellipse cx="168" cy="306" rx="4.4" ry="2.4" transform="rotate(-18 168 306)"/>
    <ellipse cx="204" cy="304" rx="4.2" ry="2.3" transform="rotate(8 204 304)"/>
    <ellipse cx="238" cy="298" rx="4.6" ry="2.5" transform="rotate(-10 238 298)"/>
    <ellipse cx="272" cy="304" rx="4" ry="2.2" transform="rotate(22 272 304)"/>
    <ellipse cx="306" cy="308" rx="4.4" ry="2.4" transform="rotate(-14 306 308)"/>
    <ellipse cx="336" cy="316" rx="4.2" ry="2.3" transform="rotate(12 336 316)"/>
    <ellipse cx="212" cy="322" rx="4.4" ry="2.4" transform="rotate(-20 212 322)"/>
    <ellipse cx="264" cy="324" rx="4" ry="2.2" transform="rotate(18 264 324)"/>
    <ellipse cx="152" cy="264" rx="3.8" ry="2.1" transform="rotate(30 152 264)"/>
    <ellipse cx="368" cy="288" rx="3.8" ry="2.1" transform="rotate(-28 368 288)"/>
  </g>
  <g fill="#F0EAB0">
    <ellipse cx="190" cy="272" rx="2.6" ry="1.5" transform="rotate(-14 190 272)"/>
    <ellipse cx="252" cy="266" rx="2.4" ry="1.4" transform="rotate(18 252 266)"/>
    <ellipse cx="308" cy="276" rx="2.6" ry="1.5" transform="rotate(-8 308 276)"/>
    <ellipse cx="228" cy="312" rx="2.4" ry="1.4" transform="rotate(24 228 312)"/>
    <ellipse cx="290" cy="296" rx="2.5" ry="1.5" transform="rotate(-20 290 296)"/>
    <ellipse cx="166" cy="294" rx="2.4" ry="1.4" transform="rotate(10 166 294)"/>
  </g>

  <!-- ỚT LÁT đỏ rải mặt -->
  <g>
    <g transform="translate(206 264)"><circle r="6" fill="#C4402C" stroke="#8E2317" stroke-width="1.7"/><circle r="2.6" fill="#EE8A70"/></g>
    <g transform="translate(300 292)"><circle r="5.6" fill="#C4402C" stroke="#8E2317" stroke-width="1.6"/><circle r="2.4" fill="#EE8A70"/></g>
    <g transform="translate(250 316)"><circle r="5.2" fill="#C4402C" stroke="#8E2317" stroke-width="1.6"/><circle r="2.2" fill="#EE8A70"/></g>
    <g transform="translate(340 264)"><circle r="5" fill="#C4402C" stroke="#8E2317" stroke-width="1.5"/><circle r="2.1" fill="#EE8A70"/></g>
    <g transform="translate(160 316)"><circle r="4.8" fill="#C4402C" stroke="#8E2317" stroke-width="1.5"/><circle r="2" fill="#EE8A70"/></g>
  </g>

  <!-- ===== HŨ MẮM RUỐC mở nắp, có muỗng gỗ cắm ===== -->
  <g transform="translate(96 340)">
    <ellipse cx="0" cy="52" rx="52" ry="13" fill="rgba(15,26,14,.32)"/>
    <!-- muỗng gỗ cắm nghiêng -->
    <g transform="rotate(20)">
      <rect x="-5" y="-64" width="10" height="58" rx="5" fill="#B08A45" stroke="#8A6A2E" stroke-width="1.6"/>
      <ellipse cx="0" cy="-66" rx="11" ry="8" fill="#C49A52" stroke="#8A6A2E" stroke-width="1.6"/>
    </g>
    <path d="M-38 -18 C -40 6 -34 34 -28 46 C -12 52 12 52 28 46 C 34 34 40 6 38 -18 Z"
          fill="#EDE4CC" stroke="#C4B894" stroke-width="2.2"/>
    <rect x="-40" y="0" width="80" height="17" rx="4" fill="#DDD1AE" opacity=".9"/>
    <ellipse cx="0" cy="-18" rx="38" ry="12" fill="#F6F1E1" stroke="#C4B894" stroke-width="2.2"/>
    <ellipse cx="0" cy="-17" rx="31" ry="9" fill="url(#mrxMam)"/>
    <ellipse cx="-8" cy="-19" rx="12" ry="3.6" fill="#9A6C7A" opacity=".8"/>
    <path d="M-20 -14 C -8 -10 8 -11 20 -15" fill="none" stroke="#A87C88" stroke-width="2" stroke-linecap="round" opacity=".7"/>
  </g>

  <!-- ===== TÉP SẢ TƯƠI dựng bên phải ===== -->
  <g transform="translate(444 396)">
    <ellipse cx="-6" cy="10" rx="42" ry="11" fill="rgba(15,26,14,.3)"/>
    <use href="#mrxSaCay" transform="translate(-24 6) rotate(-12)"/>
    <use href="#mrxSaCay" transform="translate(-4 8) rotate(2) scale(.94)"/>
    <use href="#mrxSaCay" transform="translate(16 6) rotate(14) scale(.88)"/>
  </g>

  <!-- ===== CHÉN CƠM TRẮNG — món này sinh ra để ăn với cơm nóng ===== -->
  <g transform="translate(378 376)">
    <ellipse cx="0" cy="42" rx="50" ry="13" fill="rgba(15,26,14,.32)"/>
    <path d="M-44 -4 C -42 20 -25 38 0 38 C 25 38 42 20 44 -4 Z" fill="url(#mrxDia)" stroke="#D8D0B6" stroke-width="2"/>
    <ellipse cx="0" cy="37" rx="19" ry="5" fill="#D8D0B6"/>
    <ellipse cx="0" cy="-4" rx="44" ry="14" fill="#F6F1E1" stroke="#2C5234" stroke-width="3.4"/>
    <path d="M-36 -6 C -30 -22 -16 -30 0 -30 C 16 -30 30 -22 36 -6 C 20 2 -20 2 -36 -6 Z"
          fill="#FDFAF0" stroke="#DED3B4" stroke-width="1.8"/>
    <g fill="none" stroke="#E4DAC0" stroke-width="2.2" stroke-linecap="round">
      <path d="M-22 -10 q9 -3 18 -1"/><path d="M2 -16 q9 -3 18 -1"/><path d="M-12 -20 q8 -3 16 -1"/>
      <path d="M8 -6 q9 -3 17 -1"/>
    </g>
  </g>

  <!-- ĐẠO CỤ: dưa leo lát, cắt ngang vị mặn -->
  <g transform="translate(184 400)">
    <circle r="17" fill="#6F9C48" stroke="#41702C" stroke-width="2.2"/>
    <circle r="11" fill="#D6E8B4"/>
    <g fill="#9CB25C"><circle cx="-3.4" cy="-3" r="1.7"/><circle cx="4" cy="0" r="1.7"/><circle cx="-1" cy="4.4" r="1.7"/></g>
  </g>
  <g transform="translate(224 418) scale(.84)">
    <circle r="17" fill="#6F9C48" stroke="#41702C" stroke-width="2.2"/>
    <circle r="11" fill="#D6E8B4"/>
    <g fill="#9CB25C"><circle cx="-3" cy="2.4" r="1.6"/><circle cx="3.6" cy="-2.6" r="1.6"/></g>
  </g>
  <g transform="translate(268 424) scale(.72)">
    <circle r="17" fill="#6F9C48" stroke="#41702C" stroke-width="2.2"/>
    <circle r="11" fill="#D6E8B4"/>
    <g fill="#9CB25C"><circle cx="-2.6" cy="-2" r="1.5"/><circle cx="3" cy="2.4" r="1.5"/></g>
  </g>
</svg>
