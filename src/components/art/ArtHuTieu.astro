---
/* Hủ tiếu Nam Vang — tô sâu nước lèo vàng nhạt trong: sợi hủ tiếu trắng MẢNH,
   2 tôm chữ C cam đuôi xòe, trứng cút 2 nguyên + 1 bổ đôi lộ lòng đỏ (chữ ký),
   mô thịt bằm nâu nhạt lấm tấm, hẹ cọng dài + giá, tỏi phi vàng;
   đạo cụ: dĩa giá hẹ sống + chén tỏi phi */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Tô hủ tiếu Nam Vang sợi mảnh, tôm cong, trứng cút, thịt bằm, hẹ xanh, kèm dĩa giá hẹ và chén tỏi phi">
  <defs>
    <linearGradient id="htBroth" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#F5E7BC"/><stop offset="1" stop-color="#E5C77E"/>
    </linearGradient>
    <linearGradient id="htBowl" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#FDFAF0"/><stop offset="1" stop-color="#E9E2CC"/>
    </linearGradient>
  </defs>
  <circle cx="260" cy="240" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="240" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <g class="steam">
    <path d="M186 230 C 175 206 201 190 190 164 C 183 148 197 136 193 120"/>
    <path d="M256 222 C 246 198 272 184 261 158 C 254 142 268 130 264 114"/>
    <path d="M326 232 C 316 208 342 194 331 168 C 324 152 338 140 334 124"/>
  </g>
  <ellipse cx="258" cy="420" rx="196" ry="24" fill="rgba(15,26,14,.35)"/>

  <!-- tô -->
  <path d="M68 298 C 74 372 158 414 258 414 C 358 414 442 372 448 298 Z" fill="url(#htBowl)"/>
  <ellipse cx="258" cy="412" rx="62" ry="11" fill="#D8D0B6"/>
  <ellipse cx="258" cy="296" rx="190" ry="47" fill="#F6F1E1"/>
  <ellipse cx="258" cy="296" rx="190" ry="47" fill="none" stroke="#2C5234" stroke-width="5"/>
  <ellipse cx="258" cy="297" rx="176" ry="41" fill="none" stroke="#E0A32E" stroke-width="2.5" stroke-dasharray="2 11" stroke-linecap="round"/>

  <!-- nước lèo vàng nhạt trong -->
  <ellipse cx="258" cy="299" rx="160" ry="34" fill="url(#htBroth)"/>
  <ellipse cx="196" cy="288" rx="54" ry="9" fill="#F8EDC8" opacity=".6"/>

  <!-- sợi hủ tiếu trắng MẢNH (mảnh hơn bánh phở) -->
  <g fill="none" stroke="#FCF7E8" stroke-width="5" stroke-linecap="round">
    <path d="M112 296 C 140 286 174 285 202 292"/>
    <path d="M124 308 C 152 299 186 298 214 305"/>
    <path d="M142 320 C 168 312 200 311 226 317"/>
    <path d="M300 290 C 328 283 358 283 382 290"/>
    <path d="M314 306 C 340 300 368 300 390 296"/>
    <path d="M232 330 C 258 324 288 324 312 329"/>
    <path d="M330 320 C 354 315 378 315 396 310"/>
  </g>
  <g fill="none" stroke="#E5D9B8" stroke-width="1.8" stroke-linecap="round" opacity=".85">
    <path d="M120 302 C 146 293 178 292 204 298"/>
    <path d="M308 296 C 332 290 360 290 380 293"/>
    <path d="M244 328 C 266 323 292 323 308 327"/>
    <path d="M150 316 C 174 309 202 308 224 313"/>
  </g>

  <!-- hẹ cọng dài vắt ngang -->
  <g fill="none" stroke="#55923F" stroke-width="3.6" stroke-linecap="round">
    <path d="M298 266 C 326 258 356 257 380 264"/>
    <path d="M142 320 C 162 314 184 313 202 316"/>
  </g>

  <!-- thịt bằm xào rải tơi thành mảng (không vun khối) -->
  <g>
    <ellipse cx="280" cy="317" rx="44" ry="11" fill="#C99659" opacity=".3"/>
    <g fill="#D2A05E" stroke="#A9773B" stroke-width="1.2">
      <ellipse cx="252" cy="313" rx="5" ry="3.4" transform="rotate(-14 252 313)"/>
      <ellipse cx="264" cy="308" rx="5.4" ry="3.6" transform="rotate(10 264 308)"/>
      <ellipse cx="278" cy="312" rx="5.2" ry="3.5" transform="rotate(-8 278 312)"/>
      <ellipse cx="292" cy="308" rx="5" ry="3.4" transform="rotate(14 292 308)"/>
      <ellipse cx="305" cy="313" rx="4.8" ry="3.2" transform="rotate(-10 305 313)"/>
      <ellipse cx="258" cy="321" rx="4.8" ry="3.2" transform="rotate(8 258 321)"/>
      <ellipse cx="272" cy="323" rx="5" ry="3.3" transform="rotate(-12 272 323)"/>
      <ellipse cx="287" cy="321" rx="4.9" ry="3.2" transform="rotate(9 287 321)"/>
      <ellipse cx="301" cy="323" rx="4.5" ry="3" transform="rotate(-7 301 323)"/>
      <ellipse cx="312" cy="318" rx="4.2" ry="2.9" transform="rotate(12 312 318)"/>
    </g>
    <g fill="#E8BE85">
      <ellipse cx="262" cy="311" rx="2" ry="1.3"/><ellipse cx="283" cy="315" rx="2" ry="1.3"/>
      <ellipse cx="298" cy="310" rx="1.8" ry="1.2"/><ellipse cx="270" cy="320" rx="1.8" ry="1.2"/>
      <ellipse cx="293" cy="324" rx="1.7" ry="1.1"/>
    </g>
    <g fill="#7E4E1F">
      <circle cx="255" cy="316" r="1"/><circle cx="276" cy="309" r="1"/><circle cx="290" cy="317" r="1"/>
      <circle cx="306" cy="320" r="1"/><circle cx="266" cy="325" r="1"/>
    </g>
  </g>

  <!-- trứng cút: cặp nguyên nằm kề + 1 bổ đôi lộ lòng đỏ -->
  <g transform="rotate(-8 246 272)">
    <ellipse cx="246" cy="272" rx="11.5" ry="14" fill="#FBF3DC" stroke="#D9C79A" stroke-width="2"/>
    <path d="M240.5 264 a 9.5 9.5 0 0 1 7.5 -3.2" fill="none" stroke="#FFFDF6" stroke-width="2.8" stroke-linecap="round"/>
  </g>
  <g transform="rotate(12 274 280)">
    <ellipse cx="274" cy="280" rx="10.5" ry="13" fill="#FBF3DC" stroke="#D9C79A" stroke-width="2"/>
    <path d="M269 272.5 a 9 9 0 0 1 7 -3" fill="none" stroke="#FFFDF6" stroke-width="2.6" stroke-linecap="round"/>
  </g>

  <!-- 2 tôm chữ C cam, đuôi xòe -->
  <g transform="translate(174 292) rotate(-6)">
    <path d="M-16 16 C -30 -2 -14 -24 10 -23 C 27 -22 36 -10 32 3"
          fill="none" stroke="#E8663A" stroke-width="15" stroke-linecap="round"/>
    <g fill="none" stroke="#C24A22" stroke-width="2.4" stroke-linecap="round">
      <path d="M-16 -8 q7 -7 15 -8"/>
      <path d="M0 -17 q6 -4 13 -3"/>
      <path d="M17 -16 q6 0 10 5"/>
    </g>
    <path d="M-13 11 L -34 3 L -21 17 L -37 20 L -18 23 Z" fill="#D9542E" stroke="#C24A22" stroke-width="1.8" stroke-linejoin="round"/>
    <circle cx="33" cy="6" r="2" fill="#5E2C0C"/>
  </g>
  <g transform="translate(352 292) rotate(8) scale(-.85 .85)">
    <path d="M-16 16 C -30 -2 -14 -24 10 -23 C 27 -22 36 -10 32 3"
          fill="none" stroke="#E8663A" stroke-width="15" stroke-linecap="round"/>
    <g fill="none" stroke="#C24A22" stroke-width="2.4" stroke-linecap="round">
      <path d="M-16 -8 q7 -7 15 -8"/>
      <path d="M0 -17 q6 -4 13 -3"/>
      <path d="M17 -16 q6 0 10 5"/>
    </g>
    <path d="M-13 11 L -34 3 L -21 17 L -37 20 L -18 23 Z" fill="#D9542E" stroke="#C24A22" stroke-width="1.8" stroke-linejoin="round"/>
    <circle cx="33" cy="6" r="2" fill="#5E2C0C"/>
  </g>

  <!-- trứng cút bổ đôi (vẽ sau để nằm cạnh tôm) -->
  <g transform="rotate(-12 344 320)">
    <ellipse cx="344" cy="320" rx="12" ry="14.5" fill="#FBF3DC" stroke="#D9C79A" stroke-width="2"/>
    <ellipse cx="344" cy="320" rx="8.8" ry="11" fill="#FFFDF4"/>
    <circle cx="342.5" cy="318" r="4.6" fill="#EFB93E" stroke="#D99A28" stroke-width="1.4"/>
  </g>

  <!-- hẹ khúc ngắn + giá cọng cong đầu hạt -->
  <g fill="none" stroke="#55923F" stroke-width="3.2" stroke-linecap="round">
    <path d="M320 300 l20 -5 M154 272 l18 -4 M214 330 l16 -3 M204 272 l16 -4"/>
  </g>
  <g fill="none" stroke="#EFE6C4" stroke-width="3" stroke-linecap="round">
    <path d="M150 306 q10 -3 14 -10"/>
    <path d="M230 336 q8 -2 12 -8"/>
    <path d="M384 306 q9 -3 13 -9"/>
  </g>
  <g fill="#E5D3A0">
    <circle cx="166" cy="295" r="1.7"/><circle cx="244" cy="327.5" r="1.6"/><circle cx="399" cy="296" r="1.6"/>
  </g>

  <!-- tỏi phi vàng rắc mặt -->
  <g fill="#DFA750" stroke="#B3762A" stroke-width="1.2">
    <circle cx="140" cy="288" r="2.2"/><circle cx="222" cy="292" r="2"/><circle cx="302" cy="290" r="2.3"/>
    <circle cx="370" cy="278" r="2"/><circle cx="322" cy="330" r="2.2"/><circle cx="192" cy="324" r="1.9"/>
  </g>

  <!-- dĩa giá hẹ sống bên trái -->
  <g transform="translate(100 400)">
    <ellipse cx="0" cy="12" rx="58" ry="12" fill="rgba(15,26,14,.3)"/>
    <ellipse cx="0" cy="4" rx="54" ry="15" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2"/>
    <ellipse cx="0" cy="3" rx="42" ry="10.5" fill="#F6F1E1"/>
    <g fill="none" stroke="#E5D8AC" stroke-width="3.6" stroke-linecap="round">
      <path d="M-32 2 q12 -6 24 -4"/>
      <path d="M-22 6 q14 -7 28 -4"/>
      <path d="M-12 -3 q12 -5 24 -2"/>
      <path d="M-28 -3 q10 -5 20 -4"/>
      <path d="M0 4 q12 -5 24 -3"/>
    </g>
    <g fill="#C9AE6E">
      <circle cx="-6" cy="-4" r="1.8"/><circle cx="10" cy="0" r="1.8"/><circle cx="-16" cy="3" r="1.7"/>
      <circle cx="22" cy="2" r="1.7"/>
    </g>
    <g fill="none" stroke="#55923F" stroke-width="3" stroke-linecap="round">
      <path d="M-8 -5 q18 -5 34 -1"/>
      <path d="M-16 2 q18 -3 36 1"/>
    </g>
  </g>

  <!-- chén tỏi phi bên phải -->
  <g transform="translate(430 392)">
    <ellipse cx="0" cy="14" rx="36" ry="11" fill="rgba(15,26,14,.3)"/>
    <path d="M-30 -2 C -28 15 -16 24 0 24 C 16 24 28 15 30 -2 Z" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2"/>
    <ellipse cx="0" cy="-2" rx="24" ry="7.5" fill="#E9DFC2"/>
    <g fill="#DFA750" stroke="#B3762A" stroke-width="1.2">
      <circle cx="-12" cy="-3" r="2.6"/><circle cx="-2" cy="-5" r="2.2"/><circle cx="8" cy="-2" r="2.8"/>
      <circle cx="16" cy="-5" r="2"/><circle cx="2" cy="0" r="2"/><circle cx="-16" cy="1" r="1.9"/>
      <rect x="-7" y="-2" width="4.6" height="3.4" rx="1.2" transform="rotate(18 -5 0)"/>
      <rect x="10" y="0" width="4.2" height="3.2" rx="1.1" transform="rotate(-14 12 1)"/>
    </g>
  </g>
</svg>
