    <path d="M-24 -4 C -28 -16 -10 -25 4 -23 C 20 -21 28 -10 23 -1 C 12 5 -12 5 -24 -4 Z" fill="#FBF6E6" stroke="#DFD3B2" stroke-width="2"/>
    <g fill="#EFE6CB">
      <circle cx="-12" cy="-11" r="2.4"/><circle cx="-2" cy="-16" r="2.2"/><circle cx="9" cy="-10" r="2.4"/>
      <circle cx="0" cy="-5" r="2.2"/><circle cx="-18" cy="-4" r="2"/><circle cx="16" cy="-4" r="2"/>
    </g>
  </g>

  <!-- RAU CẢI LUỘC (góc phải dưới) -->
  <g transform="translate(430 414)">
    <ellipse cx="0" cy="13" rx="38" ry="10" fill="rgba(15,26,14,.3)"/>
    <path d="M-30 -2 C -28 12 -16 21 0 21 C 16 21 28 12 30 -2 Z" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2"/>
    <ellipse cx="0" cy="-2" rx="25" ry="7.4" fill="#EDE6CE"/>
