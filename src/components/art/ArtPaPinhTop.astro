    <g fill="#3E2008">
      <circle cx="234" cy="288" r="1.8"/><circle cx="268" cy="278" r="1.7"/><circle cx="304" cy="286" r="1.8"/>
      <circle cx="336" cy="298" r="1.6"/><circle cx="246" cy="320" r="1.7"/><circle cx="288" cy="328" r="1.8"/>
      <circle cx="322" cy="314" r="1.6"/><circle cx="212" cy="302" r="1.5"/><circle cx="356" cy="288" r="1.5"/>
      <circle cx="220" cy="266" r="1.5"/><circle cx="300" cy="308" r="1.6"/>
    </g>
    <!-- mảng da bóng trên gáy -->
    <path d="M212 254 C 240 236 286 228 326 232 L 326 240 C 288 238 246 246 220 262 Z" fill="#F0B972" opacity=".45"/>

    <!-- ĐẦU: đường nắp mang tách hẳn đầu khỏi mình, mắt to, miệng rộng -->
    <path d="M356 240 C 374 258 376 314 356 332" fill="none" stroke="#5E2C0E" stroke-width="3"/>
    <path d="M344 246 C 360 262 361 310 344 326" fill="none" stroke="#5E2C0E" stroke-width="1.8" opacity=".55"/>
    <circle cx="381" cy="266" r="9.4" fill="#F4EAD2" stroke="#3E1D06" stroke-width="2.4"/>
    <circle cx="382" cy="266" r="4.2" fill="#241407"/>
    <circle cx="379" cy="263" r="1.7" fill="#FFFDF6"/>
    <path d="M404 286 C 396 295 384 300 370 300" fill="none" stroke="#4E2408" stroke-width="2.8" stroke-linecap="round"/>

    <!-- ĐƯỜNG MÉP GẬP dọc sống lưng (chỗ xẻ lưng rồi úp lại) -->
    <path d="M198 250 C 250 230 318 226 372 248" fill="none" stroke="#5E2C0E" stroke-width="4.2" stroke-linecap="round"/>
    <path d="M204 258 C 254 240 316 236 366 256" fill="none" stroke="#EDB067" stroke-width="2" stroke-linecap="round" opacity=".55"/>

    <!-- RAU THƠM nhồi bên trong ló hẳn ra ở đường mép -->
    <g fill="#4E7B36" stroke="#2E5220" stroke-width="1.4">
      <path d="M214 248 C 218 233 234 225 245 231 C 240 246 226 254 214 248 Z"/>
      <path d="M256 236 C 260 221 279 215 288 222 C 283 237 268 243 256 236 Z"/>
      <path d="M300 232 C 305 218 323 214 331 221 C 325 235 312 240 300 232 Z"/>
      <path d="M340 240 C 346 227 362 225 368 234 C 361 246 349 248 340 240 Z"/>
    </g>
    <g fill="#7FB44E" stroke="#4E7B36" stroke-width="1.1">
      <path d="M234 254 C 238 242 252 237 259 243 C 254 254 243 258 234 254 Z"/>
      <path d="M278 245 C 283 233 297 230 303 236 C 297 247 286 250 278 245 Z"/>
      <path d="M320 244 C 326 233 339 231 344 238 C 338 247 328 249 320 244 Z"/>
    </g>
    <g fill="none" stroke="#4E7B36" stroke-width="2.6" stroke-linecap="round">
      <path d="M248 232 C 246 219 242 209 236 202"/>
      <path d="M302 224 C 304 212 308 203 314 197"/>
      <path d="M354 238 C 358 228 364 221 372 217"/>
    </g>
  </g>

  <!-- ===== LẠT BUỘC ở hai chóp, chỗ hai nửa ống chụm lại ===== -->
  <g>
    <path d="M92 268 C 80 278 80 292 92 302" fill="none" stroke="#8A6A32" stroke-width="7" stroke-linecap="round"/>
    <path d="M94 272 C 85 280 85 290 94 298" fill="none" stroke="#E4CE92" stroke-width="2.6" stroke-linecap="round"/>
    <path d="M74 276 L 60 268 M74 292 L 60 300" stroke="#B08A44" stroke-width="3" stroke-linecap="round" fill="none"/>
    <path d="M428 268 C 440 278 440 292 428 302" fill="none" stroke="#8A6A32" stroke-width="7" stroke-linecap="round"/>
    <path d="M426 272 C 435 280 435 290 426 298" fill="none" stroke="#E4CE92" stroke-width="2.6" stroke-linecap="round"/>
    <path d="M446 276 L 460 268 M446 292 L 460 300" stroke="#B08A44" stroke-width="3" stroke-linecap="round" fill="none"/>
  </g>

  <!-- NẮM XÔI NẾP trên miếng lá dong (góc trái dưới) -->
  <g transform="translate(92 414)">
    <ellipse cx="0" cy="14" rx="44" ry="10" fill="rgba(15,26,14,.3)"/>
    <path d="M-42 5 C -36 -10 -16 -18 2 -17 C 22 -16 40 -8 42 6 C 24 15 -22 15 -42 5 Z" fill="#4E7B36" stroke="#375A24" stroke-width="2"/>
