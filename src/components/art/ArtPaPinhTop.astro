---
/* Pa pỉnh tộp — CON CÁ GẬP ĐÔI KẸP TRE, nằm ngang trên dĩa.
   Ba bản trước đều hỏng ở chỗ vẽ sai CƠ CHẾ chứ không phải vẽ xấu:
     1. Hai thanh tre dựng ĐỨNG chắn trước mặt cá → đọc ra cái hàng rào / cái cũi.
     2. Hai thanh nằm ngang nhưng chụm lại thành hình "<" ở một đầu → đọc ra
        cái mũi tên clip-art.
     3. Thân vẽ oval đều tăm tắp, đầu không tách khỏi mình → đọc ra CỦ KHOAI
        có gắn cái đuôi.
   Thực tế: ống tre CHẺ DỌC, kẹp cá vào khe, buộc lạt hai đầu. Hai nửa ống ôm
   lấy con cá rồi CHỤM VÀO NHAU Ở CẢ HAI ĐẦU — tức là một hình hạt hạnh nhân
   bao quanh con cá, buộc lạt ở hai chóp. Vẽ đúng vậy thì nhìn ra ngay cái vỉ kẹp.
   Thân cá: gáy cao ở giữa (vì gập đôi) nhưng THUÔN DẦN về cuống đuôi hẹp bên
   trái và có ĐẦU RIÊNG bên phải, tách bằng đường nắp mang. Lưng đã xẻ nên
   không có vây lưng — thay vào đó là đường mép gập với rau thơm ló ra. */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Pa pỉnh tộp: con cá gập đôi kẹp giữa hai nửa ống tre chẻ dọc buộc lạt hai đầu, da nâu vàng sém vệt nướng, rau thơm ló ra dọc sống lưng, kèm nắm xôi nếp và rau luộc">
  <defs>
    <linearGradient id="pptDa" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#D68E3C"/><stop offset="0.5" stop-color="#A85C20"/><stop offset="1" stop-color="#763712"/>
    </linearGradient>
    <linearGradient id="pptTre" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#EFDFAC"/><stop offset="1" stop-color="#B4914F"/>
    </linearGradient>
  </defs>
  <circle cx="260" cy="246" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="246" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <g class="steam">
    <path d="M228 176 C 217 152 243 136 232 110 C 225 94 239 82 235 68"/>
    <path d="M306 170 C 296 146 322 132 311 106 C 304 90 318 78 314 64"/>
  </g>
  <ellipse cx="260" cy="418" rx="196" ry="24" fill="rgba(15,26,14,.35)"/>

  <!-- dĩa sứ dài -->
  <ellipse cx="258" cy="374" rx="198" ry="52" fill="#F6F1E1"/>
  <ellipse cx="258" cy="370" rx="198" ry="52" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2"/>
  <ellipse cx="258" cy="370" rx="198" ry="52" fill="none" stroke="#2C5234" stroke-width="4"/>
  <ellipse cx="258" cy="372" rx="164" ry="38" fill="none" stroke="#E0A32E" stroke-width="2.4" stroke-dasharray="2 11" stroke-linecap="round"/>

  <!-- ===== NỬA ỐNG TRE DƯỚI (vẽ trước, nằm sau cá) ===== -->
  <path d="M84 284 C 118 348 178 372 258 372 C 338 372 400 348 436 284"
        fill="none" stroke="#8A6A32" stroke-width="15" stroke-linecap="round"/>
  <path d="M84 284 C 118 348 178 372 258 372 C 338 372 400 348 436 284"
        fill="none" stroke="url(#pptTre)" stroke-width="11" stroke-linecap="round"/>
  <path d="M100 302 C 132 350 182 366 258 366" fill="none" stroke="#F7ECC8" stroke-width="2.4" opacity=".7"/>

  <!-- ===== NỬA ỐNG TRE TRÊN (vẽ trước, nằm sau cá) ===== -->
  <path d="M84 284 C 118 216 178 194 258 194 C 338 194 400 216 436 284"
