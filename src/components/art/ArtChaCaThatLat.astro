          fill="#F0E7D0" stroke="#A99770" stroke-width="2.6" stroke-linejoin="round"/>
    <g fill="none" stroke="#C9B78D" stroke-width="2.4" stroke-linecap="round">
      <path d="M310 296 L 336 278"/>
      <path d="M314 305 L 340 288"/>
      <path d="M306 287 L 330 271"/>
