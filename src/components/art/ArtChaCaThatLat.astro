  <ellipse cx="420" cy="351" rx="32" ry="9" fill="#6B3A14" stroke="#42200A" stroke-width="2.2"/>
  <ellipse cx="412" cy="349" rx="10" ry="3.4" fill="#8E5220" opacity=".9"/>
  <g fill="#C4381F">
