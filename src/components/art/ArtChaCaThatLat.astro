---
/* Chả cá thát lát chiên — họ đỏ "Lửa".
   Soi cả họ trước: 9 hình, trong đó CHẢ GIÒ TÔM THỊT là hàng xóm nguy hiểm —
   cũng đĩa trắng bầu dục + đồ chiên vàng nâu + chén nước chấm. Ba thứ tách ra:
   · DÁNG: chả giò là mấy TRỤ DÀI nằm song song; ở đây là MIẾNG TRÒN DẸT xếp
     chồng lệch. Trụ ≠ đĩa, đọc được ngay ở đường bao
   · MỘT MIẾNG BẺ ĐÔI lộ ruột TRẮNG NGÀ CÓ THỚ — chữ ký của chả cá quết tay
     (dai, bẻ ra còn kéo thớ). Không hình nào trong họ có mặt cắt trắng
   · nước chấm là MẮM ME nâu sẫm sánh, không phải chén tương ớt đỏ
   Tra thành phẩm: chiên xong vỏ vàng RÁM có chỗ đậm chỗ nhạt, mép hơi phồng và
   gợn sóng chứ không tròn vành vạnh — vẽ đường bao gãy khúc nhẹ.
   Luật đợt 14 "đồ ăn co rúm vì nhiệt thì vẽ bằng ĐOẠN THẲNG, đừng vẽ bằng
   đường cong": mép miếng chả dùng lệnh L gãy khúc, không bo tròn đều. */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Đĩa chả cá thát lát chiên: mấy miếng tròn dẹt vàng rám xếp chồng, một miếng bẻ đôi lộ ruột trắng có thớ, bên cạnh là chén mắm me và rau răm">
  <circle cx="260" cy="250" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="250" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <g class="steam">
    <path d="M216 186 C 205 162 231 146 220 120 C 213 104 227 92 223 78"/>
    <path d="M298 182 C 288 158 314 144 303 118 C 296 102 310 90 306 76"/>
  </g>
  <ellipse cx="256" cy="404" rx="184" ry="26" fill="rgba(15,26,14,.35)"/>

  <!-- ĐĨA TRẮNG BẦU DỤC -->
  <ellipse cx="256" cy="362" rx="176" ry="52" fill="#D9CFB8" stroke="#8E7F5E" stroke-width="3"/>
  <ellipse cx="256" cy="354" rx="176" ry="52" fill="#F6F1E4" stroke="#8E7F5E" stroke-width="3"/>
  <ellipse cx="256" cy="354" rx="146" ry="40" fill="#EDE5D2" stroke="#B5A582" stroke-width="2.2"/>

  <!-- RAU RĂM lót dưới: dải dẹt có gân, nằm ngang -->
  <g fill="#3E7A2C" stroke="#26521A" stroke-width="2.2">
    <path d="M132 348 c 26 -12 54 -12 72 -2 c -22 10 -48 12 -72 2 z"/>
    <path d="M320 356 c 24 -12 50 -12 68 -2 c -22 10 -46 12 -68 2 z"/>
  </g>
  <g fill="none" stroke="#63A34E" stroke-width="1.8">
    <path d="M144 346 L 192 344"/>
    <path d="M330 354 L 376 352"/>
  </g>

  <!-- MIẾNG CHẢ 5: nằm sau bên phải (Thái xin thêm miếng cho đầy đĩa) -->
  <path d="M256 300 L 282 284 L 316 278 L 348 284 L 364 300 L 356 318 L 324 328 L 288 326 L 262 316 Z"
        fill="#BC7F2C" stroke="#7E4E10" stroke-width="3" stroke-linejoin="round"/>
  <path d="M268 300 L 288 288 L 316 284 L 342 289 L 352 300 L 344 312 L 318 319 L 290 317 L 272 310 Z"
