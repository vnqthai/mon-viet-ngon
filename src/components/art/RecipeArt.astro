---
/* Chọn minh họa cho món: art riêng nếu có, không thì suy từ loại món */
import CanhChuaArt from './CanhChuaArt.astro';
import ArtComTam from './ArtComTam.astro';
import ArtChaGio from './ArtChaGio.astro';
import ArtBoKho from './ArtBoKho.astro';
import ArtKhoQua from './ArtKhoQua.astro';
import ArtPhoBo from './ArtPhoBo.astro';
import ArtBunBo from './ArtBunBo.astro';
import ArtBanhXeo from './ArtBanhXeo.astro';
import ArtCaKhoTo from './ArtCaKhoTo.astro';
import ArtThitKho from './ArtThitKho.astro';
import ArtCanhBiDo from './ArtCanhBiDo.astro';
import ArtBowl from './ArtBowl.astro';
import ArtClaypot from './ArtClaypot.astro';
import ArtPlate from './ArtPlate.astro';
import ArtRolls from './ArtRolls.astro';

interface Props { art?: string; category: string }
const { art, category } = Astro.props;

const byCategory: Record<string, string> = {
  'Canh': 'bowl',
  'Kho': 'claypot',
  'Xào': 'plate',
  'Chiên': 'plate',
  'Cuốn': 'rolls',
  'Gỏi': 'rolls',
  'Hấp': 'bowl',
  'Cơm': 'plate',
  'Bún – Phở': 'bowl',
};
const kind = art ?? byCategory[category] ?? 'bowl';
---
{kind === 'canh-chua' && <CanhChuaArt />}
{kind === 'com-tam' && <ArtComTam />}
{kind === 'cha-gio' && <ArtChaGio />}
{kind === 'bo-kho' && <ArtBoKho />}
{kind === 'kho-qua' && <ArtKhoQua />}
{kind === 'pho-bo' && <ArtPhoBo />}
{kind === 'bun-bo' && <ArtBunBo />}
{kind === 'banh-xeo' && <ArtBanhXeo />}
{kind === 'ca-kho' && <ArtCaKhoTo />}
{kind === 'thit-kho' && <ArtThitKho />}
{kind === 'canh-bi-do' && <ArtCanhBiDo />}
{kind === 'bowl' && <ArtBowl />}
{kind === 'claypot' && <ArtClaypot />}
{kind === 'plate' && <ArtPlate />}
{kind === 'rolls' && <ArtRolls />}
