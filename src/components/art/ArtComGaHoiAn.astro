---
/* Cơm gà Hội An (vẽ lại từ đầu) — mô cơm nghệ dáng CHÉN ÚP vân hạt rõ, vài hạt rơi;
   gà xé = miếng dày da vàng mép xé răng cưa + sợi nhỏ; rau răm, hành tây;
   đạo cụ: chén súp nóng + chén tương ớt */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Dĩa cơm gà Hội An vàng mơ, gà xé trộn rau răm hành tây, kèm chén súp và tương ớt">
  <defs>
    <linearGradient id="cgCom" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#F4CE60"/><stop offset="1" stop-color="#DFA232"/>
    </linearGradient>
    <linearGradient id="cgGa" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#F8EDD2"/><stop offset="1" stop-color="#EAD3A2"/>
    </linearGradient>
  </defs>
  <circle cx="260" cy="250" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="250" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <g class="steam">
    <path d="M176 236 C 165 212 191 196 180 170 C 173 154 187 142 183 128"/>
    <path d="M318 224 C 308 200 334 186 323 160 C 316 144 330 132 326 118"/>
  </g>
  <ellipse cx="260" cy="400" rx="200" ry="26" fill="rgba(15,26,14,.35)"/>

  <!-- dĩa -->
  <ellipse cx="260" cy="342" rx="204" ry="58" fill="#F6F1E1"/>
  <ellipse cx="260" cy="338" rx="204" ry="58" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2"/>
  <ellipse cx="260" cy="338" rx="204" ry="58" fill="none" stroke="#2C5234" stroke-width="4"/>
  <ellipse cx="260" cy="340" rx="168" ry="44" fill="none" stroke="#E0A32E" stroke-width="2.4" stroke-dasharray="2 11" stroke-linecap="round"/>

  <!-- MÔ CƠM NGHỆ dáng chén úp -->
  <ellipse cx="176" cy="326" rx="86" ry="20" fill="#C98F2E" opacity=".35"/>
  <path d="M96 322
           C 96 288 124 268 176 268
           C 228 268 256 288 256 322
           C 256 330 234 336 176 336
           C 118 336 96 330 96 322 Z"
        fill="url(#cgCom)" stroke="#C98F2E" stroke-width="2.6"/>
  <ellipse cx="176" cy="282" rx="46" ry="10" fill="#F8DC80" opacity=".9"/>
  <!-- vân hạt cơm: nét cong hai tông -->
  <g fill="none" stroke="#F8E5A2" stroke-width="2.6" stroke-linecap="round">
    <path d="M124 300 q4 -4 8 0 M156 290 q4 -4 8 0 M196 292 q4 -4 8 0 M226 304 q4 -4 8 0
             M138 316 q4 -4 8 0 M176 308 q4 -4 8 0 M212 318 q4 -4 8 0 M158 326 q4 -4 8 0
             M110 312 q4 -4 8 0 M190 326 q4 -4 8 0"/>
  </g>
  <g fill="none" stroke="#C98F2E" stroke-width="2" stroke-linecap="round" opacity=".75">
    <path d="M140 302 q4 -4 8 0 M172 296 q4 -4 8 0 M208 302 q4 -4 8 0
             M126 322 q4 -4 8 0 M196 314 q4 -4 8 0 M232 316 q4 -4 8 0"/>
  </g>
  <!-- vài hạt cơm rơi dưới chân mô -->
  <g fill="#F4CE60" stroke="#C98F2E" stroke-width="1.3">
    <ellipse cx="104" cy="344" rx="3.6" ry="2" transform="rotate(-18 104 344)"/>
    <ellipse cx="120" cy="350" rx="3.4" ry="2" transform="rotate(12 120 350)"/>
    <ellipse cx="246" cy="346" rx="3.6" ry="2" transform="rotate(-8 246 346)"/>
  </g>

  <!-- ĐÙI GÀ LUỘC vàng óng — tín hiệu "gà" chính -->
  <g transform="rotate(-8 324 288)">
    <path d="M352 272 L 372 256" stroke="#F6EFD8" stroke-width="7" stroke-linecap="round"/>
    <circle cx="377" cy="251" r="4.8" fill="#F6EFD8" stroke="#D8C8A8" stroke-width="1.5"/>
    <circle cx="381" cy="258" r="4.2" fill="#F6EFD8" stroke="#D8C8A8" stroke-width="1.5"/>
    <path d="M350 270
             C 357 276 359 287 353 295
             C 345 306 327 312 310 309
             C 291 306 279 294 281 280
             C 283 265 298 256 317 257
             C 331 258 343 262 350 270 Z"
          fill="#EFC170" stroke="#B8862E" stroke-width="2.6"/>
    <path d="M290 270 C 297 261 308 257 319 258 C 330 258 341 263 347 271 L 340 276 C 334 268 326 264 317 263 C 307 263 297 265 294 274 Z" fill="#F8DC96"/>
    <path d="M288 288 q10 9 24 8" fill="none" stroke="#D9A040" stroke-width="2.4" stroke-linecap="round"/>
    <g fill="#C9973F"><circle cx="316" cy="284" r="1.6"/><circle cx="330" cy="290" r="1.6"/><circle cx="303" cy="292" r="1.5"/></g>
  </g>

  <!-- nhúm gà xé phía trước + hành tây + rau răm -->
  <g stroke="#B8904A" stroke-width="1.8">
    <path d="M296 322 C 308 315 328 311 344 313 C 347 314 347 317 344 318 C 328 322 309 325 297 325 C 295 325 295 323 296 322 Z" fill="#F2DFB4"/>
    <path d="M350 318 C 362 313 380 312 392 315 C 395 316 394 319 391 320 C 379 322 363 323 351 321 C 349 320 349 319 350 318 Z" fill="#F6E8C8"/>
    <path d="M312 330 C 324 325 342 323 356 325 C 359 326 359 329 356 330 C 342 333 325 334 313 333 C 311 333 311 331 312 330 Z" fill="#EFD9A6"/>
  </g>
  <path d="M336 320 C 346 316 358 315 367 317 C 369 318 369 320 367 321 C 358 323 347 323 337 322 C 335 322 335 321 336 320 Z" fill="#E8B85C" stroke="#C9973F" stroke-width="1.4"/>
  <g fill="none" stroke="#FBF7EC" stroke-width="3.6" stroke-linecap="round">
    <path d="M310 320 a 13 6 0 0 1 22 -3"/>
    <path d="M354 326 a 11 5 0 0 1 19 -2"/>
  </g>
  <g>
    <g transform="translate(320 314) rotate(-18)">
      <path d="M0 0 C -3 -7 0 -15 6 -17 C 10 -12 9 -4 3 1 C 1 2 0 1 0 0 Z" fill="#3E7B3A" stroke="#2C5E2E" stroke-width="1.4"/>
    </g>
    <g transform="translate(366 318) rotate(20)">
      <path d="M0 0 C -3 -6 0 -13 5 -15 C 9 -10 8 -3 3 1 C 1 2 0 1 0 0 Z" fill="#4A8B3E" stroke="#2C5E2E" stroke-width="1.3"/>
    </g>
    <g transform="translate(342 288) rotate(-30)">
      <path d="M0 0 C -3 -6 0 -13 5 -15 C 9 -10 8 -3 3 1 C 1 2 0 1 0 0 Z" fill="#3E7B3A" stroke="#2C5E2E" stroke-width="1.3"/>
    </g>
  </g>
  <g fill="#C9862B"><circle cx="332" cy="326" r="2.2"/><circle cx="376" cy="322" r="2"/></g>
  <path d="M346 331 q8 -3 15 -1" fill="none" stroke="#D64B33" stroke-width="2.6" stroke-linecap="round"/>

  <!-- dưa leo + cà chua kề mô cơm -->
  <g>
    <circle cx="130" cy="356" r="12" fill="#6F9C48" stroke="#4E7B36" stroke-width="2"/>
    <circle cx="130" cy="356" r="7.6" fill="#C9DDA4"/>
    <circle cx="160" cy="364" r="11" fill="#6F9C48" stroke="#4E7B36" stroke-width="2"/>
    <circle cx="160" cy="364" r="7" fill="#C9DDA4"/>
    <circle cx="250" cy="360" r="12" fill="#E23B2E" stroke="#B22B20" stroke-width="2"/>
    <circle cx="250" cy="360" r="7" fill="#F26A50"/>
  </g>

  <!-- chén súp nước luộc gà -->
  <g transform="translate(84 398)">
    <ellipse cx="0" cy="16" rx="48" ry="13" fill="rgba(15,26,14,.3)"/>
    <path d="M-38 -2 C -36 16 -20 26 0 26 C 20 26 36 16 38 -2 Z" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2.2"/>
    <ellipse cx="0" cy="-2" rx="32" ry="9.5" fill="#E8D9A0"/>
    <ellipse cx="-8" cy="-3" rx="12" ry="3.6" fill="#F2E6B8"/>
    <g stroke="#6F9C48" stroke-width="2.8" stroke-linecap="round" fill="none">
      <path d="M-14 -4 l8 -2 M6 -1 l8 -2"/>
    </g>
  </g>

  <!-- chén tương ớt + rau răm rơi -->
  <g>
    <ellipse cx="430" cy="392" rx="36" ry="11" fill="rgba(15,26,14,.3)"/>
    <path d="M400 376 C 402 393 414 402 430 402 C 446 402 458 393 460 376 Z" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2"/>
    <ellipse cx="430" cy="376" rx="30" ry="9" fill="#C0392B"/>
    <ellipse cx="423" cy="374" rx="11" ry="3.4" fill="#E05A38" opacity=".9"/>
  </g>
  <g transform="translate(378 424) rotate(-18)">
    <path d="M0 0 C -4 -8 0 -17 7 -19 C 12 -13 11 -4 4 1 C 2 2 1 1 0 0 Z" fill="#3E7B3A" stroke="#2C5E2E" stroke-width="1.5"/>
  </g>
</svg>
