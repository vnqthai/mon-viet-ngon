---
/* Bánh ướt chả lụa — VẼ LẠI vòng 3. Thái nói vòng 2 "có nét hình dạng giống
   bánh mì": đúng, vì mấy lá bánh vẽ thành khối thuôn dài viền nâu đậm, y như ổ
   bánh. Lá bánh ướt thật là tấm bột MỎNG, MỀM OẶT, nhăn nhàu như tấm lụa ướt
   vắt xuống dĩa — không có khối, không có viền cứng.
   Vòng này: mấy tấm bột RỘNG BẢN, mép lượn nhăn, viền nhạt gần bằng ruột, xếp
   chồng hờ và tràn cả ra mép dĩa. Trên mặt là LÁT CHẢ LỤA tròn hồng nhạt (chứ
   không phải sợi — lát tròn mới đọc ra chả lụa ở cỡ thumbnail), giá trụng,
   hành phi rắc dày, chan mắm chua ngọt. */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Dĩa bánh ướt chả lụa: tấm bánh mỏng nhăn nhàu xếp chồng, phủ lát chả lụa tròn, giá trụng và hành phi">
  <circle cx="260" cy="250" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="250" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <ellipse cx="260" cy="404" rx="200" ry="26" fill="rgba(15,26,14,.35)"/>

  <ellipse cx="260" cy="350" rx="206" ry="60" fill="#F0EADA"/>
  <ellipse cx="260" cy="344" rx="206" ry="60" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2"/>
  <ellipse cx="260" cy="344" rx="206" ry="60" fill="none" stroke="#2C5234" stroke-width="4"/>
  <ellipse cx="260" cy="346" rx="170" ry="46" fill="none" stroke="#E0A32E" stroke-width="2.4" stroke-dasharray="2 11" stroke-linecap="round"/>

  <!-- vũng nước mắm chua ngọt chan thẳng lên dĩa -->
  <ellipse cx="258" cy="358" rx="150" ry="34" fill="#D89A3C" opacity=".42"/>

  <!-- TẤM BÁNH ƯỚT: rộng bản, mép nhăn nhàu, viền nhạt, xếp chồng hờ -->
  <path d="M108 316 C 128 292 178 280 244 278 C 316 276 372 286 400 306
           C 392 316 378 310 364 318 C 350 326 338 318 322 326 C 306 334 292 326 276 334
           C 260 342 246 334 230 340 C 214 346 200 338 184 342 C 168 346 152 338 138 336
           C 124 334 112 328 108 316 Z"
        fill="#FBF3DF" stroke="#E2D6B4" stroke-width="2.2"/>
  <path d="M136 306 C 168 292 232 286 296 290 C 340 293 372 300 390 308"
        fill="none" stroke="#EDE1C4" stroke-width="2.6"/>

  <path d="M96 340 C 120 314 180 300 254 298 C 330 296 392 308 424 330
           C 412 342 396 334 380 342 C 364 350 350 342 332 350 C 314 358 300 350 282 357
           C 264 364 250 356 232 362 C 214 368 198 360 180 362 C 160 364 140 358 126 352
           C 112 346 100 344 96 340 Z"
        fill="#FEFAF0" stroke="#E2D6B4" stroke-width="2.4"/>
  <g fill="none" stroke="#EDE1C4" stroke-width="2.4">
    <path d="M124 336 C 164 318 236 310 306 314 C 358 317 396 326 414 334"/>
    <path d="M144 350 C 186 334 248 328 312 332 C 356 335 388 342 404 348"/>
  </g>
  <!-- nếp nhăn mềm chạy dọc tấm bánh -->
  <g fill="none" stroke="#E6D9B8" stroke-width="2" stroke-linecap="round">
    <path d="M176 300 C 172 318 174 336 180 352"/>
    <path d="M238 294 C 234 314 236 336 242 356"/>
    <path d="M300 296 C 298 316 300 336 306 354"/>
    <path d="M356 304 C 356 322 358 338 362 350"/>
  </g>
  <g stroke="#FFFFFF" stroke-width="3" stroke-linecap="round" opacity=".6">
    <path d="M204 312 L 194 328"/><path d="M270 308 L 260 324"/><path d="M330 314 L 320 330"/>
  </g>

  <!-- LÁT CHẢ LỤA: đĩa tròn hồng nhạt, mặt có lỗ khí li ti -->
  <g>
    <g transform="translate(168 314) rotate(-14)">
      <ellipse cx="0" cy="0" rx="30" ry="16" fill="#F2C4B2" stroke="#B4715A" stroke-width="2.8"/>
      <ellipse cx="0" cy="-2" rx="22" ry="10" fill="#F9DCCE"/>
      <g fill="#E0AE9A"><circle cx="-8" cy="0" r="2.2"/><circle cx="6" cy="3" r="2"/><circle cx="12" cy="-3" r="1.8"/></g>
    </g>
    <g transform="translate(252 302) rotate(6)">
      <ellipse cx="0" cy="0" rx="32" ry="17" fill="#F4C7B6" stroke="#B4715A" stroke-width="2.8"/>
      <ellipse cx="0" cy="-2" rx="23" ry="11" fill="#FBE2D6"/>
      <g fill="#E0AE9A"><circle cx="-10" cy="2" r="2.2"/><circle cx="4" cy="-3" r="2.3"/><circle cx="14" cy="3" r="1.9"/></g>
    </g>
    <g transform="translate(340 314) rotate(-6)">
      <ellipse cx="0" cy="0" rx="29" ry="15.5" fill="#F2C4B2" stroke="#B4715A" stroke-width="2.8"/>
      <ellipse cx="0" cy="-2" rx="21" ry="10" fill="#F9DCCE"/>
      <g fill="#E0AE9A"><circle cx="-8" cy="2" r="2.1"/><circle cx="7" cy="-2" r="2"/></g>
    </g>
    <g transform="translate(210 348) rotate(12)">
      <ellipse cx="0" cy="0" rx="27" ry="14" fill="#EAAF9B" stroke="#B4715A" stroke-width="2.8"/>
      <ellipse cx="0" cy="-2" rx="19" ry="9" fill="#F7D6C6"/>
    </g>
    <g transform="translate(306 352) rotate(-10)">
      <ellipse cx="0" cy="0" rx="26" ry="13.5" fill="#EAAF9B" stroke="#B4715A" stroke-width="2.8"/>
      <ellipse cx="0" cy="-2" rx="18" ry="8.6" fill="#F7D6C6"/>
    </g>
  </g>

  <!-- GIÁ TRỤNG: cọng trắng cong có đầu mầm -->
  <g>
    <g stroke="#F4F0E2" stroke-width="4.6" stroke-linecap="round" fill="none">
      <path d="M140 330 C 158 322 174 324 188 334"/>
      <path d="M368 328 C 384 320 398 322 410 332"/>
      <path d="M244 336 C 262 328 278 330 292 340"/>
      <path d="M158 358 C 176 350 192 352 206 362"/>
    </g>
    <g fill="#E8D9A8">
      <circle cx="139" cy="330" r="3.6"/><circle cx="367" cy="328" r="3.6"/><circle cx="243" cy="336" r="3.4"/><circle cx="157" cy="358" r="3.4"/>
    </g>
  </g>

  <!-- RAU THƠM xé + HÀNH PHI rắc dày -->
  <g fill="#6F9C48">
    <ellipse cx="152" cy="298" rx="6.4" ry="3.8" transform="rotate(-26 152 298)"/>
    <ellipse cx="298" cy="288" rx="6" ry="3.6" transform="rotate(18 298 288)"/>
    <ellipse cx="382" cy="342" rx="6.2" ry="3.7" transform="rotate(-10 382 342)"/>
    <ellipse cx="238" cy="368" rx="5.8" ry="3.4" transform="rotate(24 238 368)"/>
  </g>
  <g fill="#E3A544" stroke="#AE7124" stroke-width="1.3">
    <path d="M186 292 c 7 -6 16 -6 21 0 c -7 5 -15 5 -21 0 z"/>
    <path d="M244 284 c 7 -6 16 -6 21 0 c -7 5 -15 5 -21 0 z"/>
    <path d="M312 292 c 7 -6 16 -6 21 0 c -7 5 -15 5 -21 0 z"/>
    <path d="M366 306 c 7 -6 16 -6 21 0 c -7 5 -15 5 -21 0 z"/>
    <path d="M138 314 c 7 -6 16 -6 21 0 c -7 5 -15 5 -21 0 z"/>
    <path d="M276 330 c 7 -6 16 -6 21 0 c -7 5 -15 5 -21 0 z"/>
    <path d="M198 326 c 7 -6 16 -6 21 0 c -7 5 -15 5 -21 0 z"/>
    <path d="M348 340 c 7 -6 16 -6 21 0 c -7 5 -15 5 -21 0 z"/>
    <path d="M262 366 c 7 -6 16 -6 21 0 c -7 5 -15 5 -21 0 z"/>
  </g>

  <!-- lát ớt đỏ nổi trong nước mắm -->
  <g fill="none" stroke="#C0392B" stroke-width="3.4">
    <circle cx="148" cy="368" r="4.6"/><circle cx="356" cy="366" r="4"/>
  </g>

  <!-- đôi đũa gác mép dĩa -->
  <g transform="rotate(-14 420 254)">
    <rect x="330" y="222" width="176" height="8" rx="4" fill="#9A6538"/>
    <rect x="336" y="235" width="176" height="8" rx="4" fill="#8A5730"/>
  </g>
</svg>
