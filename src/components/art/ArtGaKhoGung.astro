---
/* Gà kho gừng — nồi đất sậm nhất nhà kho: đùi gà dáng giọt nước lộ khúc xương hai mấu,
   miếng chặt góc cạnh da vàng óng, gừng sợi rải chéo; củ gừng phân nhánh + muỗng gỗ */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Nồi gà kho gừng da vàng óng, gừng sợi thơm, củ gừng để bên">
  <defs>
    <linearGradient id="gkBody" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#7E4E27"/><stop offset="1" stop-color="#4A2C12"/>
    </linearGradient>
    <linearGradient id="gkSauce" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#D9913C"/><stop offset="1" stop-color="#A8641C"/>
    </linearGradient>
    <linearGradient id="gkGa" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#C97F2E"/><stop offset="1" stop-color="#9A5518"/>
    </linearGradient>
  </defs>
  <circle cx="260" cy="240" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="240" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <g class="steam">
    <path d="M228 210 C 217 186 243 170 232 144 C 225 128 239 116 235 102"/>
    <path d="M292 206 C 282 182 308 168 297 142 C 290 126 304 114 300 98"/>
  </g>
  <ellipse cx="260" cy="424" rx="188" ry="24" fill="rgba(15,26,14,.35)"/>

  <!-- nồi đất men sậm -->
  <path d="M92 262 C 96 356 168 416 260 416 C 352 416 424 356 428 262 Z" fill="url(#gkBody)"/>
  <ellipse cx="260" cy="262" rx="168" ry="38" fill="#3E2410"/>
  <ellipse cx="260" cy="258" rx="150" ry="31" fill="url(#gkSauce)"/>
  <path d="M88 258 q-26 -6 -30 -26" fill="none" stroke="#5E3A1B" stroke-width="16" stroke-linecap="round"/>
  <path d="M432 258 q26 -6 30 -26" fill="none" stroke="#5E3A1B" stroke-width="16" stroke-linecap="round"/>
  <path d="M120 320 C 170 342 350 342 400 320" fill="none" stroke="#3E2410" stroke-width="6" stroke-linecap="round" opacity=".8"/>
  <path d="M108 292 C 165 316 355 316 412 292" fill="none" stroke="#E0A32E" stroke-width="3" stroke-dasharray="2 12" stroke-linecap="round" opacity=".8"/>
  <path d="M136 342 C 176 362 240 370 262 370" fill="none" stroke="#96612F" stroke-width="5" stroke-linecap="round" opacity=".45"/>

  <!-- ĐÙI GÀ kho: thân giọt nước thon về khớp, khúc xương trắng hai mấu chìa lên -->
  <g transform="rotate(-6 200 248)">
    <!-- xương vẽ trước, thân đè lên gốc xương -->
    <path d="M226 230 L 248 208" stroke="#F6EFD8" stroke-width="9" stroke-linecap="round"/>
    <circle cx="254" cy="200" r="7" fill="#F6EFD8" stroke="#D8C8A8" stroke-width="1.8"/>
    <circle cx="259" cy="211" r="6.2" fill="#F6EFD8" stroke="#D8C8A8" stroke-width="1.8"/>
    <path d="M218 208
             C 228 214 231 226 225 236
             C 220 244 212 248 204 248
             C 198 260 182 266 166 264
             C 144 261 130 248 130 231
             C 130 212 145 199 167 196
             C 187 193 206 198 218 208 Z"
          fill="url(#gkGa)" stroke="#7A3A10" stroke-width="2.7"/>
    <path d="M145 207 C 156 200 172 196 187 198 C 200 200 211 205 217 212 L 210 217 C 203 209 193 205 182 204 C 168 203 155 206 148 212 Z" fill="#F2C27E"/>
    <path d="M134 240 C 140 250 152 257 166 259 C 152 261 138 254 131 243 Z" fill="#7A3A10" opacity=".7"/>
    <path d="M156 230 q10 8 22 5 M182 240 q10 5 20 1" fill="none" stroke="#B96F2C" stroke-width="2.4" stroke-linecap="round"/>
  </g>

  <!-- miếng gà chặt góc cạnh -->
  <g transform="rotate(6 330 246)">
    <path d="M298 240 L 314 222
             C 319 216 330 214 338 218 L 354 226
             C 361 230 363 239 358 246 L 346 260
             C 340 267 328 269 318 264 L 304 256
             C 297 251 294 245 298 240 Z"
          fill="url(#gkGa)" stroke="#7A3A10" stroke-width="2.5"/>
    <path d="M306 231 L 318 219 C 323 214 332 213 339 216 L 351 223 L 347 229 L 336 223 C 330 220 323 221 319 225 L 309 235 Z" fill="#F2C27E"/>
    <path d="M348 254 C 344 260 336 264 328 264 C 337 266 346 262 351 256 Z" fill="#7A3A10" opacity=".65"/>
    <path d="M316 244 q9 6 19 3" fill="none" stroke="#B96F2C" stroke-width="2.4" stroke-linecap="round"/>
  </g>
  <!-- miếng nhỏ phía trước ngập nước kho -->
  <g transform="rotate(-4 262 274)">
    <path d="M240 272
             C 239 264 246 258 258 256
             C 270 254 281 258 283 266
             C 284 274 276 280 264 282
             C 252 283 241 280 240 272 Z"
          fill="#BE7429" stroke="#7A3A10" stroke-width="2.3"/>
    <path d="M246 264 C 252 259 260 256 267 257 C 273 258 279 261 281 265 L 277 268 C 273 263 267 261 261 261 C 255 261 249 263 247 267 Z" fill="#F2C27E" opacity=".85"/>
  </g>

  <!-- gừng sợi rải thành nhúm xòe nhẹ -->
  <g stroke="#F5D98E" stroke-width="4" stroke-linecap="round" fill="none">
    <path d="M160 224 l20 -7 M172 232 l21 -5 M186 222 l19 -4 M312 232 l18 -6 M326 240 l17 -4 M240 260 l17 -5 M254 266 l16 -4"/>
  </g>
  <g stroke="#E0B45C" stroke-width="3" stroke-linecap="round" fill="none">
    <path d="M168 240 l16 -4 M322 248 l14 -4 M262 258 l13 -3 M344 236 l13 -4 M200 230 l14 -4"/>
  </g>
  <!-- gừng lát -->
  <g transform="rotate(-10 146 258)">
    <ellipse cx="146" cy="258" rx="12.5" ry="8" fill="#F2DA9A" stroke="#C9A050" stroke-width="1.8"/>
    <ellipse cx="146" cy="258" rx="6.8" ry="4" fill="none" stroke="#D9B36A" stroke-width="1.3"/>
  </g>
  <g transform="rotate(12 380 260)">
    <ellipse cx="380" cy="260" rx="11" ry="7" fill="#F2DA9A" stroke="#C9A050" stroke-width="1.8"/>
    <ellipse cx="380" cy="260" rx="5.8" ry="3.4" fill="none" stroke="#D9B36A" stroke-width="1.3"/>
  </g>

  <!-- ớt nguyên trái + hành lá + bong bóng kho + tiêu -->
  <path d="M276 238 C 288 234 300 236 306 230" fill="none" stroke="#C0392B" stroke-width="6.5" stroke-linecap="round"/>
  <path d="M212 268 q10 -5 20 -3" fill="none" stroke="#7FA95B" stroke-width="4" stroke-linecap="round"/>
  <g fill="#F2CD8C" opacity=".9">
    <circle cx="132" cy="246" r="3.8"/><circle cx="266" cy="244" r="3"/><circle cx="398" cy="268" r="3.4"/>
  </g>
  <g fill="#2E2318">
    <circle cx="198" cy="262" r="2"/><circle cx="294" cy="262" r="2"/><circle cx="350" cy="234" r="2"/>
  </g>

  <!-- củ gừng phân nhánh sâu + nhánh hành trên bàn trái -->
  <g transform="translate(96 396) rotate(-4)">
    <path d="M-44 6
             C -49 -4 -42 -12 -32 -11
             C -36 -24 -27 -34 -17 -28
             C -15 -22 -16 -16 -20 -10
             C -12 -16 -8 -24 -8 -32
             C -7 -44 6 -47 11 -38
             C 14 -31 11 -22 4 -12
             C 13 -18 20 -26 25 -34
             C 31 -43 43 -38 42 -28
             C 41 -20 33 -12 24 -7
             C 32 -7 37 -1 33 5
             C 27 13 11 15 1 11
             C -8 17 -28 17 -36 11
             C -41 11 -43 8 -44 6 Z"
          fill="#DDB76B" stroke="#A8874A" stroke-width="2.5"/>
    <path d="M-30 -16 q5 -2 9 0 M-12 -36 q5 -2 9 0 M28 -30 q4 -3 8 -1 M-24 0 q7 -3 13 -1 M8 -2 q7 -3 13 0 M20 -14 q5 -3 9 -1"
          fill="none" stroke="#B89552" stroke-width="1.6" stroke-linecap="round"/>
    <ellipse cx="8" cy="-40" rx="4.6" ry="5.6" fill="#F2DA9A" stroke="#C9A050" stroke-width="1.6" transform="rotate(-12 8 -40)"/>
  </g>
  <path d="M142 420 q16 -9 32 -7" fill="none" stroke="#7FA95B" stroke-width="5" stroke-linecap="round"/>

  <!-- muỗng gỗ trên bàn phải -->
  <g transform="translate(376 400) rotate(-16)">
    <rect x="14" y="1" width="94" height="8.5" rx="4.2" fill="#C9973F" stroke="#96702E" stroke-width="1.8"/>
    <ellipse cx="4" cy="5" rx="19" ry="12.5" fill="#D9B36A" stroke="#96702E" stroke-width="1.8"/>
    <ellipse cx="4" cy="4.4" rx="11" ry="6.5" fill="#B98E3C"/>
  </g>
</svg>
