---
/* Tô canh khổ qua nhồi thịt — minh họa riêng: khoanh khổ qua gờ sần, nước canh thanh */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Tô canh khổ qua nhồi thịt">
  <defs>
    <linearGradient id="kqBroth" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#E2E4AC"/><stop offset="1" stop-color="#C2CC86"/>
    </linearGradient>
    <linearGradient id="kqBowl" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#FDFAF0"/><stop offset="1" stop-color="#E9E2CC"/>
    </linearGradient>
    <linearGradient id="kqPod" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#6F9C48"/><stop offset="1" stop-color="#4E7B36"/>
    </linearGradient>
  </defs>
  <circle cx="260" cy="240" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="240" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <g class="steam">
    <path d="M215 236 C 204 210 230 194 219 166 C 212 148 226 136 222 120"/>
    <path d="M292 232 C 282 206 308 192 297 164 C 290 146 304 134 300 118"/>
  </g>
  <ellipse cx="255" cy="420" rx="196" ry="24" fill="rgba(15,26,14,.35)"/>

  <!-- tô -->
  <path d="M67 296 C 73 370 157 414 255 414 C 353 414 437 370 443 296 Z" fill="url(#kqBowl)"/>
  <ellipse cx="255" cy="412" rx="62" ry="11" fill="#D8D0B6"/>
  <ellipse cx="255" cy="294" rx="188" ry="46" fill="#F6F1E1"/>
  <ellipse cx="255" cy="294" rx="188" ry="46" fill="none" stroke="#2C5234" stroke-width="5"/>
  <ellipse cx="255" cy="295" rx="174" ry="40" fill="none" stroke="#E0A32E" stroke-width="2.5" stroke-dasharray="2 11" stroke-linecap="round"/>

  <!-- nước canh thanh trong -->
  <ellipse cx="255" cy="297" rx="158" ry="33" fill="url(#kqBroth)"/>
  <ellipse cx="205" cy="290" rx="58" ry="10" fill="#EFF0C4" opacity=".6"/>

  <!-- khoanh khổ qua lớn (nhìn nghiêng): viền gờ sần + nhân thịt -->
  <g transform="translate(186 296)">
    <!-- gờ sần quanh viền -->
    <g fill="#5C8A3C" stroke="#46702C" stroke-width="1.6">
      <circle cx="-46" cy="-4" r="5"/><circle cx="-38" cy="-12" r="5"/><circle cx="-24" cy="-17" r="5"/>
      <circle cx="-8" cy="-19" r="5"/><circle cx="8" cy="-19" r="5"/><circle cx="24" cy="-17" r="5"/>
      <circle cx="38" cy="-12" r="5"/><circle cx="46" cy="-4" r="5"/><circle cx="40" cy="6" r="5"/>
      <circle cx="26" cy="12" r="5"/><circle cx="8" cy="15" r="5"/><circle cx="-10" cy="15" r="5"/>
      <circle cx="-28" cy="11" r="5"/><circle cx="-42" cy="5" r="5"/>
    </g>
    <ellipse cx="0" cy="-2" rx="46" ry="17" fill="#5C8A3C" stroke="#46702C" stroke-width="2.4"/>
    <ellipse cx="0" cy="-2" rx="35" ry="12.5" fill="#9CB25C"/>
    <!-- nhân thịt -->
    <ellipse cx="0" cy="-2" rx="26" ry="9" fill="#E8C9A0" stroke="#C9A06E" stroke-width="2"/>
    <g fill="#B87A4E"><circle cx="-10" cy="-4" r="2.4"/><circle cx="4" cy="-1" r="2.2"/><circle cx="14" cy="-5" r="2"/></g>
    <g fill="#2E2318"><circle cx="-3" cy="-6" r="1.4"/><circle cx="9" cy="1" r="1.3"/></g>
    <path d="M-16 2 q8 3 16 1" fill="none" stroke="#F3E3C3" stroke-width="2" stroke-linecap="round"/>
  </g>

  <!-- khoanh nhỏ hơn bên phải -->
  <g transform="translate(322 300) rotate(6) scale(.78)">
    <g fill="#5C8A3C" stroke="#46702C" stroke-width="1.6">
      <circle cx="-46" cy="-4" r="5"/><circle cx="-36" cy="-13" r="5"/><circle cx="-20" cy="-18" r="5"/>
      <circle cx="-2" cy="-19" r="5"/><circle cx="16" cy="-18" r="5"/><circle cx="32" cy="-14" r="5"/>
      <circle cx="44" cy="-6" r="5"/><circle cx="40" cy="6" r="5"/><circle cx="24" cy="12" r="5"/>
      <circle cx="4" cy="15" r="5"/><circle cx="-16" cy="14" r="5"/><circle cx="-36" cy="8" r="5"/>
    </g>
    <ellipse cx="0" cy="-2" rx="46" ry="17" fill="#5C8A3C" stroke="#46702C" stroke-width="2.4"/>
    <ellipse cx="0" cy="-2" rx="35" ry="12.5" fill="#9CB25C"/>
    <ellipse cx="0" cy="-2" rx="26" ry="9" fill="#E8C9A0" stroke="#C9A06E" stroke-width="2"/>
    <g fill="#B87A4E"><circle cx="-8" cy="-4" r="2.4"/><circle cx="8" cy="-1" r="2.2"/></g>
    <g fill="#2E2318"><circle cx="1" cy="-6" r="1.4"/></g>
  </g>

  <!-- khoanh thứ ba nhỏ phía sau -->
  <g transform="translate(258 278) rotate(-4) scale(.6)">
    <g fill="#5C8A3C" stroke="#46702C" stroke-width="1.6">
      <circle cx="-44" cy="-6" r="5"/><circle cx="-30" cy="-14" r="5"/><circle cx="-12" cy="-18" r="5"/>
      <circle cx="8" cy="-18" r="5"/><circle cx="26" cy="-15" r="5"/><circle cx="42" cy="-8" r="5"/>
      <circle cx="44" cy="4" r="5"/><circle cx="28" cy="11" r="5"/><circle cx="8" cy="14" r="5"/>
      <circle cx="-14" cy="13" r="5"/><circle cx="-34" cy="8" r="5"/>
    </g>
    <ellipse cx="0" cy="-2" rx="46" ry="17" fill="#5C8A3C" stroke="#46702C" stroke-width="2.4"/>
    <ellipse cx="0" cy="-2" rx="35" ry="12.5" fill="#9CB25C"/>
    <ellipse cx="0" cy="-2" rx="26" ry="9" fill="#E8C9A0" stroke="#C9A06E" stroke-width="2"/>
    <g fill="#B87A4E"><circle cx="-8" cy="-4" r="2.4"/><circle cx="8" cy="-1" r="2.2"/></g>
  </g>

  <!-- hành ngò rắc mặt -->
  <g stroke="#6F9C48" stroke-width="3.6" stroke-linecap="round" fill="none">
    <path d="M150 288 l12 -3 M128 302 l11 -2 M382 296 l11 -3 M356 286 l10 -2"/>
  </g>
  <g fill="#2E2318"><circle cx="142" cy="296" r="1.8"/><circle cx="368" cy="302" r="1.8"/><circle cx="252" cy="316" r="1.8"/></g>

  <!-- đôi đũa gác -->
  <g transform="rotate(-16 428 240)">
    <rect x="338" y="212" width="170" height="8" rx="4" fill="#9A6538"/>
    <rect x="344" y="225" width="170" height="8" rx="4" fill="#8A5730"/>
  </g>

  <!-- trái khổ qua tươi trên bàn: sần sùi hai đầu nhọn -->
  <g transform="translate(352 384) rotate(-10)">
    <ellipse cx="62" cy="36" rx="76" ry="12" fill="rgba(15,26,14,.3)"/>
    <path d="M-6 14 C 8 -2 34 -10 62 -10 C 90 -10 116 -2 130 14 C 116 30 90 38 62 38 C 34 38 8 30 -6 14 Z" fill="url(#kqPod)" stroke="#46702C" stroke-width="2.5"/>
    <!-- gờ sần dọc trái -->
    <path d="M8 6 q54 -14 108 0 M4 22 q58 12 116 0 M22 -2 q40 -8 80 0 M22 30 q40 8 80 0" fill="none" stroke="#7BA04D" stroke-width="3.4" stroke-linecap="round"/>
    <!-- mụt sần -->
    <g fill="#8FB868" stroke="#46702C" stroke-width="1">
      <circle cx="26" cy="6" r="3.2"/><circle cx="50" cy="-3" r="3.2"/><circle cx="78" cy="0" r="3.2"/><circle cx="104" cy="8" r="3"/>
      <circle cx="34" cy="20" r="3"/><circle cx="62" cy="26" r="3.2"/><circle cx="92" cy="22" r="3"/><circle cx="114" cy="16" r="2.8"/>
      <circle cx="14" cy="14" r="2.8"/><circle cx="66" cy="12" r="3"/>
    </g>
    <!-- cuống xoăn -->
    <path d="M128 12 q12 -4 14 -12 q1 -6 -4 -8" fill="none" stroke="#4E7B36" stroke-width="4" stroke-linecap="round"/>
    <ellipse cx="-4" cy="14" rx="5" ry="7" fill="#46702C"/>
  </g>

  <!-- chén nước mắm + hành lá bên bàn -->
  <g>
    <ellipse cx="92" cy="396" rx="40" ry="13" fill="rgba(15,26,14,.3)"/>
    <path d="M58 380 C 60 399 73 409 92 409 C 111 409 124 399 126 380 Z" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2"/>
    <ellipse cx="92" cy="380" rx="34" ry="10" fill="#B3591E"/>
    <circle cx="84" cy="378" r="2.8" fill="#C0392B"/><circle cx="101" cy="381" r="2.4" fill="#C0392B"/>
  </g>
  <g stroke="#7FA95B" stroke-width="5" stroke-linecap="round" fill="none">
    <path d="M146 408 q16 -8 32 -6"/>
    <path d="M42 416 q18 -6 36 -3"/>
  </g>
</svg>
