---
/* Bún sứa Nha Trang — tô nguyên vẹn, cân giữa khung, dùng khuôn quen của họ.

   BẢN 2 (CẮT CẬN) BỊ THÁI TRẢ LẠI: cho tô tràn khỏi khung để miếng sứa to hơn.
   Ở khung vuông thì nó KHÔNG đọc ra "chụp cận" mà đọc ra "hình bị vạt mất một
   bên" — nhất là khi mép trái bị cắt còn mép phải thì không. Luật rút ra: cắt
   cận chỉ hoạt động khi cắt ĐỀU và người xem có chỗ tựa để hiểu đó là chủ ý;
   trong một ô thumbnail 260px không viền thì không có chỗ tựa nào.

   BẢN 1 BỊ BỎ: vẽ tô nhìn gần ngang mặt bàn, đống đồ nhô lên trên vành — hoá ra
   mấy dải sứa trắng TÁCH RỜI khỏi đống, nổi trên nền teal thành ra như mấy cái
   lông chim bay, còn lòng tô thì trắng rỗng. Đúng luật cũ của repo: món ăn phải
   là MỘT KHỐI, miếng nào cũng chồng mép lên miếng khác.

   CHỮ KÝ nhận dạng, cố ý vẽ lệch hẳn bún chả cá (cùng nồi nước cá, cùng miền Trung):
   1) DẢI SỨA: khối DÀY có lộ bề dày ở cạnh dưới, mép lượn sóng lam nham, TRONG
      MỜ để lớp rau xanh dưới ló qua.
      BẢN 2 TÔ TRẮNG XANH LẠNH và xếp gần thẳng hàng → đọc ra CỤC ĐÁ LẠNH. Chữa
      bằng ba việc: đổi sắc sang TRẮNG NGÀ ẤM (bỏ ánh xanh), hạ độ đục để thấy
      rõ thứ bên dưới, và XOAY LỆCH MẠNH cho hết thế xếp hàng đều
   2) chỉ có chả cá HẤP TRẮNG, KHÔNG có lát chả chiên vàng — chả chiên vàng là
      chữ ký của bún chả cá, không mượn
   3) RAU SỐNG THÁI NHỎ sẫm màu chèn giữa các khối, vừa đúng lối bày của hàng
      bún ở đây vừa làm nền sẫm đỡ đống trắng
   4) đạo cụ: DĨA RAU SỐNG THÁI NHỎ vun đống — đúng lối bày của hàng bún ở đây,
      và cố ý KHÔNG dùng chén mắm ruốc + ớt của bún chả cá dù ngoài đời có
   id prefix "bsua" */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Tô bún sứa Nha Trang cắt cận: những dải sứa chân trắng xám dày mép lượn sóng nằm xen giữa các khối chả cá hấp trắng và rau sống thái nhỏ, trên nền nước lèo trong">
  <defs>
    <linearGradient id="bsuaBowl" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#FBF6E6"/><stop offset="1" stop-color="#D2C8AC"/>
    </linearGradient>
    <linearGradient id="bsuaBroth" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#F2E7C6"/><stop offset="1" stop-color="#DCCB9C"/>
    </linearGradient>
    <linearGradient id="bsuaCha" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#FCF2D8"/><stop offset="1" stop-color="#E0CD9E"/>
    </linearGradient>

    <!-- DẢI SỨA CHÂN: mặt trên lượn sóng + CẠNH DƯỚI lộ bề dày (đó là chỗ nói
         ra "miếng này dày và giòn", không phải một mảnh mỏng) -->
    <g id="bsuaMieng">
      <!-- thân miếng TRONG MỜ: fill nửa trong để lớp rau xanh bên dưới ló qua —
           đó mới là thứ nói ra "con sứa", chứ khối trắng đục thì ở 260px chỉ đọc
           ra HÒN SỎI (bản 2 dính đúng lỗi này). Mép dưới LƯỢN SÓNG nhiều nhịp,
           mép trên gãy góc lam nham; hai mép khác nhau hẳn để khỏi ra hình thoi. -->
      <path d="M-42 -4 C -36 -14 -26 -10 -18 -17 C -10 -23 0 -18 10 -22 C 20 -26 32 -22 41 -17
               C 47 -14 48 -6 44 -1
               C 40 5 33 1 28 7 C 23 13 15 8 10 13 C 5 18 -3 13 -9 18
               C -15 23 -23 18 -30 21 C -37 24 -45 14 -42 -4 Z"
            fill="#EFEEE2" opacity=".5" stroke="#7C8076" stroke-width="2.2" stroke-linejoin="round"/>
      <!-- cạnh dưới lộ BỀ DÀY, đục hơn thân: miếng này dày chứ không phải mảnh mỏng -->
      <path d="M-42 -4 C -40 10 -36 20 -30 21 C -23 18 -15 23 -9 18 C -3 13 5 18 10 13
               C 15 8 23 13 28 7 C 33 1 40 5 44 -1 C 44 4 41 9 36 12 C 30 16 24 13 19 17
               C 13 22 6 18 0 22 C -7 26 -15 23 -22 26 C -30 29 -40 22 -42 -4 Z"
            fill="#B6B4A2" opacity=".7"/>
      <path d="M-34 -4 C -26 -10 -16 -7 -8 -13 C 0 -19 10 -15 20 -19" fill="none" stroke="#FFFDF2" stroke-width="2.6" stroke-linecap="round" opacity=".7"/>
      <path d="M-24 4 C -16 -1 -8 1 0 -4" fill="none" stroke="#FFFDF2" stroke-width="1.6" stroke-linecap="round" opacity=".45"/>
    </g>

    <!-- KHỐI CHẢ CÁ HẤP: khối vuông kem ấm, lộ mặt cắt lấm tấm thì là -->
    <g id="bsuaCham">
      <path d="M-26 -16 L 24 -22 L 30 14 L -20 21 Z" fill="url(#bsuaCha)" stroke="#B3985F" stroke-width="2.4" stroke-linejoin="round"/>
      <path d="M24 -22 L 30 14 L 34 10 L 29 -25 Z" fill="#CDB57E" stroke="#B3985F" stroke-width="2" stroke-linejoin="round"/>
      <g fill="#7FA84E">
        <ellipse cx="-8" cy="-8" rx="5" ry="2.2" transform="rotate(-12 -8 -8)"/>
        <ellipse cx="12" cy="0" rx="4.4" ry="2" transform="rotate(10 12 0)"/>
        <ellipse cx="-4" cy="10" rx="4.6" ry="2" transform="rotate(-6 -4 10)"/>
      </g>
      <path d="M-22 -12 L 20 -18" fill="none" stroke="#FDF8E6" stroke-width="2" stroke-linecap="round" opacity=".8"/>
    </g>
  </defs>

  <circle cx="260" cy="240" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="240" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>

  <g class="steam">
    <path d="M170 178 C 160 154 184 140 174 114"/>
    <path d="M256 156 C 246 132 270 118 260 92"/>
    <path d="M348 180 C 338 156 362 142 352 116"/>
  </g>

  <!-- TÔ nguyên vẹn, cân giữa khung -->
  <ellipse cx="252" cy="418" rx="196" ry="23" fill="rgba(15,26,14,.35)"/>
  <path d="M86 290 C 92 372 166 414 252 414 C 338 414 412 372 418 290 Z" fill="url(#bsuaBowl)"/>
  <ellipse cx="252" cy="412" rx="56" ry="10" fill="#D0C6AA"/>
  <ellipse cx="252" cy="288" rx="170" ry="44" fill="#F7F2E2"/>
  <ellipse cx="252" cy="288" rx="170" ry="44" fill="none" stroke="#2C5234" stroke-width="5.4"/>
  <ellipse cx="252" cy="290" rx="154" ry="37" fill="none" stroke="#E0A32E" stroke-width="2.6" stroke-dasharray="2 11" stroke-linecap="round"/>

  <!-- NƯỚC LÈO trong -->
  <ellipse cx="252" cy="292" rx="144" ry="33" fill="url(#bsuaBroth)"/>
  <ellipse cx="182" cy="282" rx="50" ry="9" fill="#FAF3DC" opacity=".5"/>

  <!-- SỢI BÚN lộ ra ở hai rìa, dưới đống đồ -->
  <g fill="none" stroke="#FAF4E2" stroke-width="6" stroke-linecap="round">
    <path d="M124 292 C 154 280 190 279 218 287"/>
    <path d="M136 312 C 166 300 200 299 226 306"/>
    <path d="M296 312 C 328 300 364 299 392 306"/>
    <path d="M304 288 C 334 276 370 275 396 282"/>
  </g>
  <g fill="none" stroke="#CFC2A0" stroke-width="1.7" stroke-linecap="round" opacity=".85">
    <path d="M126 296 C 156 284 192 283 220 291"/>
    <path d="M298 316 C 330 304 366 303 394 310"/>
  </g>

  <!-- GIƯỜNG RAU SỐNG THÁI NHỎ: lớp sẫm nằm DƯỚI đống, chồng mép lên nhau -->
  <path d="M108 278 C 136 240 190 222 252 222 C 314 222 366 240 394 278
           C 366 300 138 300 108 278 Z" fill="#3B6830"/>
  <g fill="#5C8E3E">
    <ellipse cx="148" cy="268" rx="22" ry="7" transform="rotate(-12 148 268)"/>
    <ellipse cx="206" cy="248" rx="26" ry="7.6" transform="rotate(5 206 248)"/>
    <ellipse cx="284" cy="244" rx="24" ry="7" transform="rotate(-7 284 244)"/>
    <ellipse cx="348" cy="266" rx="22" ry="6.6" transform="rotate(11 348 266)"/>
    <ellipse cx="240" cy="278" rx="28" ry="7.4" transform="rotate(-3 240 278)"/>
    <ellipse cx="170" cy="286" rx="20" ry="6" transform="rotate(9 170 286)"/>
    <ellipse cx="322" cy="286" rx="20" ry="6" transform="rotate(-9 322 286)"/>
  </g>
  <g fill="#93C25E" opacity=".92">
    <ellipse cx="172" cy="256" rx="15" ry="4.6" transform="rotate(-17 172 256)"/>
    <ellipse cx="250" cy="238" rx="17" ry="4.8" transform="rotate(3 250 238)"/>
    <ellipse cx="322" cy="252" rx="14" ry="4.4" transform="rotate(13 322 252)"/>
    <ellipse cx="208" cy="284" rx="16" ry="4.6" transform="rotate(-5 208 284)"/>
    <ellipse cx="294" cy="274" rx="14" ry="4.2" transform="rotate(7 294 274)"/>
  </g>

  <!-- KHỐI CHẢ CÁ xen giữa — đặt trước để dải sứa chồng mép lên -->
  <use href="#bsuaCham" transform="translate(154 266) rotate(-8) scale(.94)"/>
  <use href="#bsuaCham" transform="translate(330 254) rotate(9) scale(.88)"/>
  <use href="#bsuaCham" transform="translate(246 284) rotate(-3) scale(.82)"/>

  <!-- DẢI SỨA: to, dày, CHỒNG MÉP lên chả cá và lên nhau — một khối liền -->
  <use href="#bsuaMieng" transform="translate(184 244) rotate(-26) scale(1.14)"/>
  <use href="#bsuaMieng" transform="translate(296 232) rotate(17) scale(.92)"/>
  <use href="#bsuaMieng" transform="translate(356 268) rotate(-8) scale(.72)"/>
  <use href="#bsuaMieng" transform="translate(244 276) rotate(6) scale(1)"/>
  <use href="#bsuaMieng" transform="translate(142 284) rotate(31) scale(.68)"/>

  <!-- hành ngò thái nhỏ rắc trên cùng -->
  <g fill="#3E7B3A">
    <ellipse cx="176" cy="238" rx="6" ry="2.6" transform="rotate(-14 176 238)"/>
    <ellipse cx="292" cy="226" rx="5.6" ry="2.4" transform="rotate(10 292 226)"/>
    <ellipse cx="234" cy="256" rx="5.4" ry="2.3" transform="rotate(-6 234 256)"/>
    <ellipse cx="340" cy="242" rx="5.2" ry="2.2" transform="rotate(18 340 242)"/>
    <ellipse cx="152" cy="280" rx="5.2" ry="2.2" transform="rotate(6 152 280)"/>
  </g>
  <g fill="#F4B368" opacity=".7">
    <circle cx="132" cy="296" r="3"/><circle cx="382" cy="292" r="2.6"/><circle cx="312" cy="300" r="2.4"/>
  </g>

  <!-- ĐẠO CỤ: DĨA RAU SỐNG THÁI SỢI. Bản trước vẽ thành một gò xanh nhẵn trên
       dĩa nhỏ — Thái không đọc ra là gì, tưởng chén nước chấm. Chữa bằng ba
       việc: phóng to dĩa, vẽ thành SỢI DÀI RIÊNG BIỆT thay vì một khối, và cho
       vài sợi THÒ HẲN RA NGOÀI mép dĩa (luật "dấu nhận diện nằm ở đường bao"). -->
  <g transform="translate(408 378)">
    <ellipse cx="0" cy="32" rx="82" ry="15" fill="rgba(15,26,14,.32)"/>
    <ellipse cx="0" cy="18" rx="78" ry="21" fill="#FDFAF0" stroke="#D2C9AC" stroke-width="2.4"/>
    <ellipse cx="0" cy="16" rx="60" ry="14" fill="#F2EAD4"/>
    <!-- sợi rau: dải dài mảnh, nhiều hướng, chồng chéo -->
    <g fill="none" stroke="#3E6B2E" stroke-width="5" stroke-linecap="round">
      <path d="M-64 14 C -40 2 -6 -2 26 4"/>
      <path d="M-50 22 C -22 12 14 10 46 16"/>
      <path d="M-30 4 C -6 -6 24 -8 52 -2"/>
      <path d="M-58 4 C -38 -6 -12 -10 10 -8"/>
      <path d="M-16 20 C 8 12 40 12 66 18"/>
    </g>
    <g fill="none" stroke="#6FA34A" stroke-width="3.4" stroke-linecap="round">
      <path d="M-60 12 C -36 0 -4 -4 28 2"/>
      <path d="M-46 20 C -18 10 18 8 48 14"/>
      <path d="M-26 2 C -2 -8 26 -10 54 -4"/>
    </g>
    <g fill="none" stroke="#A8D072" stroke-width="2.2" stroke-linecap="round">
      <path d="M-52 10 C -30 0 0 -3 28 1"/>
      <path d="M-20 17 C 4 9 32 8 56 13"/>
    </g>
    <!-- vài sợi thò hẳn ra ngoài mép dĩa -->
    <g fill="none" stroke="#4E7B36" stroke-width="4" stroke-linecap="round">
      <path d="M-64 14 C -74 12 -84 16 -90 22"/>
      <path d="M66 18 C 76 16 84 20 90 26"/>
      <path d="M52 -2 C 62 -6 72 -4 78 2"/>
    </g>
  </g>
</svg>
