---
/* Bánh ướt lòng gà Đà Lạt — VẼ LẠI vòng 3. Thái nói vòng 2 "giống tô cháo lòng
   quá": đúng — tôi vẽ tô SÂU có chân, đổ nước mắm loang thành vũng, mấy miếng
   lòng nổi lều bều. Nhìn đúng là tô cháo.
   Tra lại cách dọn thật: dùng ĐĨA SÂU LÒNG / TÔ NÔNG, bánh ướt nằm dưới, lòng
   gà xào + thịt gà xé + hành phi xếp lên trên, rắc tiêu — món KHÔ, không có
   nước lèo. Và chi tiết tôi bỏ sót ở hai vòng trước: **TRỨNG GÀ NON cắt đôi đặt
   trên cùng** — mấy viên tròn vàng cam đó chính là dấu nhận diện của bản Đà Lạt,
   không món nào khác trên site có.
   Nên vòng này: tô NÔNG bè ngang, bỏ hẳn vũng nước, tấm bánh ướt trắng lộ rõ ở
   mép trước, lòng gà xếp gọn ở giữa, và 3 viên trứng non vàng cam trên đỉnh. */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Đĩa sâu lòng bánh ướt lòng gà Đà Lạt: bánh ướt trắng, lòng gà xào, gà xé, trứng gà non vàng và rau răm">
  <circle cx="260" cy="250" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="250" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <g class="steam">
    <path d="M214 186 C 203 162 229 146 218 120 C 211 104 225 92 221 78"/>
    <path d="M306 182 C 296 158 322 144 311 118 C 304 102 318 90 314 76"/>
  </g>
  <ellipse cx="260" cy="410" rx="196" ry="26" fill="rgba(15,26,14,.35)"/>

  <!-- ĐĨA SÂU LÒNG: bè ngang, lòng nông (không phải tô sâu có chân) -->
  <ellipse cx="260" cy="368" rx="200" ry="52" fill="#EDE6D4"/>
  <path d="M60 318 C 66 356 148 386 260 386 C 372 386 454 356 460 318 Z" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="3"/>
  <ellipse cx="260" cy="318" rx="200" ry="54" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="3"/>
  <ellipse cx="260" cy="318" rx="200" ry="54" fill="none" stroke="#2C5234" stroke-width="4"/>
  <ellipse cx="260" cy="322" rx="164" ry="42" fill="#F6F1E1" stroke="#DCD3BC" stroke-width="2.4"/>
  <ellipse cx="260" cy="324" rx="142" ry="34" fill="none" stroke="#E0A32E" stroke-width="2.2" stroke-dasharray="2 11" stroke-linecap="round"/>

  <!-- LỚP BÁNH ƯỚT: tấm mỏng nhăn, trắng, lộ rõ suốt mép trước của đĩa -->
  <path d="M124 306 C 142 288 192 278 258 278 C 326 278 376 288 394 306
           C 384 316 370 310 356 318 C 342 326 330 318 314 326 C 298 334 284 326 268 333
           C 252 340 238 332 222 338 C 206 344 192 336 176 338 C 158 340 134 322 124 306 Z"
        fill="#FBF3DF" stroke="#E2D6B4" stroke-width="2.4"/>
  <path d="M148 298 C 182 286 244 280 306 284 C 348 287 378 294 392 302" fill="none" stroke="#EDE1C4" stroke-width="2.6"/>
  <g fill="none" stroke="#E6D9B8" stroke-width="2" stroke-linecap="round">
    <path d="M186 284 C 182 300 184 318 190 334"/>
    <path d="M254 280 C 250 298 252 318 258 336"/>
    <path d="M322 284 C 320 300 322 316 328 330"/>
  </g>

  <!-- THỊT GÀ XÉ: sợi trắng ngà nằm lớp giữa -->
  <g fill="#F4E6C6" stroke="#C7A65E" stroke-width="1.8" stroke-linejoin="round">
    <path d="M158 296 C 186 288 214 288 234 294 L 232 303 C 210 297 184 297 158 305 Z"/>
    <path d="M262 288 C 290 280 318 280 338 286 L 336 295 C 314 289 288 289 262 297 Z"/>
    <path d="M196 316 C 222 308 250 308 270 314 L 268 323 C 246 317 220 317 196 325 Z"/>
    <path d="M300 312 C 324 304 350 304 368 310 L 366 319 C 346 313 322 313 300 321 Z"/>
  </g>

  <!-- LÒNG GÀ XÀO xếp gọn ở giữa, không rải lều bều -->
  <!-- mề: lát vòng cung dày, có rãnh khía -->
  <g transform="translate(196 288) rotate(-12)">
    <path d="M-24 4 C -24 -14 -10 -24 6 -24 C 22 -24 34 -14 34 2 C 34 12 26 18 16 16 C 20 6 16 -4 6 -6 C -6 -8 -12 2 -10 12 C -18 14 -24 12 -24 4 Z"
          fill="#A5674A" stroke="#6B3A22" stroke-width="2.6"/>
    <path d="M-16 2 C -14 -10 -4 -17 6 -16" fill="none" stroke="#C98D6C" stroke-width="2.6" stroke-linecap="round"/>
  </g>
  <g transform="translate(312 282) rotate(14)">
    <path d="M-23 4 C -23 -13 -10 -23 5 -23 C 21 -23 32 -13 32 2 C 32 11 25 17 15 15 C 19 6 15 -3 5 -5 C -6 -7 -11 2 -9 11 C -17 13 -23 11 -23 4 Z"
          fill="#B47353" stroke="#6B3A22" stroke-width="2.6"/>
    <path d="M-15 2 C -13 -9 -4 -16 5 -15" fill="none" stroke="#D19A79" stroke-width="2.6" stroke-linecap="round"/>
  </g>
  <!-- gan: khối dày nâu sẫm -->
  <g transform="translate(252 300) rotate(-6)">
    <path d="M-26 2 C -28 -14 -14 -24 4 -22 C 22 -20 32 -8 30 6 C 28 20 12 26 -4 22 C -18 18 -25 12 -26 2 Z"
          fill="#6E3A34" stroke="#42201C" stroke-width="2.6"/>
    <path d="M-16 -4 C -10 -14 4 -17 14 -12" fill="none" stroke="#96574E" stroke-width="3.4" stroke-linecap="round"/>
  </g>
  <g transform="translate(358 306) rotate(12)">
    <path d="M-22 2 C -24 -12 -12 -20 4 -18 C 18 -16 27 -6 25 5 C 23 17 10 22 -4 18 C -16 15 -21 10 -22 2 Z"
          fill="#7A423B" stroke="#42201C" stroke-width="2.6"/>
    <path d="M-14 -4 C -8 -12 3 -15 12 -10" fill="none" stroke="#A26056" stroke-width="3" stroke-linecap="round"/>
  </g>
  <!-- tim + ruột non -->
  <g transform="translate(158 318) rotate(-16)">
    <path d="M0 -13 C 9 -13 14 -6 14 2 C 14 11 7 17 0 17 C -7 17 -14 11 -14 2 C -14 -6 -9 -13 0 -13 Z" fill="#8E4238" stroke="#4E241E" stroke-width="2.4"/>
    <path d="M-6 -6 C -2 -9 4 -9 7 -6" fill="none" stroke="#B0655A" stroke-width="2.4" stroke-linecap="round"/>
  </g>
  <g transform="translate(298 328) rotate(-20)">
    <rect x="-15" y="-8" width="30" height="16" rx="8" fill="#E7D6B4" stroke="#B08F52" stroke-width="2.4"/>
    <ellipse cx="13" cy="0" rx="4" ry="6" fill="#C6A970" stroke="#B08F52" stroke-width="1.6"/>
  </g>
  <g transform="translate(212 330) rotate(16)">
    <rect x="-14" y="-7.5" width="28" height="15" rx="7.5" fill="#EFDFBE" stroke="#B08F52" stroke-width="2.4"/>
    <ellipse cx="12" cy="0" rx="3.6" ry="5.6" fill="#C6A970" stroke="#B08F52" stroke-width="1.6"/>
  </g>

  <!-- TRỨNG GÀ NON: dấu nhận diện của bản Đà Lạt — viên tròn vàng cam trên đỉnh -->
  <g>
    <g transform="translate(232 264)">
      <circle cx="0" cy="0" r="21" fill="#E8A72A" stroke="#A9701A" stroke-width="2.8"/>
      <path d="M-13 -7 C -8 -14 4 -16 12 -11" fill="none" stroke="#F5CE72" stroke-width="4" stroke-linecap="round"/>
    </g>
    <g transform="translate(288 258)">
      <circle cx="0" cy="0" r="18" fill="#F0B63C" stroke="#A9701A" stroke-width="2.8"/>
      <path d="M-11 -6 C -7 -12 3 -14 10 -10" fill="none" stroke="#F9DA8E" stroke-width="3.6" stroke-linecap="round"/>
    </g>
    <g transform="translate(340 266)">
      <circle cx="0" cy="0" r="16" fill="#E8A72A" stroke="#A9701A" stroke-width="2.8"/>
      <path d="M-10 -5 C -6 -11 3 -12 9 -9" fill="none" stroke="#F5CE72" stroke-width="3.2" stroke-linecap="round"/>
    </g>
  </g>

  <!-- RAU RĂM thái nhỏ + HÀNH PHI + TIÊU rắc rộng tay -->
  <g fill="#4B7F32" stroke="#2F5622" stroke-width="1.3">
    <path d="M180 268 C 191 259 202 261 199 269 C 196 276 186 276 180 268 Z"/>
    <path d="M266 290 C 277 281 288 283 285 291 C 282 298 272 298 266 290 Z"/>
    <path d="M170 340 C 181 331 192 333 189 341 C 186 348 176 348 170 340 Z"/>
    <path d="M370 282 C 381 273 391 275 388 283 C 385 290 376 290 370 282 Z"/>
    <path d="M320 336 C 331 327 342 329 339 337 C 336 344 326 344 320 336 Z"/>
  </g>
  <g fill="#E3A544" stroke="#AE7124" stroke-width="1.2">
    <path d="M204 276 c 7 -6 16 -6 21 0 c -7 5 -15 5 -21 0 z"/>
    <path d="M306 296 c 7 -6 16 -6 21 0 c -7 5 -15 5 -21 0 z"/>
    <path d="M152 300 c 7 -6 16 -6 21 0 c -7 5 -15 5 -21 0 z"/>
    <path d="M262 318 c 7 -6 16 -6 21 0 c -7 5 -15 5 -21 0 z"/>
    <path d="M368 328 c 7 -6 16 -6 21 0 c -7 5 -15 5 -21 0 z"/>
  </g>
  <g fill="#2E2822">
    <circle cx="214" cy="304" r="2.3"/><circle cx="268" cy="276" r="2.1"/><circle cx="330" cy="300" r="2.3"/>
    <circle cx="180" cy="312" r="2"/><circle cx="248" cy="330" r="2.2"/><circle cx="376" cy="298" r="2"/>
    <circle cx="146" cy="322" r="1.9"/><circle cx="300" cy="262" r="2"/><circle cx="356" cy="326" r="1.9"/>
  </g>

  <!-- muỗng gác mép đĩa (ăn bằng muỗng) -->
  <g transform="rotate(26 402 250)">
    <rect x="394" y="210" width="12" height="104" rx="6" fill="#C9BFA6" stroke="#9E937A" stroke-width="2"/>
    <ellipse cx="400" cy="202" rx="20" ry="15" fill="#D8CFB8" stroke="#9E937A" stroke-width="2"/>
  </g>
</svg>
