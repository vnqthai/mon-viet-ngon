---
/* Mì vịt tiềm — tô DUY NHẤT của trang có NƯỚC DÙNG MÀU NÂU THUỐC BẮC.
   Chữ ký: ĐÙI VỊT nguyên cái chiên vàng nâu, đặt CAO HẲN LÊN khỏi mặt nước
   (đúng cách dọn: da giòn không bị ngâm), lộ đầu xương ống trắng;
   mì trứng VÀNG sợi lượn, cải thìa xanh dựng thành tô, nấm đông cô nâu sẫm,
   táo tàu đỏ sẫm nhăn + kỷ tử đỏ cam nổi, một cánh hoa hồi thả trên mặt;
   đạo cụ: chén xì dầu ớt + cánh hồi và mấy trái táo tàu trên bàn */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Tô mì vịt tiềm: nước dùng nâu sậm, đùi vịt chiên vàng đặt trên mặt tô, mì trứng vàng, cải thìa xanh, nấm đông cô và táo tàu">
  <defs>
    <linearGradient id="mvtBroth" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#9A6330"/><stop offset="1" stop-color="#5E3413"/>
    </linearGradient>
    <linearGradient id="mvtBowl" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#FDFAF0"/><stop offset="1" stop-color="#E9E2CC"/>
    </linearGradient>
    <linearGradient id="mvtSkin" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#D9913C"/><stop offset="1" stop-color="#9A5417"/>
    </linearGradient>
    <!-- táo tàu: hình trứng đỏ sẫm, mặt nhăn dọc -->
    <g id="mvtTao">
      <ellipse cx="0" cy="0" rx="9" ry="6.4" fill="#8E2A22" stroke="#5E1A12" stroke-width="1.6"/>
      <g stroke="#B04A34" stroke-width="1.1" stroke-linecap="round" fill="none">
        <path d="M-5 -3 C -4 0 -4.6 2.6 -6 4"/>
        <path d="M0 -4.6 C 1 -1 0.6 2 -0.6 4.8"/>
        <path d="M5 -3.4 C 6 -0.6 5.6 2 4.4 4"/>
      </g>
    </g>
    <!-- cải thìa liền khối: bẹ trắng thon nối thẳng vào tán lá xanh -->
    <g id="mvtCai">
      <path d="M0 8 C -2 0 2 -5 9 -7 C 16 -9 22 -7 24 -3 C 30 -14 44 -21 58 -20
               C 60 -9 50 1 34 6 C 22 10 6 13 0 8 Z"
            fill="#3E7B3A" stroke="#25501E" stroke-width="1.9" stroke-linejoin="round"/>
      <path d="M0 8 C -2 0 2 -5 9 -7 C 16 -9 22 -7 24 -3 C 22 3 16 8 8 11 C 3 12 0 11 0 8 Z"
            fill="#EFE9D0" stroke="#25501E" stroke-width="1.7"/>
      <path d="M22 -1 C 34 -6 46 -11 55 -16" fill="none" stroke="#84B85E" stroke-width="1.6" stroke-linecap="round"/>
      <path d="M4 6 C 10 3 16 0 21 -3" fill="none" stroke="#CFC7A4" stroke-width="1.4" stroke-linecap="round"/>
    </g>
    <!-- hoa hồi: sao 8 cánh nâu -->
    <g id="mvtHoi">
      <g fill="#7A4A22" stroke="#4E2C10" stroke-width="1.2">
        <ellipse cx="0" cy="-9" rx="3.4" ry="5.4"/>
        <ellipse cx="6.4" cy="-6.4" rx="3.4" ry="5.4" transform="rotate(45 6.4 -6.4)"/>
        <ellipse cx="9" cy="0" rx="5.4" ry="3.4"/>
        <ellipse cx="6.4" cy="6.4" rx="3.4" ry="5.4" transform="rotate(-45 6.4 6.4)"/>
        <ellipse cx="0" cy="9" rx="3.4" ry="5.4"/>
        <ellipse cx="-6.4" cy="6.4" rx="3.4" ry="5.4" transform="rotate(45 -6.4 6.4)"/>
        <ellipse cx="-9" cy="0" rx="5.4" ry="3.4"/>
        <ellipse cx="-6.4" cy="-6.4" rx="3.4" ry="5.4" transform="rotate(-45 -6.4 -6.4)"/>
      </g>
      <circle r="2.6" fill="#A9743C" stroke="#4E2C10" stroke-width="1"/>
    </g>
  </defs>
  <circle cx="260" cy="240" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="240" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <g class="steam">
    <path d="M180 246 C 169 222 195 206 184 180 C 177 164 191 152 187 136"/>
    <path d="M342 244 C 332 220 358 206 347 180 C 340 164 354 152 350 136"/>
  </g>
  <ellipse cx="258" cy="424" rx="200" ry="25" fill="rgba(15,26,14,.35)"/>

  <!-- tô -->
  <path d="M74 300 C 80 376 164 420 258 420 C 352 420 436 376 442 300 Z" fill="url(#mvtBowl)"/>
  <ellipse cx="258" cy="418" rx="62" ry="11" fill="#D8D0B6"/>
  <ellipse cx="258" cy="298" rx="184" ry="46" fill="#F6F1E1"/>
  <ellipse cx="258" cy="298" rx="184" ry="46" fill="none" stroke="#2C5234" stroke-width="5"/>
  <ellipse cx="258" cy="299" rx="170" ry="40" fill="none" stroke="#E0A32E" stroke-width="2.5" stroke-dasharray="2 11" stroke-linecap="round"/>

  <!-- NƯỚC DÙNG NÂU -->
  <ellipse cx="258" cy="301" rx="156" ry="34" fill="url(#mvtBroth)"/>
  <ellipse cx="192" cy="292" rx="46" ry="8" fill="#C08A4E" opacity=".45"/>
  <g fill="#C89050" opacity=".7">
    <circle cx="132" cy="300" r="3"/><circle cx="168" cy="322" r="2.4"/><circle cx="368" cy="296" r="2.8"/>
    <circle cx="346" cy="322" r="2.2"/><circle cx="292" cy="330" r="2.4"/>
  </g>

  <!-- MÌ TRỨNG VÀNG: sợi lượn sóng nổi trên nước nâu -->
  <g fill="none" stroke="#E8B843" stroke-width="7" stroke-linecap="round">
    <path d="M126 300 C 150 288 178 288 200 296"/>
    <path d="M136 316 C 160 305 188 305 210 313"/>
    <path d="M316 296 C 340 286 366 287 384 295"/>
    <path d="M300 318 C 324 309 350 309 370 316"/>
    <path d="M206 324 C 230 315 258 315 280 322"/>
  </g>
  <g fill="none" stroke="#F7D680" stroke-width="2.6" stroke-linecap="round" opacity=".9">
    <path d="M132 298 C 154 287 178 287 198 294"/>
    <path d="M322 294 C 344 285 366 286 382 293"/>
    <path d="M212 322 C 234 314 258 313 278 320"/>
  </g>

  <!-- NẤM ĐÔNG CÔ nâu sẫm, khía chữ thập trên mũ -->
  <g transform="translate(160 306) rotate(-8)">
    <ellipse cx="0" cy="0" rx="19" ry="12" fill="#5A3A22" stroke="#36200F" stroke-width="2"/>
    <path d="M-13 -3.5 C -7 -9 7 -9 13 -3.5" fill="none" stroke="#8A5F38" stroke-width="1.8" stroke-linecap="round"/>
    <path d="M-7 1 L 6 -5 M -4 5 L 9 -1" stroke="#36200F" stroke-width="1.4" stroke-linecap="round"/>
  </g>
  <g transform="translate(354 312) rotate(6)">
    <ellipse cx="0" cy="0" rx="16" ry="10" fill="#513320" stroke="#301C0D" stroke-width="1.9"/>
    <path d="M-11 -3 C -6 -8 6 -8 11 -3" fill="none" stroke="#7F5732" stroke-width="1.6" stroke-linecap="round"/>
    <path d="M-6 1 L 5 -4" stroke="#301C0D" stroke-width="1.3" stroke-linecap="round"/>
  </g>

  <!-- CẢI THÌA: vẽ LIỀN KHỐI bẹ–lá (tách rời thì bẹ trắng trông như miếng đậu hũ) -->
  <use href="#mvtCai" transform="translate(114 286) rotate(-22)"/>
  <use href="#mvtCai" transform="translate(400 278) rotate(160)"/>
  <use href="#mvtCai" transform="translate(198 322) rotate(-8) scale(.88)"/>
  <use href="#mvtCai" transform="translate(346 324) rotate(170) scale(.84)"/>

  <!-- TÁO TÀU nổi + KỶ TỬ đỏ cam lấm tấm -->
  <use href="#mvtTao" transform="translate(150 330) rotate(-12)"/>
  <use href="#mvtTao" transform="translate(330 336) rotate(10) scale(.92)"/>
  <g fill="#D4562A" stroke="#9A3418" stroke-width="1">
    <ellipse cx="196" cy="316" rx="4.2" ry="2.6" transform="rotate(-18 196 316)"/>
    <ellipse cx="286" cy="308" rx="4" ry="2.5" transform="rotate(12 286 308)"/>
    <ellipse cx="256" cy="332" rx="4.2" ry="2.6" transform="rotate(-6 256 332)"/>
    <ellipse cx="380" cy="322" rx="3.8" ry="2.4" transform="rotate(20 380 322)"/>
    <ellipse cx="130" cy="312" rx="3.8" ry="2.4" transform="rotate(-8 130 312)"/>
  </g>
  <use href="#mvtHoi" transform="translate(404 306) scale(.85)"/>

  <!-- ĐÙI VỊT: nằm CAO trên mặt tô, mặt da vàng nâu, lộ đầu xương ống -->
  <ellipse cx="262" cy="288" rx="86" ry="16" fill="#4A2A0E" opacity=".35"/>
  <g transform="translate(252 252) rotate(-6)">
    <!-- KHỐI ĐÙI: bắp đùi phình to bên trái, THẮT LẠI thành cổ chân bên phải
         rồi mới ló ống xương — dáng đùi gà vịt, không phải khối bầu dục -->
    <path d="M-74 2
             C -82 -20 -62 -42 -30 -46
             C -2 -49 22 -41 38 -25
             C 46 -17 54 -14 62 -15
             C 72 -16 77 -8 71 -2
             C 66 3 58 5 50 4
             C 44 13 32 21 16 26
             C -12 35 -62 28 -74 2 Z"
          fill="url(#mvtSkin)" stroke="#6B330A" stroke-width="2.6" stroke-linejoin="round"/>
    <!-- mảng da bóng phồng ở lưng đùi -->
    <path d="M-56 -8 C -54 -26 -32 -36 -8 -37 C 14 -38 30 -30 40 -19 C 26 -25 4 -26 -16 -22 C -34 -19 -50 -12 -56 -8 Z"
          fill="#EEB05B" opacity=".8"/>
    <path d="M-44 -20 C -30 -29 -4 -32 16 -28" fill="none" stroke="#FBDCA0" stroke-width="3.2" stroke-linecap="round" opacity=".75"/>
    <!-- vệt cháy cạnh do chiên, chạy theo mép dưới -->
    <g stroke="#5A2A08" stroke-width="2.4" stroke-linecap="round" fill="none" opacity=".8">
      <path d="M-50 12 C -34 20 -8 22 14 18"/>
      <path d="M14 -32 C 28 -27 38 -19 43 -11"/>
    </g>
    <!-- nếp da chạy vòng quanh bắp đùi -->
    <g stroke="#8A4A15" stroke-width="1.7" stroke-linecap="round" fill="none" opacity=".7">
      <path d="M-34 -10 C -26 -2 -24 10 -28 20"/>
      <path d="M-6 -18 C 2 -8 4 6 0 20"/>
      <path d="M20 -22 C 28 -14 30 -4 26 6"/>
    </g>
    <!-- chỗ THẮT cổ chân: vệt sẫm cho thấy khối hẹp lại -->
    <path d="M44 -12 C 50 -4 50 2 46 6" fill="none" stroke="#7C3B0C" stroke-width="2.4" stroke-linecap="round" opacity=".8"/>
    <!-- ỐNG XƯƠNG ngắn và mập, đầu xương bè hai mấu -->
    <path d="M64 -12 L 88 -24 C 92 -26 95 -24 94.6 -20 L 92 -11 C 91 -7.4 87.6 -6 83 -7 L 63 -4 Z"
          fill="#F3E7C6" stroke="#BC9E66" stroke-width="2.2" stroke-linejoin="round"/>
    <path d="M86 -27 C 94 -31 101 -28 101 -21 C 101 -14 94 -11 87 -14 C 82 -16 81 -24 86 -27 Z"
          fill="#FBF4E0" stroke="#BC9E66" stroke-width="2.2"/>
    <path d="M94 -27 C 100 -29 104 -25 103 -20" fill="none" stroke="#BC9E66" stroke-width="2"/>
    <path d="M68 -9 C 76 -13 82 -16 88 -19" fill="none" stroke="#DCC79A" stroke-width="1.6" stroke-linecap="round"/>
  </g>

  <!-- hành lá + ngò rắc trên đùi vịt -->
  <g fill="#4E7B36">
    <ellipse cx="228" cy="238" rx="6" ry="2.6" transform="rotate(-16 228 238)"/>
    <ellipse cx="276" cy="228" rx="5.6" ry="2.4" transform="rotate(8 276 228)"/>
    <ellipse cx="300" cy="252" rx="5.2" ry="2.3" transform="rotate(-4 300 252)"/>
  </g>
  <g transform="translate(196 224)">
    <path d="M0 4 L 2 -6" stroke="#2C5E2E" stroke-width="1.5"/>
    <path d="M0 -2 C -5 -10 -2 -19 6 -21 C 11 -14 9 -5 3 0 C 1 1 0 0 0 -2 Z" fill="#3E7B3A" stroke="#26521F" stroke-width="1.4"/>
    <path d="M-4 2 C -10 -3 -10 -11 -4 -15 C 1 -11 2 -4 -1 2 C -2 3 -3 3 -4 2 Z" fill="#4A8B3E" stroke="#26521F" stroke-width="1.3"/>
  </g>

  <!-- ĐẠO CỤ TRÁI: chén xì dầu ớt -->
  <g transform="translate(94 406)">
    <ellipse cx="0" cy="14" rx="42" ry="12" fill="rgba(15,26,14,.3)"/>
    <path d="M-34 -2 C -32 14 -18 23 0 23 C 18 23 32 14 34 -2 Z" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2"/>
    <ellipse cx="0" cy="-2" rx="28" ry="8.5" fill="#3C2412"/>
    <ellipse cx="-8" cy="-3.5" rx="9" ry="2.6" fill="#6E4626" opacity=".85"/>
    <circle cx="7" cy="-2" r="2.8" fill="#D64B33"/><circle cx="-15" cy="-1" r="2.3" fill="#D64B33"/>
  </g>

  <!-- ĐẠO CỤ PHẢI: cánh hoa hồi + mấy trái táo tàu trên bàn -->
  <g transform="translate(430 400)">
    <ellipse cx="0" cy="20" rx="46" ry="11" fill="rgba(15,26,14,.3)"/>
    <use href="#mvtHoi" transform="translate(-16 4) rotate(12) scale(1.5)"/>
    <use href="#mvtTao" transform="translate(20 12) rotate(-14) scale(1.2)"/>
    <use href="#mvtTao" transform="translate(38 2) rotate(8) scale(1.05)"/>
    <g fill="#D4562A" stroke="#9A3418" stroke-width="1.1">
      <ellipse cx="4" cy="20" rx="4.6" ry="2.8" transform="rotate(-10 4 20)"/>
      <ellipse cx="-32" cy="20" rx="4.2" ry="2.6" transform="rotate(14 -32 20)"/>
    </g>
  </g>
</svg>
