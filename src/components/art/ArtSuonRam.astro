---
/* Sườn ram mặn ngọt — dĩa sâu lòng chất khúc sườn non vuông bo góc chồng lấn (một khúc nằm
   ngang phá nhịp), sốt keo đỏ cam mật ong ngập chân, đầu khúc lộ ĐỐM XƯƠNG tròn trắng cắn
   vào vành mỡ; mè rắc, chén cơm gác đũa kề bên */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Dĩa sườn non ram mặn ngọt sốt keo bóng, kèm chén cơm trắng gác đũa">
  <defs>
    <linearGradient id="srGlaze" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#DE8C42"/><stop offset="1" stop-color="#B25A24"/>
    </linearGradient>
    <linearGradient id="srGlaze2" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#D68238"/><stop offset="1" stop-color="#A85520"/>
    </linearGradient>
    <linearGradient id="srSauce" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#C26325"/><stop offset="1" stop-color="#8F4214"/>
    </linearGradient>
  </defs>
  <circle cx="260" cy="250" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="250" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <g class="steam">
    <path d="M226 246 C 215 222 241 206 230 180 C 223 164 237 152 233 138"/>
    <path d="M294 242 C 284 218 310 204 299 178 C 292 162 306 150 302 134"/>
  </g>
  <ellipse cx="260" cy="400" rx="200" ry="26" fill="rgba(15,26,14,.35)"/>

  <!-- dĩa sâu lòng: vành ngoài + lòng trũng -->
  <ellipse cx="260" cy="340" rx="200" ry="56" fill="#F6F1E1"/>
  <ellipse cx="260" cy="336" rx="200" ry="56" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2"/>
  <ellipse cx="260" cy="336" rx="200" ry="56" fill="none" stroke="#2C5234" stroke-width="4"/>
  <ellipse cx="260" cy="337" rx="172" ry="45" fill="none" stroke="#E0A32E" stroke-width="2.4" stroke-dasharray="2 11" stroke-linecap="round"/>
  <ellipse cx="260" cy="334" rx="150" ry="38" fill="#EFE7CE" stroke="#DCD3B4" stroke-width="2"/>

  <!-- vũng sốt keo mép loang tự nhiên -->
  <path d="M132 334 C 136 322 158 312 190 308 C 226 303 300 302 340 307
           C 372 311 388 322 386 333 C 384 350 344 362 262 364
           C 184 365 136 352 132 334 Z" fill="url(#srSauce)"/>
  <path d="M150 328 C 168 320 200 315 236 313" fill="none" stroke="#E8A65A" stroke-width="3" stroke-linecap="round" opacity=".6"/>
  <path d="M300 352 C 330 350 356 344 370 336" fill="none" stroke="#E8A65A" stroke-width="2.4" stroke-linecap="round" opacity=".45"/>
  <g fill="#E8A65A" opacity=".85">
    <circle cx="158" cy="340" r="3.2"/><circle cx="368" cy="326" r="2.8"/><circle cx="250" cy="358" r="3"/>
  </g>

  <!-- bóng khúc sườn hằn xuống sốt -->
  <g fill="rgba(74,28,6,.3)">
    <ellipse cx="182" cy="316" rx="34" ry="9"/>
    <ellipse cx="256" cy="312" rx="36" ry="9"/>
    <ellipse cx="326" cy="316" rx="32" ry="8"/>
    <ellipse cx="206" cy="346" rx="36" ry="9"/>
    <ellipse cx="282" cy="352" rx="38" ry="9"/>
    <ellipse cx="344" cy="342" rx="36" ry="8"/>
  </g>

  <!-- HÀNG SAU: khúc sườn nhỏ hơn, nhô sau các khúc trước -->
  <g transform="rotate(-9 176 284)">
    <rect x="156" y="262" width="40" height="42" rx="7.5" fill="url(#srGlaze2)" stroke="#7C3B12" stroke-width="2.4"/>
    <path d="M158 269 C 168 264 186 263 194 266 L 194 271 C 186 268 168 269 160 273 Z" fill="#EFD3A4"/>
    <circle cx="176" cy="268" r="4.6" fill="#F6EAD2" stroke="#B98A50" stroke-width="1.8"/>
    <path d="M168 284 L 164 296" stroke="#F2B063" stroke-width="2.5" stroke-linecap="round"/>
    <ellipse cx="184" cy="288" rx="2.2" ry="1.4" fill="#FBF3DC" transform="rotate(-24 184 288)"/>
  </g>
  <g transform="rotate(3 250 278)">
    <rect x="228" y="254" width="45" height="46" rx="8" fill="url(#srGlaze)" stroke="#7C3B12" stroke-width="2.5"/>
    <path d="M230 262 C 241 256 261 255 271 258 L 271 264 C 261 260 241 262 232 266 Z" fill="#EFD3A4"/>
    <circle cx="249" cy="261" r="4.9" fill="#F6EAD2" stroke="#B98A50" stroke-width="1.8"/>
    <path d="M240 278 L 236 292" stroke="#F2B063" stroke-width="2.6" stroke-linecap="round"/>
    <path d="M258 276 L 255 288" stroke="#F2B063" stroke-width="2.2" stroke-linecap="round" opacity=".85"/>
    <ellipse cx="262" cy="290" rx="2.2" ry="1.4" fill="#FBF3DC" transform="rotate(30 262 290)"/>
  </g>
  <g transform="rotate(-5 322 282)">
    <rect x="302" y="262" width="41" height="41" rx="7.5" fill="#C97434" stroke="#7C3B12" stroke-width="2.4"/>
    <path d="M304 269 C 313 264 332 263 341 266 L 341 271 C 332 268 313 269 306 273 Z" fill="#EFD3A4"/>
    <circle cx="321" cy="268" r="4.5" fill="#F6EAD2" stroke="#B98A50" stroke-width="1.8"/>
    <path d="M312 282 L 308 294" stroke="#F2B063" stroke-width="2.5" stroke-linecap="round"/>
    <ellipse cx="328" cy="286" rx="2.1" ry="1.3" fill="#FBF3DC" transform="rotate(-18 328 286)"/>
  </g>

  <!-- HÀNG TRƯỚC trái + giữa: khúc đứng, chân ngập sốt, mặt bên tối tạo khối -->
  <g transform="rotate(7 202 322)">
    <rect x="178" y="298" width="48" height="46" rx="8.5" fill="url(#srGlaze)" stroke="#7C3B12" stroke-width="2.6"/>
    <path d="M219 302 C 224 312 225 328 221 341 L 212 343 C 217 330 217 313 213 301 Z" fill="#8A3E12" opacity=".55"/>
    <path d="M180 306 C 191 300 213 299 224 302 L 224 308 C 213 304 191 306 182 310 Z" fill="#EFD3A4"/>
    <circle cx="200" cy="305" r="5.2" fill="#F6EAD2" stroke="#B98A50" stroke-width="1.9"/>
    <path d="M190 323 L 186 337" stroke="#F2B063" stroke-width="2.8" stroke-linecap="round"/>
    <path d="M201 321 L 197 333" stroke="#F2B063" stroke-width="2.3" stroke-linecap="round" opacity=".85"/>
    <ellipse cx="210" cy="328" rx="2.4" ry="1.5" fill="#FBF3DC" transform="rotate(22 210 328)"/>
    <circle cx="194" cy="313" r="2" fill="#FBF3DC"/>
  </g>
  <g transform="rotate(-4 280 330)">
    <rect x="254" y="304" width="51" height="48" rx="9" fill="url(#srGlaze)" stroke="#7C3B12" stroke-width="2.6"/>
    <path d="M298 308 C 303 319 304 336 300 349 L 291 351 C 296 337 296 320 292 307 Z" fill="#8A3E12" opacity=".55"/>
    <path d="M256 313 C 268 306 291 305 302 308 L 302 314 C 291 310 268 312 258 317 Z" fill="#EFD3A4"/>
    <circle cx="277" cy="311" r="5.4" fill="#F6EAD2" stroke="#B98A50" stroke-width="1.9"/>
    <path d="M266 330 L 262 344" stroke="#F2B063" stroke-width="2.8" stroke-linecap="round"/>
    <path d="M278 328 L 274 340" stroke="#F2B063" stroke-width="2.3" stroke-linecap="round" opacity=".85"/>
    <ellipse cx="288" cy="336" rx="2.4" ry="1.5" fill="#FBF3DC" transform="rotate(-26 288 336)"/>
    <circle cx="270" cy="320" r="2" fill="#FBF3DC"/>
  </g>

  <!-- khúc NẰM NGANG phá nhịp: mặt cắt xương quay về bên trái -->
  <g transform="rotate(-8 344 326)">
    <rect x="316" y="306" width="56" height="38" rx="8" fill="url(#srGlaze2)" stroke="#7C3B12" stroke-width="2.5"/>
    <path d="M323 308 C 318 316 317 330 321 341 L 327 342 C 323 331 324 317 328 309 Z" fill="#EFD3A4"/>
    <circle cx="325" cy="325" r="5" fill="#F6EAD2" stroke="#B98A50" stroke-width="1.9"/>
    <path d="M340 314 L 336 328" stroke="#F2B063" stroke-width="2.7" stroke-linecap="round"/>
    <path d="M354 313 L 350 326" stroke="#F2B063" stroke-width="2.2" stroke-linecap="round" opacity=".85"/>
    <ellipse cx="356" cy="332" rx="2.3" ry="1.4" fill="#FBF3DC" transform="rotate(18 356 332)"/>
    <path d="M366 310 C 370 318 371 330 368 340" fill="none" stroke="#8A3E12" stroke-width="3" stroke-linecap="round" opacity=".45"/>
  </g>

  <!-- sốt keo dâng ôm chân khúc sườn trước -->
  <path d="M168 344 C 190 352 232 356 262 356 C 300 357 340 352 364 344"
        fill="none" stroke="#8A3E12" stroke-width="5" stroke-linecap="round" opacity=".45"/>
  <path d="M196 350 q14 5 30 4 M288 354 q16 2 32 -2" fill="none" stroke="#C56A28" stroke-width="3" stroke-linecap="round" opacity=".75"/>

  <!-- hành lá + ớt lát điểm trên sốt -->
  <g stroke="#7FA95B" stroke-width="3.6" stroke-linecap="round" fill="none">
    <path d="M214 268 q10 -6 20 -4"/><path d="M294 292 q10 -5 19 -2"/><path d="M236 340 q9 -3 18 -2"/>
  </g>
  <g>
    <circle cx="160" cy="342" r="5.6" fill="#D64B33" stroke="#A83722" stroke-width="1.8"/>
    <circle cx="160" cy="342" r="2.2" fill="#F2B063"/>
    <circle cx="304" cy="356" r="5.2" fill="#D64B33" stroke="#A83722" stroke-width="1.8"/>
    <circle cx="304" cy="356" r="2" fill="#F2B063"/>
  </g>

  <!-- chén cơm trắng gác đũa — món tốn cơm mà -->
  <g transform="translate(98 390)">
    <ellipse cx="0" cy="30" rx="48" ry="12" fill="rgba(15,26,14,.32)"/>
    <path d="M-36 4 C -34 21 -19 31 0 31 C 19 31 34 21 36 4 Z" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2.2"/>
    <path d="M-36 4 Q 0 12 36 4" fill="none" stroke="#2C5234" stroke-width="3"/>
    <path d="M-31 1 C -25 -15 -12 -23 1 -23 C 14 -23 26 -15 31 1 Q 0 9 -31 1 Z" fill="#FFFDF6" stroke="#E3D9BB" stroke-width="2"/>
    <g stroke="#E3D9BB" stroke-width="2.6" stroke-linecap="round" fill="none">
      <path d="M-18 -8 l6 -2 M-2 -15 l6 -2 M12 -6 l6 -2 M-8 -2 l5 -2"/>
    </g>
    <g transform="rotate(-10)">
      <rect x="-46" y="-31" width="94" height="5" rx="2.5" fill="#D9A050" stroke="#B3762A" stroke-width="1.4"/>
      <rect x="-42" y="-23" width="94" height="5" rx="2.5" fill="#D9A050" stroke="#B3762A" stroke-width="1.4"/>
    </g>
  </g>

  <!-- ớt + nhánh hành trên bàn phải -->
  <g transform="translate(398 412) rotate(-12)">
    <path d="M0 0C13 2 22 -4 26 -13" fill="none" stroke="#C0392B" stroke-width="8" stroke-linecap="round"/>
    <path d="M26 -15c2-4 6-5 9-4" fill="none" stroke="#4E7B36" stroke-width="4" stroke-linecap="round"/>
  </g>
  <g stroke="#7FA95B" stroke-width="5" stroke-linecap="round" fill="none">
    <path d="M420 432 q14 -8 28 -6"/>
  </g>
</svg>
