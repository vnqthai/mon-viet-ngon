---
/* Lẩu bò Đà Lạt — CHỮ KÝ nhận dạng, phải lệch hẳn SÁU nồi kia:
   1) Ổ BÁNH MÌ xé dở nằm ngay cạnh nồi — thứ ăn kèm đúng bài của lẩu bò Đà Lạt
      (mấy nồi kia ăn với bún/mì). Đây là dấu nhận ra nhanh nhất.
   2) nồi GANG ĐEN dày, thấp, hai tai VUÔNG NHỎ sát thân — không quai cong, không
      quai xách, không ống khói
   3) KHÚC ĐUÔI BÒ có ĐẦU XƯƠNG LÒI HẲN RA NGOÀI ĐƯỜNG BAO. Cố ý KHÔNG vẽ mặt
      cắt xương nhìn thẳng: vành tròn có chấm giữa ở cỡ thumbnail luôn đọc ra
      cái mặt (bài học khúc cá thu đợt 12).
   4) MIẾNG GÂN trong veo màu hổ phách, nhìn xuyên được — thứ nồi nào khác không có
   5) nước lèo NÂU TRONG, không đục như lẩu mắm, không đỏ như lẩu Thái
   id prefix "ldl" */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Nồi lẩu bò Đà Lạt: nồi gang đen thấp, nước dùng nâu trong với khúc đuôi bò lòi đầu xương, miếng gân trong veo và cà rốt, bên cạnh là ổ bánh mì xé dở và chén chao">
  <defs>
    <linearGradient id="ldlBroth" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#A9702F"/><stop offset="1" stop-color="#6B3F13"/>
    </linearGradient>
    <linearGradient id="ldlIron" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#4A4642"/><stop offset="1" stop-color="#1E1C1A"/>
    </linearGradient>
    <linearGradient id="ldlTendon" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#F3D9A0"/><stop offset="1" stop-color="#C79B4E"/>
    </linearGradient>
  </defs>

  <circle cx="260" cy="234" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="234" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <g class="steam">
    <path d="M206 208 C 195 184 221 168 210 142 C 203 126 217 114 213 98"/>
    <path d="M278 200 C 268 176 294 162 283 136 C 276 120 290 108 286 92"/>
    <path d="M348 212 C 338 188 364 174 353 148 C 346 132 360 120 356 104"/>
  </g>
  <ellipse cx="266" cy="418" rx="190" ry="22" fill="rgba(15,26,14,.35)"/>

  <!-- Ổ BÁNH MÌ xé dở (đạo cụ trái) — dấu nhận diện mạnh nhất -->
  <g transform="translate(84 366) rotate(-14)">
    <ellipse cx="4" cy="42" rx="72" ry="13" fill="rgba(15,26,14,.32)"/>
    <!-- nửa ổ dài, vỏ vàng nâu, đầu nhọn hai bên nhưng lệch cỡ -->
    <path d="M-76 12 C -68 -12 -34 -24 4 -24 C 44 -24 74 -12 80 8 C 72 28 40 38 2 38 C -36 38 -70 30 -76 12 Z"
          fill="#D69434" stroke="#7E4C10" stroke-width="3"/>
    <!-- khía dọc lưng ổ, dấu của bánh mì Việt -->
    <g fill="none" stroke="#8E5814" stroke-width="3" stroke-linecap="round">
      <path d="M-46 -12 C -38 -4 -36 6 -40 16"/>
      <path d="M-14 -18 C -6 -8 -4 4 -8 16"/>
      <path d="M18 -18 C 26 -8 28 4 24 16"/>
      <path d="M48 -12 C 55 -4 57 4 53 14"/>
    </g>
    <g fill="none" stroke="#F3C877" stroke-width="2.2" stroke-linecap="round" opacity=".85">
      <path d="M-58 4 C -46 -8 -20 -14 6 -15"/>
    </g>
    <!-- MIẾNG XÉ RA nằm riêng, lộ RUỘT TRẮNG XỐP — đây là chỗ đọc ra bánh mì -->
    <g transform="translate(86 30) rotate(24)">
      <path d="M-26 6 C -22 -10 -6 -18 12 -16 C 28 -14 34 -2 30 10 C 24 22 -20 22 -26 6 Z"
            fill="#D69434" stroke="#7E4C10" stroke-width="2.6"/>
      <path d="M-22 4 C -18 -8 -4 -13 10 -11 C 22 -9 27 -1 24 8 C 18 17 -18 16 -22 4 Z"
            fill="#F7F0DA" stroke="#D6C79E" stroke-width="2"/>
      <g fill="#E4D9B8">
        <circle cx="-8" cy="0" r="3"/><circle cx="4" cy="-4" r="2.4"/>
        <circle cx="12" cy="4" r="2.6"/><circle cx="-2" cy="8" r="2.2"/>
      </g>
    </g>
  </g>

  <!-- NỒI GANG ĐEN dày, thấp, hai tai VUÔNG NHỎ sát thân -->
  <path d="M136 296 C 142 350 200 382 268 382 C 336 382 394 350 400 296 Z" fill="url(#ldlIron)"/>
  <path d="M136 296 C 142 350 200 382 268 382 C 336 382 394 350 400 296"
        fill="none" stroke="#100F0E" stroke-width="4"/>
  <path d="M134 300 L 108 300 L 108 326 L 136 326 Z" fill="#3A3734" stroke="#100F0E" stroke-width="2.6" stroke-linejoin="round"/>
  <path d="M402 302 L 424 302 L 424 324 L 400 324 Z" fill="#3A3734" stroke="#100F0E" stroke-width="2.6" stroke-linejoin="round"/>
  <!-- vành nồi gang dày, gờ nổi -->
  <ellipse cx="268" cy="294" rx="140" ry="35" fill="#5A5551"/>
  <ellipse cx="268" cy="294" rx="140" ry="35" fill="none" stroke="#2C5234" stroke-width="5"/>
  <ellipse cx="268" cy="295" rx="128" ry="29" fill="none" stroke="#E0A32E" stroke-width="2.4" stroke-dasharray="2 11" stroke-linecap="round"/>

  <!-- NƯỚC DÙNG NÂU TRONG, có váng mỡ vàng tròn nổi -->
  <ellipse cx="268" cy="297" rx="120" ry="27" fill="url(#ldlBroth)"/>
  <g fill="#E8B85E" opacity=".55">
    <circle cx="204" cy="292" r="6"/><circle cx="238" cy="302" r="4.4"/>
    <circle cx="312" cy="290" r="5.2"/><circle cx="338" cy="302" r="3.8"/>
    <circle cx="272" cy="308" r="4"/><circle cx="178" cy="300" r="3.4"/>
  </g>

  <!-- KHÚC ĐUÔI BÒ: khối thịt tròn có ĐẦU XƯƠNG LÒI RA KHỎI ĐƯỜNG BAO hai bên,
       không vẽ mặt cắt xương nhìn thẳng -->
  <g>
    <g transform="translate(212 292) rotate(-12)">
      <path d="M-34 0 C -34 -16 -18 -24 0 -24 C 18 -24 34 -16 34 0 C 34 15 18 24 0 24 C -18 24 -34 15 -34 0 Z"
            fill="#8E4A28" stroke="#4E2109" stroke-width="2.4"/>
      <path d="M-30 -8 C -16 -16 16 -16 30 -8" fill="none" stroke="#B3714A" stroke-width="3" stroke-linecap="round"/>
      <!-- hai đầu xương thò hẳn ra ngoài, dấu nhận diện nằm ở đường bao -->
      <path d="M-34 -2 C -48 -6 -52 6 -40 10 C -34 12 -32 6 -34 0 Z" fill="#F3EEDC" stroke="#C4B891" stroke-width="2.2"/>
      <path d="M34 -2 C 48 -6 52 6 40 10 C 34 12 32 6 34 0 Z" fill="#F3EEDC" stroke="#C4B891" stroke-width="2.2"/>
    </g>
    <g transform="translate(322 300) rotate(10) scale(.88)">
      <path d="M-34 0 C -34 -16 -18 -24 0 -24 C 18 -24 34 -16 34 0 C 34 15 18 24 0 24 C -18 24 -34 15 -34 0 Z"
            fill="#8E4A28" stroke="#4E2109" stroke-width="2.4"/>
      <path d="M-30 -8 C -16 -16 16 -16 30 -8" fill="none" stroke="#B3714A" stroke-width="3" stroke-linecap="round"/>
      <path d="M-34 -2 C -48 -6 -52 6 -40 10 C -34 12 -32 6 -34 0 Z" fill="#F3EEDC" stroke="#C4B891" stroke-width="2.2"/>
      <path d="M34 -2 C 48 -6 52 6 40 10 C 34 12 32 6 34 0 Z" fill="#F3EEDC" stroke="#C4B891" stroke-width="2.2"/>
    </g>
  </g>

  <!-- MIẾNG GÂN trong veo màu hổ phách, nhìn xuyên được -->
  <g stroke="#9A7128" stroke-width="2.2" stroke-linejoin="round">
    <path d="M258 280 C 272 268 292 268 300 278 C 304 288 294 298 278 298 C 262 298 252 290 258 280 Z"
          fill="url(#ldlTendon)" opacity=".9"/>
    <path d="M172 296 C 184 286 200 286 206 294 C 210 302 200 310 188 310 C 176 310 168 304 172 296 Z"
          fill="url(#ldlTendon)" opacity=".9"/>
  </g>
  <g fill="none" stroke="#FBEFCC" stroke-width="2" stroke-linecap="round" opacity=".9">
    <path d="M266 280 C 276 274 288 274 295 279"/>
    <path d="M180 296 C 188 291 197 291 202 295"/>
  </g>

  <!-- MIẾNG NẠM: khối thịt có vân mỡ trắng chạy ngang -->
  <g transform="translate(272 316) rotate(-6)">
    <path d="M-30 -12 C -16 -20 16 -20 30 -10 C 34 0 24 12 6 14 C -14 16 -32 8 -30 -12 Z"
          fill="#9E5230" stroke="#54250D" stroke-width="2.2"/>
    <g fill="none" stroke="#F0DEC4" stroke-width="3" stroke-linecap="round">
      <path d="M-22 -4 C -8 -9 12 -9 24 -3"/>
      <path d="M-18 6 C -6 2 12 2 22 6"/>
    </g>
  </g>

  <!-- KHÚC CÀ RỐT cắt lớn, thả 20 phút cuối -->
  <g stroke="#9A4A0E" stroke-width="2.2" stroke-linejoin="round">
    <path d="M348 282 L 372 276 L 378 294 L 354 300 Z" fill="#E4801E"/>
    <path d="M154 284 L 176 278 L 181 294 L 159 300 Z" fill="#E4801E"/>
  </g>

  <!-- LÁ CẢI THẢO nhúng, gợn sóng, nhô khỏi mép nồi -->
  <g stroke="#2C5820" stroke-width="2.2">
    <path d="M212 272 C 206 250 220 232 240 230 C 240 250 232 266 218 276 C 214 279 211 277 212 272 Z" fill="#7FA84C"/>
    <path d="M300 268 C 298 248 312 234 330 232 C 328 250 320 264 306 272 C 302 275 300 273 300 268 Z" fill="#8FB85A"/>
  </g>
  <g fill="none" stroke="#EDF3DC" stroke-width="4" stroke-linecap="round">
    <path d="M218 274 C 224 258 230 244 238 232"/>
    <path d="M306 270 C 312 256 320 242 328 234"/>
  </g>

  <!-- CHÉN CHAO (đạo cụ phải), thấp và nhỏ hơn ổ bánh mì bên trái -->
  <g transform="translate(446 370)">
    <ellipse cx="0" cy="22" rx="36" ry="9" fill="rgba(15,26,14,.3)"/>
    <path d="M-32 -2 C -30 13 -17 21 0 21 C 17 21 30 13 32 -2 Z" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2.2"/>
    <ellipse cx="0" cy="-2" rx="32" ry="9" fill="#F6F1E1" stroke="#D8D0B6" stroke-width="2"/>
    <ellipse cx="0" cy="-1" rx="25" ry="6.4" fill="#C46A2E"/>
    <g fill="#E89A4E" opacity=".85">
      <ellipse cx="-8" cy="-3" rx="6" ry="2.2"/><ellipse cx="7" cy="1" rx="5" ry="2"/>
    </g>
  </g>
</svg>
