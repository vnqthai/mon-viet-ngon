---
/* Cơm rang dưa bò — VẬT ĐỰNG là CHẢO GANG ĐEN, không phải dĩa. Cả họ "Cơm &
   bánh" (18 hình) là dĩa bầu dục kem hoặc ổ bánh mì; một cái chảo đen có cán
   gỗ chìa ra là dáng và MÀU chưa hình nào trong họ dùng. Và nó đúng với món:
   cả bài viết xoay quanh chuyện chảo phải nóng già.

   BẢN 1 BỊ THÁI TRẢ LẠI HAI CHỖ: "nhìn giống cái nồi hơn cái chảo" và "không
   nhìn ra miếng bò, miếng dưa đâu hết". Sửa bằng ba việc:
   ① thành chảo hạ THẤP HẲN và VÀNH LOE RA — nồi thì thành cao và dựng thẳng,
      đó chính là chỗ đọc nhầm; chiều cao thân nay chỉ bằng ~1/5 bề ngang
   ② cán gỗ DÀI HƠN và có khớp nối đen gắn rõ vào thành chảo
   ③ lát bò và sợi dưa PHÓNG TO gần gấp đôi, đồng thời BỚT hạt cơm — bản 1 rải
      22 hạt cơm nên hai thứ kia chìm nghỉm giữa một mặt vàng lấm tấm

   CHỮ KÝ nhận dạng, cố ý vẽ lệch hẳn cơm chiên cá mặn (hình gần nhất — cùng
   món cứu cơm nguội, cùng họ màu):
   1) cơm chiên cá mặn là GÒ CƠM ĐẮP CAO GIỮA DĨA; đây là cơm TRẢI ĐỀU LÒNG CHẢO
   2) LÁT BÒ THÁI MỎNG, màu NÂU ẤM NGẢ XÁM (không phải đỏ mận): mảnh DẸT DÀI, một đầu cuộn lộ mặt trong nhạt, vệt sém
      chạy DỌC chiều dài — mảng sẫm nhất khung. (Bản 2 vẽ khối tròn dày có chấm
      sẫm giữa: Thái trả lại, đọc ra một cục thịt vô hình thù.)
   3) SỢI DƯA CẢI dài cong, tô VÀNG NGẢ XANH chứ không vàng thuần — bản 2 tô
      vàng óng thì lẫn hẳn vào hạt cơm cũng vàng, Thái không nhìn ra sợi dưa
      đâu. Dưa cải muối thật cũng ngả xanh ô liu, nên đổi màu vừa đúng vừa tách
   4) KHÔNG có chén nước chấm (cả họ hình nào cũng có) — chảo đã chiếm hết khung
   id prefix "crdb" */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Chảo gang đen lòng nông vành loe đựng cơm rang dưa bò: hạt cơm vàng trải đều, những lát thịt bò nâu đỏ thái mỏng, mép co rúm và sợi dưa cải vàng ngả xanh nằm rõ trên mặt, rắc hành lá, cán gỗ dài chìa sang phải">
  <defs>
    <linearGradient id="crdbChao" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#4A4A4E"/><stop offset="1" stop-color="#1C1C20"/>
    </linearGradient>
    <radialGradient id="crdbLong" cx="0.4" cy="0.34" r="0.76">
      <stop offset="0" stop-color="#3E3E42"/><stop offset="1" stop-color="#18181C"/>
    </radialGradient>
    <linearGradient id="crdbCan" x1="0" y1="0" x2="1" y2="0.4">
      <stop offset="0" stop-color="#A87642"/><stop offset="1" stop-color="#6B4522"/>
    </linearGradient>
    <!-- LÁT BÒ: MƯỢN NGUYÊN bảng màu + cách vẽ đã được Thái duyệt ở
         ArtBoXaoThienLy (đợt 13, cũng mất 3 vòng mới qua). Sai ba lần ở hình này
         chỉ vì tôi ngồi nghĩ lại một miếng bò mới, trong khi repo đã có sẵn một
         miếng đạt — đúng cái luật đã ghi từ đợt 12: "món có họ hàng trên site
         thì mượn bố cục đã duyệt, chỉ đổi ruột". -->
    <linearGradient id="crdbBo" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#B4592C"/><stop offset="1" stop-color="#7A3016"/>
    </linearGradient>

    <!-- HẠT CƠM: hạt bầu dục nhỏ, áo trứng nên ngả vàng -->
    <g id="crdbHat">
      <ellipse cx="0" cy="0" rx="7" ry="4.2" fill="#F2DC9E" stroke="#C9A651" stroke-width="1.2"/>
      <ellipse cx="-1.6" cy="-1" rx="3.4" ry="1.8" fill="#FBF0C8"/>
    </g>

    <!-- SỢI DƯA CẢI: dải dài cong, vàng óng, có gân dọc -->
    <g id="crdbDua">
      <path d="M0 0 C 12 -7 28 -9 42 -5 C 46 -3.6 46 0 42 1.6 C 28 6 12 8 2 5 C -1 4 -2 1.4 0 0 Z"
            fill="#BFC24A" stroke="#6E7A18" stroke-width="1.9" stroke-linejoin="round"/>
      <path d="M5 1 C 16 -3 30 -5 40 -2" fill="none" stroke="#E4E88E" stroke-width="1.6" stroke-linecap="round"/>
    </g>

    <!-- LÁT BÒ THÁI MỎNG: bản 2 vẽ khối tròn dày có vệt sẫm ở giữa — Thái trả
         lại vì "nhìn quá kỳ cục", và đúng: nó ra một cục thịt vô hình thù chứ
         không ra lát bò. Lát bò xào thật là một MẢNH DẸT DÀI, mép lượn tự nhiên
         theo thớ, một đầu HƠI CUỘN LÊN lộ mặt trong nhạt màu, trên mặt có vài
         vệt sém sẫm chạy DỌC THEO CHIỀU DÀI chứ không phải một chấm giữa. -->
    <g id="crdbBoLat">
      <!-- Chép từ #tlBeefSlice đã duyệt. Chìa khoá nằm ở chỗ đường bao toàn
           đoạn THẲNG GÃY KHÚC (lệnh L), không có cạnh nào cong đều — lát thịt
           mỏng gặp chảo nóng thì co RÚM lại. Ba bản trước của tôi đều dùng
           đường cong (lệnh C) nên ra vật nhẵn nhụi: cục thịt, rồi dăm bào.
           Chỗ duy nhất đổi so với bản gốc: DẸT bớt theo chiều đứng (×0,72) cho
           đúng ý "miếng bò mỏng, không tròn vo". -->
      <g transform="scale(1 0.72)">
        <path d="M-32 -7 L -14 -16 L 6 -14 L 24 -9 L 32 -1 L 25 9 L 6 15 L -12 13 L -27 8 Z"
              fill="url(#crdbBo)" stroke="#48190A" stroke-width="2.8" stroke-linejoin="round"/>
        <!-- mép cuộn lên: dải nhạt chạy dọc cạnh trên -->
        <path d="M-32 -7 L -14 -16 L 6 -14 L 24 -9 L 32 -1 L 20 -4 L 3 -8 L -13 -9 L -27 -3 Z"
              fill="#C9825A" stroke="#48190A" stroke-width="2.2" stroke-linejoin="round"/>
        <!-- vệt cháy sém -->
        <path d="M-16 3 L 2 1 L 18 4" fill="none" stroke="#5E2810" stroke-width="4" stroke-linecap="round" opacity=".8"/>
        <!-- thớ thịt sáng -->
        <path d="M-20 9 L -2 7 L 16 10" fill="none" stroke="#D19A72" stroke-width="2.4" stroke-linecap="round" opacity=".75"/>
      </g>
    </g>
  </defs>

  <circle cx="260" cy="240" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="240" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>

  <!-- Dời cả cụm (khói + chảo + ruột) sang trái 30: bản trước cán chảo
       chạm mép phải khung và bị cắt cụt một khúc. -->
  <g transform="translate(-30 0)">
  <g class="steam">
    <path d="M190 196 C 180 172 204 158 194 132 C 187 116 200 104 196 88"/>
    <path d="M256 180 C 246 156 270 142 260 116 C 253 100 266 88 262 72"/>
    <path d="M322 198 C 312 174 336 160 326 134 C 319 118 332 106 328 90"/>
  </g>

  <ellipse cx="248" cy="358" rx="190" ry="22" fill="rgba(15,26,14,.4)"/>

  <!-- CÁN CHẢO gỗ: dài, có khớp nối đen gắn vào thành chảo -->
  <g transform="translate(398 272) rotate(-13)">
    <rect x="-18" y="-13" width="48" height="26" rx="5" fill="#26262A" stroke="#141417" stroke-width="2.4"/>
    <path d="M26 -13 L 116 -18 C 128 -18 134 -12 134 -3 C 134 6 128 12 116 12 L 26 13 Z"
          fill="url(#crdbCan)" stroke="#4A2E12" stroke-width="2.6" stroke-linejoin="round"/>
    <path d="M38 -9 C 68 -13 102 -14 124 -11" fill="none" stroke="#D2A464" stroke-width="2.8" stroke-linecap="round" opacity=".6"/>
    <ellipse cx="120" cy="-3" rx="5.4" ry="4.4" fill="#3A2410"/>
  </g>

  <!-- CHẢO GANG: LÒNG NÔNG, VÀNH LOE RA — đó là chỗ phân biệt với cái nồi -->
  <path d="M76 272 C 88 322 160 348 250 348 C 340 348 412 322 424 272
           C 400 296 330 308 250 308 C 170 308 100 296 76 272 Z" fill="url(#crdbChao)"/>
  <ellipse cx="250" cy="270" rx="186" ry="52" fill="#3A3A40"/>
  <ellipse cx="250" cy="270" rx="186" ry="52" fill="none" stroke="#141417" stroke-width="5"/>
  <ellipse cx="250" cy="273" rx="170" ry="44" fill="url(#crdbLong)"/>
  <path d="M96 254 C 126 232 184 220 250 220" fill="none" stroke="#8A8A92" stroke-width="4.4" stroke-linecap="round" opacity=".5"/>
  <ellipse cx="250" cy="275" rx="158" ry="39" fill="none" stroke="#0E0E10" stroke-width="6" opacity=".55"/>

  <!-- CƠM TRẢI ĐỀU LÒNG CHẢO — khối liền trước, hạt đè lên sau, RẢI THƯA để
       lát bò và sợi dưa còn chỗ nổi lên -->
  <ellipse cx="250" cy="275" rx="150" ry="35" fill="#C9A44E"/>
  <ellipse cx="250" cy="271" rx="146" ry="32" fill="#E0C069"/>
  <g>
    <use href="#crdbHat" transform="translate(146 254) rotate(-16)"/>
    <use href="#crdbHat" transform="translate(204 246) rotate(12)"/>
    <use href="#crdbHat" transform="translate(300 244) rotate(20)"/>
    <use href="#crdbHat" transform="translate(352 258) rotate(-12)"/>
    <use href="#crdbHat" transform="translate(120 274) rotate(8)"/>
    <use href="#crdbHat" transform="translate(168 296) rotate(-14)"/>
    <use href="#crdbHat" transform="translate(236 300) rotate(18)"/>
    <use href="#crdbHat" transform="translate(310 296) rotate(-8)"/>
    <use href="#crdbHat" transform="translate(366 280) rotate(10)"/>
    <use href="#crdbHat" transform="translate(258 256) rotate(-6)"/>
  </g>

  <!-- SỢI DƯA CẢI vàng óng: to bản, rải xen giữa các lát bò -->
  <use href="#crdbDua" transform="translate(114 262) rotate(-16) scale(1.7)"/>
  <use href="#crdbDua" transform="translate(206 240) rotate(8) scale(1.62)"/>
  <use href="#crdbDua" transform="translate(300 260) rotate(-6) scale(1.7)"/>
  <use href="#crdbDua" transform="translate(136 300) rotate(14) scale(1.5)"/>
  <use href="#crdbDua" transform="translate(254 308) rotate(-10) scale(1.56)"/>
  <use href="#crdbDua" transform="translate(336 288) rotate(9) scale(1.44)"/>

  <!-- LÁT BÒ: to bản, sẫm hẳn — mảng đọc được đầu tiên của khung -->
  <use href="#crdbBoLat" transform="translate(178 262) rotate(-13) scale(1.28)"/>
  <use href="#crdbBoLat" transform="translate(290 246) rotate(9) scale(1.16)"/>
  <use href="#crdbBoLat" transform="translate(232 292) rotate(-4) scale(1.24)"/>
  <use href="#crdbBoLat" transform="translate(338 274) rotate(16) scale(1.06)"/>
  <use href="#crdbBoLat" transform="translate(136 288) rotate(6) scale(1)"/>

  <!-- HÀNH LÁ cắt khúc rắc trên cùng -->
  <g fill="#4E7B36">
    <ellipse cx="160" cy="244" rx="7.4" ry="3.2" transform="rotate(-16 160 244)"/>
    <ellipse cx="236" cy="234" rx="7" ry="3" transform="rotate(10 236 234)"/>
    <ellipse cx="330" cy="244" rx="7" ry="3" transform="rotate(-6 330 244)"/>
    <ellipse cx="140" cy="302" rx="6.6" ry="2.9" transform="rotate(18 140 302)"/>
    <ellipse cx="298" cy="308" rx="6.6" ry="2.8" transform="rotate(-10 298 308)"/>
    <ellipse cx="374" cy="278" rx="6.2" ry="2.7" transform="rotate(6 374 278)"/>
  </g>
  <g fill="#8CB85A" opacity=".9">
    <circle cx="212" cy="256" r="2.4"/><circle cx="270" cy="282" r="2.2"/><circle cx="334" cy="298" r="2"/>
    <circle cx="128" cy="286" r="2.2"/>
  </g>
  </g>
</svg>
