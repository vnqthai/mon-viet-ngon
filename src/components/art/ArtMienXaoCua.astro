---
/* Miến xào cua — ĐĨA (không phải tô), phân biệt với mì xào bò cùng nền nâu:
   sợi ở đây là MIẾN DONG TRONG MỜ xám ngà (mì xào bò là sợi mì trứng VÀNG),
   đạm là THỚ CUA trắng ngà xé dọc thớ + mảng GẠCH CUA cam bóng (không phải lát bò nâu);
   thêm mộc nhĩ đen, cà rốt sợi, giá đỗ, hành phi;
   đạo cụ: mai cua đỏ cam úp ngửa + một cái càng cua — chữ ký nhận ra ngay */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Đĩa miến xào cua: sợi miến trong mờ, thớ thịt cua trắng và gạch cua vàng cam, mộc nhĩ, cà rốt sợi và giá đỗ, kèm mai cua đỏ">
  <defs>
    <linearGradient id="mxcGach" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#F2A73C"/><stop offset="1" stop-color="#D2761A"/>
    </linearGradient>
    <linearGradient id="mxcMai" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#E4643A"/><stop offset="1" stop-color="#B23C1E"/>
    </linearGradient>
    <!-- THỚ THỊT CUA: khối thịt gỡ nguyên miếng — mép TƯỚC RĂNG CƯA theo thớ,
         vệt sợi chạy dọc bên trong, đầu có ánh hồng cam của thịt cua bể.
         Cố ý không dùng hình bầu dục trơn kẻo trông thành khoanh mực hay quả trứng. -->
    <g id="mxcThit">
      <path d="M0 4 C 2 -1 8 -4 16 -5 L 26 -7 L 30 -3.4 L 39 -6
               C 45 -6.6 48 -2 46 3 C 44 8 36 10.6 27 11 L 17 12 L 13 8.4 L 5 10
               C 1 10 -1 7 0 4 Z"
            fill="#FBF3E4" stroke="#C09A66" stroke-width="1.9" stroke-linejoin="round"/>
      <g stroke="#E0C99C" stroke-width="1.5" stroke-linecap="round" fill="none">
        <path d="M4 4 C 15 0 30 -1 42 0"/>
        <path d="M6 8 C 17 5 30 4 40 4"/>
        <path d="M5 0 C 16 -4 30 -5 40 -4"/>
      </g>
      <path d="M39 -6 C 45 -6.6 48 -2 46 3 C 44 6 40 8 35 9 C 39 4 40 -1 39 -6 Z" fill="#F2B78E" opacity=".8"/>
      <path d="M3 1 C 13 -3 25 -5 35 -5" fill="none" stroke="#FFFDF4" stroke-width="1.8" stroke-linecap="round" opacity=".9"/>
    </g>
    <!-- giá đỗ: thân trắng cong + đầu mầm vàng ngà -->
    <g id="mxcGia">
      <path d="M0 0 C 8 -4 18 -4 26 0" fill="none" stroke="#FBF6E6" stroke-width="4.4" stroke-linecap="round"/>
      <ellipse cx="27.5" cy="0.6" rx="4" ry="2.8" fill="#EFDFAC" stroke="#C9B47C" stroke-width="1.2"/>
    </g>
  </defs>
  <circle cx="260" cy="250" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="250" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <g class="steam">
    <path d="M214 234 C 203 210 229 194 218 168 C 211 152 225 140 221 126"/>
    <path d="M298 230 C 288 206 314 192 303 166 C 296 150 310 138 306 124"/>
  </g>
  <ellipse cx="260" cy="400" rx="200" ry="26" fill="rgba(15,26,14,.35)"/>

  <!-- đĩa -->
  <ellipse cx="260" cy="342" rx="204" ry="58" fill="#F6F1E1"/>
  <ellipse cx="260" cy="338" rx="204" ry="58" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2"/>
  <ellipse cx="260" cy="338" rx="204" ry="58" fill="none" stroke="#2C5234" stroke-width="4"/>
  <ellipse cx="260" cy="340" rx="168" ry="44" fill="none" stroke="#E0A32E" stroke-width="2.4" stroke-dasharray="2 11" stroke-linecap="round"/>

  <!-- KHỐI NỀN của đống miến — không có khối này thì mấy sợi rời trông như dây -->
  <ellipse cx="258" cy="332" rx="152" ry="36" fill="#8A5E22" opacity=".22"/>
  <path d="M128 336 C 142 302 192 286 258 286 C 324 286 374 302 388 336
           C 374 364 324 376 258 376 C 192 376 142 364 128 336 Z"
        fill="#6B5330"/>
  <path d="M146 318 C 168 298 206 290 258 290 C 310 290 348 298 370 318
           C 344 308 304 302 258 302 C 212 302 172 308 146 318 Z"
        fill="#856A3C" opacity=".95"/>

  <!-- LỚP SAU: cà rốt sợi cam + mộc nhĩ đen dựng lên -->
  <g stroke-linecap="round" fill="none" stroke="#EF9440" stroke-width="5">
    <path d="M150 314 q 18 -8 36 -3"/>
    <path d="M330 306 q 18 -8 36 -2"/>
    <path d="M250 296 q 18 -7 34 -2"/>
  </g>
  <g fill="#3B2A22" stroke="#221610" stroke-width="1.6">
    <path d="M186 300 C 196 291 212 289 224 294 C 219 303 206 307 196 306 C 190 306 187 304 186 300 Z"/>
    <path d="M300 314 C 310 305 326 304 338 309 C 333 318 320 322 310 321 C 304 321 301 318 300 314 Z"/>
  </g>

  <!-- SỢI MIẾN XÀO: miến dong ngấm nước mắm nên ngả NÂU NGÀ BÓNG chứ không trắng;
       ba lớp chồng + hai sợi vắt cong lên khỏi đống cho thấy đây là sợi, không phải đám -->
  <g fill="none" stroke="#5F4A26" stroke-width="7" stroke-linecap="round" opacity=".55">
    <path d="M140 332 C 178 316 226 314 266 324"/>
    <path d="M238 314 C 276 300 322 300 358 310"/>
    <path d="M174 362 C 214 348 264 347 302 356"/>
  </g>
  <!-- sợi xếp DÀY sát nhau để thành một đống miến, không thành mấy cọng rời -->
  <g fill="none" stroke="#D6BD87" stroke-width="8" stroke-linecap="round">
    <path d="M134 302 C 172 292 218 290 256 296"/>
    <path d="M244 298 C 282 288 326 288 362 296"/>
    <path d="M132 314 C 172 302 220 300 260 308"/>
    <path d="M248 310 C 288 298 332 298 370 306"/>
    <path d="M134 326 C 176 312 226 310 268 318"/>
    <path d="M254 322 C 296 310 342 310 378 318"/>
    <path d="M142 338 C 186 324 240 322 284 330"/>
    <path d="M262 334 C 302 322 348 322 382 330"/>
    <path d="M150 350 C 194 336 248 334 292 342"/>
    <path d="M270 346 C 308 334 350 334 380 342"/>
    <path d="M164 362 C 208 348 262 347 302 356"/>
    <path d="M290 358 C 322 346 356 346 380 354"/>
    <!-- sợi vắt cong lên khỏi đống -->
    <path d="M190 306 C 200 284 228 276 256 282"/>
    <path d="M298 298 C 312 278 340 274 360 282"/>
  </g>
  <g fill="none" stroke="#F4E6BC" stroke-width="3" stroke-linecap="round" opacity=".95">
    <path d="M138 300 C 174 290 218 288 254 294"/>
    <path d="M138 324 C 178 310 226 308 266 316"/>
    <path d="M250 308 C 288 296 332 296 368 304"/>
    <path d="M156 348 C 198 334 248 332 290 340"/>
    <path d="M268 344 C 306 332 350 332 378 340"/>
    <path d="M194 305 C 204 285 228 278 252 283"/>
    <path d="M302 297 C 316 279 340 276 358 283"/>
  </g>
  <g fill="none" stroke="#A88C55" stroke-width="1.8" stroke-linecap="round" opacity=".65">
    <path d="M136 308 C 174 296 220 294 258 302"/>
    <path d="M146 344 C 190 330 244 328 288 336"/>
    <path d="M258 328 C 300 316 344 316 380 324"/>
  </g>

  <!-- GẠCH CUA: mảng cam bóng lẫn trong sợi miến -->
  <g>
    <path d="M204 332 C 214 324 232 323 242 329 C 236 338 218 341 208 338 C 203 336 202 334 204 332 Z"
          fill="url(#mxcGach)" stroke="#B0600F" stroke-width="1.8"/>
    <path d="M312 330 C 322 323 338 322 347 328 C 341 336 325 339 316 336 C 311 334 310 332 312 330 Z"
          fill="url(#mxcGach)" stroke="#B0600F" stroke-width="1.8"/>
    <path d="M254 356 C 262 350 276 349 284 354 C 279 361 265 363 258 360 C 254 358 253 357 254 356 Z"
          fill="url(#mxcGach)" stroke="#B0600F" stroke-width="1.6"/>
  </g>
  <g fill="#F8CE7C" opacity=".85">
    <circle cx="216" cy="330" r="2.2"/><circle cx="326" cy="328" r="2"/><circle cx="266" cy="354" r="1.8"/>
  </g>

  <!-- THỚ THỊT CUA: khối trắng ngà xếp nổi lên trên đống miến — vừa đủ để
       thấy là cua chứ không lấn hết sợi miến -->
  <use href="#mxcThit" transform="translate(180 318) rotate(-12) scale(.9)"/>
  <use href="#mxcThit" transform="translate(238 304) rotate(4) scale(.98)"/>
  <use href="#mxcThit" transform="translate(300 322) rotate(-8) scale(.86)"/>
  <use href="#mxcThit" transform="translate(214 350) rotate(6) scale(.92)"/>

  <!-- GIÁ ĐỖ trắng ló ra mép đống -->
  <use href="#mxcGia" transform="translate(140 352) rotate(-14)"/>
  <use href="#mxcGia" transform="translate(160 366) rotate(6)"/>
  <use href="#mxcGia" transform="translate(344 358) rotate(-172)"/>
  <use href="#mxcGia" transform="translate(366 344) rotate(166)"/>
  <use href="#mxcGia" transform="translate(268 372) rotate(-6) scale(.9)"/>

  <!-- vụn trứng tráng vàng nhạt lẫn trong miến -->
  <g fill="#F5D888" stroke="#D9B558" stroke-width="1.2">
    <path d="M196 344 C 202 340 210 340 214 344 C 210 349 200 349 196 346 Z"/>
    <path d="M300 348 C 306 344 314 344 318 348 C 314 353 304 353 300 350 Z"/>
    <path d="M240 332 C 245 329 252 329 256 332 C 252 336 244 336 240 334 Z"/>
  </g>

  <!-- HÀNH PHI + rau mùi rắc mặt -->
  <g fill="#D89A38" stroke="#A86E1C" stroke-width="1">
    <path d="M188 316 a 6 3 0 0 1 10 -1 a 6 3 0 0 1 -10 1 Z"/>
    <path d="M262 328 a 5.6 2.9 0 0 1 9.4 -1 a 5.6 2.9 0 0 1 -9.4 1 Z"/>
    <path d="M318 314 a 5.6 2.9 0 0 1 9.4 -1 a 5.6 2.9 0 0 1 -9.4 1 Z"/>
    <path d="M226 362 a 5.4 2.8 0 0 1 9 -1 a 5.4 2.8 0 0 1 -9 1 Z"/>
  </g>
  <g transform="translate(286 300)">
    <path d="M0 4 L 2 -6" stroke="#2C5E2E" stroke-width="1.5"/>
    <path d="M0 -2 C -5 -10 -2 -19 6 -21 C 11 -14 9 -5 3 0 C 1 1 0 0 0 -2 Z" fill="#3E7B3A" stroke="#26521F" stroke-width="1.4"/>
    <path d="M-4 2 C -10 -3 -10 -11 -4 -15 C 1 -11 2 -4 -1 2 C -2 3 -3 3 -4 2 Z" fill="#4A8B3E" stroke="#26521F" stroke-width="1.3"/>
  </g>
  <g fill="#4E7B36">
    <ellipse cx="170" cy="336" rx="5.4" ry="2.4" transform="rotate(-14 170 336)"/>
    <ellipse cx="352" cy="330" rx="5" ry="2.2" transform="rotate(10 352 330)"/>
    <ellipse cx="246" cy="368" rx="4.8" ry="2.2" transform="rotate(-4 246 368)"/>
  </g>
  <!-- ớt lát điểm màu -->
  <g>
    <g transform="translate(154 322)"><circle r="4.6" fill="#D64B33" stroke="#A83722" stroke-width="1.5"/><circle r="2" fill="#F28C6E"/></g>
    <g transform="translate(370 326)"><circle r="4.2" fill="#D64B33" stroke="#A83722" stroke-width="1.4"/><circle r="1.8" fill="#F28C6E"/></g>
  </g>

  <!-- ĐẠO CỤ TRÁI: MAI CUA đỏ cam úp ngửa (chữ ký của món) -->
  <g transform="translate(84 404) rotate(-6)">
    <ellipse cx="0" cy="26" rx="52" ry="12" fill="rgba(15,26,14,.32)"/>
    <path d="M-46 6 C -44 -14 -26 -26 0 -26 C 26 -26 44 -14 46 6 C 40 20 22 26 0 26 C -22 26 -40 20 -46 6 Z"
          fill="url(#mxcMai)" stroke="#7E2810" stroke-width="2.4"/>
    <path d="M-38 2 C -34 -12 -20 -20 0 -20 C 20 -20 34 -12 38 2" fill="none" stroke="#F09570" stroke-width="2.4" stroke-linecap="round" opacity=".7"/>
    <g stroke="#8E3418" stroke-width="1.6" stroke-linecap="round" fill="none" opacity=".85">
      <path d="M-24 -4 C -22 4 -22 12 -25 18"/>
      <path d="M0 -10 C 2 0 2 12 0 20"/>
      <path d="M24 -4 C 22 4 22 12 25 18"/>
    </g>
    <!-- gai mép mai -->
    <g fill="#C24A24">
      <path d="M-46 4 L -53 1 L -45 -1 Z"/><path d="M-44 -6 L -51 -10 L -42 -11 Z"/>
      <path d="M46 4 L 53 1 L 45 -1 Z"/><path d="M44 -6 L 51 -10 L 42 -11 Z"/>
    </g>
    <!-- gạch còn dính trong mai -->
    <path d="M-16 8 C -6 2 10 2 18 8 C 10 14 -6 14 -16 10 Z" fill="url(#mxcGach)" stroke="#B0600F" stroke-width="1.6"/>
  </g>

  <!-- ĐẠO CỤ PHẢI: CÀNG CUA -->
  <g transform="translate(438 396) rotate(10)">
    <ellipse cx="-6" cy="30" rx="40" ry="10" fill="rgba(15,26,14,.3)"/>
    <!-- đốt càng -->
    <path d="M-38 22 C -30 8 -16 0 -2 0 C 6 0 10 6 6 12 C 0 20 -18 28 -30 30 C -36 31 -40 28 -38 22 Z"
          fill="url(#mxcMai)" stroke="#7E2810" stroke-width="2.2"/>
    <!-- kẹp trên + kẹp dưới -->
    <path d="M-2 0 C 12 -8 30 -10 40 -4 C 32 4 14 8 0 8 C -4 6 -5 2 -2 0 Z"
          fill="#E4643A" stroke="#7E2810" stroke-width="2.2"/>
    <path d="M0 8 C 12 8 28 10 36 16 C 26 22 10 20 0 14 C -3 12 -3 9 0 8 Z"
          fill="#C94E28" stroke="#7E2810" stroke-width="2"/>
    <path d="M-30 20 C -22 10 -10 4 0 3" fill="none" stroke="#F09570" stroke-width="2.2" stroke-linecap="round" opacity=".7"/>
    <circle cx="-22" cy="16" r="2.2" fill="#F5B79C" opacity=".8"/>
  </g>
</svg>
