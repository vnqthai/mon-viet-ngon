---
/* Canh sườn khoai tây cà rốt — CHỮ KÝ, phải tách khỏi CẢ canh bí đỏ (cùng
   gam cam) LẪN canh sườn bí đao (cùng đợt, cùng nền xanh họ "nuoc"):
   1) KHOANH CÀ RỐT VẼ HAI VÒNG ĐỒNG TÂM — lõi giữa sáng màu hơn viền ngoài.
      Canh bí đỏ là MÚI CONG đục màu, không có vòng tròn nào; đây là chỗ tách
      hai món ở cỡ thumbnail dù cùng gam cam.
   2) KHỐI KHOAI TÂY vẽ CÓ MẶT CẮT: mặt trên sáng, mặt bên tối, thành khối
      lập phương đặc — khác hẳn thanh bí đao trong veo của món cùng đợt
   3) nước canh HƠI ĐỤC ngả vàng, đứng giữa nước trong của bí đao và nước
      cam đặc của bí đỏ
   4) khúc sườn lộ ĐỐM XƯƠNG tròn trắng (canh bí đỏ dùng thịt bằm rắc hạt)
   5) đạo cụ: củ khoai tây nguyên và củ cà rốt có cuống lá
   id prefix "csk" */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Tô canh sườn khoai tây cà rốt: khối khoai tây vàng bở, khoanh cà rốt cam có lõi sáng và khúc sườn lộ xương">
  <defs>
    <linearGradient id="cskBroth" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#F3E2B4"/><stop offset="1" stop-color="#DCC383"/>
    </linearGradient>
    <linearGradient id="cskBowl" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#FDFAF0"/><stop offset="1" stop-color="#E9E2CC"/>
    </linearGradient>
    <!-- KHÚC SƯỜN: khối thịt + ĐẦU XƯƠNG TRẮNG LÒI HẲN RA khỏi đường bao.
         Bản đầu vẽ đốm xương tròn trên mặt khối, ở cỡ 260px chỉ còn là ô vuông nâu. -->
    <g id="cskSuon">
      <path d="M6 -18 C 6 -26 12 -31 19 -31 C 24 -31 27 -28 27 -24 C 30 -25 34 -23 34 -18
               C 34 -13 30 -10 25 -11 L 20 -4 L 4 -8 Z"
            fill="#FBF4E2" stroke="#A8834A" stroke-width="2.2" stroke-linejoin="round"/>
      <rect x="-24" y="-10" width="46" height="34" rx="8" fill="#CE9153" stroke="#8A5A22" stroke-width="2.5"/>
      <path d="M-22 -4 C -10 -11 10 -12 20 -8 L 20 -2 C 10 -6 -10 -5 -20 1 Z" fill="#F0DDB4"/>
      <path d="M-14 6 L -17 18" stroke="#A96F2E" stroke-width="2.4" stroke-linecap="round"/>
      <path d="M-2 8 L -5 19" stroke="#A96F2E" stroke-width="2" stroke-linecap="round" opacity=".8"/>
      <path d="M10 6 L 8 17" stroke="#A96F2E" stroke-width="2" stroke-linecap="round" opacity=".7"/>
    </g>
    <!-- KHOANH CÀ RỐT: hai vòng đồng tâm, lõi giữa sáng hơn -->
    <g id="cskCaRot">
      <circle cx="0" cy="0" r="15" fill="#E4762A" stroke="#A94B12" stroke-width="2.1"/>
      <circle cx="0" cy="0" r="9.4" fill="#F5A44E" stroke="#C86A1E" stroke-width="1.6"/>
      <circle cx="0" cy="0" r="3.6" fill="#F9C782"/>
      <path d="M-10 -8 C -5 -12 5 -12 10 -8" fill="none" stroke="#F6A860" stroke-width="1.8" stroke-linecap="round" opacity=".8"/>
    </g>
    <!-- KHỐI KHOAI TÂY: lập phương bo góc, mặt trên sáng và mặt bên tối -->
    <g id="cskKhoai">
      <path d="M-17 -6 L 0 -15 L 17 -6 L 17 8 L 0 17 L -17 8 Z" fill="#E8C86A" stroke="#B08A22" stroke-width="2.2" stroke-linejoin="round"/>
      <path d="M-17 -6 L 0 -15 L 17 -6 L 0 3 Z" fill="#F6E2A4" stroke="#B08A22" stroke-width="1.8" stroke-linejoin="round"/>
      <path d="M0 3 L 0 17" stroke="#B08A22" stroke-width="1.8"/>
      <path d="M0 3 L 17 -6" fill="none" stroke="#CBA43E" stroke-width="1.4"/>
      <path d="M4 8 L 12 3" stroke="#D8B95A" stroke-width="1.4" stroke-linecap="round"/>
    </g>
  </defs>
  <circle cx="260" cy="240" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="240" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <g class="steam">
    <path d="M208 228 C 197 204 223 188 212 162 C 205 146 219 134 215 118"/>
    <path d="M272 222 C 262 198 288 184 277 158 C 270 142 284 130 280 114"/>
    <path d="M334 230 C 324 206 350 192 339 166 C 332 150 346 138 342 122"/>
  </g>
  <ellipse cx="258" cy="420" rx="196" ry="24" fill="rgba(15,26,14,.35)"/>

  <!-- tô -->
  <path d="M76 296 C 82 366 162 410 258 410 C 354 410 434 366 440 296 Z" fill="url(#cskBowl)"/>
  <ellipse cx="258" cy="408" rx="60" ry="10" fill="#D8D0B6"/>
  <ellipse cx="258" cy="294" rx="184" ry="45" fill="#F6F1E1"/>
  <ellipse cx="258" cy="294" rx="184" ry="45" fill="none" stroke="#2C5234" stroke-width="5"/>
  <ellipse cx="258" cy="295" rx="170" ry="39" fill="none" stroke="#E0A32E" stroke-width="2.5" stroke-dasharray="2 11" stroke-linecap="round"/>

  <!-- nước canh hơi đục ngả vàng -->
  <ellipse cx="258" cy="297" rx="156" ry="33" fill="url(#cskBroth)"/>
  <ellipse cx="198" cy="288" rx="50" ry="8.4" fill="#F8EFC8" opacity=".75"/>
  <g fill="#F6D98F" opacity=".7">
    <ellipse cx="168" cy="306" rx="7" ry="3"/><ellipse cx="348" cy="296" rx="6" ry="2.6"/>
    <ellipse cx="268" cy="320" rx="5.6" ry="2.4"/>
  </g>
  <!-- bóng các khối hằn xuống nước -->
  <g fill="rgba(96,64,10,.22)">
    <ellipse cx="192" cy="300" rx="24" ry="7"/><ellipse cx="268" cy="294" rx="26" ry="7"/>
    <ellipse cx="336" cy="302" rx="22" ry="6"/><ellipse cx="226" cy="322" rx="24" ry="7"/>
    <ellipse cx="308" cy="324" rx="24" ry="7"/>
  </g>

  <!-- KHÚC SƯỜN lộ đầu xương -->
  <use href="#cskSuon" transform="translate(190 284) rotate(-9)"/>
  <use href="#cskSuon" transform="translate(346 296) rotate(10) scale(.88)"/>

  <!-- KHỐI KHOAI TÂY và KHOANH CÀ RỐT xen kẽ, chồng mép cho liền đống.
       Phóng to hơn bản đầu — ở cỡ 260px khối nhỏ đọc thành hạt lấm tấm. -->
  <use href="#cskKhoai" transform="translate(252 296) rotate(-5) scale(1.08)"/>
  <use href="#cskCaRot" transform="translate(298 286) rotate(8) scale(1.06)"/>
  <use href="#cskKhoai" transform="translate(154 306) rotate(9)"/>
  <use href="#cskCaRot" transform="translate(210 318) rotate(-6)"/>
  <use href="#cskKhoai" transform="translate(306 320) rotate(-10)"/>
  <use href="#cskCaRot" transform="translate(366 306) rotate(12) scale(.94)"/>
  <use href="#cskKhoai" transform="translate(384 286) rotate(6) scale(.86)"/>
  <use href="#cskCaRot" transform="translate(132 288) rotate(-12) scale(.86)"/>

  <!-- hành lá cắt khúc + ngò -->
  <g stroke="#6F9C48" stroke-width="3.4" stroke-linecap="round" fill="none">
    <path d="M228 270 q11 -5 20 -3"/><path d="M320 266 q11 -4 19 -2"/>
    <path d="M180 330 q10 -3 18 -2"/><path d="M336 330 q10 -4 18 -2"/>
  </g>
  <g fill="#4E7B36">
    <ellipse cx="268" cy="264" rx="6" ry="2.8" transform="rotate(-14 268 264)"/>
    <ellipse cx="204" cy="288" rx="5.4" ry="2.5" transform="rotate(14 204 288)"/>
    <ellipse cx="284" cy="330" rx="5.2" ry="2.4" transform="rotate(-8 284 330)"/>
  </g>
  <g fill="#2E2318"><circle cx="240" cy="306" r="1.5"/><circle cx="326" cy="300" r="1.4"/></g>

  <!-- ĐẠO CỤ TRÁI: củ khoai tây nguyên, vỏ mộc có mắt -->
  <g transform="translate(88 406) rotate(-10)">
    <ellipse cx="0" cy="26" rx="44" ry="10" fill="rgba(15,26,14,.32)"/>
    <path d="M-38 -2 C -38 -20 -18 -30 4 -28 C 28 -26 40 -12 38 4 C 36 20 16 28 -6 25 C -26 22 -38 12 -38 -2 Z"
          fill="#C99C52" stroke="#8E6A22" stroke-width="2.6"/>
    <path d="M-28 -8 C -14 -18 8 -20 24 -13" fill="none" stroke="#E0BC7A" stroke-width="3" stroke-linecap="round" opacity=".8"/>
    <g fill="#8E6A22">
      <ellipse cx="-14" cy="6" rx="3" ry="2" transform="rotate(-16 -14 6)"/>
      <ellipse cx="10" cy="-4" rx="2.8" ry="1.9" transform="rotate(20 10 -4)"/>
      <ellipse cx="18" cy="12" rx="2.6" ry="1.8"/>
    </g>
  </g>

  <!-- ĐẠO CỤ PHẢI: củ cà rốt còn cuống lá + một khoanh đã cắt -->
  <g transform="translate(434 400) rotate(12)">
    <ellipse cx="-4" cy="34" rx="44" ry="10" fill="rgba(15,26,14,.32)"/>
    <path d="M-34 -12 C -18 -20 6 -20 22 -14 C 30 -10 32 -2 26 6 C 16 18 -8 24 -24 18 C -36 13 -40 -6 -34 -12 Z"
          fill="#E4762A" stroke="#A94B12" stroke-width="2.6"/>
    <g stroke="#C86A1E" stroke-width="1.8" stroke-linecap="round">
      <path d="M-22 -8 L -20 10"/><path d="M-8 -12 L -6 14"/><path d="M6 -12 L 8 12"/>
    </g>
    <g stroke="#4E7B36" stroke-width="4" stroke-linecap="round" fill="none">
      <path d="M24 -14 C 34 -22 44 -22 50 -16"/>
      <path d="M22 -12 C 32 -26 42 -30 50 -28"/>
    </g>
    <use href="#cskCaRot" transform="translate(-42 24) rotate(-14) scale(.9)"/>
  </g>
</svg>
