    <ellipse cx="0" cy="3" rx="34" ry="8.5" fill="#F6F1E1"/>
    <use href="#mgRam" transform="translate(-24 0) rotate(-14)"/>
    <use href="#mgRam" transform="translate(-8 6) rotate(8) scale(.95)"/>
    <use href="#mgRam" transform="translate(2 -4) rotate(-4) scale(.9)"/>
    <path d="M-26 4 C -12 1 6 0 20 2" fill="none" stroke="#2C5E2E" stroke-width="1.4" stroke-linecap="round"/>
  </g>

  <!-- ĐẠO CỤ PHẢI: hũ hành phi -->
  <g transform="translate(424 386)">
    <ellipse cx="0" cy="36" rx="38" ry="10" fill="rgba(15,26,14,.3)"/>
    <path d="M-26 -14 L 26 -14 L 22 30 C 21.6 33.4 18.6 35 14 35 L -14 35 C -18.6 35 -21.6 33.4 -22 30 Z"
          fill="#F3EBD4" stroke="#C7B98E" stroke-width="2.2" opacity=".92"/>
    <rect x="-29" y="-22" width="58" height="10" rx="3.6" fill="#D9B36A" stroke="#B08A45" stroke-width="2"/>
    <!-- hành phi bên trong -->
    <g fill="#D89A38" stroke="#A86E1C" stroke-width="1">
      <path d="M-16 6 a 7 3.4 0 0 1 12 -1 a 7 3.4 0 0 1 -12 1 Z"/>
      <path d="M-2 12 a 7 3.4 0 0 1 12 -1 a 7 3.4 0 0 1 -12 1 Z"/>
      <path d="M-14 20 a 6.4 3.2 0 0 1 11 -1 a 6.4 3.2 0 0 1 -11 1 Z"/>
      <path d="M2 24 a 6 3 0 0 1 10 -1 a 6 3 0 0 1 -10 1 Z"/>
      <path d="M-6 -2 a 6 3 0 0 1 10 -1 a 6 3 0 0 1 -10 1 Z"/>
    </g>
    <g fill="#EFC069">
      <circle cx="10" cy="4" r="2"/><circle cx="-18" cy="13" r="1.8"/><circle cx="12" cy="18" r="1.8"/>
    </g>
    <path d="M-20 -8 C -8 -11 10 -11 20 -8" fill="none" stroke="#FFFDF4" stroke-width="2.4" stroke-linecap="round" opacity=".55"/>
  </g>
</svg>
