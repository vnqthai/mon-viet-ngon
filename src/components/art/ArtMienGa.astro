---
/* Miến gà kiểu Bắc — KHÁC PHỞ GÀ ở bốn chỗ, cố ý vẽ cho lệch hẳn:
   1) sợi MIẾN DONG xám trong mờ (không phải bánh phở trắng bản dẹp)
   2) thịt gà XÉ TAY tơi thớ (không phải lát chặt còn nguyên vành da vàng)
   3) MỘC NHĨ đen cuộn + NẤM HƯƠNG nâu — thứ phở gà không có
   4) rắc RAU RĂM lá thuôn nhọn (không phải sợi lá chanh thái chỉ)
   đạo cụ: dĩa rau răm + hũ hành phi (cố ý tránh dĩa chanh ớt của phở gà) */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Bát miến gà: sợi miến dong trong mờ, thịt gà xé tay, mộc nhĩ và nấm hương, rắc rau răm và hành phi">
  <defs>
    <linearGradient id="mgBroth" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#F2E5C0"/><stop offset="1" stop-color="#DCC48C"/>
    </linearGradient>
    <linearGradient id="mgBowl" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#FDFAF0"/><stop offset="1" stop-color="#E9E2CC"/>
    </linearGradient>
    <linearGradient id="mgGa" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#FCF6E6"/><stop offset="1" stop-color="#EADDBD"/>
    </linearGradient>
    <!-- lá rau răm: thuôn nhọn hai đầu, gân giữa, vệt sẫm hình chữ V -->
    <g id="mgRam">
      <path d="M0 0 C 5 -4 13 -5 19 -2 C 13 2 5 4 0 0 Z" fill="#3E7B3A" stroke="#26521F" stroke-width="1.3"/>
      <path d="M1 0 L 18 -1.6" stroke="#7FB35B" stroke-width="1" stroke-linecap="round"/>
      <path d="M7 -1.6 L 10 0.4 L 13 -2" fill="none" stroke="#1E4218" stroke-width="1.1" stroke-linecap="round"/>
    </g>
  </defs>
  <circle cx="260" cy="240" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="240" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <g class="steam">
    <path d="M196 226 C 185 202 211 186 200 160 C 193 144 207 132 203 116"/>
    <path d="M262 220 C 252 196 278 182 267 156 C 260 140 274 128 270 112"/>
    <path d="M326 228 C 316 204 342 190 331 164 C 324 148 338 136 334 120"/>
  </g>
  <ellipse cx="258" cy="420" rx="196" ry="24" fill="rgba(15,26,14,.35)"/>

  <!-- bát (cao và hẹp hơn tô phở một chút) -->
  <path d="M84 296 C 90 368 168 412 258 412 C 348 412 426 368 432 296 Z" fill="url(#mgBowl)"/>
  <ellipse cx="258" cy="410" rx="58" ry="10" fill="#D8D0B6"/>
  <ellipse cx="258" cy="294" rx="176" ry="44" fill="#F6F1E1"/>
  <ellipse cx="258" cy="294" rx="176" ry="44" fill="none" stroke="#2C5234" stroke-width="5"/>
  <ellipse cx="258" cy="295" rx="162" ry="38" fill="none" stroke="#E0A32E" stroke-width="2.5" stroke-dasharray="2 11" stroke-linecap="round"/>

  <!-- nước dùng trong, vàng rất nhạt -->
  <ellipse cx="258" cy="297" rx="148" ry="32" fill="url(#mgBroth)"/>
  <ellipse cx="196" cy="288" rx="46" ry="8" fill="#F7EDD2" opacity=".55"/>
  <g fill="#F6E4B0" opacity=".9">
    <circle cx="128" cy="296" r="2.8"/><circle cx="160" cy="318" r="2.3"/><circle cx="300" cy="322" r="2.5"/>
    <circle cx="382" cy="290" r="2.6"/><circle cx="360" cy="316" r="2.2"/><circle cx="340" cy="276" r="2"/>
  </g>

  <!-- SỢI MIẾN DONG: xám trong mờ, ĐẬM HƠN nước dùng để đọc ra là sợi;
       ba lớp chồng nhau + vài sợi vắt cong lên khỏi mặt nước -->
  <g fill="none" stroke="#8F836A" stroke-width="6" stroke-linecap="round" opacity=".85">
    <path d="M122 294 C 156 280 198 279 230 289"/>
    <path d="M132 310 C 168 296 212 295 246 305"/>
    <path d="M296 328 C 324 318 354 317 378 324"/>
    <path d="M330 290 C 358 280 388 281 408 290"/>
  </g>
  <g fill="none" stroke="#B7AA8A" stroke-width="5.4" stroke-linecap="round">
    <path d="M126 300 C 160 286 202 285 234 295"/>
    <path d="M140 316 C 176 302 218 301 252 311"/>
    <path d="M198 326 C 232 314 268 313 296 321"/>
    <path d="M324 296 C 354 285 386 286 406 295"/>
