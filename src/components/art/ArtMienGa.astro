    <path d="M144 314 C 178 301 218 300 250 309"/>
    <path d="M328 294 C 356 284 386 285 404 293"/>
    <path d="M190 287 C 200 269 220 262 242 267"/>
  </g>

  <!-- THỊT GÀ XÉ TAY: dải thịt DÀI MẢNH, mép lượn gợn như thớ tước ra,
       đầu tưa vài sợi nhỏ. Cố ý tránh dáng lát bầu dục — đó là của phở gà. -->
  <g stroke="#BE9F66" stroke-width="1.7" stroke-linejoin="round" fill="url(#mgGa)">
    <path d="M170 282 C 176 276 184 278 191 275 C 198 272 206 274 213 271 C 219 269 224 270 227 272
             C 229 274 228 277 225 278 C 219 281 212 280 205 283 C 198 286 191 285 184 288
             C 178 290 172 289 170 287 C 168 285 168 283 170 282 Z"/>
    <path d="M192 296 C 199 290 208 292 216 289 C 224 286 232 288 240 285 C 247 283 252 284 255 286
             C 257 288 256 291 253 292 C 246 295 239 294 231 297 C 223 300 216 299 208 302
             C 201 304 195 303 193 301 C 191 299 191 297 192 296 Z"/>
    <path d="M236 276 C 243 270 252 272 260 269 C 268 266 276 268 284 265 C 291 263 296 264 299 266
             C 301 268 300 271 297 272 C 290 275 283 274 275 277 C 267 280 260 279 252 282
             C 245 284 239 283 237 281 C 235 279 235 277 236 276 Z"/>
    <path d="M258 298 C 265 292 275 294 283 291 C 291 288 300 290 308 287 C 315 285 320 286 323 288
             C 325 290 324 293 321 294 C 314 297 306 296 298 299 C 290 302 282 301 274 304
             C 267 306 261 305 259 303 C 257 301 257 299 258 298 Z"/>
    <path d="M300 280 C 306 275 314 277 321 274 C 328 271 335 273 342 270 C 348 268 353 269 356 271
             C 358 273 357 276 354 277 C 348 280 341 279 334 282 C 327 285 320 284 313 287
             C 307 289 302 288 300 286 C 298 284 299 281 300 280 Z"/>
  </g>
  <!-- thớ xé chạy dọc + vài sợi tưa ở đầu miếng -->
  <g stroke="#D9C69B" stroke-width="1.2" stroke-linecap="round" fill="none" opacity=".95">
    <path d="M176 281 C 190 277 206 277 220 274"/>
    <path d="M198 295 C 212 291 230 291 246 288"/>
    <path d="M242 275 C 256 271 274 271 290 268"/>
    <path d="M264 297 C 280 293 298 293 314 290"/>
    <path d="M306 279 C 320 275 336 275 348 273"/>
  </g>
  <g stroke="#E7D8B4" stroke-width="1.6" stroke-linecap="round" fill="none">
    <path d="M227 274 l 7 -1.5 M255 288 l 7 -1.5 M299 268 l 7 -1.5 M323 290 l 7 -1.5 M356 273 l 6 -1.4"/>
  </g>

  <!-- MỘC NHĨ: dải đen cuộn sóng, mép gợn -->
  <g fill="#3B2A22" stroke="#221610" stroke-width="1.6">
    <path d="M148 328 C 158 320 172 318 184 322 C 180 330 170 334 160 334 C 154 334 150 332 148 328 Z"/>
    <path d="M262 336 C 272 328 288 327 300 331 C 296 339 284 343 274 342 C 268 342 264 340 262 336 Z"/>
    <path d="M330 310 C 340 303 354 302 364 306 C 360 313 350 317 341 316 C 335 316 332 313 330 310 Z"/>
  </g>
  <g fill="none" stroke="#6B5244" stroke-width="1.4" stroke-linecap="round" opacity=".9">
    <path d="M154 327 C 164 322 174 322 180 324"/>
    <path d="M268 335 C 280 330 290 330 296 332"/>
    <path d="M336 309 C 346 305 355 305 360 307"/>
  </g>

  <!-- NẤM HƯƠNG: cánh nâu tròn, mặt trên có khía chữ thập nhạt -->
  <g>
    <g transform="translate(216 306)">
      <ellipse cx="0" cy="0" rx="17" ry="11" fill="#8A5A34" stroke="#5E3A1E" stroke-width="2"/>
      <path d="M-12 -3 C -6 -8 6 -8 12 -3" fill="none" stroke="#B07C4C" stroke-width="1.8" stroke-linecap="round"/>
      <path d="M-6 2 L 5 -4 M -3 5 L 8 0" stroke="#5E3A1E" stroke-width="1.3" stroke-linecap="round"/>
    </g>
    <g transform="translate(322 296) rotate(-8)">
      <ellipse cx="0" cy="0" rx="14" ry="9.5" fill="#7E5230" stroke="#573619" stroke-width="1.9"/>
      <path d="M-10 -2.5 C -5 -7 5 -7 10 -2.5" fill="none" stroke="#A97648" stroke-width="1.6" stroke-linecap="round"/>
      <path d="M-5 2 L 4 -3" stroke="#573619" stroke-width="1.2" stroke-linecap="round"/>
    </g>
  </g>

  <!-- hành hoa xắt nhỏ, thưa -->
  <g fill="#4E7B36">
    <ellipse cx="176" cy="300" rx="5.5" ry="2.4" transform="rotate(-14 176 300)"/>
    <ellipse cx="292" cy="312" rx="5" ry="2.2" transform="rotate(10 292 312)"/>
    <ellipse cx="358" cy="286" rx="4.6" ry="2.1" transform="rotate(-6 358 286)"/>
  </g>

  <!-- RAU RĂM rắc trên mặt: lá thuôn nhọn nằm rải, KHÔNG phải sợi chỉ -->
  <use href="#mgRam" transform="translate(186 268) rotate(-16)"/>
  <use href="#mgRam" transform="translate(230 260) rotate(6) scale(.9)"/>
  <use href="#mgRam" transform="translate(268 282) rotate(-8)"/>
  <use href="#mgRam" transform="translate(310 268) rotate(14) scale(.92)"/>
  <use href="#mgRam" transform="translate(206 300) rotate(20) scale(.85)"/>
  <use href="#mgRam" transform="translate(336 302) rotate(-12) scale(.88)"/>

  <!-- HÀNH PHI vàng giòn rắc khắp mặt -->
  <g fill="#D89A38" stroke="#A86E1C" stroke-width="1">
    <path d="M162 286 a 6 3 0 0 1 10 -1 a 6 3 0 0 1 -10 1 Z"/>
    <path d="M248 306 a 5.5 2.8 0 0 1 9 -1 a 5.5 2.8 0 0 1 -9 1 Z"/>
    <path d="M300 292 a 5.5 2.8 0 0 1 9 -1 a 5.5 2.8 0 0 1 -9 1 Z"/>
    <path d="M366 306 a 5 2.6 0 0 1 8.5 -1 a 5 2.6 0 0 1 -8.5 1 Z"/>
    <path d="M198 316 a 5 2.6 0 0 1 8.5 -1 a 5 2.6 0 0 1 -8.5 1 Z"/>
  </g>
  <g fill="#EFC069">
    <circle cx="222" cy="292" r="1.7"/><circle cx="284" cy="272" r="1.6"/><circle cx="344" cy="320" r="1.6"/><circle cx="176" cy="322" r="1.5"/>
  </g>

  <!-- ĐẠO CỤ TRÁI: dĩa nhỏ đựng nhúm rau răm để thêm -->
  <g transform="translate(100 402)">
    <ellipse cx="0" cy="14" rx="50" ry="12" fill="rgba(15,26,14,.3)"/>
