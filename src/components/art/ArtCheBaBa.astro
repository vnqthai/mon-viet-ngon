---
/* Chè bà ba — CHỮ KÝ nhận dạng, cố ý vẽ lệch hẳn bốn món chè kia:
   1) TÔ SỨ RỘNG MIỆNG NÔNG — bốn món kia: ly cao (chè bưởi), ly thấp thành dày
      (chè Thái), tô sâu lòng (đậu xanh bột báng), ly loe (đậu đỏ)
   2) KHỐI VUÔNG BA MÀU nổi rõ: khoai lang CAM, khoai môn TÍM vân, khoai mì TRẮNG
      — cái tên "bà ba" nằm ở chỗ nhiều màu, nên đây phải là tín hiệu mạnh nhất
   3) nước cốt dừa TRẮNG ĐỤC, không trong
   4) đạo cụ trái: củ KHOAI MÔN bổ đôi lộ vân tím — nói ngay món này làm từ khoai
   Đống chè vẽ MỘT KHỐI liền trước, rồi mới đắp từng miếng chồng mép lên.
   id prefix "cbb" */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Tô chè bà ba nóng: khối khoai lang cam, khoai môn tím và khoai mì trắng cùng hạt bột báng trong nước cốt dừa trắng đục, bên cạnh là củ khoai môn bổ đôi lộ vân tím">
  <defs>
    <linearGradient id="cbbBowl" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#FDFAF0"/><stop offset="1" stop-color="#D9D1B6"/>
    </linearGradient>
    <linearGradient id="cbbBroth" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#F6EEDA"/><stop offset="1" stop-color="#DCCEA8"/>
    </linearGradient>
    <!-- Khối nền của đống chè phải SẪM hơn nước cốt dừa hẳn một bậc: bản 1 để
         gần bằng nhau nên mấy miếng khoai đọc thành giấy vụn rải trên mặt nước
         chứ không ra một đống. -->
    <linearGradient id="cbbMound" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#C8B078"/><stop offset="1" stop-color="#96794A"/>
    </linearGradient>
    <linearGradient id="cbbLang" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#EE9A34"/><stop offset="1" stop-color="#B4600F"/>
    </linearGradient>
    <linearGradient id="cbbMon" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#CDB4DC"/><stop offset="1" stop-color="#9A7BAE"/>
    </linearGradient>
    <linearGradient id="cbbMi" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#FBF5E4"/><stop offset="1" stop-color="#DFD3B4"/>
    </linearGradient>
    <!-- miếng khoai môn: khối vuông tím có vân sẫm, dấu nhận diện nằm ở VÂN -->
    <g id="cbbTaro">
      <path d="M-17 -13 L 15 -16 L 18 12 L -14 15 Z" fill="url(#cbbMon)" stroke="#6B4C82" stroke-width="2.2" stroke-linejoin="round"/>
      <g stroke="#6B4C82" stroke-width="2" stroke-linecap="round">
        <path d="M-10 -9 L -6 10"/><path d="M2 -12 L 5 8"/><path d="M11 -13 L 13 6"/>
      </g>
    </g>
  </defs>

  <circle cx="260" cy="240" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="240" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <!-- KHÔNG vẽ khói: chè bà ba ăn nóng hay để ngăn mát ăn lạnh đều đúng, nên
       vẽ khói là đóng đinh món vào một cách ăn. -->
  <ellipse cx="270" cy="412" rx="188" ry="24" fill="rgba(15,26,14,.35)"/>

  <!-- ĐẠO CỤ TRÁI: hai củ BỔ ĐÔI nằm ngửa mặt cắt lên. Bản 1 vẽ một củ khoai
       môn đứng, ở 260px đọc thành hòn đá. Nằm ngửa + ruột CAM RỰC thì nhận ra
       ngay là khoai, mà cũng nói luôn nồi chè làm từ gì. -->
  <g transform="translate(96 372)">
    <!-- khoai môn bổ đôi (lớp sau, lệch trái và cao hơn) -->
    <g transform="translate(-16 -30) rotate(-14)">
      <ellipse cx="0" cy="0" rx="42" ry="26" fill="#7A5B3C" stroke="#4A3320" stroke-width="2.8"/>
      <ellipse cx="0" cy="-2" rx="35" ry="20" fill="#F1E9F0" stroke="#B7A3C4" stroke-width="2.4"/>
      <g fill="#8A6BA0">
        <ellipse cx="-16" cy="-6" rx="4.4" ry="3" transform="rotate(-20 -16 -6)"/>
        <ellipse cx="-2" cy="4" rx="4" ry="2.6" transform="rotate(12 -2 4)"/>
        <ellipse cx="14" cy="-7" rx="4.6" ry="3" transform="rotate(-8 14 -7)"/>
        <ellipse cx="22" cy="5" rx="3.4" ry="2.4" transform="rotate(18 22 5)"/>
        <ellipse cx="-24" cy="6" rx="3.6" ry="2.4" transform="rotate(-4 -24 6)"/>
        <ellipse cx="4" cy="-11" rx="3.2" ry="2.2" transform="rotate(24 4 -11)"/>
      </g>
    </g>
    <!-- khoai lang bổ đôi (lớp trước, ruột CAM — tín hiệu mạnh nhất của đạo cụ).
         Bản 2 vẽ hình bầu dục cân đối nên đọc thành lát cam; củ khoai phải
         THUÔN DÀI, hai đầu nhỏ dần và không đầu nào giống đầu nào. -->
    <g transform="translate(12 24) rotate(11)">
      <ellipse cx="2" cy="28" rx="60" ry="11" fill="rgba(15,26,14,.3)"/>
      <path d="M-72 4 C -66 -12 -40 -23 -6 -25 C 30 -27 62 -17 72 -3 C 66 14 38 26 2 26 C -34 26 -68 19 -72 4 Z"
            fill="#8E4520" stroke="#54270C" stroke-width="2.6"/>
      <path d="M-63 4 C -58 -9 -36 -18 -6 -19 C 26 -21 54 -12 63 -2 C 57 11 34 20 2 20 C -30 20 -60 15 -63 4 Z"
            fill="#EE9A34" stroke="#B4600F" stroke-width="2.2"/>
      <g fill="none" stroke="#F8C578" stroke-width="2.2" stroke-linecap="round" opacity=".85">
        <path d="M-44 -5 C -24 -12 18 -13 42 -6"/>
        <path d="M-38 10 C -18 15 20 14 44 6"/>
      </g>
    </g>
  </g>

  <!-- TÔ SỨ rộng miệng, nông -->
  <path d="M92 300 C 100 366 168 400 262 400 C 356 400 424 366 432 300 Z"
        fill="url(#cbbBowl)" stroke="#B7AE8E" stroke-width="3"/>
  <path d="M92 300 C 100 366 168 400 262 400 C 356 400 424 366 432 300"
        fill="none" stroke="#2C5234" stroke-width="4.5"/>
  <ellipse cx="262" cy="300" rx="170" ry="42" fill="#F3EDDA" stroke="#B7AE8E" stroke-width="3"/>
  <ellipse cx="262" cy="301" rx="155" ry="35" fill="none" stroke="#E0A32E" stroke-width="2.4" stroke-dasharray="2 11" stroke-linecap="round"/>

  <!-- NƯỚC CỐT DỪA trắng đục -->
  <ellipse cx="262" cy="303" rx="146" ry="33" fill="url(#cbbBroth)"/>
  <!-- váng dừa loang trên mặt nước -->
  <g fill="#FCF7E8" opacity=".8">
    <ellipse cx="182" cy="298" rx="20" ry="6"/>
    <ellipse cx="330" cy="312" rx="17" ry="5"/>
    <ellipse cx="372" cy="296" rx="12" ry="4"/>
  </g>

  <!-- ĐỐNG CHÈ: một khối liền làm nền trước, rồi mới đắp miếng chồng lên -->
  <path d="M132 296 C 150 258 196 240 258 240 C 322 240 372 258 392 296 C 372 322 320 334 258 334 C 196 334 152 322 132 296 Z"
        fill="url(#cbbMound)"/>

  <!-- khoai lang CAM — miếng to nhất, đặt lệch trái -->
  <g stroke="#8C4A0B" stroke-width="2.4" stroke-linejoin="round">
    <path d="M162 292 L 196 282 L 204 312 L 170 322 Z" fill="url(#cbbLang)"/>
    <path d="M236 260 L 272 254 L 278 282 L 242 289 Z" fill="url(#cbbLang)"/>
    <path d="M310 300 L 344 292 L 352 320 L 318 328 Z" fill="url(#cbbLang)"/>
  </g>
  <g fill="none" stroke="#F7C071" stroke-width="2" stroke-linecap="round" opacity=".85">
    <path d="M170 292 L 190 288"/><path d="M244 264 L 266 260"/><path d="M318 302 L 340 298"/>
  </g>

  <!-- khoai môn TÍM có vân — tín hiệu mạnh thứ hai -->
  <use href="#cbbTaro" transform="translate(214 294) rotate(-8)"/>
  <use href="#cbbTaro" transform="translate(292 268) rotate(11) scale(.92)"/>
  <use href="#cbbTaro" transform="translate(266 318) rotate(-4) scale(.88)"/>
  <use href="#cbbTaro" transform="translate(360 274) rotate(16) scale(.8)"/>

  <!-- khoai mì TRẮNG — khối trơn, không vân, để tách khỏi khoai môn -->
  <g stroke="#B9AC88" stroke-width="2.2" stroke-linejoin="round">
    <path d="M186 258 L 218 250 L 224 274 L 192 282 Z" fill="url(#cbbMi)"/>
    <path d="M320 254 L 350 248 L 355 270 L 325 277 Z" fill="url(#cbbMi)"/>
    <path d="M232 322 L 260 316 L 265 336 L 237 342 Z" fill="url(#cbbMi)"/>
  </g>

  <!-- HẠT BỘT BÁNG trong veo, tròn nhỏ — rải kín kẽ giữa các khối -->
  <g fill="rgba(255,253,244,.86)" stroke="#CBBF9C" stroke-width="1.4">
    <circle cx="152" cy="308" r="6"/><circle cx="206" cy="330" r="5.4"/>
    <circle cx="300" cy="246" r="5.6"/><circle cx="342" cy="330" r="6.2"/>
    <circle cx="378" cy="304" r="5"/><circle cx="252" cy="246" r="5"/>
    <circle cx="176" cy="278" r="4.6"/><circle cx="288" cy="336" r="5.2"/>
    <circle cx="368" cy="252" r="4.4"/><circle cx="140" cy="286" r="4.2"/>
  </g>

  <!-- hạt đậu xanh vàng lấm tấm -->
  <g fill="#E8C25E" stroke="#B08A1C" stroke-width="1.2">
    <ellipse cx="226" cy="276" rx="5" ry="3.6" transform="rotate(-16 226 276)"/>
    <ellipse cx="278" cy="300" rx="4.6" ry="3.4" transform="rotate(10 278 300)"/>
    <ellipse cx="332" cy="256" rx="4.4" ry="3.2" transform="rotate(-8 332 256)"/>
    <ellipse cx="196" cy="316" rx="4.2" ry="3" transform="rotate(18 196 316)"/>
    <ellipse cx="356" cy="312" rx="4.6" ry="3.4" transform="rotate(-12 356 312)"/>
  </g>

  <!-- đậu phộng và mè rang rắc mặt -->
  <g fill="#C9884A" stroke="#8A5A28" stroke-width="1.4">
    <path d="M240 236 C 246 230 254 233 254 240 C 253 247 244 249 240 244 Z"/>
    <path d="M306 232 C 312 227 319 230 319 236 C 318 242 310 244 306 240 Z"/>
    <path d="M188 244 C 194 239 200 242 200 248 C 199 253 192 254 188 250 Z"/>
  </g>

  <!-- CHÉN ĐẬU PHỘNG nhỏ (đạo cụ phải), cố ý thấp và bé hơn củ khoai bên trái -->
  <g transform="translate(448 384)">
    <ellipse cx="0" cy="20" rx="36" ry="9" fill="rgba(15,26,14,.3)"/>
    <path d="M-32 -4 C -30 12 -17 20 0 20 C 17 20 30 12 32 -4 Z" fill="#FDFAF0" stroke="#CFC6A6" stroke-width="2.2"/>
    <ellipse cx="0" cy="-4" rx="32" ry="9" fill="#F3EDDA" stroke="#CFC6A6" stroke-width="2"/>
    <g fill="#C9884A" stroke="#8A5A28" stroke-width="1.3">
      <path d="M-16 -6 C -10 -12 -2 -9 -2 -3 C -3 3 -12 4 -16 0 Z"/>
      <path d="M2 -8 C 8 -13 15 -10 15 -4 C 14 2 6 3 2 -1 Z"/>
      <path d="M-8 2 C -3 -2 3 0 3 5 C 2 9 -5 10 -8 6 Z"/>
    </g>
  </g>
</svg>
