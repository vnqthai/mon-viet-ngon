---
/* Cháo gà — CHỮ KÝ, vẽ lệch hẳn hai tô cháo kia:
   1) mặt cháo TRẮNG NGÀ ngả kem, sáng nhất trong ba tô
   2) THỊT GÀ XÉ tơi thớ + GỪNG THÁI SỢI vàng mảnh — không phải sợi lươn
      (cháo lươn) cũng không phải khoanh dồi (cháo lòng)
   3) hạt gạo RANG nên vẽ ngả vàng nhạt, tơi rời chứ không sánh đặc
   4) đạo cụ trái: ĐĨA QUẨY cắt khúc · phải: chén muối tiêu chanh
   id prefix "cga" */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Tô cháo gà: cháo trắng ngà, thịt gà xé tay, gừng thái sợi và hành lá, bên cạnh là đĩa quẩy và chén muối tiêu chanh">
  <defs>
    <linearGradient id="cgaChao" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#F6EDD4"/><stop offset="1" stop-color="#E2D3AC"/>
    </linearGradient>
    <linearGradient id="cgaBowl" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#FDFAF0"/><stop offset="1" stop-color="#E9E2CC"/>
    </linearGradient>
    <!-- thịt gà xé phải SẪM HƠN mặt cháo một bậc rõ rệt: bản trước gần trùng
         màu nền nên cả tô nhìn trống trơn -->
    <linearGradient id="cgaGa" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#F6E4BE"/><stop offset="1" stop-color="#D8BC84"/>
    </linearGradient>
    <!-- hạt gạo rang: thuôn, ngả vàng nhạt hơn cháo -->
    <g id="cgaGao">
      <path d="M0 0 C 1 -3.4 5 -4.8 7.6 -3.4 C 10 -2.2 10 1 7.6 2.2 C 5 3.6 1 2.8 0 0 Z"
            fill="#FBF3DC" stroke="#D6C193" stroke-width=".9"/>
      <path d="M7.6 -2.8 C 10.4 -4.2 12 -2.6 11.4 -0.8" fill="none" stroke="#EADFC0" stroke-width="1.1" stroke-linecap="round"/>
    </g>
  </defs>
  <circle cx="260" cy="240" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="240" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <g class="steam">
    <path d="M200 222 C 189 198 215 182 204 156 C 197 140 211 128 207 112"/>
    <path d="M262 216 C 252 192 278 178 267 152 C 260 136 274 124 270 108"/>
    <path d="M326 224 C 316 200 342 186 331 160 C 324 144 338 132 334 116"/>
  </g>
  <ellipse cx="258" cy="420" rx="192" ry="24" fill="rgba(15,26,14,.35)"/>

  <!-- tô sâu lòng hơn tô cháo lươn, miệng hẹp hơn chút -->
  <path d="M90 294 C 96 370 172 412 258 412 C 344 412 420 370 426 294 Z" fill="url(#cgaBowl)"/>
  <ellipse cx="258" cy="410" rx="56" ry="10" fill="#D8D0B6"/>
  <ellipse cx="258" cy="292" rx="172" ry="43" fill="#F6F1E1"/>
  <ellipse cx="258" cy="292" rx="172" ry="43" fill="none" stroke="#2C5234" stroke-width="5"/>
  <ellipse cx="258" cy="293" rx="158" ry="37" fill="none" stroke="#E0A32E" stroke-width="2.5" stroke-dasharray="2 11" stroke-linecap="round"/>

  <!-- MẶT CHÁO trắng ngà -->
  <ellipse cx="258" cy="295" rx="145" ry="31" fill="url(#cgaChao)"/>
  <ellipse cx="198" cy="286" rx="40" ry="7" fill="#FCF6E4" opacity=".8"/>
  <!-- mỡ hành vàng óng chan mặt tô -->
  <g fill="#E8BE58" opacity=".7">
    <ellipse cx="178" cy="302" rx="13" ry="4.2"/>
    <ellipse cx="306" cy="306" rx="11" ry="3.8"/>
    <ellipse cx="338" cy="286" rx="8" ry="3"/>
  </g>

  <!-- HẠT GẠO RANG rải khắp — tơi rời, không bết -->
  <use href="#cgaGao" transform="translate(146 294) rotate(-16)"/>
  <use href="#cgaGao" transform="translate(174 308) rotate(12)"/>
  <use href="#cgaGao" transform="translate(204 286) rotate(-4)"/>
  <use href="#cgaGao" transform="translate(224 314) rotate(22)"/>
  <use href="#cgaGao" transform="translate(258 302) rotate(-10)"/>
  <use href="#cgaGao" transform="translate(290 316) rotate(6)"/>
  <use href="#cgaGao" transform="translate(314 288) rotate(-20)"/>
  <use href="#cgaGao" transform="translate(344 304) rotate(14)"/>
  <use href="#cgaGao" transform="translate(366 292) rotate(-2)"/>
  <use href="#cgaGao" transform="translate(236 278) rotate(8)"/>
  <use href="#cgaGao" transform="translate(134 306) rotate(4)"/>

  <!-- THỊT GÀ XÉ TAY: dải dài mảnh, mép gợn, đầu tưa vài sợi -->
  <g stroke="#A5854A" stroke-width="1.9" stroke-linejoin="round" fill="url(#cgaGa)">
    <path d="M164 284 C 170 278 178 280 185 277 C 192 274 200 276 207 273 C 213 271 218 272 221 274
             C 223 276 222 279 219 280 C 213 283 206 282 199 285 C 192 288 185 287 178 290
             C 172 292 166 291 164 289 C 162 287 162 285 164 284 Z"/>
    <path d="M190 300 C 197 294 206 296 214 293 C 222 290 230 292 238 289 C 245 287 250 288 253 290
             C 255 292 254 295 251 296 C 244 299 237 298 229 301 C 221 304 214 303 206 306
             C 199 308 193 307 191 305 C 189 303 189 301 190 300 Z"/>
    <path d="M238 278 C 245 272 254 274 262 271 C 270 268 278 270 286 267 C 293 265 298 266 301 268
             C 303 270 302 273 299 274 C 292 277 285 276 277 279 C 269 282 262 281 254 284
             C 247 286 241 285 239 283 C 237 281 237 279 238 278 Z"/>
    <path d="M262 302 C 269 296 279 298 287 295 C 295 292 304 294 312 291 C 319 289 324 290 327 292
             C 329 294 328 297 325 298 C 318 301 310 300 302 303 C 294 306 286 305 278 308
             C 271 310 265 309 263 307 C 261 305 261 303 262 302 Z"/>
    <path d="M302 282 C 308 277 316 279 323 276 C 330 273 337 275 344 272 C 350 270 355 271 358 273
             C 360 275 359 278 356 279 C 350 282 343 281 336 284 C 329 287 322 286 315 289
             C 309 291 304 290 302 288 C 300 286 301 283 302 282 Z"/>
  </g>
  <g stroke="#BC9A5C" stroke-width="1.3" stroke-linecap="round" fill="none" opacity=".95">
    <path d="M170 283 C 184 279 200 279 214 276"/>
    <path d="M196 299 C 210 295 228 295 244 292"/>
    <path d="M244 277 C 258 273 276 273 292 270"/>
    <path d="M268 301 C 284 297 302 297 318 294"/>
    <path d="M308 281 C 322 277 338 277 350 275"/>
  </g>
  <g stroke="#EDE0BF" stroke-width="1.6" stroke-linecap="round" fill="none">
    <path d="M221 276 l 7 -1.5 M253 292 l 7 -1.5 M301 270 l 7 -1.5 M327 294 l 7 -1.5 M358 275 l 6 -1.4"/>
  </g>

  <!-- GỪNG THÁI SỢI: sợi mảnh vàng nhạt, rải trên mặt — chữ ký của tô cháo gà -->
  <g stroke="#D79A22" stroke-width="2.8" stroke-linecap="round">
    <path d="M186 268 L 210 262"/>
    <path d="M214 272 L 236 265"/>
    <path d="M266 266 L 290 261"/>
    <path d="M300 274 L 322 268"/>
    <path d="M176 296 L 198 291"/>
    <path d="M330 296 L 350 291"/>
    <path d="M244 314 L 266 309"/>
  </g>
  <g stroke="#F7E3A6" stroke-width="1.1" stroke-linecap="round">
    <path d="M188 267 L 208 261.6"/>
    <path d="M268 265 L 288 260.4"/>
    <path d="M302 273 L 320 267.6"/>
  </g>

  <!-- hành lá xắt nhỏ + ngò -->
  <g fill="#4E7B36">
    <ellipse cx="200" cy="304" rx="5.4" ry="2.4" transform="rotate(-14 200 304)"/>
    <ellipse cx="284" cy="288" rx="5" ry="2.2" transform="rotate(10 284 288)"/>
    <ellipse cx="344" cy="312" rx="4.6" ry="2.1" transform="rotate(-6 344 312)"/>
    <ellipse cx="160" cy="290" rx="4.8" ry="2.2" transform="rotate(16 160 290)"/>
  </g>
  <g fill="#5C9440" stroke="#3B6B2A" stroke-width="1">
    <path d="M228 258 C 232 253 240 252 244 256 C 240 261 232 262 228 258 Z"/>
    <path d="M318 258 C 322 253 330 252 334 256 C 330 261 322 262 318 258 Z"/>
  </g>

  <!-- HÀNH PHI vàng giòn -->
  <g fill="#D89A38" stroke="#A86E1C" stroke-width="1">
    <path d="M212 292 a 5.6 2.8 0 0 1 9.4 -1 a 5.6 2.8 0 0 1 -9.4 1 Z"/>
    <path d="M296 296 a 5.2 2.6 0 0 1 8.8 -1 a 5.2 2.6 0 0 1 -8.8 1 Z"/>
    <path d="M172 314 a 5 2.5 0 0 1 8.4 -1 a 5 2.5 0 0 1 -8.4 1 Z"/>
  </g>

  <!-- TIÊU rắc -->
  <g fill="#3B2A22">
    <circle cx="238" cy="292" r="1.7"/><circle cx="276" cy="312" r="1.6"/>
    <circle cx="322" cy="282" r="1.6"/><circle cx="190" cy="278" r="1.5"/>
    <circle cx="352" cy="302" r="1.4"/><circle cx="212" cy="322" r="1.5"/>
  </g>

  <!-- ĐẠO CỤ TRÁI: ĐĨA QUẨY cắt khúc — cặp đôi quen thuộc của cháo gà -->
  <g transform="translate(92 398)">
    <ellipse cx="0" cy="18" rx="54" ry="12" fill="rgba(15,26,14,.3)"/>
    <ellipse cx="0" cy="6" rx="50" ry="13" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2.2"/>
    <ellipse cx="0" cy="5" rx="38" ry="9" fill="#F6F1E1"/>
    <!-- ba khúc quẩy: hai thân dính nhau, mặt rỗ vàng nâu -->
    <g stroke="#A56E22" stroke-width="1.9">
      <g transform="translate(-20 -2) rotate(-12)">
        <rect x="-17" y="-9" width="34" height="8" rx="4" fill="#E3A94E"/>
        <rect x="-17" y="-1" width="34" height="8" rx="4" fill="#D99C3F"/>
        <path d="M-10 -6 L -6 -4 M 0 -6.4 L 4 -4.4 M 8 -6 L 12 -4" stroke="#B87F2A" stroke-width="1.1" stroke-linecap="round"/>
      </g>
      <g transform="translate(10 6) rotate(6)">
        <rect x="-17" y="-9" width="34" height="8" rx="4" fill="#E3A94E"/>
        <rect x="-17" y="-1" width="34" height="8" rx="4" fill="#D99C3F"/>
        <path d="M-9 -6 L -5 -4 M 2 -6.4 L 6 -4.4" stroke="#B87F2A" stroke-width="1.1" stroke-linecap="round"/>
      </g>
      <g transform="translate(-4 -12) rotate(-2) scale(.92)">
        <rect x="-17" y="-9" width="34" height="8" rx="4" fill="#EBB65C"/>
        <rect x="-17" y="-1" width="34" height="8" rx="4" fill="#E0A648"/>
      </g>
    </g>
  </g>

  <!-- ĐẠO CỤ PHẢI: chén muối tiêu chanh + miếng chanh -->
  <g transform="translate(438 394)">
    <ellipse cx="0" cy="22" rx="38" ry="10" fill="rgba(15,26,14,.3)"/>
    <path d="M-32 -4 C -30 12 -17 21 0 21 C 17 21 30 12 32 -4 Z" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2.2"/>
    <ellipse cx="0" cy="-4" rx="32" ry="9" fill="#F6F1E1" stroke="#D8D0B6" stroke-width="2"/>
    <!-- ụ muối tiêu trắng lấm tấm đen -->
    <path d="M-20 -4 C -16 -12 -2 -14 8 -12 C 16 -10 20 -7 20 -3 C 16 2 4 4 -6 3 C -14 2 -20 0 -20 -4 Z"
          fill="#F6F2E4" stroke="#CFC5A8" stroke-width="1.6"/>
    <g fill="#3B2A22">
      <circle cx="-12" cy="-6" r="1.5"/><circle cx="-2" cy="-9" r="1.4"/><circle cx="8" cy="-6" r="1.4"/>
      <circle cx="0" cy="-2" r="1.3"/><circle cx="12" cy="-3" r="1.2"/><circle cx="-16" cy="-2" r="1.2"/>
    </g>
    <!-- miếng chanh gác mép chén -->
    <g transform="translate(20 -10) rotate(18)">
      <path d="M0 0 A 12 12 0 0 1 -12 12 L 0 12 Z" fill="#D8E9A8" stroke="#5C8A2C" stroke-width="1.8" stroke-linejoin="round"/>
      <path d="M-1.4 3 L -3.6 11 M -4.6 5.6 L -7.6 11.2" stroke="#8FB45A" stroke-width="1.1" stroke-linecap="round"/>
    </g>
  </g>
</svg>
