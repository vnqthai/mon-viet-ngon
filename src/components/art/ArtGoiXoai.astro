  <!-- sợi ôm sát mép ngoài vai trái + chóp -->
  <g fill="none" stroke-linecap="round" stroke-width="6.5">
    <path d="M247 234 q-26 8 -44 30" stroke="#EFD37A"/>
    <path d="M228 244 q-20 12 -32 32" stroke="#BFD892"/>
    <path d="M209 262 q-16 12 -24 30" stroke="#EFD37A"/>
    <path d="M262 233 q-22 0 -42 14" stroke="#BFD892"/>
  </g>
  <!-- sợi ôm sườn phải -->
  <g fill="none" stroke-linecap="round" stroke-width="6">
    <path d="M290 252 q18 14 26 34" stroke="#EFD37A"/>
    <path d="M306 268 q16 14 22 32" stroke="#BFD892"/>
  </g>
  <!-- hàng sát chân che mép mô -->
  <g fill="none" stroke-linecap="round" stroke-width="6">
    <path d="M168 334 q28 -6 56 -5" stroke="#EFD37A"/>
    <path d="M228 338 q30 -5 60 -4" stroke="#BFD892"/>
    <path d="M292 336 q28 -4 54 -1" stroke="#EFD37A"/>
  </g>
  <!-- sợi lòi mép đống cho tơi -->
  <g fill="none" stroke-linecap="round" stroke-width="5">
    <path d="M166 306 q-10 -4 -18 0" stroke="#BFD892"/>
    <path d="M176 282 q-10 -6 -16 -12" stroke="#EFD37A"/>
    <path d="M344 306 q10 -2 18 4" stroke="#EFD37A"/>
    <path d="M334 282 q10 -4 18 -2" stroke="#BFD892"/>
    <path d="M272 242 q10 -4 20 -2" stroke="#EFD37A"/>
  </g>
  <!-- sợi vương ra dĩa -->
  <g fill="none" stroke-linecap="round" stroke-width="5">
    <path d="M224 344 q12 -3 24 -3" stroke="#EFD37A"/>
    <path d="M298 342 q12 -2 24 0" stroke="#BFD892"/>
    <path d="M144 340 q9 -5 19 -5" stroke="#EFD37A"/>
    <path d="M356 328 q10 -4 20 -2" stroke="#BFD892"/>
  </g>

  <!-- TÔM KHÔ: mảnh cam đậm cong, mập lùn (chữ ký của món) -->
  <g fill="none" stroke-linecap="round">
    <g transform="translate(224 258) rotate(-12)">
      <path d="M0 0 q6 -8 14 -8" stroke="#D9601C" stroke-width="7"/>
      <path d="M7 -6 l1.5 -4" stroke="#A84E12" stroke-width="1.5"/>
    </g>
    <g transform="translate(280 250) rotate(16)">
      <path d="M0 0 q6 -8 14 -8" stroke="#CE5716" stroke-width="7"/>
      <path d="M7 -6 l1.5 -4" stroke="#A84E12" stroke-width="1.5"/>
    </g>
    <g transform="translate(200 298) rotate(-30)">
      <path d="M0 0 q6 -8 14 -8" stroke="#D9601C" stroke-width="7"/>
    </g>
    <g transform="translate(312 290) rotate(6)">
      <path d="M0 0 q6 -8 14 -8" stroke="#D9601C" stroke-width="7"/>
      <path d="M7 -6 l1.5 -4" stroke="#A84E12" stroke-width="1.5"/>
    </g>
    <g transform="translate(250 284) rotate(-2)">
      <path d="M0 0 q6 -8 14 -8" stroke="#CE5716" stroke-width="7"/>
    </g>
    <g transform="translate(334 320) rotate(22)">
      <path d="M0 0 q6 -8 14 -8" stroke="#D9601C" stroke-width="7"/>
    </g>
    <g transform="translate(242 312) rotate(168)">
      <path d="M0 0 q6 -8 14 -8" stroke="#D9601C" stroke-width="7"/>
    </g>
  </g>

  <!-- rau răm thon nhọn -->
  <g>
    <g transform="translate(226 266) rotate(-20)">
      <path d="M0 0 C -3 -7 0 -15 6 -17 C 10 -12 9 -4 3 1 C 1 2 0 1 0 0 Z" fill="#3E7B3A" stroke="#2C5E2E" stroke-width="1.4"/>
    </g>
    <g transform="translate(278 262) rotate(18)">
      <path d="M0 0 C -3 -7 0 -15 6 -17 C 10 -12 9 -4 3 1 C 1 2 0 1 0 0 Z" fill="#4A8B3E" stroke="#2C5E2E" stroke-width="1.4"/>
    </g>
    <g transform="translate(240 300) rotate(-35)">
      <path d="M0 0 C -3 -6 0 -13 5 -15 C 9 -10 8 -3 3 1 C 1 2 0 1 0 0 Z" fill="#3E7B3A" stroke="#2C5E2E" stroke-width="1.3"/>
    </g>
    <g transform="translate(318 300) rotate(28)">
      <path d="M0 0 C -3 -6 0 -13 5 -15 C 9 -10 8 -3 3 1 C 1 2 0 1 0 0 Z" fill="#4A8B3E" stroke="#2C5E2E" stroke-width="1.3"/>
    </g>
    <g transform="translate(184 312) rotate(-6)">
      <path d="M0 0 C -3 -6 0 -13 5 -15 C 9 -10 8 -3 3 1 C 1 2 0 1 0 0 Z" fill="#3E7B3A" stroke="#2C5E2E" stroke-width="1.3"/>
    </g>
    <g transform="translate(342 336) rotate(14)">
      <path d="M0 0 C -3 -6 0 -13 5 -15 C 9 -10 8 -3 3 1 C 1 2 0 1 0 0 Z" fill="#3E7B3A" stroke="#2C5E2E" stroke-width="1.3"/>
    </g>
  </g>

  <!-- đậu phộng + hành phi -->
  <g>
    <g fill="#C9973F" stroke="#96702E" stroke-width="1.4">
      <circle cx="218" cy="320" r="3.8"/>
      <circle cx="266" cy="312" r="3.6"/>
      <circle cx="304" cy="278" r="3.6"/>
      <circle cx="242" cy="290" r="3.4"/>
      <circle cx="190" cy="306" r="3.6"/>
      <circle cx="286" cy="334" r="3.8"/>
    </g>
    <g fill="none" stroke="#E8C078" stroke-width="1.3" stroke-linecap="round">
      <path d="M216 318 a 3 3 0 0 1 4 -1"/>
      <path d="M302 276 a 3 3 0 0 1 4 -1"/>
      <path d="M284 332 a 3 3 0 0 1 4 -1"/>
    </g>
  </g>
  <g fill="#C98A2E" stroke="#96702E" stroke-width="1">
    <rect x="252" y="264" width="8" height="3.6" rx="1.8" transform="rotate(-18 256 266)"/>
    <rect x="212" y="288" width="8" height="3.6" rx="1.8" transform="rotate(22 216 290)"/>
    <rect x="296" y="308" width="8" height="3.6" rx="1.8" transform="rotate(-8 300 310)"/>
    <rect x="236" y="318" width="8" height="3.6" rx="1.8" transform="rotate(30 240 320)"/>
    <rect x="320" y="286" width="8" height="3.6" rx="1.8" transform="rotate(-24 324 288)"/>
  </g>

  <!-- ớt sừng sợi — ít, nằm trên sợi xoài -->
  <g fill="none" stroke="#D64B33" stroke-width="3.2" stroke-linecap="round">
    <path d="M176 300 q8 -6 18 -6"/>
    <path d="M262 324 q9 -4 18 -3"/>
  </g>

  <!-- trái xoài xanh nguyên trên bàn trái: vai tròn bên cuống, thuôn dần về mỏ -->
  <g transform="translate(86 402) rotate(-4)">
    <ellipse cx="0" cy="24" rx="54" ry="12" fill="rgba(15,26,14,.3)"/>
    <path d="M-48 -2
             C -50 -18 -34 -29 -10 -30
             C 12 -31 30 -25 40 -14
             C 47 -7 51 0 49 6
             C 47 12 40 15 30 16
             C 12 19 -10 20 -28 15
             C -42 11 -47 6 -48 -2 Z"
          fill="#5E9444" stroke="#35682A" stroke-width="2.5"/>
    <path d="M-42 -10 C -36 -20 -22 -26 -6 -27 C 10 -28 24 -23 33 -15 L 28 -9 C 20 -16 8 -20 -6 -19 C -20 -18 -32 -13 -37 -5 Z" fill="#8FBF5A" opacity=".6"/>
    <ellipse cx="-14" cy="-9" rx="19" ry="9" fill="#C9DDA4" opacity=".5" transform="rotate(-10 -14 -9)"/>
    <path d="M6 -18 L -4 -5" stroke="#EAF2C8" stroke-width="3" stroke-linecap="round" opacity=".9"/>
    <path d="M-42 -22 q-2 -6 0 -11" fill="none" stroke="#4A6B2A" stroke-width="3.6" stroke-linecap="round"/>
    <g transform="translate(-42 -33)">
      <path d="M0 0 C -9 -1 -19 -7 -23 -17 C -14 -22 -3 -18 3 -8 C 5 -4 4 -1 0 0 Z" fill="#6F9C48" stroke="#4A6B2A" stroke-width="1.7"/>
      <path d="M-2 -3 q-9 -5 -16 -12" fill="none" stroke="#4A6B2A" stroke-width="1.2" opacity=".7"/>
    </g>
  </g>

  <!-- chén nước trộn tỏi ớt -->
  <g transform="translate(424 392)">
    <ellipse cx="0" cy="16" rx="42" ry="12" fill="rgba(15,26,14,.3)"/>
    <path d="M-34 -2 C -32 15 -18 25 0 25 C 18 25 32 15 34 -2 Z" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2.2"/>
    <ellipse cx="0" cy="-2" rx="34" ry="10" fill="#F6F1E1" stroke="#D8D0B6" stroke-width="1.6"/>
    <ellipse cx="0" cy="-2" rx="27" ry="7.5" fill="#B87B24"/>
    <ellipse cx="-7" cy="-3.5" rx="11" ry="3" fill="#D9A040" opacity=".85"/>
    <circle cx="9" cy="-2" r="2.6" fill="none" stroke="#D64B33" stroke-width="1.8"/>
    <circle cx="-15" cy="-1" r="2" fill="#D64B33"/>
    <g fill="#F2E6C0">
      <circle cx="-1" cy="-5" r="1.5"/><circle cx="17" cy="-4" r="1.5"/>
    </g>
  </g>
</svg>
