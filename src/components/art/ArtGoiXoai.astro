---
/* Gỏi xoài xanh tôm khô — đống sợi xoài hai tông vàng nhạt + xanh non vun cao trên dĩa,
   tôm khô = mảnh cam đậm nhỏ cong rải mặt (chữ ký), rau răm thon nhọn, đậu phộng + hành phi;
   đạo cụ: trái xoài xanh nguyên + chén nước trộn. Món nguội — không vẽ khói. */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Dĩa gỏi xoài xanh tôm khô sợi vàng xanh vun cao, tôm khô cam rải mặt, kèm trái xoài xanh và chén nước trộn">
  <circle cx="260" cy="250" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="250" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <ellipse cx="260" cy="400" rx="200" ry="26" fill="rgba(15,26,14,.35)"/>

  <!-- dĩa -->
  <ellipse cx="260" cy="342" rx="204" ry="58" fill="#F6F1E1"/>
  <ellipse cx="260" cy="338" rx="204" ry="58" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2"/>
  <ellipse cx="260" cy="338" rx="204" ry="58" fill="none" stroke="#2C5234" stroke-width="4"/>
  <ellipse cx="260" cy="340" rx="168" ry="44" fill="none" stroke="#E0A32E" stroke-width="2.4" stroke-dasharray="2 11" stroke-linecap="round"/>

  <!-- bóng dưới đống gỏi -->
  <ellipse cx="256" cy="332" rx="124" ry="22" fill="#7A5A18" opacity=".28"/>

  <!-- ĐỐNG SỢI XOÀI: mô lót + sợi song song dày hai tông -->
  <path d="M150 324
           C 154 298 172 270 202 252
           C 224 238 240 232 254 232
           C 274 232 296 244 314 262
           C 334 280 350 302 358 320
           C 361 330 352 336 326 338
           C 294 341 216 341 186 338
           C 162 336 148 330 150 324 Z"
        fill="#D4C26C"/>
  <!-- sợi tông sẫm lót -->
  <g fill="none" stroke="#9FB768" stroke-width="5" stroke-linecap="round">
    <path d="M186 314 q34 -14 66 -10"/>
    <path d="M204 300 q30 -14 60 -10"/>
    <path d="M228 268 q26 -12 52 -8"/>
    <path d="M274 322 q30 -6 58 2"/>
    <path d="M246 336 q26 -4 52 -2"/>
  </g>
  <!-- hàng chân đống -->
  <g fill="none" stroke-linecap="round" stroke-width="6">
    <path d="M150 330 q26 -10 52 -8" stroke="#EFD37A"/>
    <path d="M206 334 q30 -8 60 -6" stroke="#BFD892"/>
    <path d="M268 332 q30 -6 60 -2" stroke="#EFD37A"/>
    <path d="M330 328 q16 -6 30 -12" stroke="#BFD892"/>
  </g>
  <!-- hàng 2 -->
  <g fill="none" stroke-linecap="round" stroke-width="6">
    <path d="M162 320 q30 -14 60 -12" stroke="#BFD892"/>
    <path d="M226 322 q32 -10 64 -6" stroke="#EFD37A"/>
    <path d="M292 318 q28 -8 54 0" stroke="#BFD892"/>
    <path d="M254 314 q30 -8 58 -2" stroke="#F6E9AE"/>
  </g>
  <!-- hàng 3 -->
  <g fill="none" stroke-linecap="round" stroke-width="6">
    <path d="M170 306 q32 -16 64 -14" stroke="#EFD37A"/>
    <path d="M238 308 q34 -10 66 -4" stroke="#BFD892"/>
    <path d="M300 302 q24 -10 46 -4" stroke="#EFD37A"/>
  </g>
  <!-- hàng 4 -->
  <g fill="none" stroke-linecap="round" stroke-width="6">
    <path d="M182 292 q32 -16 64 -12" stroke="#BFD892"/>
    <path d="M248 292 q32 -10 62 -2" stroke="#EFD37A"/>
    <path d="M302 286 q22 -10 44 -2" stroke="#BFD892"/>
    <path d="M216 284 q28 -12 56 -10" stroke="#F6E9AE"/>
  </g>
  <!-- hàng 5 -->
  <g fill="none" stroke-linecap="round" stroke-width="6">
    <path d="M196 276 q30 -14 60 -12" stroke="#EFD37A"/>
    <path d="M258 274 q28 -10 54 0" stroke="#BFD892"/>
  </g>
  <!-- hàng 6 -->
  <g fill="none" stroke-linecap="round" stroke-width="6">
    <path d="M210 260 q26 -14 52 -12" stroke="#BFD892"/>
    <path d="M262 258 q24 -8 46 2" stroke="#EFD37A"/>
    <path d="M240 250 q22 -12 44 -8" stroke="#F6E9AE"/>
  </g>
  <!-- chóp -->
  <g fill="none" stroke-linecap="round" stroke-width="5.5">
    <path d="M228 244 q20 -10 40 -8" stroke="#EFD37A"/>
    <path d="M250 238 q18 -6 36 -2" stroke="#BFD892"/>
  </g>
  <!-- sợi ôm sườn trái (phủ khoảng trống) -->
  <g fill="none" stroke-linecap="round" stroke-width="6">
