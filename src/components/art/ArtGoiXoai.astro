    <path d="M218 254 q-18 14 -26 34" stroke="#EFD37A"/>
    <path d="M206 268 q-16 14 -22 32" stroke="#BFD892"/>
    <path d="M196 284 q-14 14 -18 30" stroke="#F6E9AE"/>
