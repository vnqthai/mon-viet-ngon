    <path d="M312 300 c 12 -8 26 -6 32 2 c -12 7 -25 5 -32 -2 z"/>
    <path d="M232 254 c 12 -8 26 -6 32 2 c -12 7 -25 5 -32 -2 z"/>
  </g>
  <g fill="none" stroke="#7CB055" stroke-width="1.6">
