  <ellipse cx="258" cy="410" rx="168" ry="26" fill="rgba(15,26,14,.35)"/>

  <!-- BÁT SÀNH NÂU ĐỎ -->
  <path d="M118 302 C 122 358 168 396 258 396 C 348 396 394 358 398 302 Z"
        fill="#9C532B" stroke="#5E2C13" stroke-width="3"/>
  <path d="M136 336 C 160 368 200 384 258 384 C 316 384 356 368 380 336" fill="none" stroke="#7C3E1D" stroke-width="4"/>
  <ellipse cx="258" cy="396" rx="46" ry="10" fill="#7C3E1D" stroke="#5E2C13" stroke-width="3"/>
  <!-- vành bát -->
  <ellipse cx="258" cy="302" rx="140" ry="42" fill="#B36335" stroke="#5E2C13" stroke-width="3"/>
  <ellipse cx="258" cy="304" rx="126" ry="35" fill="#7C3E1D" stroke="#5E2C13" stroke-width="2.4"/>

  <!-- KHỐI BỘT: trắng ngà, quánh, mặt hơi vồng -->
  <path d="M136 300 C 146 278 190 266 258 266 C 326 266 370 278 380 300 C 360 322 320 332 258 332 C 196 332 156 322 136 300 Z"
        fill="#F2EADA" stroke="#B0A182" stroke-width="3"/>
  <path d="M158 292 C 178 278 218 272 258 272" fill="none" stroke="#FCF8EE" stroke-width="5" stroke-linecap="round" opacity=".9"/>
  <!-- nước chan sóng sánh quanh mép khối bột -->
  <path d="M136 300 C 148 312 176 320 210 324 C 190 330 156 320 140 308 Z" fill="#C68A3E" opacity=".85"/>
  <path d="M380 300 C 368 312 342 320 310 324 C 330 330 362 320 376 308 Z" fill="#C68A3E" opacity=".85"/>

  <!-- NHÂN THỊT BĂM XÀO MỘC NHĨ: gò nâu sẫm đắp giữa mặt bột -->
