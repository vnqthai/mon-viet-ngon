  </g>
  <!-- cuốn 3 (cắt đôi, dựng) -->
  <g transform="rotate(-3 372 300)">
    <ellipse cx="372" cy="302" rx="26" ry="26" fill="#FBF3E2" stroke="#E3D5B4" stroke-width="2.5"/>
    <ellipse cx="372" cy="302" rx="18" ry="18" fill="#F5EBD2"/>
