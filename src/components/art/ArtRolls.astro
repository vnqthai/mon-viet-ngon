---
/* Dĩa gỏi cuốn + chén tương chấm — các món cuốn */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Dĩa gỏi cuốn tôm thịt">
  <circle cx="260" cy="250" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="250" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <ellipse cx="260" cy="402" rx="200" ry="26" fill="rgba(15,26,14,.35)"/>
  <!-- dĩa -->
  <ellipse cx="260" cy="346" rx="206" ry="58" fill="#F6F1E1"/>
  <ellipse cx="260" cy="342" rx="206" ry="58" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2"/>
  <ellipse cx="260" cy="342" rx="206" ry="58" fill="none" stroke="#2C5234" stroke-width="4"/>
  <!-- lá xà lách lót -->
  <g fill="#6F9C48" opacity=".9">
    <ellipse cx="200" cy="332" rx="70" ry="22" transform="rotate(-8 200 332)"/>
    <ellipse cx="320" cy="336" rx="74" ry="24" transform="rotate(6 320 336)"/>
