    <circle cx="366" cy="310" r="5" fill="#DCE8C2"/>
    <circle cx="380" cy="308" r="4" fill="#B7CF8E"/>
    <circle cx="373" cy="299" r="3" fill="#E8D9B0"/>
  </g>

  <!-- chén tương chấm -->
  <g>
    <ellipse cx="112" cy="404" rx="46" ry="14" fill="rgba(15,26,14,.3)"/>
    <path d="M72 386 C 74 408 88 418 112 418 C 136 418 150 408 152 386 Z" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2"/>
