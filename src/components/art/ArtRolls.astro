    <path d="M255 306 q14 6 22 2" stroke="#4E7B36" stroke-width="5" fill="none" stroke-linecap="round"/>
  </g>
  <!-- cuốn 2 -->
  <g transform="rotate(5 300 340)">
    <rect x="222" y="318" width="162" height="42" rx="21" fill="#FBF3E2" stroke="#E3D5B4" stroke-width="2.5"/>
    <rect x="232" y="324" width="50" height="30" rx="15" fill="#DCE8C2" opacity=".85"/>
    <g fill="#F08A7A">
      <ellipse cx="318" cy="332" rx="15" ry="8"/>
