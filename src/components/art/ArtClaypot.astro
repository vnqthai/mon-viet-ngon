---
/* Nồi đất kho — cá kho tộ, thịt kho… */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Nồi đất kho sôi liu riu">
  <defs>
    <linearGradient id="cpBody" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#A9713D"/><stop offset="1" stop-color="#7E4E27"/>
    </linearGradient>
    <linearGradient id="cpLid" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#B67C45"/><stop offset="1" stop-color="#96612F"/>
    </linearGradient>
    <linearGradient id="cpSauce" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#8A4A1E"/><stop offset="1" stop-color="#5E2F10"/>
    </linearGradient>
  </defs>
  <circle cx="260" cy="240" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="240" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <g class="steam">
    <path d="M225 210 C 214 186 240 170 229 144 C 222 128 236 116 232 102"/>
    <path d="M285 206 C 275 182 301 168 290 142 C 283 126 297 114 293 98"/>
  </g>
  <ellipse cx="260" cy="424" rx="188" ry="24" fill="rgba(15,26,14,.35)"/>

  <!-- thân nồi đất -->
  <path d="M92 262 C 96 356 168 416 260 416 C 352 416 424 356 428 262 Z" fill="url(#cpBody)"/>
  <ellipse cx="260" cy="262" rx="168" ry="38" fill="#5E3A1B"/>
  <ellipse cx="260" cy="258" rx="150" ry="31" fill="url(#cpSauce)"/>
  <!-- quai nồi -->
  <path d="M88 258 q-26 -6 -30 -26" fill="none" stroke="#8A5730" stroke-width="16" stroke-linecap="round"/>
  <path d="M432 258 q26 -6 30 -26" fill="none" stroke="#8A5730" stroke-width="16" stroke-linecap="round"/>
  <!-- hoa văn thân -->
  <path d="M120 320 C 170 342 350 342 400 320" fill="none" stroke="#6B4020" stroke-width="6" stroke-linecap="round" opacity=".7"/>
  <path d="M108 292 C 165 316 355 316 412 292" fill="none" stroke="#E0A32E" stroke-width="3" stroke-dasharray="2 12" stroke-linecap="round" opacity=".8"/>

  <!-- khứa cá / thịt kho -->
  <g transform="rotate(-5 210 252)">
    <rect x="168" y="238" width="84" height="30" rx="9" fill="#B8672B" stroke="#8A4517" stroke-width="2.5"/>
    <path d="M172 242 q38 -12 76 0" fill="none" stroke="#5E3410" stroke-width="6" stroke-linecap="round"/>
    <path d="M186 254 q7 5 14 0 M208 258 q7 5 14 0" fill="none" stroke="#D98F4B" stroke-width="2.6" stroke-linecap="round"/>
  </g>
  <g transform="rotate(6 322 258)">
    <rect x="280" y="244" width="76" height="28" rx="9" fill="#C0702F" stroke="#8A4517" stroke-width="2.5"/>
    <path d="M284 248 q34 -11 68 0" fill="none" stroke="#5E3410" stroke-width="6" stroke-linecap="round"/>
    <path d="M296 260 q6 4 12 0" fill="none" stroke="#D98F4B" stroke-width="2.6" stroke-linecap="round"/>
  </g>
  <!-- bong bóng kho + tiêu + hành ớt -->
  <g fill="#E8A65A" opacity=".85">
    <circle cx="160" cy="256" r="4"/><circle cx="266" cy="238" r="3.4"/><circle cx="368" cy="250" r="4"/>
    <circle cx="238" cy="266" r="3"/><circle cx="330" cy="238" r="3"/>
  </g>
  <g fill="#2E2318">
    <circle cx="200" cy="236" r="2.2"/><circle cx="252" cy="252" r="2.2"/><circle cx="300" cy="236" r="2.2"/><circle cx="348" cy="262" r="2.2"/>
  </g>
  <g stroke="#7FA95B" stroke-width="4" stroke-linecap="round" fill="none">
    <path d="M222 232 q10 -6 20 -4"/><path d="M312 268 q10 -5 19 -2"/>
  </g>
  <path d="M258 232 C 270 228 282 230 288 224" fill="none" stroke="#C0392B" stroke-width="7" stroke-linecap="round"/>

  <!-- nắp dựng bên cạnh -->
  <g transform="rotate(18 452 366)">
    <ellipse cx="452" cy="366" rx="52" ry="52" fill="url(#cpLid)"/>
    <ellipse cx="452" cy="366" rx="52" ry="52" fill="none" stroke="#6B4020" stroke-width="4"/>
    <circle cx="452" cy="366" r="11" fill="#6B4020"/>
  </g>
  <!-- ớt + hành trên bàn -->
  <g transform="translate(76 396) rotate(-14)">
    <path d="M0 0C13 2 22 -4 26 -13" fill="none" stroke="#C0392B" stroke-width="8" stroke-linecap="round"/>
    <path d="M26 -15c2-4 6-5 9-4" fill="none" stroke="#4E7B36" stroke-width="4" stroke-linecap="round"/>
  </g>
  <g stroke="#7FA95B" stroke-width="5" stroke-linecap="round" fill="none">
    <path d="M96 418 q14 -8 28 -6"/>
  </g>
</svg>
