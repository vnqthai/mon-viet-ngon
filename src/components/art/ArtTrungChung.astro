---
/* Trứng chưng thịt nấm mèo — DĨA sứ với bản trứng chưng tròn dày vàng óng (kiểu chả
   trứng hấp đổ dĩa; mặt phẳng mịn, không vòng cam giữa — tránh ra ốp la); mép phải bị
   khoét một muỗng lộ mặt cắt lấm tấm thịt + nấm; muỗng sứ dính miếng trứng gác trên bàn.
   Khác thịt kho (hột vịt NGUYÊN trong nồi) — đây không có quả trứng nguyên nào */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Dĩa trứng chưng thịt nấm mèo mặt vàng óng phẳng mịn, một góc đã múc lộ nhân, muỗng sứ múc dở gác bên cạnh">
  <defs>
    <linearGradient id="tcEgg" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#EDBE4F"/><stop offset="1" stop-color="#DFA53A"/>
    </linearGradient>
  </defs>
  <circle cx="260" cy="240" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="240" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <g class="steam">
    <path d="M215 226 C 204 202 230 186 219 160 C 212 144 226 132 222 118"/>
    <path d="M262 220 C 252 196 278 182 267 156 C 260 140 274 128 270 114"/>
    <path d="M306 228 C 296 206 320 192 310 168 C 303 152 316 140 313 126"/>
  </g>
  <ellipse cx="255" cy="408" rx="184" ry="23" fill="rgba(15,26,14,.35)"/>

  <!-- dĩa sứ -->
  <ellipse cx="255" cy="338" rx="196" ry="54" fill="#F6F1E1"/>
  <ellipse cx="255" cy="334" rx="196" ry="54" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2"/>
  <ellipse cx="255" cy="334" rx="196" ry="54" fill="none" stroke="#2C5234" stroke-width="4"/>
  <ellipse cx="255" cy="335" rx="166" ry="43" fill="none" stroke="#E0A32E" stroke-width="2.4" stroke-dasharray="2 11" stroke-linecap="round"/>

  <!-- bản trứng chưng tròn dày trên dĩa: thành đậm + mặt vàng óng phẳng mịn -->
  <ellipse cx="255" cy="318" rx="118" ry="26" fill="#C08324"/>
  <ellipse cx="255" cy="307" rx="118" ry="24" fill="url(#tcEgg)"/>
  <!-- vệt bóng thẳng xiên (không cong, không chấm tròn) -->
  <path d="M 182 303 L 220 293 M 197 313 L 231 303" stroke="#F9E29B" stroke-width="4.2" stroke-linecap="round" opacity=".8"/>

  <!-- góc múc: khuyết cắt hẳn vào mép phải bản trứng, lộ mặt dĩa + mặt cắt -->
  <g>
    <path d="M 370 298 A 118 24 0 0 1 342 328 C 333 324 328 316 331 309 C 335 300 350 296 370 298 Z" fill="#EAE0C2"/>
    <path d="M 370 298 A 118 24 0 0 1 342 328" fill="none" stroke="#D8C9A0" stroke-width="1.6"/>
    <path d="M 367 300 C 352 300 338 304 334 311" fill="none" stroke="#C9B482" stroke-width="2" stroke-linecap="round" opacity=".7"/>
    <path d="M 342 328 C 333 324 328 316 331 309 C 335 300 350 296 370 298" fill="none" stroke="#E8C25A" stroke-width="6" stroke-linecap="round"/>
    <path d="M 342 328 C 333 324 328 316 331 309 C 335 300 350 296 370 298" fill="none" stroke="#C08324" stroke-width="2.4" stroke-linecap="round"/>
    <!-- vụn nhân còn dính trong hố -->
    <g fill="#AD7845">
      <circle cx="349" cy="313" r="2"/><circle cx="363" cy="320" r="1.8"/>
    </g>
    <path d="M 342 320 l 7 -3" stroke="#4F3322" stroke-width="1.9" stroke-linecap="round" fill="none"/>
    <ellipse cx="358" cy="305" rx="4.6" ry="2" fill="#EFD9A6" transform="rotate(-18 358 305)"/>
  </g>

  <!-- sợi nấm mèo mảnh, đầu hếch lên, tách xa nhau -->
  <g stroke="#4F3322" stroke-width="2.4" stroke-linecap="round" fill="none">
    <path d="M 200 298 q 13 -2 23 -7"/>
    <path d="M 268 324 l 20 -7"/>
  </g>
  <ellipse cx="251" cy="294" rx="6" ry="2.8" transform="rotate(-14 251 294)" fill="#5B3A28"/>

  <!-- hành lá + tiêu -->
  <g stroke="#6F9C48" stroke-width="3.2" stroke-linecap="round" fill="none">
    <path d="M 180 311 l 12 -3 M 242 289 l 12 -2 M 218 321 l 11 -2"/>
  </g>
  <g fill="#86B25A">
    <circle cx="232" cy="306" r="2.4"/><circle cx="281" cy="296" r="2.2"/>
  </g>
  <g fill="#2E2318">
    <circle cx="221" cy="294" r="1.4"/><circle cx="248" cy="318" r="1.4"/><circle cx="296" cy="302" r="1.4"/><circle cx="204" cy="318" r="1.3"/>
  </g>

  <!-- muỗng sứ múc dở gác trên bàn, dính miếng trứng -->
  <g transform="translate(390 384) rotate(-14)">
    <ellipse cx="18" cy="10" rx="52" ry="9" fill="rgba(15,26,14,.28)"/>
    <rect x="16" y="-5" width="86" height="10" rx="5" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2"/>
    <ellipse cx="0" cy="0" rx="21" ry="13.5" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2.4"/>
    <ellipse cx="-1" cy="0.5" rx="14.5" ry="8.6" fill="#EFEADA"/>
    <ellipse cx="-2" cy="-1" rx="10.5" ry="6" fill="#E2AE3C" stroke="#C08A24" stroke-width="1.8"/>
    <circle cx="-6" cy="-2" r="1.6" fill="#AD7845"/>
    <path d="M 1 -4 q 4 -2 7 -1" stroke="#4F3322" stroke-width="1.8" fill="none" stroke-linecap="round"/>
  </g>

  <!-- chén cơm trắng nhỏ bên trái -->
  <g transform="translate(92 380)">
    <ellipse cx="0" cy="20" rx="48" ry="13" fill="rgba(15,26,14,.3)"/>
    <path d="M -40 -2 C -38 20 -21 31 0 31 C 21 31 38 20 40 -2 Z" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2"/>
    <path d="M -34 -3 C -26 -12 -14 -17 0 -17 C 14 -17 26 -12 34 -3 C 20 3 -20 3 -34 -3 Z" fill="#FFFDF6" stroke="#E3DCC4" stroke-width="2"/>
    <g fill="none" stroke="#E3DCC4" stroke-width="1.8" stroke-linecap="round">
      <path d="M -22 -8 a 6 4 0 0 1 9 -2"/>
      <path d="M -4 -12 a 6 4 0 0 1 9 -2"/>
      <path d="M 12 -7 a 6 4 0 0 1 9 -2"/>
    </g>
  </g>

  <!-- đôi đũa trên bàn -->
  <g transform="rotate(-7 420 424)">
    <rect x="340" y="416" width="152" height="7.5" rx="3.75" fill="#9A6538"/>
    <rect x="344" y="427" width="152" height="7.5" rx="3.75" fill="#8A5730"/>
  </g>

  <!-- dưa leo lát cạnh chén cơm -->
  <g>
    <ellipse cx="158" cy="400" rx="15" ry="7.5" transform="rotate(-14 158 400)" fill="#E9F1D2" stroke="#7BA05B" stroke-width="2.8"/>
    <g fill="#C9DCA0"><ellipse cx="154" cy="398" rx="2.1" ry="1.4"/><ellipse cx="162" cy="401" rx="2.1" ry="1.4"/></g>
    <ellipse cx="178" cy="410" rx="13" ry="6.5" transform="rotate(-8 178 410)" fill="#EDF4D8" stroke="#7BA05B" stroke-width="2.6"/>
    <g fill="#C9DCA0"><ellipse cx="175" cy="408" rx="1.9" ry="1.2"/><ellipse cx="181" cy="411" rx="1.9" ry="1.2"/></g>
  </g>
</svg>
