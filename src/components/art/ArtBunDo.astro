---
/* Bún đỏ Buôn Ma Thuột — chữ ký là CHÍNH SỢI BÚN: cọng to cỡ chiếc đũa và
   bị nhuộm ĐỎ CAM, nổi hẳn lên mặt tô. Ba tô đỏ sẵn có đều tách được nhờ đó:
   bún riêu (sợi TRẮNG mảnh + đậu phụ chiên + múi cà chua), bún bò Huế (khoanh giò),
   lẩu Thái (nồi inox + tôm sú). Nên tô này CỐ Ý không có cà chua, không đậu phụ.
   Kèm trứng cút trắng nguyên quả + rau cần nước xanh + tóp mỡ */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Tô bún đỏ Buôn Ma Thuột sợi bún cọng to nhuộm đỏ cam nổi trên mặt, riêu cua, trứng cút, rau cần nước và tóp mỡ, kèm chén ớt chưng">
  <defs>
    <linearGradient id="bdNuoc" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#D9532B"/><stop offset="1" stop-color="#A83417"/>
    </linearGradient>
    <linearGradient id="bdTo" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#FDFAF0"/><stop offset="1" stop-color="#E9E2CC"/>
    </linearGradient>
  </defs>
  <circle cx="260" cy="240" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="240" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <g class="steam">
    <path d="M198 232 C 187 206 213 190 202 162 C 195 144 209 132 205 116"/>
    <path d="M258 226 C 248 200 274 186 263 158 C 256 140 270 128 266 110"/>
    <path d="M320 234 C 310 210 334 194 324 168 C 318 152 330 140 326 126"/>
  </g>
  <ellipse cx="255" cy="420" rx="196" ry="24" fill="rgba(15,26,14,.35)"/>

  <!-- tô -->
  <path d="M67 296 C 73 370 157 414 255 414 C 353 414 437 370 443 296 Z" fill="url(#bdTo)"/>
  <ellipse cx="255" cy="412" rx="62" ry="11" fill="#D8D0B6"/>
  <ellipse cx="255" cy="294" rx="188" ry="46" fill="#F6F1E1"/>
  <ellipse cx="255" cy="294" rx="188" ry="46" fill="none" stroke="#2C5234" stroke-width="5"/>
  <ellipse cx="255" cy="295" rx="174" ry="40" fill="none" stroke="#E0A32E" stroke-width="2.5" stroke-dasharray="2 11" stroke-linecap="round"/>

  <!-- nước lèo đỏ gạch (cam hơn, sẫm hơn nước bún riêu) -->
  <ellipse cx="255" cy="297" rx="158" ry="33" fill="url(#bdNuoc)"/>
  <ellipse cx="198" cy="288" rx="48" ry="8" fill="#E9743F" opacity=".45"/>
  <g fill="#F0925F" opacity=".8">
    <circle cx="146" cy="302" r="3.4"/><circle cx="356" cy="304" r="3.2"/><circle cx="300" cy="322" r="2.6"/>
  </g>

  <!-- TẢNG RIÊU CUA: nhỏ, dẹt, nằm sau bên trái — cố ý KHÔNG to như bún riêu -->
  <g transform="translate(158 279)">
    <path d="M-34 4 C -38 -6 -28 -14 -16 -12 C -11 -20 3 -22 11 -16
             C 21 -21 34 -17 36 -8 C 42 -5 42 3 35 7
             C 26 14 8 16 -3 12 C -14 17 -28 13 -34 4 Z"
          fill="#CE9A55" stroke="#A8702E" stroke-width="2.4"/>
    <g fill="none" stroke="#B37E3E" stroke-width="1.6" opacity=".95">
      <circle cx="-18" cy="-2" r="3.6"/><circle cx="2" cy="-8" r="4"/><circle cx="20" cy="0" r="3.4"/>
    </g>
    <path d="M-22 -6 C -14 -13 0 -14 8 -10 C 14 -7 12 -2 4 0 C -6 2 -20 0 -22 -6 Z" fill="#E0862F" stroke="#C4681F" stroke-width="1.6"/>
    <g fill="#F2CD8C"><circle cx="-28" cy="2" r="1.7"/><circle cx="14" cy="8" r="1.7"/></g>
  </g>

  <!-- ============ SỢI BÚN TO ĐỎ CAM — chữ ký của món ============
       Cọng dày (nét 10–12) so với sợi bún trắng nét 6 của mấy tô kia, và bản thân
       sợi có màu, không phải trắng nằm dưới nước màu. Hai cọng vồng hẳn lên khỏi
       mặt nước để đọc ra "cọng to" ngay ở cỡ thumbnail. -->
  <g stroke-linecap="round" fill="none">
    <!-- viền sẫm dưới -->
    <g stroke="#9A3212" stroke-width="13">
      <path d="M150 306 C 186 292 232 288 276 296"/>
      <path d="M168 320 C 206 310 252 308 296 316"/>
      <path d="M282 300 C 312 288 344 286 368 292"/>
      <path d="M196 282 C 224 268 258 264 288 270"/>
      <path d="M300 318 C 328 310 352 308 370 312"/>
    </g>
    <!-- thân sợi -->
    <g stroke="#EA7440" stroke-width="10">
      <path d="M150 306 C 186 292 232 288 276 296"/>
      <path d="M168 320 C 206 310 252 308 296 316"/>
      <path d="M282 300 C 312 288 344 286 368 292"/>
      <path d="M196 282 C 224 268 258 264 288 270"/>
      <path d="M300 318 C 328 310 352 308 370 312"/>
    </g>
    <!-- gờ sáng chạy dọc sợi -->
    <g stroke="#F8A876" stroke-width="3">
      <path d="M158 303 C 192 290 232 287 272 293"/>
      <path d="M176 317 C 210 308 252 306 292 313"/>
      <path d="M288 296 C 314 286 342 284 364 289"/>
      <path d="M202 279 C 228 266 258 262 284 267"/>
    </g>
  </g>
  <!-- hai cọng VỒNG LÊN khỏi mặt nước: chỗ đọc ra cọng dày -->
  <g fill="none" stroke-linecap="round">
    <path d="M228 292 C 244 262 276 254 302 268" stroke="#9A3212" stroke-width="13"/>
    <path d="M228 292 C 244 262 276 254 302 268" stroke="#EA7440" stroke-width="10"/>
    <path d="M234 288 C 248 264 274 258 296 268" stroke="#F8A876" stroke-width="3"/>
    <path d="M312 296 C 326 274 350 270 366 280" stroke="#9A3212" stroke-width="12"/>
    <path d="M312 296 C 326 274 350 270 366 280" stroke="#EA7440" stroke-width="9"/>
    <path d="M318 292 C 330 276 348 273 362 280" stroke="#F8A876" stroke-width="2.6"/>
  </g>

  <!-- TRỨNG CÚT trắng nguyên quả: mảng trắng duy nhất trong tô, bật hẳn trên nền đỏ -->
  <g>
    <ellipse cx="212" cy="312" rx="19" ry="16" fill="#FBF6E6" stroke="#DCD0AE" stroke-width="2.2"/>
    <ellipse cx="206" cy="306" rx="7" ry="5" fill="#FFFDF6" opacity=".9"/>
  </g>
  <g>
    <ellipse cx="330" cy="306" rx="17" ry="14.5" fill="#FBF6E6" stroke="#DCD0AE" stroke-width="2.2"/>
    <ellipse cx="325" cy="301" rx="6" ry="4.4" fill="#FFFDF6" opacity=".9"/>
  </g>
  <!-- một quả bổ đôi lộ lòng đỏ -->
  <g transform="translate(268 322)">
    <ellipse cx="0" cy="0" rx="16" ry="13.5" fill="#FBF6E6" stroke="#DCD0AE" stroke-width="2.2"/>
    <circle cx="0" cy="0" r="6.6" fill="#E8B23C" stroke="#C98F1F" stroke-width="1.6"/>
  </g>

  <!-- RAU CẦN NƯỚC trụng: nhúm cọng ngắn có lá, nằm HẲN TRONG tô phía sau.
       Bản đầu vẽ hai cọng dài vắt ngang mép tô — ở cỡ thumbnail nó đọc ra hai cái
       QUE XANH chìa ra khỏi tô, không ai nhận ra là rau. -->
  <g fill="none" stroke="#4E7B36" stroke-width="4.4" stroke-linecap="round">
    <path d="M150 294 C 158 281 172 275 186 275"/>
    <path d="M168 298 C 176 284 190 278 204 279"/>
    <path d="M322 290 C 334 278 350 274 364 277"/>
    <path d="M342 296 C 352 285 366 281 378 283"/>
  </g>
  <g fill="#5C8A3C" stroke="#3F6A28" stroke-width="1.2">
    <path d="M186 275 C 192 265 206 262 212 266 C 206 276 194 280 186 275 Z"/>
    <path d="M204 279 C 210 270 222 267 228 271 C 222 280 212 283 204 279 Z"/>
    <path d="M364 277 C 370 267 384 264 390 268 C 384 278 372 281 364 277 Z"/>
    <path d="M378 283 C 384 274 396 272 402 275 C 396 284 386 287 378 283 Z"/>
  </g>

  <!-- TÓP MỠ: mẩu nhỏ MÉO MÓ, cố ý không phải khối vuông bo góc — khối vuông vàng
       chính là chữ ký đậu phụ chiên của bún riêu, vẽ giống là hai tô lẫn nhau. -->
  <g fill="#E0A050" stroke="#B87C2E" stroke-width="1.1">
    <path d="M181 285 l6 -4 l6 2 l-1 6 l-8 1 Z"/>
    <path d="M302 284 l5 -4 l6 3 l-2 5 l-7 0 Z"/>
    <path d="M247 302 l6 -3 l5 3 l-2 5 l-7 0 Z"/>
    <path d="M352 321 l5 -3 l6 2 l-1 5 l-7 1 Z"/>
    <path d="M214 292 l5 -3 l4 3 l-2 4 l-6 0 Z"/>
  </g>
  <g stroke="#6F9C48" stroke-width="3.2" stroke-linecap="round" fill="none">
    <path d="M226 326 l10 -2 M292 288 l9 -2 M162 310 l9 -2 M344 296 l9 -2"/>
  </g>

  <!-- CHÉN ỚT CHƯNG đỏ sánh (khác chén mắm tôm tím xám của bún riêu) -->
  <g transform="translate(430 394)">
    <ellipse cx="0" cy="13" rx="36" ry="11" fill="rgba(15,26,14,.3)"/>
    <path d="M-30 -2 C -28 14 -16 23 0 23 C 16 23 28 14 30 -2 Z" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2"/>
    <ellipse cx="0" cy="-2" rx="25" ry="7.6" fill="#C43B1E"/>
    <ellipse cx="-6" cy="-4" rx="9" ry="2.8" fill="#E4643F" opacity=".9"/>
    <g fill="#8E2712"><circle cx="7" cy="-1" r="1.7"/><circle cx="-13" cy="0" r="1.5"/><circle cx="14" cy="-4" r="1.4"/></g>
  </g>

  <!-- nhúm giá + rau cải non trên bàn (trái) -->
  <g transform="translate(92 400)">
    <g fill="none" stroke="#F4EEDA" stroke-width="4.4" stroke-linecap="round">
      <path d="M-32 6 C -18 0 -2 -1 12 3"/>
      <path d="M-28 14 C -14 8 4 7 18 11"/>
      <path d="M-20 -2 C -6 -8 10 -8 22 -4"/>
    </g>
    <g fill="#E4DCC0"><circle cx="-34" cy="6" r="3.2"/><circle cx="-30" cy="14" r="3"/><circle cx="-22" cy="-2" r="3"/></g>
    <path d="M22 8 C 16 -4 26 -14 38 -11 C 46 -18 58 -13 58 -4 C 50 4 34 10 22 8 Z" fill="#C9DDA4" stroke="#8FBF4D" stroke-width="2"/>
  </g>
</svg>
