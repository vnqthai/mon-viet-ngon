---
/* Bánh tráng cuốn thịt heo Đà Nẵng — cùng họ "Cuốn & trộn" với gỏi cuốn, nên phải
   tránh bằng được cái đọc "dĩa cuốn thành phẩm". Cách tránh: KHÔNG VẼ CUỐN NÀO CẢ,
   vẽ MÂM BÀY lúc chưa cuốn.
   Chữ ký duy nhất trên trang: NAN QUẠT LÁT THỊT LUỘC CÓ HAI VÀNH DA HAI ĐẦU —
   mỗi lát là dải nạc hồng ở giữa, hai đầu là băng da kem sát lớp mỡ trắng.
   Kèm: chồng bánh tráng khô tròn, xấp mì lá gấp, lát KHẾ hình ngôi sao (dấu hiệu
   nhìn ra ngay), chuối chát, và chén MẮM NÊM nâu xám có xác thơm —
   khác hẳn tương đậu phộng nâu đỏ của gỏi cuốn.
   Món NGUỘI → không vẽ khói. id prefix: btc */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Mâm bánh tráng cuốn thịt heo: dĩa lát thịt luộc có hai vành da hai đầu xếp nan quạt, chồng bánh tráng khô, xấp mì lá, rau sống với lát khế hình sao, chén mắm nêm">
  <defs>
    <linearGradient id="btcPaper" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#FDF8EB"/><stop offset="1" stop-color="#E3D3AF"/>
    </linearGradient>
    <linearGradient id="btcMam" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#9C7F5C"/><stop offset="1" stop-color="#6B5136"/>
    </linearGradient>
    <!-- LÁT THỊT HAI ĐẦU DA — chữ ký của cả món.
         Giữa: nạc hồng có thớ. Hai đầu: BĂNG DA kem, sát trong là LỚP MỠ trắng.
         Phải thấy rõ hai băng ở HAI đầu, không phải một. -->
    <g id="btcThit">
      <path d="M-31 -13 L 31 -13 A 6.5 6.5 0 0 1 31 13 L -31 13 A 6.5 6.5 0 0 1 -31 -13 Z"
            fill="#EFBCA8" stroke="#A9705A" stroke-width="2.2"/>
      <path d="M-31 -13 L -19 -13 L -19 13 L -31 13 A 6.5 6.5 0 0 1 -31 -13 Z"
            fill="#F2E1BE" stroke="#A9705A" stroke-width="2.2"/>
      <path d="M31 -13 A 6.5 6.5 0 0 1 31 13 L 19 13 L 19 -13 Z"
            fill="#F2E1BE" stroke="#A9705A" stroke-width="2.2"/>
      <rect x="-19" y="-12" width="6.5" height="24" fill="#FDF6E8"/>
      <rect x="12.5" y="-12" width="6.5" height="24" fill="#FDF6E8"/>
      <g fill="none" stroke="#D89984" stroke-width="1.8" stroke-linecap="round">
        <path d="M-7 -7 L -5 7"/><path d="M3 -7 L 5 7"/>
      </g>
      <path d="M-10 -9 C -3 -11 5 -11 10 -9" fill="none" stroke="#F8D9CB" stroke-width="2" stroke-linecap="round" opacity=".85"/>
    </g>
    <!-- lát khế: ngôi sao 5 cánh, nhìn phát ra ngay -->
    <g id="btcKhe">
      <path d="M0 -13 L 3.8 -4.2 L 13 -4 L 5.8 2 L 8.4 11 L 0 5.6 L -8.4 11 L -5.8 2 L -13 -4 L -3.8 -4.2 Z"
            fill="#E4ECB2" stroke="#8FA84E" stroke-width="1.8" stroke-linejoin="round"/>
      <path d="M0 -6 L 0 2" stroke="#B7CC7C" stroke-width="1.4" stroke-linecap="round"/>
    </g>
    <!-- lá rau thơm nhỏ -->
    <g id="btcLa">
      <path d="M0 0 C 3 -10 13 -15 23 -13 C 26 -4 19 5 8 7 C 3 8 -1 4 0 0 Z" fill="#5C9440" stroke="#356123" stroke-width="1.5"/>
      <path d="M2 2 L 21 -11" stroke="#93C169" stroke-width="1.3" stroke-linecap="round"/>
    </g>
  </defs>

  <circle cx="258" cy="244" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="258" cy="244" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <ellipse cx="258" cy="404" rx="200" ry="26" fill="rgba(15,26,14,.35)"/>

  <!-- DĨA DÀI đựng thịt -->
  <ellipse cx="248" cy="286" rx="176" ry="62" fill="#EFE9D6"/>
  <ellipse cx="248" cy="280" rx="176" ry="62" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2"/>
  <ellipse cx="248" cy="280" rx="176" ry="62" fill="none" stroke="#2C5234" stroke-width="4"/>
  <ellipse cx="248" cy="282" rx="146" ry="48" fill="none" stroke="#E0A32E" stroke-width="2.4" stroke-dasharray="2 11" stroke-linecap="round"/>

  <!-- NAN QUẠT LÁT THỊT — lát DỰNG GẦN ĐỨNG, lợp ngang như bộ bài xòe.
       Hai bản trước để lát nằm NGANG nối đuôi nhau, và vì hai đầu lát đều là băng
       da màu kem nên da lát này chạm da lát kia rồi nhập thành một dải liền — cả
       dĩa đọc ra thành hai miếng thịt xông khói dài. Dựng đứng thì mỗi lát tự tách,
       mà hai vành da lại lộ ra ở trên và dưới, đúng thứ cần khoe. -->
  <!-- thu nhỏ 10% quanh tâm dĩa cho nan quạt nằm gọn trong vành -->
  <g transform="matrix(.9 0 0 .9 24.8 28.2)">
  <use href="#btcThit" transform="translate(126 272) rotate(-110)"/>
  <use href="#btcThit" transform="translate(158 264) rotate(-104)"/>
  <use href="#btcThit" transform="translate(190 258) rotate(-99)"/>
  <use href="#btcThit" transform="translate(222 254) rotate(-95)"/>
  <use href="#btcThit" transform="translate(254 253) rotate(-91)"/>
  <use href="#btcThit" transform="translate(286 254) rotate(-87)"/>
  <use href="#btcThit" transform="translate(318 258) rotate(-82)"/>
  <use href="#btcThit" transform="translate(350 265) rotate(-76)"/>
  <use href="#btcThit" transform="translate(380 274) rotate(-70)"/>
  <!-- ba lát lớp trước, thấp hơn, cho dĩa có chiều sâu -->
  <use href="#btcThit" transform="translate(206 310) rotate(-97) scale(.95)"/>
  <use href="#btcThit" transform="translate(248 308) rotate(-91) scale(.95)"/>
  <use href="#btcThit" transform="translate(290 310) rotate(-85) scale(.95)"/>
  </g>

  <!-- CHỒNG BÁNH TRÁNG KHÔ tròn, dựng chếch bên phải -->
  <g transform="translate(432 216) rotate(-8)">
    <ellipse cx="0" cy="26" rx="64" ry="18" fill="rgba(15,26,14,.28)"/>
    <g stroke="#C4AC7C" stroke-width="2">
      <ellipse cx="0" cy="16" rx="62" ry="19" fill="#E6D6B4"/>
      <ellipse cx="0" cy="9" rx="62" ry="19" fill="#F1E4C6"/>
      <ellipse cx="0" cy="2" rx="62" ry="19" fill="url(#btcPaper)"/>
      <ellipse cx="0" cy="-5" rx="62" ry="19" fill="#FDF8EB"/>
    </g>
    <ellipse cx="0" cy="-5" rx="48" ry="12.5" fill="none" stroke="#E0CFA6" stroke-width="1.6" stroke-dasharray="2 8"/>
    <g fill="#DCC89A" opacity=".8">
      <circle cx="-24" cy="-8" r="1.7"/><circle cx="-6" cy="-11" r="1.6"/><circle cx="14" cy="-7" r="1.7"/>
      <circle cx="30" cy="-2" r="1.5"/><circle cx="-38" cy="-2" r="1.5"/><circle cx="4" cy="-2" r="1.5"/>
    </g>
  </g>

  <!-- XẤP MÌ LÁ — lá bánh ướt mềm gấp đôi, xếp chồng ba lá.
       Bản 1 vẽ một khối vòm liền nên render ra nhìn y như cái vỏ sò. Bản này để
       thấy rõ BA LÁ RỜI có mép lượn sóng và đường gấp giữa — mềm, ướt, bóng,
       tách hẳn với chồng bánh tráng khô tròn cứng ở phía kia. -->
  <g transform="translate(92 336) rotate(-5)">
    <ellipse cx="0" cy="34" rx="62" ry="15" fill="rgba(15,26,14,.28)"/>
    <g stroke="#C9BD98" stroke-width="1.9">
      <path d="M-58 22 C -44 12 -18 8 4 10 C 30 12 52 18 58 26 C 40 34 -24 36 -58 22 Z" fill="#E4DBC0"/>
      <path d="M-56 12 C -42 2 -16 -2 6 0 C 32 2 54 8 60 16 C 42 24 -22 26 -56 12 Z" fill="#F2EBD8"/>
      <path d="M-54 2 C -40 -8 -14 -12 8 -10 C 34 -8 56 -2 62 6 C 44 14 -20 16 -54 2 Z" fill="#FCF8EC"/>
    </g>
    <path d="M-46 0 C -30 -8 -6 -11 14 -9" fill="none" stroke="#FFFFFA" stroke-width="3.6" stroke-linecap="round"/>
    <path d="M-40 4 C -20 10 22 12 50 8" fill="none" stroke="#D9CEAA" stroke-width="1.8" stroke-linecap="round" opacity=".85"/>
    <path d="M-42 14 C -22 20 20 22 52 18" fill="none" stroke="#D9CEAA" stroke-width="1.7" stroke-linecap="round" opacity=".75"/>
  </g>

  <!-- RỔ RAU: lá thơm + chuối chát + KHẾ NGÔI SAO, cụm dưới giữa.
       Có mẹt lót bên dưới — bản 1 để rau trôi thẳng trên nền, nhìn như rơi vãi. -->
  <g transform="translate(252 376)">
    <ellipse cx="0" cy="14" rx="128" ry="34" fill="rgba(15,26,14,.3)"/>
    <ellipse cx="0" cy="6" rx="126" ry="34" fill="#C79B4E" stroke="#8E6524" stroke-width="2.4"/>
    <ellipse cx="0" cy="2" rx="126" ry="34" fill="#D9B36A" stroke="#8E6524" stroke-width="2.2"/>
    <ellipse cx="0" cy="2" rx="112" ry="27" fill="#C79B4E" stroke="#8E6524" stroke-width="1.8"/>
    <ellipse cx="0" cy="2" rx="112" ry="27" fill="none" stroke="#2C5234" stroke-width="3"/>
  </g>
  <use href="#btcLa" transform="translate(196 356) rotate(-16)"/>
  <use href="#btcLa" transform="translate(232 366) rotate(10) scale(.95)"/>
  <use href="#btcLa" transform="translate(168 372) rotate(22) scale(.9)"/>
  <use href="#btcLa" transform="translate(262 352) rotate(-6) scale(.92)"/>
  <use href="#btcLa" transform="translate(214 384) rotate(30) scale(.86)"/>
  <!-- lát chuối chát: tròn, ruột kem, lấm tấm hạt -->
  <g>
    <g transform="translate(300 366)">
      <circle r="17" fill="#CFDFAB" stroke="#8FA84E" stroke-width="2.2"/>
      <circle r="11" fill="#F3F0DC"/>
      <g fill="#B9A87C"><circle cx="-3.4" cy="-3" r="1.7"/><circle cx="4" cy="0" r="1.7"/><circle cx="-1" cy="4.4" r="1.7"/></g>
    </g>
    <g transform="translate(334 384) scale(.86)">
      <circle r="17" fill="#CFDFAB" stroke="#8FA84E" stroke-width="2.2"/>
      <circle r="11" fill="#F3F0DC"/>
      <g fill="#B9A87C"><circle cx="-3" cy="2" r="1.6"/><circle cx="3.4" cy="-2.4" r="1.6"/></g>
    </g>
  </g>
  <use href="#btcKhe" transform="translate(268 388) rotate(14)"/>
  <use href="#btcKhe" transform="translate(238 404) rotate(-20) scale(.9)"/>
  <use href="#btcKhe" transform="translate(300 402) rotate(6) scale(.82)"/>

  <!-- CHÉN MẮM NÊM — nâu xám, có xác thơm vàng và lát ớt.
       Cố ý KHÔNG dùng nâu đỏ: nâu đỏ là chén tương đậu phộng của gỏi cuốn. -->
  <g transform="translate(420 366)">
    <ellipse cx="0" cy="26" rx="54" ry="14" fill="rgba(15,26,14,.32)"/>
    <path d="M-48 0 C -46 22 -28 36 0 36 C 28 36 46 22 48 0 Z" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2.2"/>
    <ellipse cx="0" cy="0" rx="48" ry="15" fill="#F6F1E1" stroke="#D8D0B6" stroke-width="2"/>
    <ellipse cx="0" cy="0" rx="40" ry="12" fill="url(#btcMam)"/>
    <ellipse cx="-10" cy="-2" rx="15" ry="4.6" fill="#B29470" opacity=".8"/>
    <!-- xác thơm băm nổi lên mặt mắm -->
    <g fill="#EEC85E" stroke="#C79E30" stroke-width="1.2">
      <ellipse cx="-18" cy="1" rx="4.4" ry="3" transform="rotate(-16 -18 1)"/>
      <ellipse cx="-4" cy="3" rx="4" ry="2.8" transform="rotate(12 -4 3)"/>
      <ellipse cx="10" cy="-1" rx="4.2" ry="2.9" transform="rotate(-8 10 -1)"/>
      <ellipse cx="22" cy="2" rx="3.6" ry="2.5" transform="rotate(20 22 2)"/>
      <ellipse cx="2" cy="-4" rx="3.4" ry="2.4" transform="rotate(6 2 -4)"/>
    </g>
    <g><circle cx="16" cy="4" r="4.2" fill="#D64B33" stroke="#A83722" stroke-width="1.4"/><circle cx="16" cy="4" r="1.8" fill="#F28C6E"/></g>
    <g><circle cx="-26" cy="4" r="3.6" fill="#D64B33" stroke="#A83722" stroke-width="1.3"/><circle cx="-26" cy="4" r="1.5" fill="#F28C6E"/></g>
    <g stroke="#5C9440" stroke-width="2.4" stroke-linecap="round" fill="none">
      <path d="M-14 6 l8 -1 M6 7 l7 -1"/>
    </g>
  </g>
</svg>
