---
/* Cá kho tộ — minh họa riêng: khúc cá rõ da và xương, đuôi cá ló, chén cơm trắng */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Tộ cá kho sôi liu riu, kèm chén cơm trắng">
  <defs>
    <linearGradient id="ckBody" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#A9713D"/><stop offset="1" stop-color="#7E4E27"/>
    </linearGradient>
    <linearGradient id="ckSauce" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#8A4A1E"/><stop offset="1" stop-color="#5E2F10"/>
    </linearGradient>
  </defs>
  <circle cx="260" cy="240" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="240" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <g class="steam">
    <path d="M225 210 C 214 186 240 170 229 144 C 222 128 236 116 232 102"/>
    <path d="M285 206 C 275 182 301 168 290 142 C 283 126 297 114 293 98"/>
  </g>
  <ellipse cx="260" cy="424" rx="188" ry="24" fill="rgba(15,26,14,.35)"/>

  <!-- thân tộ đất -->
  <path d="M92 262 C 96 356 168 416 260 416 C 352 416 424 356 428 262 Z" fill="url(#ckBody)"/>
  <!-- Viền sáng: tộ đất nâu đặt trên nền nâu của họ "Mặn đưa cơm" thì mất
       đường bao. Đây là tộ to và tối nhất trong nhóm nên cần thêm viền riêng,
       ngoài quầng sáng chung đã có ở --art-halo. -->
  <path d="M92 262 C 96 356 168 416 260 416 C 352 416 424 356 428 262"
        fill="none" stroke="#E9B778" stroke-width="3" stroke-linecap="round" opacity=".5"/>
  <ellipse cx="260" cy="262" rx="168" ry="38" fill="#5E3A1B"/>
  <ellipse cx="260" cy="262" rx="168" ry="38" fill="none" stroke="#F0C48D" stroke-width="3.2" opacity=".7"/>
  <ellipse cx="260" cy="258" rx="150" ry="31" fill="url(#ckSauce)"/>
  <path d="M88 258 q-26 -6 -30 -26" fill="none" stroke="#8A5730" stroke-width="16" stroke-linecap="round"/>
  <path d="M432 258 q26 -6 30 -26" fill="none" stroke="#8A5730" stroke-width="16" stroke-linecap="round"/>
  <path d="M120 320 C 170 342 350 342 400 320" fill="none" stroke="#6B4020" stroke-width="6" stroke-linecap="round" opacity=".7"/>
  <path d="M108 292 C 165 316 355 316 412 292" fill="none" stroke="#E0A32E" stroke-width="3" stroke-dasharray="2 12" stroke-linecap="round" opacity=".8"/>

  <!-- khúc cá 1: da sậm trên lưng, thịt vân, xương giữa -->
  <g transform="rotate(-5 200 250)">
    <rect x="152" y="234" width="96" height="34" rx="12" fill="#C98B4E" stroke="#8A4517" stroke-width="2.5"/>
    <path d="M156 240 C 186 228 218 228 244 240 L 244 246 C 218 236 186 236 156 246 Z" fill="#4A2C12"/>
    <path d="M170 252 q10 8 20 0 M198 258 q10 8 20 0" fill="none" stroke="#A66430" stroke-width="2.6" stroke-linecap="round"/>
    <circle cx="200" cy="252" r="5" fill="#F3E3C3" stroke="#C9A06E" stroke-width="1.6"/>
    <path d="M160 244 q40 -10 82 0" fill="none" stroke="#E8A65A" stroke-width="2.4" stroke-linecap="round" opacity=".8"/>
  </g>
  <!-- khúc cá 2 -->
  <g transform="rotate(6 316 258)">
    <rect x="272" y="242" width="88" height="32" rx="11" fill="#C4854A" stroke="#8A4517" stroke-width="2.5"/>
    <path d="M276 248 C 302 237 332 237 356 248 L 356 254 C 332 244 302 244 276 254 Z" fill="#4A2C12"/>
    <path d="M290 260 q9 7 18 0" fill="none" stroke="#A66430" stroke-width="2.6" stroke-linecap="round"/>
    <circle cx="316" cy="258" r="4.6" fill="#F3E3C3" stroke="#C9A06E" stroke-width="1.6"/>
  </g>
  <!-- đuôi cá ló khỏi mặt nước kho -->
  <g transform="rotate(-18 388 240)">
    <path d="M364 246 C 376 238 388 236 398 238 L 424 218 C 422 230 424 240 430 248 C 424 254 420 262 422 272 L 396 258 C 386 258 374 254 364 246 Z" fill="#8A5730" stroke="#5E3A1B" stroke-width="2.4"/>
    <path d="M402 240 L 420 226 M404 248 L 424 246 M400 254 L 416 264" stroke="#5E3A1B" stroke-width="2.2" stroke-linecap="round"/>
  </g>

  <!-- nước kho sánh bong bóng + tiêu + ớt + hành -->
  <g fill="#E8A65A" opacity=".85">
    <circle cx="150" cy="256" r="4"/><circle cx="258" cy="238" r="3.4"/><circle cx="352" cy="270" r="3.6"/>
    <circle cx="230" cy="266" r="3"/><circle cx="300" cy="234" r="3"/>
  </g>
  <g fill="#2E2318">
    <circle cx="188" cy="234" r="2.2"/><circle cx="248" cy="254" r="2.2"/><circle cx="296" cy="264" r="2.2"/><circle cx="342" cy="240" r="2.2"/>
  </g>
  <path d="M254 230 C 266 226 278 228 284 222" fill="none" stroke="#C0392B" stroke-width="7" stroke-linecap="round"/>
  <g stroke="#7FA95B" stroke-width="4" stroke-linecap="round" fill="none">
    <path d="M214 228 q10 -6 20 -4"/><path d="M320 272 q10 -5 19 -2"/>
  </g>

  <!-- chén cơm trắng kề bên -->
  <g transform="translate(448 366)">
    <ellipse cx="0" cy="34" rx="52" ry="13" fill="rgba(15,26,14,.35)"/>
    <path d="M-40 6 C -38 26 -22 38 0 38 C 22 38 38 26 40 6 Z" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2.2"/>
    <path d="M-40 6 Q 0 16 40 6" fill="none" stroke="#2C5234" stroke-width="3"/>
    <path d="M-36 2 C -30 -16 -14 -26 0 -26 C 14 -26 30 -16 36 2 Q 0 12 -36 2 Z" fill="#FFFDF6" stroke="#E3D9BB" stroke-width="2"/>
    <g stroke="#E3D9BB" stroke-width="2.6" stroke-linecap="round" fill="none">
      <path d="M-20 -8 l7 -2 M2 -16 l7 -2 M16 -6 l7 -2 M-6 -2 l7 -2"/>
    </g>
  </g>

  <!-- ớt + hành trên bàn trái -->
  <g transform="translate(76 396) rotate(-14)">
    <path d="M0 0C13 2 22 -4 26 -13" fill="none" stroke="#C0392B" stroke-width="8" stroke-linecap="round"/>
    <path d="M26 -15c2-4 6-5 9-4" fill="none" stroke="#4E7B36" stroke-width="4" stroke-linecap="round"/>
  </g>
  <g stroke="#7FA95B" stroke-width="5" stroke-linecap="round" fill="none">
    <path d="M96 418 q14 -8 28 -6"/>
  </g>
</svg>
