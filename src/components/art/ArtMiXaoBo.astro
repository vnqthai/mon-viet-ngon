---
/* Mì xào bò — ĐĨA, cặp đôi phân biệt với miến xào cua (cùng nền nâu):
   sợi ở đây là MÌ TRỨNG VÀNG dày, cuộn thành đống cao và có sợi vắt lên khỏi mép đĩa
   (miến xào cua là sợi trong mờ xám ngà, nằm bệt);
   đạm là LÁT BÒ DẸT mỏng — mép thẳng, mặt cắt sáng, thớ chạy dọc, một đầu cong lên
   (cố ý tránh dáng viên tròn kẻo thành xúc xích);
   cải thìa vẽ LIỀN KHỐI bẹ-lá (tách rời thì bẹ trắng trông như đậu hũ);
   đạo cụ: chén tương ớt + một cây cải thìa nguyên trên bàn */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Đĩa mì xào bò: sợi mì trứng vàng cuộn đầy đĩa, lát thịt bò dẹt xém cạnh, cải thìa xanh, hành tây và cà rốt, kèm chén tương ớt">
  <defs>
    <linearGradient id="mxbBo" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#9A5730"/><stop offset="1" stop-color="#5A2810"/>
    </linearGradient>
    <!-- LÁT BÒ XÀO: bản dẹt mép thẳng, mặt cắt sáng chạy suốt mép trên,
         thớ dọc, đuôi phải cong hớt lên — dáng lát, không phải dáng viên -->
    <g id="mxbLat">
      <!-- thân lát: DẸT (rộng gấp ~5 lần dày), mép trên dưới gợn không đều -->
      <path d="M-38 -2 C -26 -6.6 -10 -5.6 4 -7 C 16 -8.2 26 -7.4 33 -5
               C 38 -3.2 38.6 1 34 2.8 C 25 6.4 12 5.2 -1 6.6
               C -13 7.8 -25 7.4 -34 5.6 C -39.6 4.4 -41 0 -38 -2 Z"
            fill="url(#mxbBo)" stroke="#3A1706" stroke-width="1.9" stroke-linejoin="round"/>
      <!-- mặt cắt sáng chạy suốt mép trên -->
      <path d="M-38 -2 C -26 -6.6 -10 -5.6 4 -7 C 16 -8.2 26 -7.4 33 -5 C 35.6 -4 37 -2.4 37.4 -0.6
               C 28 -3.4 17 -3.6 4 -2.4 C -10 -1 -26 -1.4 -37.6 0.6 Z" fill="#C48156"/>
      <!-- thớ thịt chạy dọc -->
      <g stroke="#6E381A" stroke-width="1.2" stroke-linecap="round" fill="none" opacity=".8">
        <path d="M-31 2 C -18 0.6 -2 1.6 12 0.4 C 22 -0.4 28 -1 32 -2"/>
        <path d="M-29 4.6 C -18 3.6 -4 4.4 8 3.6"/>
      </g>
      <!-- rìa dưới sẫm: cạnh mỏng của lát thịt -->
      <path d="M-34 5.6 C -25 7.4 -13 7.8 -1 6.6 C 12 5.2 25 6.4 34 2.8
               C 32 5.4 24 7.6 12 8.4 C -2 9.4 -20 9.2 -32 7.6 Z" fill="#3A1706" opacity=".6"/>
      <!-- ánh sốt bóng trên mặt -->
      <path d="M-26 -3 C -14 -5 2 -4.4 14 -5.4" fill="none" stroke="#E0A472" stroke-width="1.8" stroke-linecap="round" opacity=".8"/>
    </g>
    <!-- CẢI THÌA vẽ LIỀN KHỐI: bẹ trắng thon nối thẳng vào tán lá xanh -->
    <g id="mxbCai">
      <path d="M0 8 C -2 0 2 -5 9 -7 C 16 -9 22 -7 24 -3 C 30 -14 44 -21 58 -20
               C 60 -9 50 1 34 6 C 22 10 6 13 0 8 Z"
            fill="#3E7B3A" stroke="#25501E" stroke-width="1.9" stroke-linejoin="round"/>
      <path d="M0 8 C -2 0 2 -5 9 -7 C 16 -9 22 -7 24 -3 C 22 3 16 8 8 11 C 3 12 0 11 0 8 Z"
            fill="#EFE9D0" stroke="#25501E" stroke-width="1.7"/>
      <path d="M22 -1 C 34 -6 46 -11 55 -16" fill="none" stroke="#84B85E" stroke-width="1.6" stroke-linecap="round"/>
      <path d="M4 6 C 10 3 16 0 21 -3" fill="none" stroke="#CFC7A4" stroke-width="1.4" stroke-linecap="round"/>
    </g>
  </defs>
  <circle cx="260" cy="250" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="250" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <g class="steam">
    <path d="M204 218 C 193 194 219 178 208 152 C 201 136 215 124 211 110"/>
    <path d="M272 210 C 262 186 288 172 277 146 C 270 130 284 118 280 104"/>
    <path d="M330 220 C 320 196 346 182 335 156 C 328 140 342 128 338 114"/>
  </g>
  <ellipse cx="260" cy="404" rx="200" ry="26" fill="rgba(15,26,14,.35)"/>

  <!-- đĩa -->
  <ellipse cx="260" cy="346" rx="204" ry="58" fill="#F6F1E1"/>
  <ellipse cx="260" cy="342" rx="204" ry="58" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2"/>
  <ellipse cx="260" cy="342" rx="204" ry="58" fill="none" stroke="#2C5234" stroke-width="4"/>
  <ellipse cx="260" cy="344" rx="168" ry="44" fill="none" stroke="#E0A32E" stroke-width="2.4" stroke-dasharray="2 11" stroke-linecap="round"/>

  <!-- vũng sốt nâu bóng dưới đống mì -->
  <ellipse cx="258" cy="336" rx="152" ry="34" fill="#6E3F17" opacity=".5"/>

  <!-- lớp sau: cải thìa + cà rốt dựng cao sau đống mì -->
  <use href="#mxbCai" transform="translate(126 306) rotate(-14)"/>
  <use href="#mxbCai" transform="translate(392 300) rotate(174) scale(.96)"/>
  <g>
    <g transform="translate(196 294) rotate(-18)">
      <ellipse cx="0" cy="0" rx="13" ry="7" fill="#EF9440" stroke="#BF6A18" stroke-width="2"/>
      <ellipse cx="0" cy="0" rx="6.5" ry="3.4" fill="#F8C078"/>
    </g>
    <g transform="translate(322 288) rotate(14)">
      <ellipse cx="0" cy="0" rx="12" ry="6.4" fill="#EF9440" stroke="#BF6A18" stroke-width="2"/>
      <ellipse cx="0" cy="0" rx="6" ry="3.1" fill="#F8C078"/>
    </g>
  </g>

  <!-- ===== ĐỐNG MÌ TRỨNG: dựng CAO thành gò, ba lớp, phủ kín lòng đĩa =====
       Khối nền đặc trước, sợi vẽ đè lên — không có khối nền thì mấy sợi rời
       trông như dây thép chứ không ra đống mì. -->
  <path d="M130 336 C 144 300 194 282 258 282 C 322 282 372 300 386 336
           C 372 366 322 380 258 380 C 194 380 144 366 130 336 Z"
        fill="#A9761A"/>
  <path d="M146 318 C 166 296 206 286 258 286 C 310 286 350 296 370 318
           C 344 306 304 300 258 300 C 212 300 172 306 146 318 Z"
        fill="#C08A22" opacity=".9"/>
  <!-- lớp sau (sẫm, nằm sâu) — vòng cao nhất của gò -->
  <g fill="none" stroke="#9A6A12" stroke-width="8.5" stroke-linecap="round">
    <path d="M148 306 C 188 282 240 276 288 288"/>
    <path d="M242 288 C 282 268 330 268 368 284"/>
    <path d="M158 328 C 200 306 254 302 300 314"/>
    <path d="M286 306 C 322 288 360 288 388 302"/>
  </g>
  <!-- lớp giữa (vàng chính) -->
  <g fill="none" stroke="#F0C24C" stroke-width="9.5" stroke-linecap="round">
    <path d="M138 322 C 180 298 238 294 284 308"/>
    <path d="M250 302 C 292 282 342 282 380 298"/>
    <path d="M144 346 C 190 322 250 318 300 332"/>
    <path d="M272 340 C 314 320 358 320 390 336"/>
    <path d="M170 364 C 216 344 272 342 314 356"/>
    <path d="M298 360 C 332 344 366 344 392 356"/>
    <path d="M136 334 C 178 314 234 310 280 322"/>
    <path d="M262 318 C 302 300 348 300 384 314"/>
    <path d="M152 356 C 196 336 252 333 298 345"/>
    <path d="M284 350 C 322 332 362 332 392 346"/>
  </g>
  <!-- HAI SỢI vắt lên khỏi gò, đủ dày để vẫn ra sợi mì chứ không thành sợi dây -->
  <g fill="none" stroke="#C08A22" stroke-width="10" stroke-linecap="round">
    <path d="M212 302 C 216 278 244 266 276 272"/>
    <path d="M300 294 C 314 272 344 266 366 276"/>
  </g>
  <g fill="none" stroke="#F0C24C" stroke-width="8" stroke-linecap="round">
    <path d="M212 302 C 216 278 244 266 276 272"/>
    <path d="M300 294 C 314 272 344 266 366 276"/>
  </g>
  <!-- ánh sáng trên sợi -->
  <g fill="none" stroke="#FBDE86" stroke-width="3.2" stroke-linecap="round" opacity=".95">
    <path d="M144 320 C 184 296 238 292 280 305"/>
    <path d="M256 300 C 296 280 342 280 376 296"/>
    <path d="M176 362 C 220 342 272 340 310 353"/>
    <path d="M216 300 C 220 276 244 265 272 271"/>
    <path d="M304 292 C 318 271 344 266 364 275"/>
  </g>
  <!-- vệt XÉM VÀNG NÂU: dấu mặt mì áp chảo -->
  <g fill="none" stroke="#9A5A10" stroke-width="2.8" stroke-linecap="round" opacity=".9">
    <path d="M162 334 C 196 318 232 315 258 321"/>
    <path d="M296 336 C 326 322 356 321 380 327"/>
    <path d="M196 360 C 224 347 254 346 278 350"/>
    <path d="M256 296 C 288 280 324 279 352 285"/>
  </g>

  <!-- HÀNH TÂY múi trắng trong lẫn giữa sợi -->
  <g fill="none" stroke="#F6F1E1" stroke-width="6.4" stroke-linecap="round">
    <path d="M188 330 a 18 11 0 0 1 29 -6"/>
    <path d="M330 334 a 17 10 0 0 1 27 -6"/>
    <path d="M246 362 a 15 9 0 0 1 24 -5"/>
  </g>
  <g fill="none" stroke="#C9BD99" stroke-width="1.9" stroke-linecap="round" opacity=".9">
    <path d="M193 326 a 14 8 0 0 1 22 -5"/>
    <path d="M335 330 a 13 8 0 0 1 21 -5"/>
    <path d="M251 359 a 12 7 0 0 1 19 -4"/>
  </g>

  <!-- ===== LÁT BÒ DẸT nằm trên gò mì — chừa chỗ cho sợi mì lộ ra ===== -->
  <ellipse cx="258" cy="342" rx="102" ry="20" fill="#3A1706" opacity=".16"/>
  <use href="#mxbLat" transform="translate(200 334) rotate(-9)"/>
  <use href="#mxbLat" transform="translate(288 324) rotate(5) scale(.98)"/>
  <use href="#mxbLat" transform="translate(238 358) rotate(6) scale(1.02)"/>
  <use href="#mxbLat" transform="translate(324 352) rotate(-4) scale(.9)"/>

  <!-- cải thìa lớp trước, đè lên mép đống mì -->
  <use href="#mxbCai" transform="translate(146 350) rotate(-10) scale(.92)"/>
  <use href="#mxbCai" transform="translate(378 346) rotate(172) scale(.88)"/>

  <!-- hành lá khúc + ngò rắc mặt -->
  <g fill="none" stroke="#6F9C48" stroke-width="4.6" stroke-linecap="round">
    <path d="M234 300 l 15 -3"/>
    <path d="M344 356 l 13 -3"/>
    <path d="M186 358 l 13 -3"/>
    <path d="M282 340 l 12 -3"/>
  </g>
  <g transform="translate(298 292)">
    <path d="M0 4 L 2 -6" stroke="#2C5E2E" stroke-width="1.5"/>
    <path d="M0 -2 C -5 -10 -2 -19 6 -21 C 11 -14 9 -5 3 0 C 1 1 0 0 0 -2 Z" fill="#3E7B3A" stroke="#26521F" stroke-width="1.4"/>
    <path d="M-4 2 C -10 -3 -10 -11 -4 -15 C 1 -11 2 -4 -1 2 C -2 3 -3 3 -4 2 Z" fill="#4A8B3E" stroke="#26521F" stroke-width="1.3"/>
  </g>
  <!-- tiêu xay lấm tấm -->
  <g fill="#3E2A16" opacity=".8">
    <circle cx="218" cy="322" r="1.5"/><circle cx="286" cy="308" r="1.4"/><circle cx="344" cy="342" r="1.4"/>
    <circle cx="242" cy="348" r="1.3"/><circle cx="308" cy="352" r="1.3"/><circle cx="176" cy="344" r="1.3"/>
  </g>

  <!-- ĐẠO CỤ TRÁI: chén tương ớt -->
  <g transform="translate(90 406)">
    <ellipse cx="0" cy="14" rx="42" ry="12" fill="rgba(15,26,14,.3)"/>
    <path d="M-34 -2 C -32 14 -18 23 0 23 C 18 23 32 14 34 -2 Z" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2"/>
    <ellipse cx="0" cy="-2" rx="28" ry="8.5" fill="#C9391F"/>
    <ellipse cx="-8" cy="-4" rx="10" ry="2.8" fill="#E86A4A" opacity=".85"/>
    <g fill="#8E2113">
      <circle cx="8" cy="-1" r="1.6"/><circle cx="-2" cy="1" r="1.4"/><circle cx="16" cy="-4" r="1.3"/>
    </g>
  </g>

  <!-- ĐẠO CỤ PHẢI: một cây cải thìa nguyên trên bàn -->
  <g transform="translate(428 392) rotate(-8)">
    <ellipse cx="4" cy="42" rx="46" ry="11" fill="rgba(15,26,14,.3)"/>
    <path d="M-16 38 C -20 18 -14 2 -2 -4 C 12 -10 26 -4 30 10 C 33 22 28 34 20 40 C 8 46 -12 46 -16 38 Z"
          fill="#EFE9D0" stroke="#C1B992" stroke-width="2.2"/>
    <g stroke="#D5CBA4" stroke-width="1.8" stroke-linecap="round" fill="none">
      <path d="M-6 38 C -8 22 -6 8 0 -2"/>
      <path d="M8 42 C 8 26 10 10 16 2"/>
    </g>
    <g fill="#3E7B3A" stroke="#25501E" stroke-width="1.9">
      <path d="M-2 -4 C -18 -20 -20 -42 -8 -52 C 4 -44 8 -22 4 -4 Z"/>
      <path d="M6 -6 C 8 -28 22 -46 36 -46 C 38 -30 26 -12 12 -2 Z"/>
      <path d="M-6 0 C -26 -6 -42 -20 -42 -32 C -26 -32 -10 -20 -2 -6 Z"/>
    </g>
    <g fill="none" stroke="#84B85E" stroke-width="1.6" stroke-linecap="round">
      <path d="M-4 -6 C -10 -22 -12 -38 -8 -48"/>
      <path d="M8 -8 C 12 -24 22 -38 32 -43"/>
      <path d="M-6 -1 C -18 -8 -30 -18 -38 -28"/>
    </g>
  </g>
</svg>
