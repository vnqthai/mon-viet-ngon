---
/* Tô bún bò Huế — minh họa riêng: nước đỏ sa tế, khoanh giò, sợi bún, cây sả */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Tô bún bò Huế đỏ óng, khoanh giò heo">
  <defs>
    <linearGradient id="bbBroth" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#E2703F"/><stop offset="1" stop-color="#C24A22"/>
    </linearGradient>
    <linearGradient id="bbBowl" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#FDFAF0"/><stop offset="1" stop-color="#E9E2CC"/>
    </linearGradient>
  </defs>
  <circle cx="260" cy="240" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="240" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <g class="steam">
    <path d="M205 236 C 194 210 220 194 209 166 C 202 148 216 136 212 120"/>
    <path d="M262 230 C 252 204 278 190 267 162 C 260 144 274 132 270 114"/>
    <path d="M318 238 C 308 214 332 198 322 172 C 316 156 328 144 324 130"/>
  </g>
  <ellipse cx="255" cy="420" rx="196" ry="24" fill="rgba(15,26,14,.35)"/>

  <!-- tô -->
  <path d="M67 296 C 73 370 157 414 255 414 C 353 414 437 370 443 296 Z" fill="url(#bbBowl)"/>
  <ellipse cx="255" cy="412" rx="62" ry="11" fill="#D8D0B6"/>
  <ellipse cx="255" cy="294" rx="188" ry="46" fill="#F6F1E1"/>
  <ellipse cx="255" cy="294" rx="188" ry="46" fill="none" stroke="#2C5234" stroke-width="5"/>
  <ellipse cx="255" cy="295" rx="174" ry="40" fill="none" stroke="#E0A32E" stroke-width="2.5" stroke-dasharray="2 11" stroke-linecap="round"/>

  <!-- nước lèo đỏ, váng sa tế -->
  <ellipse cx="255" cy="297" rx="158" ry="33" fill="url(#bbBroth)"/>
  <ellipse cx="205" cy="290" rx="55" ry="10" fill="#F2925E" opacity=".55"/>
  <g fill="#F29B68" opacity=".9">
    <circle cx="160" cy="298" r="4"/><circle cx="238" cy="316" r="3.4"/><circle cx="300" cy="288" r="3.6"/>
    <circle cx="352" cy="304" r="4"/><circle cx="272" cy="300" r="2.8"/>
  </g>
  <path d="M300 314 q18 -6 36 -2 M148 306 q14 -6 30 -4" fill="none" stroke="#F2A968" stroke-width="3" stroke-linecap="round" opacity=".8"/>

  <!-- khoanh giò heo: da – thịt – xương -->
  <g transform="translate(190 296)">
    <circle r="33" fill="#E8C39E" stroke="#C9935E" stroke-width="2.5"/>
    <circle r="24" fill="#D9917A" stroke="#B96A50" stroke-width="1.8"/>
    <circle r="9" fill="#FBF5E3" stroke="#D8C8A8" stroke-width="2"/>
    <circle r="3" fill="#E3D3AE"/>
    <path d="M-26 -14 a30 30 0 0 1 18 -14" fill="none" stroke="#F3DDBE" stroke-width="4" stroke-linecap="round"/>
  </g>

  <!-- lát bắp bò -->
  <g transform="rotate(-6 286 288)">
    <ellipse cx="286" cy="288" rx="28" ry="12" fill="#A5563C" stroke="#7E3A26" stroke-width="2.2"/>
    <path d="M266 286 q20 -7 40 0" fill="none" stroke="#C98070" stroke-width="2.4" stroke-linecap="round"/>
  </g>
  <g transform="rotate(8 330 310)">
    <ellipse cx="330" cy="310" rx="25" ry="11" fill="#B06044" stroke="#7E3A26" stroke-width="2.2"/>
    <path d="M312 308 q18 -6 36 0" fill="none" stroke="#D08A78" stroke-width="2.2" stroke-linecap="round"/>
  </g>

  <!-- sợi bún tròn ló bên phải -->
  <g fill="none" stroke="#FBF5E3" stroke-width="6.5" stroke-linecap="round">
    <path d="M348 288 C 366 282 384 284 396 292"/>
    <path d="M352 300 C 370 294 386 296 396 302"/>
  </g>
  <path d="M356 292 C 372 287 386 289 394 296" fill="none" stroke="#E8DDBE" stroke-width="2" stroke-linecap="round" opacity=".7"/>

  <!-- hành tây + hành lá + ớt -->
  <path d="M236 316 a12 6 0 0 1 20 3" fill="none" stroke="#F6EEDC" stroke-width="3.2" stroke-linecap="round" opacity=".95"/>
  <g stroke="#6F9C48" stroke-width="3.6" stroke-linecap="round" fill="none">
    <path d="M148 288 l12 -3 M262 322 l11 -2 M372 310 l10 -2"/>
  </g>
  <circle cx="256" cy="286" r="5.5" fill="none" stroke="#8FBF4D" stroke-width="3.6"/>

  <!-- cây sả nhỏ nằm trên bàn -->
  <g transform="translate(42 386) rotate(-12)">
    <path d="M0 7 C 20 3 58 2 96 4 L 97 10 C 58 12 20 13 2 12 Z" fill="#E8EFCB" stroke="#9CB25C" stroke-width="2"/>
    <path d="M96 4 q18 -2 28 -7 M97 10 q16 0 26 3" fill="none" stroke="#86A94F" stroke-width="3" stroke-linecap="round"/>
    <path d="M14 7 h22 M46 6 h26" stroke="#B9C98A" stroke-width="1.8" stroke-linecap="round"/>
    <ellipse cx="2" cy="9.5" rx="3.4" ry="5" fill="#F6F1DC" stroke="#9CB25C" stroke-width="1.4"/>
  </g>
  <g transform="translate(56 408) rotate(-6)">
    <path d="M0 6 C 18 3 50 2 84 4 L 85 9 C 50 11 18 12 2 10 Z" fill="#DFE8BC" stroke="#9CB25C" stroke-width="1.8"/>
    <path d="M84 4 q16 -2 24 -6" fill="none" stroke="#86A94F" stroke-width="2.8" stroke-linecap="round"/>
    <ellipse cx="2" cy="8" rx="3" ry="4.4" fill="#F6F1DC" stroke="#9CB25C" stroke-width="1.4"/>
  </g>

  <!-- chén sa tế + chanh ớt -->
  <g>
    <ellipse cx="428" cy="392" rx="38" ry="12" fill="rgba(15,26,14,.3)"/>
    <path d="M396 376 C 398 394 410 404 428 404 C 446 404 458 394 460 376 Z" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2"/>
    <ellipse cx="428" cy="376" rx="32" ry="9.5" fill="#C0392B"/>
    <ellipse cx="420" cy="374" rx="12" ry="4" fill="#E05A38" opacity=".9"/>
  </g>
  <g transform="translate(360 416)">
    <path d="M-16 5 A17 17 0 0 1 16 5 Z" fill="#E4ECB2" stroke="#9CB25C" stroke-width="2.2"/>
    <path d="M0 5 0 -10 M0 5 -11 -3 M0 5 11 -3" stroke="#9CB25C" stroke-width="1.5"/>
  </g>
  <g transform="translate(168 424) rotate(-14)">
    <path d="M0 0C13 2 22 -4 26 -13" fill="none" stroke="#C0392B" stroke-width="8" stroke-linecap="round"/>
    <path d="M26 -15c2-4 6-5 9-4" fill="none" stroke="#4E7B36" stroke-width="4" stroke-linecap="round"/>
  </g>
</svg>
