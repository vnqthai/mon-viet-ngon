---
/* Lòng heo luộc — CHỮ KÝ, vẽ lệch hẳn khỏi ArtChaoLong và ArtBunDau:
   1) DĨA BẸT xếp LÁT THÁI XÉO chồng mép thành hàng cánh cung — cháo lòng là
      TÔ cháo tròn, bún đậu là mẹt có bún nắm; hình tổng thể khác hẳn ngay từ
      cỡ thumbnail
   2) lát lòng non là VÒNG TRÒN RỖNG GIỮA bản to (ở cháo lòng chỉ là chấm nhỏ
      chìm trong cháo), thái xéo nên hơi bầu dục
   3) LÁT KHẾ HÌNH NGÔI SAO — cả site không món nào có hình sao, đây là dấu
      nhận diện rẻ nhất mà chắc nhất
   4) chén MẮM TÔM TÍM HỒNG có BỌT nổi lấm tấm (cháo lòng dùng mắm gừng nâu
      với sợi gừng vàng — cố ý tránh trùng)
   5) nhánh húng quế xanh sẫm phủ mép dĩa
   id prefix "llu" */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Dĩa lòng heo luộc thái xéo trắng ngà xếp cánh cung, kèm lát khế hình sao, húng quế và chén mắm tôm đánh bông">
  <defs>
    <linearGradient id="lluPlate" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#FDFAF0"/><stop offset="1" stop-color="#E9E2CC"/>
    </linearGradient>
    <!-- LÁT LÒNG NON thái xéo: vòng dày rỗng giữa, bầu dục vì cắt chéo dao.
         Viền đậm hơn bản đầu và lỗ giữa tối hẳn: cả dĩa toàn sắc kem nằm trên
         dĩa cũng màu kem, render 260px ra một vệt nhợt không đọc được gì. Cái
         cứu được hình này là ĐỘ TƯƠNG PHẢN trong từng lát, không phải màu. -->
    <g id="lluLongNon">
      <ellipse cx="0" cy="0" rx="20" ry="15" fill="#F7EEDC" stroke="#8A6F45" stroke-width="2.8"/>
      <ellipse cx="0" cy="0" rx="9" ry="6.4" fill="#B79A6E" stroke="#8A6F45" stroke-width="2"/>
      <path d="M-14 -7 C -7 -12 7 -12 14 -7" fill="none" stroke="#FFFCF2" stroke-width="2.6" stroke-linecap="round"/>
      <path d="M-11 8 C -5 11 5 11 11 8" fill="none" stroke="#B49A70" stroke-width="1.8" stroke-linecap="round"/>
    </g>
    <!-- LÁT DẠ DÀY: miếng dày mép lượn, mặt có vân gợn -->
    <g id="lluDaDay">
      <path d="M-20 -8 C -12 -14 12 -14 20 -7 C 24 -2 21 9 12 12 C 1 15 -14 13 -20 8 C -24 4 -24 -4 -20 -8 Z"
            fill="#EFE0C6" stroke="#B49C74" stroke-width="2.1"/>
      <path d="M-14 -4 C -6 -8 8 -8 15 -4" fill="none" stroke="#CFB88E" stroke-width="1.6" stroke-linecap="round"/>
      <path d="M-13 2 C -5 -1 8 -1 14 2" fill="none" stroke="#CFB88E" stroke-width="1.4" stroke-linecap="round"/>
      <path d="M-11 7 C -4 5 6 5 12 7" fill="none" stroke="#CFB88E" stroke-width="1.2" stroke-linecap="round"/>
    </g>
    <!-- LÁT GAN: bản to nâu sẫm, mặt cắt mịn -->
    <g id="lluGan">
      <path d="M-21 -10 C -12 -16 13 -16 21 -9 C 25 -4 24 9 14 13 C 2 16 -16 14 -21 8 C -25 3 -25 -6 -21 -10 Z"
            fill="#6B3A2E" stroke="#42211A" stroke-width="2.1"/>
      <path d="M-15 -5 C -6 -10 9 -10 16 -5" fill="none" stroke="#8E5442" stroke-width="1.7" stroke-linecap="round"/>
      <path d="M-10 5 C -1 2 9 2 15 4" fill="none" stroke="#8E5442" stroke-width="1.4" stroke-linecap="round"/>
    </g>
    <!-- LÁT KHẾ hình ngôi sao 5 cánh — dấu nhận diện rẻ nhất mà chắc nhất, nên
         phải NHÌN THẤY: bản đầu xanh nhạt quá, chìm nghỉm vào dĩa kem. -->
    <g id="lluKhe">
      <path d="M0 -17 L 5 -5.4 L 17 -5.2 L 7.4 2.2 L 10.8 14 L 0 7 L -10.8 14 L -7.4 2.2 L -17 -5.2 L -5 -5.4 Z"
            fill="#C3D96A" stroke="#5F7A22" stroke-width="2.2" stroke-linejoin="round"/>
      <path d="M0 -10 L 0 3" stroke="#8AA83A" stroke-width="1.6" stroke-linecap="round"/>
      <path d="M-5.5 -2 L 5.5 -2" stroke="#8AA83A" stroke-width="1.4" stroke-linecap="round"/>
    </g>
    <!-- LÁ HÚNG QUẾ: lá bầu dục nhọn đầu, gân giữa -->
    <g id="lluHungQue">
      <path d="M0 0 C 4 -9 16 -13 24 -9 C 27 -3 21 6 11 9 C 4 11 0 6 0 0 Z"
            fill="#2F6B2E" stroke="#1E4218" stroke-width="1.7"/>
      <path d="M2 -0.5 C 9 -3 17 -6 23 -8" fill="none" stroke="#6BA45C" stroke-width="1.3"/>
    </g>
  </defs>
  <circle cx="260" cy="248" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="248" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <g class="steam">
    <path d="M218 250 C 207 226 233 210 222 184 C 215 168 229 156 225 142"/>
    <path d="M302 246 C 292 222 318 208 307 182 C 300 166 314 154 310 138"/>
  </g>
  <ellipse cx="260" cy="400" rx="198" ry="26" fill="rgba(15,26,14,.35)"/>

  <!-- DĨA BẸT bản rộng, vành mỏng -->
  <ellipse cx="260" cy="346" rx="200" ry="52" fill="#F6F1E1"/>
  <ellipse cx="260" cy="340" rx="200" ry="52" fill="url(#lluPlate)" stroke="#D8D0B6" stroke-width="2"/>
  <ellipse cx="260" cy="340" rx="200" ry="52" fill="none" stroke="#2C5234" stroke-width="4"/>
  <ellipse cx="260" cy="341" rx="174" ry="42" fill="none" stroke="#E0A32E" stroke-width="2.4" stroke-dasharray="2 11" stroke-linecap="round"/>
  <ellipse cx="260" cy="338" rx="148" ry="35" fill="#E7DCBC" stroke="#D0C39C" stroke-width="1.8"/>

  <!-- MỘT KHỐI: đống lát nền liền mạch, các lát vẽ đè lên.
       Nền đống sẫm hơn hẳn bản đầu — lát lòng màu kem chỉ nổi lên được khi có
       cái nền tối hơn đỡ dưới, chứ đặt kem trên kem thì mất hình. -->
  <path d="M128 336 C 134 320 168 308 214 304 C 264 300 320 302 358 310
           C 388 316 398 328 392 338 C 382 352 330 360 258 360
           C 182 360 126 350 128 336 Z" fill="#B99A66" opacity=".95"/>
  <g fill="rgba(90,70,36,.22)">
    <ellipse cx="180" cy="326" rx="26" ry="8"/><ellipse cx="252" cy="320" rx="28" ry="8"/>
    <ellipse cx="328" cy="326" rx="26" ry="8"/><ellipse cx="214" cy="346" rx="28" ry="8"/>
    <ellipse cx="300" cy="348" rx="26" ry="8"/>
  </g>

  <!-- HÀNG SAU: gan và dạ dày nhô sau -->
  <use href="#lluGan" transform="translate(170 314) rotate(-10)"/>
  <use href="#lluDaDay" transform="translate(228 306) rotate(5) scale(.96)"/>
  <use href="#lluGan" transform="translate(330 312) rotate(8) scale(.9)"/>
  <use href="#lluDaDay" transform="translate(288 304) rotate(-6) scale(.9)"/>

  <!-- HÀNG TRƯỚC: lát lòng non xếp cánh cung, chồng mép lên nhau -->
  <use href="#lluLongNon" transform="translate(160 336) rotate(-16)"/>
  <use href="#lluLongNon" transform="translate(198 342) rotate(-8) scale(1.02)"/>
  <use href="#lluLongNon" transform="translate(238 346) rotate(-2)"/>
  <use href="#lluLongNon" transform="translate(280 347) rotate(4) scale(1.02)"/>
  <use href="#lluLongNon" transform="translate(320 343) rotate(10)"/>
  <use href="#lluLongNon" transform="translate(358 335) rotate(16) scale(.94)"/>

  <!-- một lát dạ dày chen vào hàng trước cho khỏi đều tăm tắp -->
  <use href="#lluDaDay" transform="translate(258 330) rotate(-14) scale(.86)"/>

  <!-- LÁT KHẾ hình sao xếp mép dĩa -->
  <use href="#lluKhe" transform="translate(140 312) rotate(-18) scale(.95)"/>
  <use href="#lluKhe" transform="translate(384 320) rotate(14) scale(.86)"/>
  <use href="#lluKhe" transform="translate(212 366) rotate(24) scale(.8)"/>

  <!-- HÚNG QUẾ phủ mép và xen giữa -->
  <use href="#lluHungQue" transform="translate(186 300) rotate(-24)"/>
  <use href="#lluHungQue" transform="translate(300 292) rotate(8) scale(.92)"/>
  <use href="#lluHungQue" transform="translate(352 358) rotate(150) scale(.86)"/>
  <use href="#lluHungQue" transform="translate(158 360) rotate(190) scale(.82)"/>

  <!-- tiêu rắc lấm tấm -->
  <g fill="#2E2318">
    <circle cx="220" cy="330" r="1.6"/><circle cx="296" cy="334" r="1.5"/>
    <circle cx="180" cy="348" r="1.4"/><circle cx="340" cy="330" r="1.4"/>
  </g>

  <!-- ĐẠO CỤ TRÁI: nhánh húng quế tươi để rời trên bàn -->
  <g transform="translate(74 414) rotate(-10)">
    <path d="M0 0 C 16 -4 34 -4 50 0" fill="none" stroke="#4E7B36" stroke-width="3.4" stroke-linecap="round"/>
    <use href="#lluHungQue" transform="translate(8 -2) rotate(-32) scale(.9)"/>
    <use href="#lluHungQue" transform="translate(30 -4) rotate(-12) scale(.84)"/>
    <use href="#lluHungQue" transform="translate(22 4) rotate(150) scale(.8)"/>
  </g>

  <!-- ĐẠO CỤ PHẢI: chén MẮM TÔM tím hồng ĐÁNH BÔNG, bọt nổi lấm tấm.
       Vẽ to hơn bản đầu và tím đậm hơn: đây là điểm màu DUY NHẤT của cả tấm
       hình vốn toàn sắc kem, chén nhỏ quá thì cả ô thumbnail nhạt thếch. -->
  <g transform="translate(436 388) scale(1.24)">
    <ellipse cx="0" cy="22" rx="38" ry="10" fill="rgba(15,26,14,.3)"/>
    <path d="M-33 -4 C -31 12 -18 21 0 21 C 18 21 31 12 33 -4 Z" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2.2"/>
    <ellipse cx="0" cy="-4" rx="33" ry="9.2" fill="#F6F1E1" stroke="#D8D0B6" stroke-width="2"/>
    <ellipse cx="0" cy="-3" rx="27" ry="7" fill="#71407E"/>
    <ellipse cx="-4" cy="-5" rx="16" ry="3.6" fill="#96609F" opacity=".9"/>
    <!-- BỌT nổi — dấu hiệu "đánh bông" -->
    <g fill="#E0CBE6" stroke="#96609F" stroke-width=".9">
      <circle cx="-14" cy="-4" r="2.8"/><circle cx="-6" cy="-6" r="2.2"/><circle cx="3" cy="-4" r="2.6"/>
      <circle cx="12" cy="-6" r="2"/><circle cx="18" cy="-2" r="1.7"/><circle cx="-18" cy="0" r="1.8"/>
      <circle cx="7" cy="0" r="1.7"/>
    </g>
    <g fill="#D4442A" stroke="#93230F" stroke-width="1">
      <ellipse cx="-10" cy="2" rx="3.6" ry="2"/><ellipse cx="12" cy="2" rx="3.2" ry="1.8"/>
    </g>
  </g>
</svg>
