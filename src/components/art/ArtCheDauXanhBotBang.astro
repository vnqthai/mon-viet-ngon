---
/* Chè đậu xanh bột báng (Nam Bộ) — CHỮ KÝ nhận dạng:
   1) TÔ SÂU LÒNG, đáy nhỏ miệng loe (dáng chiết yêu) — khác hẳn tô rộng nông
      của chè bà ba và ly thấp thành dày của chè Thái
   2) HẠT BỘT BÁNG TRÒN TRẮNG TO nổi kín mặt — tín hiệu chính, cố ý vẽ to hơn
      hạt đậu hẳn một bậc; chè bà ba có bột báng nhưng bị mấy khối khoai lấn át
   3) chỉ MỘT MÀU vàng nhạt đục, KHÔNG có khối vuông nhiều màu — đây là chỗ tách
      khỏi chè bà ba rõ nhất
   4) GÚT LÁ DỨA xanh nổi ngay trên mặt tô — bốn món chè kia không có gì màu
      xanh nằm trong lòng vật đựng
   id prefix "bx" */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Tô chè đậu xanh bột báng nóng: nước vàng nhạt đục với hạt đậu xanh lấm tấm và nhiều hạt bột báng tròn trắng trong, có gút lá dứa xanh nổi trên mặt">
  <defs>
    <!-- Bản 1 để nước chè quá nhạt, ở 260px cả tô đọc thành bát cháo yến mạch.
         Đẩy sâu về phía vàng nghệ thì mới ra nồi chè đậu xanh. -->
    <linearGradient id="bxBroth" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#EFCB68"/><stop offset="1" stop-color="#BE9328"/>
    </linearGradient>
    <linearGradient id="bxBowl" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#FDFBF3"/><stop offset="1" stop-color="#CFC6A8"/>
    </linearGradient>
    <!-- hạt bột báng: tròn, trong, một chấm sáng lệch -->
    <g id="bxPearl">
      <circle r="9.5" fill="rgba(255,253,246,.92)" stroke="#C4B893" stroke-width="1.8"/>
      <circle cx="-3" cy="-3.4" r="3" fill="#FFFFFF" opacity=".9"/>
    </g>
  </defs>

  <circle cx="260" cy="240" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="240" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <g class="steam">
    <path d="M198 214 C 187 190 213 174 202 148 C 195 132 209 120 205 104"/>
    <path d="M268 206 C 258 182 284 168 273 142 C 266 126 280 114 276 98"/>
    <path d="M336 218 C 326 194 352 180 341 154 C 334 138 348 126 344 110"/>
  </g>
  <ellipse cx="264" cy="416" rx="180" ry="23" fill="rgba(15,26,14,.35)"/>

  <!-- ĐẠO CỤ TRÁI: NỬA TRÁI DỪA. Bản 1 để bó lá dứa, mà lá dứa ở 260px đọc y
       như trái ớt xanh. Gáo dừa thì không lẫn vào đâu được, lại nói thẳng ra
       thứ làm nên vị của nồi chè này. Lá dứa hạ xuống làm chi tiết phụ, vẽ dài
       và dẹt hẳn cho khác dáng trái ớt. -->
  <g transform="translate(92 376)">
    <!-- lá dứa nằm dài phía sau, dẹt, có gân song song -->
    <g transform="rotate(-7)">
      <path d="M-64 42 C -20 30 40 26 92 32 C 42 44 -18 50 -64 42 Z" fill="#3E7B2C" stroke="#255018" stroke-width="2"/>
      <g fill="none" stroke="#8FC262" stroke-width="1.6" stroke-linecap="round" opacity=".85">
        <path d="M-56 41 C -14 32 38 29 84 33"/>
        <path d="M-52 45 C -12 38 36 35 82 37"/>
      </g>
    </g>
    <!-- nửa trái dừa: gáo nâu sẫm, cùi dừa TRẮNG DÀY, lòng đọng nước -->
    <ellipse cx="2" cy="34" rx="52" ry="12" fill="rgba(15,26,14,.32)"/>
    <path d="M-52 -6 C -52 22 -30 38 0 38 C 30 38 52 22 52 -6 Z" fill="#5A3A22" stroke="#33200F" stroke-width="3"/>
    <g fill="none" stroke="#77502F" stroke-width="2" stroke-linecap="round">
      <path d="M-40 6 C -22 16 22 16 40 6"/><path d="M-30 20 C -16 27 16 27 30 20"/>
    </g>
    <ellipse cx="0" cy="-6" rx="52" ry="16" fill="#4A2F1B" stroke="#33200F" stroke-width="2.6"/>
    <ellipse cx="0" cy="-6" rx="44" ry="12" fill="#F7F2E2" stroke="#CDC3A4" stroke-width="2.4"/>
    <ellipse cx="1" cy="-5" rx="32" ry="8" fill="#EFE7D0" stroke="#CDC3A4" stroke-width="2"/>
    <!-- ánh nước đọng trong lòng gáo, lệch trái -->
    <path d="M-22 -8 C -14 -13 0 -14 10 -11" fill="none" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round" opacity=".85"/>
  </g>

  <!-- TÔ SÂU LÒNG: đáy nhỏ, thành cao dốc, miệng loe -->
  <g>
    <ellipse cx="264" cy="392" rx="52" ry="11" fill="#E9E0C6" stroke="#B0A585" stroke-width="2.4"/>
    <path d="M138 268 C 152 348 196 392 264 392 C 332 392 376 348 390 268 Z"
          fill="url(#bxBowl)" stroke="#B7AE8E" stroke-width="3"/>
    <path d="M138 268 C 152 348 196 392 264 392 C 332 392 376 348 390 268"
          fill="none" stroke="#2C5234" stroke-width="4.5"/>
    <ellipse cx="264" cy="268" rx="126" ry="32" fill="#F5EFDC" stroke="#B7AE8E" stroke-width="3"/>
    <ellipse cx="264" cy="269" rx="112" ry="26" fill="none" stroke="#E0A32E" stroke-width="2.4" stroke-dasharray="2 11" stroke-linecap="round"/>
  </g>

  <!-- NƯỚC CHÈ vàng nhạt đục, một màu -->
  <ellipse cx="264" cy="270" rx="118" ry="28" fill="url(#bxBroth)"/>
  <!-- váng cốt dừa loang, lệch một bên -->
  <g fill="#FBF5E2" opacity=".8">
    <ellipse cx="204" cy="264" rx="22" ry="6.5"/>
    <ellipse cx="308" cy="278" rx="16" ry="5"/>
    <ellipse cx="256" cy="286" rx="12" ry="4"/>
  </g>

  <!-- HẠT ĐẬU XANH nguyên hạt, lấm tấm và nhỏ -->
  <g fill="#E6C063" stroke="#AC8418" stroke-width="1.3">
    <ellipse cx="196" cy="276" rx="6" ry="4.4" transform="rotate(-18 196 276)"/>
    <ellipse cx="228" cy="262" rx="5.8" ry="4.2" transform="rotate(12 228 262)"/>
    <ellipse cx="252" cy="280" rx="6.2" ry="4.6" transform="rotate(-6 252 280)"/>
    <ellipse cx="288" cy="262" rx="5.6" ry="4" transform="rotate(20 288 262)"/>
    <ellipse cx="318" cy="272" rx="6" ry="4.4" transform="rotate(-14 318 272)"/>
    <ellipse cx="212" cy="288" rx="5.4" ry="4" transform="rotate(8 212 288)"/>
    <ellipse cx="272" cy="292" rx="5.8" ry="4.2" transform="rotate(-22 272 292)"/>
    <ellipse cx="340" cy="284" rx="5.2" ry="3.8" transform="rotate(16 340 284)"/>
    <ellipse cx="176" cy="266" rx="5" ry="3.6" transform="rotate(-10 176 266)"/>
    <ellipse cx="300" cy="288" rx="5.4" ry="4" transform="rotate(4 300 288)"/>
    <ellipse cx="238" cy="250" rx="5" ry="3.6" transform="rotate(-16 238 250)"/>
    <ellipse cx="356" cy="266" rx="4.8" ry="3.4" transform="rotate(10 356 266)"/>
  </g>

  <!-- HẠT BỘT BÁNG to, tròn, trong — nổi kín mặt tô -->
  <use href="#bxPearl" transform="translate(186 258)"/>
  <use href="#bxPearl" transform="translate(216 276) scale(.94)"/>
  <use href="#bxPearl" transform="translate(248 260) scale(1.04)"/>
  <use href="#bxPearl" transform="translate(276 274) scale(.9)"/>
  <use href="#bxPearl" transform="translate(308 258) scale(1)"/>
  <use href="#bxPearl" transform="translate(334 274) scale(.86)"/>
  <use href="#bxPearl" transform="translate(200 286) scale(.82)"/>
  <use href="#bxPearl" transform="translate(262 292) scale(.88)"/>
  <use href="#bxPearl" transform="translate(322 290) scale(.8)"/>
  <use href="#bxPearl" transform="translate(160 272) scale(.76)"/>
  <use href="#bxPearl" transform="translate(292 246) scale(.84)"/>
  <use href="#bxPearl" transform="translate(232 240) scale(.74)"/>

  <!-- KHÚC LÁ DỨA gấp đôi nổi trên mặt tô. Bản 1 vẽ cái gút tròn nên đọc thành
       trái ớt xanh; đổi sang dải DẸT có gân song song, nằm ngang, thì ra lá. -->
  <g transform="translate(332 250) rotate(-9)">
    <path d="M-40 0 C -16 -8 20 -10 44 -5 C 20 4 -16 8 -40 0 Z" fill="#3E7B2C" stroke="#255018" stroke-width="2.2"/>
    <path d="M-34 -1 C -12 -8 18 -9 38 -5" fill="none" stroke="#8FC262" stroke-width="1.8" stroke-linecap="round"/>
    <path d="M-30 3 C -10 -2 16 -3 34 -1" fill="none" stroke="#8FC262" stroke-width="1.4" stroke-linecap="round" opacity=".8"/>
  </g>
  <!-- dừa nạo sợi trắng vắt trên mặt -->
  <g fill="none" stroke="#FDFBF2" stroke-width="3" stroke-linecap="round" opacity=".92">
    <path d="M204 250 C 216 242 232 241 244 246"/>
    <path d="M256 306 C 268 300 282 300 292 304"/>
  </g>

  <!-- đậu phộng rang rắc mặt -->
  <g fill="#C08147" stroke="#7E4E1E" stroke-width="1.4">
    <path d="M222 302 C 228 296 236 299 236 306 C 235 312 226 314 222 310 Z"/>
    <path d="M290 306 C 296 300 304 303 304 310 C 303 316 294 317 290 313 Z"/>
    <path d="M254 236 C 260 231 267 233 267 240 C 266 246 258 247 254 243 Z"/>
  </g>

  <!-- vài hạt bột báng và đậu xanh rơi trên bàn, phía phải -->
  <use href="#bxPearl" transform="translate(424 404) scale(.72)"/>
  <use href="#bxPearl" transform="translate(448 416) scale(.6)"/>
  <g fill="#E6C063" stroke="#AC8418" stroke-width="1.2">
    <ellipse cx="406" cy="418" rx="5" ry="3.6" transform="rotate(14 406 418)"/>
    <ellipse cx="432" cy="426" rx="4.4" ry="3.2" transform="rotate(-8 432 426)"/>
  </g>
</svg>
