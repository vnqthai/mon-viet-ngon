---
/* Bún riêu cua — tô nước đỏ hồng cà chua: tảng riêu vàng gạch, múi cà chua,
   khối đậu phụ chiên, bún trắng ló; đạo cụ: cà chua + chén mắm tôm nhỏ */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Tô bún riêu cua nổi tảng riêu vàng, cà chua, đậu phụ chiên, kèm chén mắm tôm và cà chua">
  <defs>
    <linearGradient id="brBroth" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#E0573F"/><stop offset="1" stop-color="#BE3A28"/>
    </linearGradient>
    <linearGradient id="brBowl" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#FDFAF0"/><stop offset="1" stop-color="#E9E2CC"/>
    </linearGradient>
  </defs>
  <circle cx="260" cy="240" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="240" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <g class="steam">
    <path d="M205 236 C 194 210 220 194 209 166 C 202 148 216 136 212 120"/>
    <path d="M262 230 C 252 204 278 190 267 162 C 260 144 274 132 270 114"/>
    <path d="M318 238 C 308 214 332 198 322 172 C 316 156 328 144 324 130"/>
  </g>
  <ellipse cx="255" cy="420" rx="196" ry="24" fill="rgba(15,26,14,.35)"/>

  <!-- tô -->
  <path d="M67 296 C 73 370 157 414 255 414 C 353 414 437 370 443 296 Z" fill="url(#brBowl)"/>
  <ellipse cx="255" cy="412" rx="62" ry="11" fill="#D8D0B6"/>
  <ellipse cx="255" cy="294" rx="188" ry="46" fill="#F6F1E1"/>
  <ellipse cx="255" cy="294" rx="188" ry="46" fill="none" stroke="#2C5234" stroke-width="5"/>
  <ellipse cx="255" cy="295" rx="174" ry="40" fill="none" stroke="#E0A32E" stroke-width="2.5" stroke-dasharray="2 11" stroke-linecap="round"/>

  <!-- nước riêu đỏ hồng cà chua -->
  <ellipse cx="255" cy="297" rx="158" ry="33" fill="url(#brBroth)"/>
  <ellipse cx="200" cy="288" rx="52" ry="9" fill="#F2825E" opacity=".5"/>
  <g fill="#F2916A" opacity=".85">
    <circle cx="150" cy="300" r="3.6"/><circle cx="352" cy="306" r="3.4"/><circle cx="262" cy="322" r="2.8"/>
  </g>

  <!-- TẢNG RIÊU CUA vàng gạch (lệch trái) -->
  <g transform="translate(186 290)">
    <path d="M-48 6
             C -52 -8 -40 -18 -26 -16
             C -21 -27 -3 -30 6 -22
             C 17 -29 34 -25 37 -13
             C 48 -11 52 1 44 8
             C 38 17 24 20 11 16
             C 2 23 -16 23 -25 15
             C -38 18 -45 13 -48 6 Z"
          fill="#CE9A55" stroke="#A8702E" stroke-width="2.5"/>
    <g fill="none" stroke="#B37E3E" stroke-width="1.7" opacity=".95">
      <circle cx="-30" cy="0" r="4"/>
      <circle cx="-10" cy="-10" r="4.6"/>
      <circle cx="8" cy="6" r="3.8"/>
      <circle cx="24" cy="-6" r="3.4"/>
    </g>
    <path d="M-34 -8 C -26 -16 -10 -18 0 -13 C 8 -9 6 -2 -4 0 C -16 2 -32 -1 -34 -8 Z" fill="#E0862F" stroke="#C4681F" stroke-width="1.6"/>
    <path d="M12 -12 C 20 -17 32 -14 35 -7 C 36 -2 30 2 22 0 C 14 -2 9 -8 12 -12 Z" fill="#DD7E2A" stroke="#C4681F" stroke-width="1.5"/>
    <g fill="#B3762A"><circle cx="-22" cy="10" r="2"/><circle cx="28" cy="8" r="2"/></g>
    <g fill="#F2CD8C"><circle cx="-38" cy="2" r="1.8"/><circle cx="2" cy="14" r="1.8"/></g>
  </g>

  <!-- múi cà chua -->
  <g transform="rotate(-14 262 300)">
    <path d="M240 304 A 26 26 0 0 1 284 296 L 276 302 A 16 16 0 0 0 250 306 Z" fill="#E23B2E" stroke="#B22B20" stroke-width="2.2"/>
    <path d="M252 303 A 13 13 0 0 1 272 300" fill="none" stroke="#F26A50" stroke-width="3.4" stroke-linecap="round"/>
  </g>
  <g transform="rotate(10 300 316)">
    <path d="M282 318 A 22 22 0 0 1 318 312 L 312 317 A 14 14 0 0 0 290 320 Z" fill="#E0402F" stroke="#B22B20" stroke-width="2"/>
    <path d="M292 317 A 11 11 0 0 1 308 315" fill="none" stroke="#F26A50" stroke-width="3" stroke-linecap="round"/>
  </g>

  <!-- đậu phụ chiên vàng: khối vuông, mặt cắt kem -->
  <g transform="rotate(-8 330 288)">
    <rect x="312" y="272" width="38" height="32" rx="6" fill="#E8B554" stroke="#C08A2E" stroke-width="2.4"/>
    <path d="M315 279 C 324 274 340 274 347 279 L 347 275 C 340 271 323 271 315 275 Z" fill="#F6E3B4"/>
    <path d="M318 296 q8 4 17 2" fill="none" stroke="#C98F3C" stroke-width="2" stroke-linecap="round"/>
  </g>
  <g transform="rotate(9 366 310)">
    <rect x="352" y="298" width="30" height="26" rx="5" fill="#E2AE4C" stroke="#C08A2E" stroke-width="2.2"/>
    <path d="M355 304 C 362 300 373 300 378 304 L 378 301 C 372 297 361 297 355 301 Z" fill="#F6E3B4"/>
  </g>

  <!-- bún trắng ló giữa dưới -->
  <g fill="none" stroke="#FBF5E3" stroke-width="6" stroke-linecap="round">
    <path d="M242 313 C 254 308 266 309 276 315"/>
    <path d="M246 321 C 257 317 267 317 275 321"/>
  </g>
  <path d="M248 316 C 258 312 268 313 274 318" fill="none" stroke="#E8DDBE" stroke-width="1.8" stroke-linecap="round" opacity=".7"/>

  <!-- hành lá + hành phi -->
  <g stroke="#6F9C48" stroke-width="3.4" stroke-linecap="round" fill="none">
    <path d="M232 320 l11 -2 M304 286 l10 -2 M356 296 l9 -2"/>
  </g>
  <g fill="#D9A050"><circle cx="246" cy="290" r="2.4"/><circle cx="286" cy="326" r="2.2"/><circle cx="326" cy="318" r="2.2"/></g>

  <!-- cà chua trên bàn trái -->
  <g transform="translate(84 388)">
    <circle cx="0" cy="0" r="24" fill="#E23B2E" stroke="#B22B20" stroke-width="2.5"/>
    <path d="M-9 -14 A 17 17 0 0 1 4 -19" fill="none" stroke="#F26A50" stroke-width="4" stroke-linecap="round"/>
    <path d="M0 -22 l-6 -4 M0 -22 l-1 -7 M0 -22 l6 -3 M0 -22 l-8 1 M0 -22 l8 2" stroke="#4E7B36" stroke-width="2.6" stroke-linecap="round"/>
  </g>
  <g transform="translate(126 408)">
    <circle cx="0" cy="0" r="16" fill="#E85341" stroke="#B22B20" stroke-width="2.2"/>
    <path d="M-6 -9 A 11 11 0 0 1 2 -13" fill="none" stroke="#F28C6E" stroke-width="3" stroke-linecap="round"/>
    <path d="M0 -14 l-5 -3 M0 -14 l0 -5 M0 -14 l5 -2" stroke="#4E7B36" stroke-width="2.2" stroke-linecap="round"/>
  </g>

  <!-- chén mắm tôm nhỏ + chanh ớt -->
  <g>
    <ellipse cx="424" cy="392" rx="36" ry="11" fill="rgba(15,26,14,.3)"/>
    <path d="M394 376 C 396 393 408 402 424 402 C 440 402 452 393 454 376 Z" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2"/>
    <ellipse cx="424" cy="376" rx="30" ry="9" fill="#8E7F94"/>
    <ellipse cx="418" cy="374" rx="11" ry="3.6" fill="#A393AA" opacity=".9"/>
    <path d="M436 372 C 442 370 447 372 449 375" fill="none" stroke="#C0392B" stroke-width="4.4" stroke-linecap="round"/>
  </g>
  <g transform="translate(366 416)">
    <path d="M-14 4 A15 15 0 0 1 14 4 Z" fill="#E4ECB2" stroke="#9CB25C" stroke-width="2.2"/>
    <path d="M0 4 0 -9 M0 4 -10 -3 M0 4 10 -3" stroke="#9CB25C" stroke-width="1.4"/>
  </g>
</svg>
