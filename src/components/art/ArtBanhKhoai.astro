---
/* Bánh khoái Huế — cùng kiểu món "Chiên" và cùng nền đỏ họ "Lửa" với BÁNH XÈO,
   nên cả hình được dựng quanh đúng ba chỗ khác nhau giữa hai món:

   1. BÁNH XÈO là MỘT cái mỏng tang, rộng gần hết dĩa, gập bán nguyệt.
      Bánh khoái là HAI cái NHỎ và DÀY — vẽ hẳn cạnh dày ra để thấy bề dày,
      một cái gập phồng lộ nhân, một cái để ngửa khoe mặt trứng.
   2. Chấm NƯỚC LÈO chứ không phải nước mắm chua ngọt: chén sốt ĐỤC và SÁNH,
      vun thành gò chứ không phẳng mặt như chén nước mắm, rắc mè và đậu phộng.
   3. Đổ trong KHUÔN GANG nhỏ có cán — để nguyên cái khuôn đen làm đạo cụ.

   Đợt 10 món này dời sang kiểu "Bánh" (nền vàng), nên contact-sheet đã gắn
   SLUG_RECAT để soi trước trên nền vàng — hình vẽ đủ tương phản cho cả hai nền.
   id prefix: bk */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Bánh khoái Huế: hai cái bánh nhỏ dày vàng giòn, một cái gập lộ nhân tôm giá, kèm chén nước lèo sánh đặc rắc mè đậu phộng, khuôn gang và rau sống">
  <defs>
    <linearGradient id="bkVo" x1="0" y1="0" x2="0.2" y2="1">
      <stop offset="0" stop-color="#F4C75E"/><stop offset="1" stop-color="#CE8B21"/>
    </linearGradient>
    <linearGradient id="bkCanh" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#C07E1C"/><stop offset="1" stop-color="#8E570C"/>
    </linearGradient>
    <linearGradient id="bkLeo" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#B98F5E"/><stop offset="1" stop-color="#87643A"/>
    </linearGradient>
    <linearGradient id="bkGang" x1="0" y1="0" x2="0.3" y2="1">
      <stop offset="0" stop-color="#5A5750"/><stop offset="1" stop-color="#2E2C28"/>
    </linearGradient>
  </defs>

  <circle cx="258" cy="242" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="258" cy="242" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <g class="steam">
    <path d="M214 214 C 203 190 229 174 218 148 C 211 132 225 120 221 106"/>
    <path d="M286 210 C 276 186 302 172 291 146 C 284 130 298 118 294 104"/>
  </g>
  <ellipse cx="258" cy="404" rx="200" ry="26" fill="rgba(15,26,14,.35)"/>

  <!-- DĨA -->
  <ellipse cx="248" cy="322" rx="192" ry="58" fill="#EFE9D6"/>
  <ellipse cx="248" cy="316" rx="192" ry="58" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2"/>
  <ellipse cx="248" cy="316" rx="192" ry="58" fill="none" stroke="#2C5234" stroke-width="4"/>
  <ellipse cx="248" cy="318" rx="160" ry="45" fill="none" stroke="#E0A32E" stroke-width="2.4" stroke-dasharray="2 11" stroke-linecap="round"/>

  <!-- lá xà lách lót -->
  <path d="M100 316 C 106 292 144 278 188 282 C 162 300 148 320 148 338 C 128 336 108 328 100 316 Z"
        fill="#6F9C48" stroke="#4E7B36" stroke-width="2.4"/>
  <path d="M114 314 q24 -18 58 -24" fill="none" stroke="#A8C46E" stroke-width="3.4" stroke-linecap="round"/>

  <!-- ===== BÁNH 1 (lớp sau): để NGỬA, tròn nhỏ, khoe mặt trứng và nhân ===== -->
  <g transform="translate(196 268) rotate(-6)">
    <!-- cạnh dày: đây là chỗ tách khỏi bánh xèo mỏng -->
    <path d="M-74 0 C -74 22 -34 36 0 36 C 34 36 74 22 74 0 L 74 15 C 74 37 34 51 0 51 C -34 51 -74 37 -74 15 Z"
          fill="url(#bkCanh)" stroke="#7A4A08" stroke-width="2.4" stroke-linejoin="round"/>
    <ellipse cx="0" cy="0" rx="74" ry="36" fill="url(#bkVo)" stroke="#A9700F" stroke-width="2.8"/>
    <!-- rìa giòn răng cưa quanh vành -->
    <g fill="url(#bkVo)" stroke="#A9700F" stroke-width="1.6">
      <circle cx="-70" cy="8" r="5"/><circle cx="-56" cy="22" r="5.2"/><circle cx="-34" cy="31" r="5.2"/>
      <circle cx="-8" cy="35" r="5.2"/><circle cx="18" cy="34" r="5.2"/><circle cx="44" cy="27" r="5"/>
      <circle cx="63" cy="16" r="4.8"/><circle cx="72" cy="3" r="4.4"/>
    </g>
    <!-- mặt trứng vàng đậm — bánh khoái có TRỨNG đánh trong bột -->
    <ellipse cx="-4" cy="-4" rx="50" ry="22" fill="#EFB43C" opacity=".85"/>
    <g fill="#D99A22" opacity=".8">
      <ellipse cx="-26" cy="-6" rx="8" ry="4"/><ellipse cx="6" cy="2" rx="7" ry="3.6"/><ellipse cx="28" cy="-8" rx="6" ry="3.2"/>
    </g>
    <g fill="#FBE1A2">
      <ellipse cx="-14" cy="-12" rx="6" ry="3"/><ellipse cx="18" cy="-6" rx="5" ry="2.6"/><ellipse cx="-38" cy="2" rx="4.6" ry="2.4"/>
    </g>
    <!-- nhân trên mặt: tôm cong + giá + lát thịt -->
    <g transform="translate(-24 -2) rotate(-14)">
      <path d="M-12 8 C -22 -2 -12 -16 4 -15 C 15 -14 20 -6 17 2" fill="none" stroke="#EE7E6D" stroke-width="10" stroke-linecap="round"/>
      <path d="M-10 -5 q5 -5 11 -6 M2 -12 q5 -3 9 -2" fill="none" stroke="#C9513E" stroke-width="1.9" stroke-linecap="round"/>
    </g>
    <g transform="translate(26 4) rotate(12)">
      <path d="M-11 7 C -20 -2 -11 -14 3 -13 C 13 -12 18 -5 15 1" fill="none" stroke="#F0907E" stroke-width="9" stroke-linecap="round"/>
      <path d="M-9 -4 q4 -4 10 -5" fill="none" stroke="#C9513E" stroke-width="1.8" stroke-linecap="round"/>
    </g>
    <g fill="none" stroke="#F8F2E0" stroke-width="4.2" stroke-linecap="round">
      <path d="M-46 8 q14 4 26 0"/><path d="M0 14 q14 4 26 -1"/><path d="M38 6 q12 4 22 0"/>
    </g>
    <g stroke="#6F9C48" stroke-width="3" stroke-linecap="round" fill="none">
      <path d="M-34 16 l10 -2 M14 -14 l9 -2 M46 14 l8 -2"/>
    </g>
  </g>

  <!-- ===== BÁNH 2 (lớp trước): GẬP PHỒNG như cái vỏ sò, nhân ló ở khe ===== -->
  <g transform="translate(322 300) rotate(4)">
    <ellipse cx="0" cy="46" rx="76" ry="14" fill="rgba(15,26,14,.28)"/>
    <!-- nửa dưới -->
    <path d="M-76 6 C -70 30 -38 44 0 44 C 38 44 70 30 76 6 C 50 20 -50 20 -76 6 Z"
          fill="url(#bkCanh)" stroke="#7A4A08" stroke-width="2.6" stroke-linejoin="round"/>
    <!-- nhân ló ra khỏi khe gập -->
    <g>
      <g fill="none" stroke="#F8F2E0" stroke-width="4.6" stroke-linecap="round">
        <path d="M-44 12 q16 6 32 2"/><path d="M-8 16 q16 6 32 1"/><path d="M26 12 q14 5 28 1"/>
      </g>
      <g transform="translate(-26 12) rotate(-8)">
        <path d="M-11 6 C -20 -3 -11 -15 3 -14 C 13 -13 18 -6 15 0" fill="none" stroke="#EE7E6D" stroke-width="9.5" stroke-linecap="round"/>
      </g>
      <g transform="translate(30 14) rotate(10)">
        <path d="M-10 5 C -18 -3 -10 -13 2 -12 C 11 -11 15 -5 13 0" fill="none" stroke="#F0907E" stroke-width="8.5" stroke-linecap="round"/>
      </g>
      <g stroke="#6F9C48" stroke-width="3.2" stroke-linecap="round" fill="none">
        <path d="M-52 14 l10 -2 M4 18 l10 -2 M46 14 l9 -2"/>
      </g>
    </g>
    <!-- nửa trên gập úp xuống, PHỒNG chứ không phẳng -->
    <path d="M-76 6 C -72 -26 -40 -44 0 -44 C 40 -44 72 -26 76 6 C 50 16 -50 16 -76 6 Z"
          fill="url(#bkVo)" stroke="#A9700F" stroke-width="2.8"/>
    <path d="M-76 6 C -50 14 50 14 76 6" fill="none" stroke="#8E570C" stroke-width="3" stroke-linecap="round" opacity=".8"/>
    <!-- rìa giòn răng cưa ôm vành gập -->
    <g fill="url(#bkVo)" stroke="#A9700F" stroke-width="1.6">
      <circle cx="-72" cy="-6" r="5"/><circle cx="-62" cy="-20" r="5.2"/><circle cx="-44" cy="-32" r="5.2"/>
      <circle cx="-22" cy="-40" r="5.2"/><circle cx="2" cy="-43" r="5.2"/><circle cx="26" cy="-40" r="5.2"/>
      <circle cx="48" cy="-31" r="5"/><circle cx="65" cy="-19" r="5"/><circle cx="73" cy="-5" r="4.8"/>
    </g>
    <!-- chấm rộp giòn -->
    <g fill="#D99A22" opacity=".85">
      <circle cx="-40" cy="-14" r="4.4"/><circle cx="-4" cy="-24" r="4"/><circle cx="32" cy="-16" r="4.2"/>
      <circle cx="-18" cy="-6" r="3.4"/><circle cx="14" cy="-6" r="3.6"/><circle cx="52" cy="-6" r="3.4"/>
    </g>
    <g fill="#FBE1A2">
      <circle cx="-26" cy="-22" r="2.8"/><circle cx="10" cy="-30" r="2.6"/><circle cx="44" cy="-22" r="2.6"/>
      <circle cx="-52" cy="-8" r="2.4"/><circle cx="0" cy="-12" r="2.4"/>
    </g>
  </g>

  <!-- ===== CHÉN NƯỚC LÈO: đục và SÁNH, vun gò chứ không phẳng mặt ===== -->
  <g transform="translate(96 372)">
    <ellipse cx="0" cy="30" rx="54" ry="14" fill="rgba(15,26,14,.32)"/>
    <path d="M-48 0 C -46 22 -28 36 0 36 C 28 36 46 22 48 0 Z" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2.2"/>
    <ellipse cx="0" cy="0" rx="48" ry="15" fill="#F6F1E1" stroke="#D8D0B6" stroke-width="2"/>
    <!-- gò sốt vun lên khỏi miệng chén — dấu hiệu "sánh đặc", chén nước mắm thì phẳng lì -->
    <path d="M-40 2 C -38 -14 -20 -22 0 -22 C 20 -22 38 -14 40 2 C 24 10 -24 10 -40 2 Z"
          fill="url(#bkLeo)" stroke="#6B4C28" stroke-width="1.8"/>
    <path d="M-30 -4 C -24 -14 -8 -18 6 -17" fill="none" stroke="#CFA878" stroke-width="3" stroke-linecap="round" opacity=".85"/>
    <!-- đậu phộng giã + mè rắc mặt -->
    <g fill="#D9A050" stroke="#A9711F" stroke-width="1.3">
      <ellipse cx="-20" cy="-6" rx="5" ry="3.6" transform="rotate(-16 -20 -6)"/>
      <ellipse cx="-2" cy="-11" rx="4.6" ry="3.4" transform="rotate(10 -2 -11)"/>
      <ellipse cx="16" cy="-5" rx="4.8" ry="3.4" transform="rotate(-8 16 -5)"/>
      <ellipse cx="28" cy="1" rx="4" ry="2.8" transform="rotate(20 28 1)"/>
      <ellipse cx="-31" cy="1" rx="4" ry="2.8" transform="rotate(6 -31 1)"/>
      <ellipse cx="7" cy="0" rx="4.4" ry="3" transform="rotate(-14 7 0)"/>
    </g>
    <g fill="#F6EBCB">
      <circle cx="-12" cy="-14" r="2"/><circle cx="8" cy="-15" r="1.9"/><circle cx="22" cy="-10" r="1.8"/>
      <circle cx="-26" cy="-9" r="1.8"/><circle cx="-4" cy="-4" r="1.7"/><circle cx="18" cy="2" r="1.7"/>
      <circle cx="-16" cy="1" r="1.6"/>
    </g>
  </g>

  <!-- ===== ĐẠO CỤ: KHUÔN GANG nhỏ có cán — món này đổ khuôn gang chứ không chảo lớn ===== -->
  <g transform="translate(414 386) rotate(-8)">
    <ellipse cx="-6" cy="26" rx="56" ry="13" fill="rgba(15,26,14,.32)"/>
    <rect x="34" y="-10" width="76" height="13" rx="6.5" fill="url(#bkGang)" stroke="#211F1C" stroke-width="2"/>
    <rect x="86" y="-9" width="20" height="11" rx="5" fill="#6E6A62"/>
    <path d="M-52 -8 C -50 14 -30 26 -4 26 C 22 26 42 14 44 -8 Z" fill="url(#bkGang)" stroke="#211F1C" stroke-width="2.4"/>
    <ellipse cx="-4" cy="-8" rx="48" ry="15" fill="#43403A" stroke="#211F1C" stroke-width="2.4"/>
    <ellipse cx="-4" cy="-7" rx="38" ry="11" fill="#2E2C28"/>
    <path d="M-32 -12 C -22 -18 6 -19 22 -14" fill="none" stroke="#7E7A70" stroke-width="2.4" stroke-linecap="round" opacity=".8"/>
  </g>

  <!-- ĐẠO CỤ: lát vả / chuối chát chát nhẹ, cân với nước lèo béo bùi -->
  <g transform="translate(196 396)">
    <circle r="18" fill="#CFDFAB" stroke="#8FA84E" stroke-width="2.2"/>
    <circle r="11.5" fill="#F3F0DC"/>
    <g fill="#C4A177"><circle cx="-3.6" cy="-3" r="1.9"/><circle cx="4" cy="0" r="1.9"/><circle cx="-1" cy="4.6" r="1.9"/></g>
  </g>
  <g transform="translate(238 414) scale(.84)">
    <circle r="18" fill="#CFDFAB" stroke="#8FA84E" stroke-width="2.2"/>
    <circle r="11.5" fill="#F3F0DC"/>
    <g fill="#C4A177"><circle cx="-3" cy="2.4" r="1.8"/><circle cx="3.6" cy="-2.6" r="1.8"/></g>
  </g>
  <g transform="translate(288 420) rotate(-12)">
    <path d="M0 0 C 4 -12 16 -18 28 -16 C 32 -5 23 6 10 8 C 4 9 -1 5 0 0 Z" fill="#5C9440" stroke="#356123" stroke-width="1.7"/>
    <path d="M2 3 L 26 -14" stroke="#93C169" stroke-width="1.5" stroke-linecap="round"/>
  </g>
</svg>
