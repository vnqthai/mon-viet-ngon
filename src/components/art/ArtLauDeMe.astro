---
/* Lẩu dê nhúng mẻ Ninh Bình — CHỮ KÝ nhận dạng, phải lệch hẳn SÁU nồi kia:
   1) QUAI XÁCH VÒNG CUNG bắc ngang trên đỉnh nồi — dáng riêng, sáu nồi kia đều
      chỉ có quai hai bên hoặc ống khói
   2) DĨA THỊT DÊ SỐNG THÁI LÁT xếp vòng đặt phía trước — món "nhúng" thì thịt
      phải nằm ngoài nồi, đó mới là cách ăn; không nồi nào khác có dĩa thịt sống
   3) HŨ MẺ trắng đục có nắp vải buộc dây, đạo cụ chỉ món này có
   4) nước lèo NÂU ĐỎ ĐỤC (mẻ làm đục), không đỏ trong như lẩu Thái; cà chua chỉ
      vẽ hai múi thôi cho khỏi đụng lẩu Thái vốn lấy cà chua làm tín hiệu chính
   5) rau: RAU CẦN cọng dài trắng ngà bó lại, khác lá cải to bản của lẩu dê chao
   id prefix "lm2" */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Lẩu dê nhúng mẻ Ninh Bình: nồi có quai xách vòng cung, nước lèo nâu đỏ đục với cà chua và riềng, phía trước là dĩa thịt dê thái lát xếp vòng, bên cạnh là bó rau cần và hũ mẻ">
  <defs>
    <linearGradient id="lm2Broth" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#C4653A"/><stop offset="1" stop-color="#833518"/>
    </linearGradient>
    <linearGradient id="lm2Pot" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#C9B48A"/><stop offset="1" stop-color="#8A7448"/>
    </linearGradient>
    <linearGradient id="lm2Plate" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#FDFAF0"/><stop offset="1" stop-color="#D9D1B6"/>
    </linearGradient>
    <!-- lát thịt dê sống: mỏng, viền mỡ trắng chạy một cạnh, vân thớ bên trong -->
    <g id="lm2Slice">
      <path d="M-30 -10 C -14 -18 16 -18 30 -8 C 34 0 26 10 8 13 C -12 16 -32 8 -32 0 Z"
            fill="#B44B39" stroke="#6E2314" stroke-width="2.2"/>
      <path d="M-28 -9 C -12 -16 14 -16 28 -7" fill="none" stroke="#F1E4D4" stroke-width="4.4" stroke-linecap="round"/>
      <g fill="none" stroke="#D98871" stroke-width="1.8" stroke-linecap="round">
        <path d="M-18 -1 C -8 -5 8 -5 18 -1"/>
        <path d="M-14 6 C -4 3 8 3 16 6"/>
      </g>
    </g>
  </defs>

  <circle cx="260" cy="222" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="222" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <g class="steam">
    <path d="M212 176 C 201 152 227 136 216 110 C 209 94 223 82 219 66"/>
    <path d="M286 168 C 276 144 302 130 291 104 C 284 88 298 76 294 60"/>
    <path d="M352 182 C 342 158 368 144 357 118 C 350 102 364 90 360 74"/>
  </g>
  <ellipse cx="264" cy="424" rx="192" ry="22" fill="rgba(15,26,14,.35)"/>

  <!-- BÓ RAU CẦN (đạo cụ trái) — cọng dài trắng ngà, lá xẻ nhỏ ở ngọn -->
  <g transform="translate(70 316)">
    <ellipse cx="6" cy="86" rx="46" ry="11" fill="rgba(15,26,14,.3)"/>
    <g fill="none" stroke="#EFF2DC" stroke-width="7" stroke-linecap="round">
      <path d="M-14 82 C -20 46 -14 12 2 -18"/>
      <path d="M4 84 C 2 48 10 14 26 -12"/>
      <path d="M22 84 C 24 52 34 20 48 -4"/>
    </g>
    <g fill="none" stroke="#B9C98E" stroke-width="2" stroke-linecap="round">
      <path d="M-13 78 C -18 46 -12 14 3 -14"/>
      <path d="M23 80 C 25 52 34 22 46 0"/>
    </g>
    <!-- ngọn lá xẻ -->
    <g fill="#4E8A38" stroke="#2C5820" stroke-width="1.8">
      <path d="M2 -18 C -6 -32 2 -44 12 -38 C 18 -34 14 -22 2 -18 Z"/>
      <path d="M26 -12 C 20 -28 30 -38 39 -31 C 44 -26 38 -16 26 -12 Z"/>
      <path d="M48 -4 C 44 -18 54 -26 61 -19 C 65 -14 58 -6 48 -4 Z"/>
    </g>
    <!-- dây buộc bó -->
    <path d="M-18 56 C 0 50 26 50 42 56" fill="none" stroke="#B08A44" stroke-width="5" stroke-linecap="round"/>
  </g>

  <!-- NỒI có QUAI XÁCH VÒNG CUNG — vẽ quai TRƯỚC thân để nó bắc qua miệng nồi -->
  <path d="M156 268 C 176 176 356 176 376 268" fill="none" stroke="#6E5A34" stroke-width="11" stroke-linecap="round"/>
  <path d="M156 268 C 176 182 356 182 376 268" fill="none" stroke="#C9B48A" stroke-width="5" stroke-linecap="round"/>

  <!-- thân nồi: thấp, thành xuôi -->
  <path d="M144 286 C 150 344 208 376 268 376 C 328 376 386 344 392 286 Z" fill="url(#lm2Pot)"/>
  <path d="M144 286 C 150 344 208 376 268 376 C 328 376 386 344 392 286"
        fill="none" stroke="#5E4C2A" stroke-width="4"/>
  <!-- tai giữ quai hai bên -->
  <circle cx="152" cy="278" r="9" fill="#8A7448" stroke="#5E4C2A" stroke-width="2.6"/>
  <circle cx="384" cy="278" r="9" fill="#8A7448" stroke="#5E4C2A" stroke-width="2.6"/>
  <!-- vành miệng -->
  <ellipse cx="268" cy="284" rx="126" ry="32" fill="#D9C79C"/>
  <ellipse cx="268" cy="284" rx="126" ry="32" fill="none" stroke="#2C5234" stroke-width="5"/>
  <ellipse cx="268" cy="285" rx="114" ry="27" fill="none" stroke="#E0A32E" stroke-width="2.4" stroke-dasharray="2 11" stroke-linecap="round"/>

  <!-- NƯỚC LÈO NÂU ĐỎ ĐỤC vị mẻ -->
  <ellipse cx="268" cy="287" rx="107" ry="25" fill="url(#lm2Broth)"/>
  <!-- lợn cợn của mẻ nổi trên mặt, thứ nồi lẩu nào khác cũng không có -->
  <g fill="#EBD6B4" opacity=".7">
    <circle cx="212" cy="282" r="3"/><circle cx="240" cy="292" r="2.4"/>
    <circle cx="298" cy="280" r="2.8"/><circle cx="322" cy="292" r="2.2"/>
    <circle cx="264" cy="298" r="2.6"/><circle cx="188" cy="290" r="2.2"/>
    <circle cx="340" cy="282" r="2"/>
  </g>

  <!-- hai múi CÀ CHUA (chỉ hai, cho khỏi đụng lẩu Thái) -->
  <g stroke="#8E2416" stroke-width="2.2" stroke-linejoin="round">
    <path d="M186 284 C 200 276 216 278 222 288 C 214 296 194 296 186 290 Z" fill="#D2402A"/>
    <path d="M310 292 C 322 284 338 286 342 296 C 334 302 316 302 310 298 Z" fill="#D2402A"/>
  </g>
  <!-- LÁT RIỀNG: lát tròn mỏng vân tia, màu ngà vàng -->
  <g fill="#F0E2BC" stroke="#B79A5A" stroke-width="2">
    <ellipse cx="248" cy="278" rx="13" ry="8" transform="rotate(-14 248 278)"/>
    <ellipse cx="292" cy="270" rx="11" ry="7" transform="rotate(10 292 270)"/>
  </g>
  <g fill="none" stroke="#C9AE72" stroke-width="1.4">
    <path d="M240 276 L 256 280 M 244 272 L 252 284"/>
    <path d="M285 268 L 299 272 M 289 265 L 295 276"/>
  </g>
  <!-- ngọn rau cần thả trong nồi -->
  <g fill="none" stroke="#EFF2DC" stroke-width="5" stroke-linecap="round">
    <path d="M206 296 C 226 288 254 288 272 294"/>
  </g>
  <g fill="#4E8A38" stroke="#2C5820" stroke-width="1.6">
    <path d="M272 294 C 268 284 278 278 285 284 C 289 289 282 295 272 294 Z"/>
  </g>
  <!-- khúc sả nổi mép -->
  <g stroke="#3F6B2C" stroke-width="2" stroke-linecap="round">
    <path d="M320 278 L 360 268" stroke="#7EA24C" stroke-width="6.5"/>
    <path d="M320 278 L 360 268"/>
  </g>

  <!-- DĨA THỊT DÊ SỐNG xếp vòng, đặt PHÍA TRƯỚC nồi và chồng lên đáy nồi -->
  <g transform="translate(266 394)">
    <ellipse cx="0" cy="18" rx="140" ry="24" fill="rgba(15,26,14,.32)"/>
    <ellipse cx="0" cy="4" rx="140" ry="34" fill="url(#lm2Plate)" stroke="#B7AE8E" stroke-width="3"/>
    <ellipse cx="0" cy="2" rx="140" ry="34" fill="none" stroke="#2C5234" stroke-width="4"/>
    <ellipse cx="0" cy="3" rx="118" ry="26" fill="none" stroke="#E0A32E" stroke-width="2.2" stroke-dasharray="2 11" stroke-linecap="round"/>
    <!-- đống thịt một khối liền làm nền, rồi mới đắp từng lát chồng mép -->
    <path d="M-112 0 C -96 -18 -50 -26 0 -26 C 50 -26 96 -18 112 0 C 92 16 50 22 0 22 C -50 22 -92 16 -112 0 Z"
          fill="#8A3524"/>
    <use href="#lm2Slice" transform="translate(-84 -2) rotate(-9) scale(.9)"/>
    <use href="#lm2Slice" transform="translate(-42 -8) rotate(6) scale(.96)"/>
    <use href="#lm2Slice" transform="translate(2 -10) rotate(-4)"/>
    <use href="#lm2Slice" transform="translate(46 -6) rotate(9) scale(.96)"/>
    <use href="#lm2Slice" transform="translate(88 0) rotate(-7) scale(.88)"/>
    <use href="#lm2Slice" transform="translate(-62 12) rotate(4) scale(.8)"/>
    <use href="#lm2Slice" transform="translate(-16 14) rotate(-8) scale(.82)"/>
    <use href="#lm2Slice" transform="translate(30 14) rotate(7) scale(.8)"/>
    <use href="#lm2Slice" transform="translate(70 12) rotate(-5) scale(.74)"/>
  </g>

  <!-- HŨ MẺ (đạo cụ phải) — hũ sành thấp, miệng bịt vải buộc dây -->
  <g transform="translate(452 336)">
    <ellipse cx="0" cy="46" rx="38" ry="10" fill="rgba(15,26,14,.3)"/>
    <path d="M-32 -8 C -36 18 -24 44 0 44 C 24 44 36 18 32 -8 Z" fill="#9A8258" stroke="#5E4C2A" stroke-width="2.8"/>
    <g fill="none" stroke="#7E683E" stroke-width="2" stroke-linecap="round">
      <path d="M-28 10 C -14 18 14 18 28 10"/><path d="M-24 26 C -12 33 12 33 24 26"/>
    </g>
    <!-- vải bịt miệng hũ, mép gợn sóng -->
    <path d="M-36 -8 C -30 -22 -16 -28 0 -28 C 16 -28 30 -22 36 -8 C 24 -2 -24 -2 -36 -8 Z"
          fill="#F3EDDA" stroke="#CFC6A6" stroke-width="2.4"/>
    <path d="M-36 -8 C -26 -13 -14 -3 0 -8 C 14 -13 26 -3 36 -8" fill="none" stroke="#CFC6A6" stroke-width="2"/>
    <!-- dây buộc -->
    <path d="M-34 -6 C -18 2 18 2 34 -6" fill="none" stroke="#B08A44" stroke-width="4.4" stroke-linecap="round"/>
  </g>
</svg>
