---
/* Dĩa cơm tấm sườn nướng — sườn cốt lết dáng rẻ quạt TO BẢN (tỉ lệ ~1.3:1 như thật),
   vệt nướng chéo, vành mỡ, mỡ hành; cơm tấm, ốp la, đồ chua, muỗng nĩa */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Dĩa cơm tấm sườn nướng ốp la">
  <defs>
    <linearGradient id="ctSuon" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#D07B35"/><stop offset="1" stop-color="#A04C1B"/>
    </linearGradient>
    <linearGradient id="ctRice" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#FDFAF0"/><stop offset="1" stop-color="#EFE7CE"/>
    </linearGradient>
  </defs>
  <circle cx="260" cy="250" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="250" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <g class="steam">
    <path d="M330 208 C 319 184 345 168 334 142 C 327 126 341 114 337 100"/>
    <path d="M392 204 C 382 180 408 166 397 140 C 390 124 404 112 400 96"/>
  </g>
  <ellipse cx="260" cy="400" rx="200" ry="26" fill="rgba(15,26,14,.35)"/>

  <!-- dĩa -->
  <ellipse cx="260" cy="342" rx="204" ry="58" fill="#F6F1E1"/>
  <ellipse cx="260" cy="338" rx="204" ry="58" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2"/>
  <ellipse cx="260" cy="338" rx="204" ry="58" fill="none" stroke="#2C5234" stroke-width="4"/>
  <ellipse cx="260" cy="340" rx="168" ry="44" fill="none" stroke="#E0A32E" stroke-width="2.4" stroke-dasharray="2 11" stroke-linecap="round"/>

  <!-- mô cơm tấm phía sau bên trái -->
  <ellipse cx="168" cy="318" rx="88" ry="30" fill="url(#ctRice)" stroke="#DCD3B4" stroke-width="2"/>
  <ellipse cx="168" cy="304" rx="66" ry="23" fill="#FDFAF0"/>
  <ellipse cx="168" cy="294" rx="43" ry="15" fill="#FFFDF6"/>
  <g stroke="#E3D9BB" stroke-width="3" stroke-linecap="round" fill="none">
    <path d="M136 302 l8 -2 M178 294 l8 -2 M154 312 l8 -2 M196 308 l8 -2 M144 290 l7 -2 M170 284 l7 -2"/>
  </g>
  <g stroke="#6F9C48" stroke-width="3.4" stroke-linecap="round" fill="none">
    <path d="M144 296 l10 -1 M172 290 l9 2 M158 304 l9 1 M188 300 l9 -1"/>
  </g>
  <g fill="#E9B23C"><circle cx="152" cy="292" r="2.2"/><circle cx="182" cy="304" r="2.2"/></g>

  <!-- MIẾNG SƯỜN CỐT LẾT: dáng rẻ quạt to bản, vệt nướng chéo, không xương -->
  <g>
    <path d="M282 262
             C 294 244 320 234 352 232
             C 384 230 410 238 421 254
             C 431 270 428 294 413 313
             C 397 333 364 342 331 340
             C 299 338 278 323 272 302
             C 267 287 272 273 282 262 Z"
          fill="url(#ctSuon)" stroke="#7A3A10" stroke-width="3"/>
    <!-- vành mỡ dọc mép trên -->
    <path d="M290 254 C 306 240 332 233 358 232 C 388 231 410 238 419 252 L 410 258 C 400 246 380 240 356 241 C 330 242 308 248 296 260 Z" fill="#EFD3A4"/>
    <!-- vệt nướng chéo song song -->
    <g stroke="#5E2C0C" stroke-width="6" stroke-linecap="round" fill="none">
      <path d="M312 248 L 296 316"/>
      <path d="M346 241 L 330 329"/>
      <path d="M380 240 L 364 327"/>
      <path d="M407 252 L 395 311"/>
    </g>
    <!-- cháy xém mép -->
    <path d="M414 310 C 406 324 392 334 374 338 C 390 339 406 330 417 317 Z" fill="#5E2C0C" opacity=".75"/>
    <path d="M273 296 C 271 284 274 273 282 264 C 276 274 274 285 277 297 Z" fill="#5E2C0C" opacity=".7"/>
    <!-- bóng mỡ óng xiên theo vệt nướng -->
    <g stroke="#F2B063" stroke-width="3" stroke-linecap="round" fill="none" opacity=".95">
      <path d="M328 258 L 320 294"/>
      <path d="M362 254 L 354 292"/>
      <path d="M394 262 L 387 296"/>
    </g>
    <!-- mỡ hành rưới mặt + mỡ óng lấm tấm -->
    <g stroke="#6F9C48" stroke-width="3.4" stroke-linecap="round" fill="none">
      <path d="M330 274 l11 -2 M358 306 l11 -2 M392 278 l10 -2 M312 300 l9 2"/>
    </g>
    <g fill="#F6C888"><circle cx="342" cy="290" r="2.4"/><circle cx="374" cy="266" r="2.4"/><circle cx="398" cy="298" r="2.2"/></g>
  </g>

  <!-- trứng ốp la lòng đào phía trước -->
  <g transform="translate(220 354) scale(1.3)">
    <path d="M-52 2 C -54 -16 -34 -26 -10 -26 C 18 -27 46 -20 50 -4 C 54 12 34 22 4 23 C -24 24 -50 18 -52 2 Z" fill="#FFFDF6" stroke="#E3D9BB" stroke-width="2.5"/>
    <circle cx="-2" cy="-3" r="14" fill="#F2B93E" stroke="#D9971E" stroke-width="2.5"/>
    <circle cx="-7" cy="-8" r="4" fill="#F9D97C"/>
  </g>

  <!-- dưa leo + cà chua + đồ chua -->
  <g>
    <circle cx="106" cy="354" r="13" fill="#6F9C48" stroke="#4E7B36" stroke-width="2"/>
    <circle cx="106" cy="354" r="8.5" fill="#C9DDA4"/>
    <circle cx="132" cy="364" r="12" fill="#6F9C48" stroke="#4E7B36" stroke-width="2"/>
    <circle cx="132" cy="364" r="7.6" fill="#C9DDA4"/>
    <path d="M424 348 a17 12 0 0 1 30 6 q-18 8 -30 -6Z" fill="#D64B33" stroke="#B23A26" stroke-width="1.8"/>
  </g>
  <g stroke-linecap="round" fill="none">
    <path d="M394 364 q10 -5 20 -1 M406 372 q10 -4 19 0" stroke="#EF9440" stroke-width="4.4"/>
    <path d="M400 356 q9 -4 18 -1" stroke="#F6F1E1" stroke-width="4.4"/>
  </g>

  <!-- muỗng nĩa để góc bàn (cơm tấm ăn muỗng nĩa mới đúng điệu) -->
  <g transform="translate(384 396) rotate(-16)">
    <rect x="8" y="0" width="92" height="9" rx="4.5" fill="#F6F1E1" stroke="#D8D0B6" stroke-width="1.6"/>
    <ellipse cx="116" cy="4.5" rx="17" ry="11.5" fill="#F6F1E1" stroke="#D8D0B6" stroke-width="1.6"/>
    <g transform="translate(0 24)">
      <rect x="14" y="0" width="92" height="9" rx="4.5" fill="#F6F1E1" stroke="#D8D0B6" stroke-width="1.6"/>
      <rect x="6" y="-3" width="14" height="15" rx="5" fill="#F6F1E1" stroke="#D8D0B6" stroke-width="1.6"/>
      <g fill="#F6F1E1" stroke="#D8D0B6" stroke-width="1.4">
        <rect x="-12" y="-3.5" width="20" height="4" rx="2"/>
        <rect x="-14" y="2.6" width="22" height="4" rx="2"/>
        <rect x="-12" y="8.7" width="20" height="4" rx="2"/>
      </g>
    </g>
  </g>

  <!-- chén nước mắm kẹo -->
  <g>
    <ellipse cx="86" cy="398" rx="42" ry="14" fill="rgba(15,26,14,.3)"/>
    <path d="M50 382 C 52 402 66 412 86 412 C 106 412 120 402 122 382 Z" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2"/>
    <ellipse cx="86" cy="382" rx="36" ry="11" fill="#B3591E"/>
    <circle cx="78" cy="380" r="3" fill="#C0392B"/><circle cx="96" cy="383" r="2.6" fill="#C0392B"/>
    <path d="M70 386 q8 3 16 1" stroke="#E8A65A" stroke-width="2.4" stroke-linecap="round" fill="none"/>
  </g>
  <!-- ớt trên bàn -->
  <g transform="translate(148 418) rotate(-14)">
    <path d="M0 0C13 2 22 -4 26 -13" fill="none" stroke="#C0392B" stroke-width="8" stroke-linecap="round"/>
    <path d="M26 -15c2-4 6-5 9-4" fill="none" stroke="#4E7B36" stroke-width="4" stroke-linecap="round"/>
  </g>
</svg>
