---
/* Dĩa cơm tấm sườn nướng — minh họa riêng: cơm vun, sườn cọng xương, ốp la, muỗng nĩa */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Dĩa cơm tấm sườn nướng ốp la">
  <defs>
    <linearGradient id="ctSuon" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#B8672B"/><stop offset="1" stop-color="#8A4517"/>
    </linearGradient>
    <linearGradient id="ctRice" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#FDFAF0"/><stop offset="1" stop-color="#EFE7CE"/>
    </linearGradient>
  </defs>
  <circle cx="260" cy="250" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="250" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <g class="steam">
    <path d="M310 214 C 299 190 325 174 314 148 C 307 132 321 120 317 106"/>
    <path d="M366 220 C 356 196 382 182 371 156 C 364 140 378 128 374 112"/>
  </g>
  <ellipse cx="260" cy="400" rx="200" ry="26" fill="rgba(15,26,14,.35)"/>

  <!-- dĩa -->
  <ellipse cx="260" cy="342" rx="204" ry="58" fill="#F6F1E1"/>
  <ellipse cx="260" cy="338" rx="204" ry="58" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2"/>
  <ellipse cx="260" cy="338" rx="204" ry="58" fill="none" stroke="#2C5234" stroke-width="4"/>
  <ellipse cx="260" cy="340" rx="168" ry="44" fill="none" stroke="#E0A32E" stroke-width="2.4" stroke-dasharray="2 11" stroke-linecap="round"/>

  <!-- mô cơm tấm vun -->
  <ellipse cx="176" cy="322" rx="92" ry="32" fill="url(#ctRice)" stroke="#DCD3B4" stroke-width="2"/>
  <ellipse cx="176" cy="308" rx="70" ry="24" fill="#FDFAF0"/>
  <ellipse cx="176" cy="298" rx="46" ry="16" fill="#FFFDF6"/>
  <!-- hột tấm lấm tấm -->
  <g stroke="#E3D9BB" stroke-width="3" stroke-linecap="round" fill="none">
    <path d="M142 306 l8 -2 M186 298 l8 -2 M162 316 l8 -2 M206 312 l8 -2 M150 294 l7 -2 M196 322 l8 -2 M176 288 l7 -2"/>
  </g>
  <!-- mỡ hành rưới mặt cơm -->
  <g stroke="#6F9C48" stroke-width="3.4" stroke-linecap="round" fill="none">
    <path d="M150 300 l10 -1 M180 294 l9 2 M164 308 l9 1 M198 304 l9 -1 M186 314 l8 2"/>
  </g>
  <g fill="#E9B23C"><circle cx="158" cy="296" r="2.2"/><circle cx="192" cy="308" r="2.2"/><circle cx="172" cy="302" r="1.8"/></g>

  <!-- miếng sườn nướng có cọng xương -->
  <g transform="rotate(-8 330 300)">
    <!-- cọng xương ló ra -->
    <rect x="398" y="290" width="46" height="15" rx="7.5" fill="#F3E9D2" stroke="#D9C8A8" stroke-width="2"/>
    <circle cx="446" cy="291" r="8" fill="#F3E9D2" stroke="#D9C8A8" stroke-width="2"/>
    <circle cx="447" cy="304" r="7" fill="#F3E9D2" stroke="#D9C8A8" stroke-width="2"/>
    <!-- thịt sườn -->
    <path d="M236 272 C 232 302 244 326 280 330 C 330 336 388 328 402 312 C 412 300 410 282 398 272 C 376 254 336 250 296 254 C 264 258 240 258 236 272 Z" fill="url(#ctSuon)" stroke="#6E3A16" stroke-width="3"/>
    <!-- viền mỡ cháy cạnh -->
    <path d="M240 270 C 262 256 322 250 362 256" fill="none" stroke="#E8A65A" stroke-width="6" stroke-linecap="round" opacity=".85"/>
    <!-- vệt nướng -->
    <g stroke="#54280C" stroke-width="6" stroke-linecap="round" fill="none">
      <path d="M270 268 q-8 26 4 52"/>
      <path d="M312 264 q-8 28 4 56"/>
      <path d="M354 264 q-6 26 4 50"/>
    </g>
    <!-- bóng mỡ óng -->
    <path d="M256 288 q16 -10 34 -8 M330 282 q14 -8 30 -6" fill="none" stroke="#E8A65A" stroke-width="3.4" stroke-linecap="round" opacity=".9"/>
    <!-- mè rắc -->
    <g fill="#F3E3C3"><ellipse cx="286" cy="300" rx="3.4" ry="2"/><ellipse cx="340" cy="296" rx="3.4" ry="2" transform="rotate(20 340 296)"/><ellipse cx="308" cy="316" rx="3.2" ry="1.9" transform="rotate(-14 308 316)"/></g>
  </g>

  <!-- trứng ốp la lòng đào -->
  <g transform="translate(238 348)">
    <path d="M-52 2 C -54 -16 -34 -26 -10 -26 C 18 -27 46 -20 50 -4 C 54 12 34 22 4 23 C -24 24 -50 18 -52 2 Z" fill="#FFFDF6" stroke="#E3D9BB" stroke-width="2.5"/>
    <circle cx="-2" cy="-3" r="14" fill="#F2B93E" stroke="#D9971E" stroke-width="2.5"/>
    <circle cx="-7" cy="-8" r="4" fill="#F9D97C"/>
  </g>

  <!-- dưa leo + cà chua -->
  <g>
    <circle cx="112" cy="352" r="13" fill="#6F9C48" stroke="#4E7B36" stroke-width="2"/>
    <circle cx="112" cy="352" r="8.5" fill="#C9DDA4"/>
    <circle cx="138" cy="362" r="12" fill="#6F9C48" stroke="#4E7B36" stroke-width="2"/>
    <circle cx="138" cy="362" r="7.6" fill="#C9DDA4"/>
    <path d="M330 352 a17 12 0 0 1 30 6 q-18 8 -30 -6Z" fill="#D64B33" stroke="#B23A26" stroke-width="1.8"/>
  </g>
  <!-- đồ chua sợi -->
  <g stroke-linecap="round" fill="none">
    <path d="M300 356 q10 -5 20 -1 M312 364 q10 -4 19 0" stroke="#EF9440" stroke-width="4.4"/>
    <path d="M306 348 q9 -4 18 -1" stroke="#F6F1E1" stroke-width="4.4"/>
  </g>

  <!-- muỗng nĩa để góc bàn (cơm tấm ăn muỗng nĩa mới đúng điệu) -->
  <g transform="translate(384 392) rotate(-16)">
    <rect x="8" y="0" width="92" height="9" rx="4.5" fill="#F6F1E1" stroke="#D8D0B6" stroke-width="1.6"/>
    <ellipse cx="116" cy="4.5" rx="17" ry="11.5" fill="#F6F1E1" stroke="#D8D0B6" stroke-width="1.6"/>
    <g transform="translate(0 24)">
      <rect x="14" y="0" width="92" height="9" rx="4.5" fill="#F6F1E1" stroke="#D8D0B6" stroke-width="1.6"/>
      <rect x="6" y="-3" width="14" height="15" rx="5" fill="#F6F1E1" stroke="#D8D0B6" stroke-width="1.6"/>
      <g fill="#F6F1E1" stroke="#D8D0B6" stroke-width="1.4">
        <rect x="-12" y="-3.5" width="20" height="4" rx="2"/>
        <rect x="-14" y="2.6" width="22" height="4" rx="2"/>
        <rect x="-12" y="8.7" width="20" height="4" rx="2"/>
      </g>
    </g>
  </g>

  <!-- chén nước mắm kẹo -->
  <g>
    <ellipse cx="86" cy="398" rx="42" ry="14" fill="rgba(15,26,14,.3)"/>
    <path d="M50 382 C 52 402 66 412 86 412 C 106 412 120 402 122 382 Z" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2"/>
    <ellipse cx="86" cy="382" rx="36" ry="11" fill="#B3591E"/>
    <circle cx="78" cy="380" r="3" fill="#C0392B"/><circle cx="96" cy="383" r="2.6" fill="#C0392B"/>
    <path d="M70 386 q8 3 16 1" stroke="#E8A65A" stroke-width="2.4" stroke-linecap="round" fill="none"/>
  </g>
  <!-- ớt trên bàn -->
  <g transform="translate(148 414) rotate(-14)">
    <path d="M0 0C13 2 22 -4 26 -13" fill="none" stroke="#C0392B" stroke-width="8" stroke-linecap="round"/>
    <path d="M26 -15c2-4 6-5 9-4" fill="none" stroke="#4E7B36" stroke-width="4" stroke-linecap="round"/>
  </g>
</svg>
