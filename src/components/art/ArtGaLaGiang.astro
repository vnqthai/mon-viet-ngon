---
/* Canh gà lá giang — tô canh vàng trong: miếng gà luộc da vàng nhạt, lá giang
   nhỏ rải quanh, ớt lát; đạo cụ nhận diện: NHÁNH DÂY lá giang lá mọc đôi + chén muối ớt */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Tô canh gà lá giang chua thanh, lá giang xanh, kèm nhánh lá giang và chén muối ớt">
  <defs>
    <linearGradient id="glBroth" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#E5CF82"/><stop offset="1" stop-color="#C9AC55"/>
    </linearGradient>
    <linearGradient id="glBowl" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#FDFAF0"/><stop offset="1" stop-color="#E9E2CC"/>
    </linearGradient>
  </defs>
  <circle cx="260" cy="240" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="240" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <g class="steam">
    <path d="M205 236 C 194 210 220 194 209 166 C 202 148 216 136 212 120"/>
    <path d="M262 230 C 252 204 278 190 267 162 C 260 144 274 132 270 114"/>
    <path d="M318 238 C 308 214 332 198 322 172 C 316 156 328 144 324 130"/>
  </g>
  <ellipse cx="255" cy="420" rx="196" ry="24" fill="rgba(15,26,14,.35)"/>

  <!-- tô canh -->
  <path d="M67 296 C 73 370 157 414 255 414 C 353 414 437 370 443 296 Z" fill="url(#glBowl)"/>
  <ellipse cx="255" cy="412" rx="62" ry="11" fill="#D8D0B6"/>
  <ellipse cx="255" cy="294" rx="188" ry="46" fill="#F6F1E1"/>
  <ellipse cx="255" cy="294" rx="188" ry="46" fill="none" stroke="#2C5234" stroke-width="5"/>
  <ellipse cx="255" cy="295" rx="174" ry="40" fill="none" stroke="#E0A32E" stroke-width="2.5" stroke-dasharray="2 11" stroke-linecap="round"/>

  <!-- nước canh vàng trong -->
  <ellipse cx="255" cy="297" rx="158" ry="33" fill="url(#glBroth)"/>
  <ellipse cx="308" cy="288" rx="52" ry="8" fill="#F2E3A4" opacity=".6"/>
  <g fill="#F2E3A4" opacity=".85">
    <circle cx="152" cy="302" r="3.2"/><circle cx="356" cy="308" r="3"/><circle cx="240" cy="322" r="2.6"/>
  </g>

  <!-- đùi gà nhỏ ló khỏi mặt canh: thân + khúc xương hai mấu -->
  <g transform="rotate(-9 194 290)">
    <path d="M218 272 L 244 252" stroke="#F6EFD8" stroke-width="7" stroke-linecap="round"/>
    <circle cx="249" cy="247" r="4.8" fill="#F6EFD8" stroke="#D8C8A8" stroke-width="1.5"/>
    <circle cx="253" cy="254" r="4.2" fill="#F6EFD8" stroke="#D8C8A8" stroke-width="1.5"/>
    <path d="M220 274
             C 224 279 224 287 218 293
             C 210 302 194 306 180 303
             C 163 300 152 289 154 276
             C 156 262 170 253 188 254
             C 202 255 214 263 220 274 Z"
          fill="#EFDCB2" stroke="#C49A50" stroke-width="2.5"/>
    <path d="M162 268 C 170 259 182 254 193 256 C 204 257 214 263 218 272 L 211 276 C 206 267 198 262 189 261 C 180 261 170 263 166 272 Z" fill="#E2BC72"/>
    <path d="M160 288 q9 7 20 5" fill="none" stroke="#D9B87A" stroke-width="2.2" stroke-linecap="round"/>
  </g>
  <!-- miếng gà chặt góc cạnh -->
  <g transform="rotate(8 320 300)">
    <path d="M294 296 L 306 282
             C 310 277 319 275 326 278 L 340 285
             C 346 288 348 295 344 301 L 334 312
             C 329 317 319 319 311 315 L 299 308
             C 293 304 291 300 294 296 Z"
          fill="#F2E0BA" stroke="#C49A50" stroke-width="2.4"/>
    <path d="M300 289 L 310 279 C 314 275 321 274 327 277 L 337 282 L 334 287 L 325 282 C 320 280 314 281 311 284 L 303 293 Z" fill="#E2BC72"/>
    <path d="M302 306 q8 5 17 2" fill="none" stroke="#D9B87A" stroke-width="2" stroke-linecap="round"/>
  </g>

  <!-- lá giang nhỏ rải trong canh: lá đôi trên cọng ngắn -->
  <g transform="translate(252 286) rotate(-10)">
    <path d="M-12 0 L 12 0" stroke="#5E8B3A" stroke-width="2"/>
    <path d="M-12 0 C -16 -8 -12 -16 -4 -17 C 0 -11 -2 -3 -9 1 C -10 2 -11 1 -12 0 Z" fill="#4E8B3A" stroke="#35682A" stroke-width="1.4"/>
    <path d="M12 0 C 16 -8 12 -16 4 -17 C 0 -11 2 -3 9 1 C 10 2 11 1 12 0 Z" fill="#5E9B46" stroke="#35682A" stroke-width="1.4"/>
  </g>
  <g transform="translate(150 296) rotate(14)">
    <path d="M0 0 C -4 -8 -1 -17 6 -19 C 11 -13 10 -4 3 1 C 1 2 0 1 0 0 Z" fill="#4E8B3A" stroke="#35682A" stroke-width="1.4"/>
  </g>
  <g transform="translate(282 316) rotate(24)">
    <path d="M0 0 C -4 -7 -1 -15 5 -17 C 10 -12 9 -4 3 1 C 1 2 0 1 0 0 Z" fill="#5E9B46" stroke="#35682A" stroke-width="1.3"/>
  </g>
  <g transform="translate(356 292) rotate(-18)">
    <path d="M0 0 C -4 -7 -1 -15 5 -17 C 10 -12 9 -4 3 1 C 1 2 0 1 0 0 Z" fill="#4E8B3A" stroke="#35682A" stroke-width="1.3"/>
  </g>
  <g transform="translate(218 318) rotate(-2)">
    <path d="M0 0 C -3 -6 0 -13 5 -15 C 9 -10 8 -3 3 1 C 1 2 0 1 0 0 Z" fill="#5E9B46" stroke="#35682A" stroke-width="1.2"/>
  </g>

  <!-- ớt sừng lát + hành ngò (thả trên mặt nước, tránh đè lên gà) -->
  <g>
    <circle cx="262" cy="318" r="6.5" fill="#D64B33" stroke="#A83722" stroke-width="1.8"/>
    <circle cx="262" cy="318" r="3" fill="#F28C6E"/>
    <circle cx="368" cy="286" r="5.5" fill="#D64B33" stroke="#A83722" stroke-width="1.6"/>
    <circle cx="368" cy="286" r="2.5" fill="#F28C6E"/>
  </g>
  <g stroke="#6F9C48" stroke-width="3.2" stroke-linecap="round" fill="none">
    <path d="M236 292 l10 -2 M300 322 l9 -2 M374 300 l8 -2"/>
  </g>

  <!-- NHÁNH DÂY LÁ GIANG trên bàn trái: lá mọc đôi đối xứng -->
  <g transform="translate(34 394) rotate(-9)">
    <path d="M0 10 C 30 -2 74 -6 128 2 C 138 3 146 6 150 10" fill="none" stroke="#5E8B3A" stroke-width="3.2" stroke-linecap="round"/>
    <g transform="translate(34 4) rotate(-6)">
      <path d="M0 0 C -5 -10 -1 -20 8 -22 C 14 -15 12 -5 4 1 C 2 2 1 1 0 0 Z" fill="#4E8B3A" stroke="#35682A" stroke-width="1.6"/>
      <path d="M2 3 C -3 13 1 23 10 25 C 16 18 14 8 6 2 C 4 1 3 2 2 3 Z" fill="#5E9B46" stroke="#35682A" stroke-width="1.6"/>
    </g>
    <g transform="translate(74 -2) rotate(4)">
      <path d="M0 0 C -5 -10 -1 -20 8 -22 C 14 -15 12 -5 4 1 C 2 2 1 1 0 0 Z" fill="#5E9B46" stroke="#35682A" stroke-width="1.6"/>
      <path d="M2 3 C -3 13 1 23 10 25 C 16 18 14 8 6 2 C 4 1 3 2 2 3 Z" fill="#4E8B3A" stroke="#35682A" stroke-width="1.6"/>
    </g>
    <g transform="translate(112 0) rotate(10)">
      <path d="M0 0 C -4 -9 -1 -18 7 -20 C 12 -14 11 -5 3 1 C 1 2 0 1 0 0 Z" fill="#4E8B3A" stroke="#35682A" stroke-width="1.5"/>
      <path d="M2 3 C -2 12 1 21 9 23 C 14 16 12 7 5 2 C 3 1 2 2 2 3 Z" fill="#5E9B46" stroke="#35682A" stroke-width="1.5"/>
    </g>
    <g transform="translate(148 8) rotate(30)">
      <path d="M0 0 C -4 -9 -1 -18 7 -20 C 12 -14 11 -5 3 1 C 1 2 0 1 0 0 Z" fill="#5E9B46" stroke="#35682A" stroke-width="1.5"/>
    </g>
    <path d="M6 8 q-5 5 -3 11" fill="none" stroke="#5E8B3A" stroke-width="2.4" stroke-linecap="round"/>
  </g>

  <!-- chén muối ớt -->
  <g>
    <ellipse cx="428" cy="392" rx="38" ry="12" fill="rgba(15,26,14,.3)"/>
    <path d="M396 376 C 398 394 410 404 428 404 C 446 404 458 394 460 376 Z" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2"/>
    <ellipse cx="428" cy="376" rx="32" ry="9.5" fill="#F6F1E1"/>
    <g fill="#D64B33">
      <circle cx="418" cy="374" r="2.6"/><circle cx="432" cy="372" r="2.4"/><circle cx="440" cy="377" r="2.2"/><circle cx="424" cy="379" r="2"/>
    </g>
    <g fill="#2E2318">
      <circle cx="428" cy="375" r="1.3"/><circle cx="414" cy="378" r="1.2"/>
    </g>
    <path d="M446 366 C 454 363 461 365 464 369" fill="none" stroke="#C0392B" stroke-width="5" stroke-linecap="round"/>
    <path d="M464 367 c 2 -3 5 -4 8 -3" fill="none" stroke="#4E7B36" stroke-width="3" stroke-linecap="round"/>
  </g>
</svg>
