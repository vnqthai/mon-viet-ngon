---
/* Lẩu dê nấu chao — CHỮ KÝ nhận dạng, phải lệch hẳn SÁU nồi lẩu kia:
   1) BẾP CỒN CÓ NGỌN LỬA XANH cháy dưới đáy nồi — không nồi nào khác có lửa,
      đây là dấu nhận ra nhanh nhất ở cỡ thumbnail
   2) nồi đất ĐEN NÂU thấp, miệng rất rộng, hai quai VUÔNG (lẩu mắm dùng nồi
      đất CAM có quai cong, lẩu Thái dùng nồi thép xám, lẩu gà lá é có ống khói)
   3) nước lèo VÀNG NÂU ĐỤC vị chao, không nâu đen như lẩu mắm
   4) hai thứ chỉ nồi này có: KHỐI KHOAI MÔN TÍM và LÁ TÀU HŨ KY vàng phồng
      nhăn nheo nổi trên mặt
   5) đạo cụ phải: chén CHAO ĐỎ, khác chén nước mắm trong của lẩu mắm
   id prefix "dc" */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Nồi lẩu dê nấu chao đặt trên bếp cồn đang cháy: nước lèo vàng nâu đục, khối khoai môn tím và lá tàu hũ ky vàng phồng nổi trên mặt, bên cạnh là rổ cải xanh và chén chao đỏ">
  <defs>
    <linearGradient id="dcBroth" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#D19A3C"/><stop offset="1" stop-color="#8E5A16"/>
    </linearGradient>
    <linearGradient id="dcPot" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#5A4438"/><stop offset="1" stop-color="#2E211A"/>
    </linearGradient>
    <linearGradient id="dcTaro" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#CDB4DC"/><stop offset="1" stop-color="#96769F"/>
    </linearGradient>
    <linearGradient id="dcSkin" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#F0C664"/><stop offset="1" stop-color="#B67F1C"/>
    </linearGradient>
    <!-- miếng thịt dê: khối nâu đỏ có VIỀN DA sẫm chạy dọc một cạnh -->
    <g id="dcMeat">
      <path d="M-19 -12 C -8 -18 12 -18 20 -10 C 24 -2 20 10 8 14 C -6 18 -20 12 -22 2 Z"
            fill="#8E4327" stroke="#4E1F0E" stroke-width="2.2"/>
      <path d="M-19 -12 C -8 -18 12 -18 20 -10" fill="none" stroke="#3A1608" stroke-width="5" stroke-linecap="round"/>
      <path d="M-12 0 C -4 -4 6 -3 13 2" fill="none" stroke="#C07A52" stroke-width="2" stroke-linecap="round"/>
    </g>
  </defs>

  <circle cx="260" cy="230" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="230" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <g class="steam">
    <path d="M198 200 C 187 176 213 160 202 134 C 195 118 209 106 205 90"/>
    <path d="M270 192 C 260 168 286 154 275 128 C 268 112 282 100 278 84"/>
    <path d="M340 204 C 330 180 356 166 345 140 C 338 124 352 112 348 96"/>
  </g>
  <ellipse cx="268" cy="428" rx="182" ry="20" fill="rgba(15,26,14,.35)"/>

  <!-- BẾP CỒN + NGỌN LỬA XANH — dấu nhận diện mạnh nhất, vẽ TRƯỚC nồi -->
  <g>
    <path d="M204 400 L 214 424 L 322 424 L 332 400 Z" fill="#3E3A34" stroke="#211E1A" stroke-width="2.6" stroke-linejoin="round"/>
    <ellipse cx="268" cy="424" rx="56" ry="10" fill="#4E4A42" stroke="#211E1A" stroke-width="2.4"/>
    <ellipse cx="268" cy="400" rx="64" ry="12" fill="#5E594F" stroke="#2C2823" stroke-width="2.6"/>
    <!-- Ba lưỡi lửa, cao thấp lệch nhau. Bản 1 tô XANH (đúng với lửa cồn lỏng
         cháy sạch) nhưng nhìn ra thì lạ mắt — lửa bếp lẩu ngoài hàng là cồn
         khô, cháy VÀNG CAM. Vẽ vàng cam vừa đúng thứ người ta thấy thật, vừa
         ăn với nền họ màu ấm. -->
    <g>
      <path d="M234 400 C 228 384 240 376 238 362 C 250 372 254 388 246 400 Z" fill="#E4761E"/>
      <path d="M236 400 C 233 390 240 384 239 376 C 245 383 246 393 242 400 Z" fill="#FBE08A"/>
      <path d="M268 402 C 260 380 276 368 272 350 C 290 364 294 386 284 402 Z" fill="#E4761E"/>
      <path d="M270 402 C 266 388 275 380 274 368 C 282 378 284 392 278 402 Z" fill="#FBE08A"/>
      <path d="M300 400 C 294 386 304 378 302 366 C 313 375 316 389 310 400 Z" fill="#E4761E"/>
      <path d="M302 400 C 299 391 305 385 304 377 C 310 384 311 393 307 400 Z" fill="#FBE08A"/>
    </g>
  </g>

  <!-- NỒI ĐẤT ĐEN NÂU, thấp, miệng rộng, hai quai VUÔNG -->
  <path d="M116 300 C 122 356 186 388 268 388 C 350 388 414 356 420 300 Z" fill="url(#dcPot)"/>
  <path d="M116 300 C 122 356 186 388 268 388 C 350 388 414 356 420 300"
        fill="none" stroke="#1C130E" stroke-width="4"/>
  <!-- quai vuông hai bên, cỡ lệch nhau -->
  <path d="M116 306 L 84 306 L 84 342 L 118 342" fill="none" stroke="#4A382D" stroke-width="13" stroke-linejoin="round"/>
  <path d="M420 308 L 450 308 L 450 340 L 418 340" fill="none" stroke="#4A382D" stroke-width="11" stroke-linejoin="round"/>
  <!-- vành miệng nồi -->
  <ellipse cx="268" cy="298" rx="152" ry="38" fill="#6B5343"/>
  <ellipse cx="268" cy="298" rx="152" ry="38" fill="none" stroke="#2C5234" stroke-width="5"/>
  <ellipse cx="268" cy="299" rx="139" ry="32" fill="none" stroke="#E0A32E" stroke-width="2.5" stroke-dasharray="2 11" stroke-linecap="round"/>

  <!-- NƯỚC LÈO VÀNG NÂU ĐỤC vị chao -->
  <ellipse cx="268" cy="301" rx="130" ry="29" fill="url(#dcBroth)"/>
  <!-- váng chao nổi lều bều -->
  <g fill="#E9BA63" opacity=".72">
    <ellipse cx="194" cy="294" rx="17" ry="5"/>
    <ellipse cx="318" cy="310" rx="14" ry="4.4"/>
    <ellipse cx="356" cy="294" rx="10" ry="3.6"/>
    <ellipse cx="230" cy="316" rx="11" ry="3.8"/>
  </g>

  <!-- KHỐI KHOAI MÔN TÍM — thứ chỉ nồi này có -->
  <g stroke="#6B4C82" stroke-width="2.2" stroke-linejoin="round">
    <path d="M170 296 L 204 288 L 210 316 L 176 324 Z" fill="url(#dcTaro)"/>
    <path d="M296 290 L 328 284 L 333 310 L 301 316 Z" fill="url(#dcTaro)"/>
    <path d="M240 312 L 270 306 L 275 330 L 245 336 Z" fill="url(#dcTaro)"/>
  </g>
  <g stroke="#6B4C82" stroke-width="1.9" stroke-linecap="round">
    <path d="M180 292 L 184 318"/><path d="M192 290 L 196 316"/>
    <path d="M306 288 L 309 312"/><path d="M318 286 L 321 310"/>
    <path d="M250 310 L 253 332"/><path d="M262 308 L 265 330"/>
  </g>

  <!-- LÁ TÀU HŨ KY vàng phồng, mép NHĂN GỢN SÓNG — cảm giác giòn nằm ở đường bao -->
  <g stroke="#8A5C10" stroke-width="2.2" stroke-linejoin="round">
    <path d="M206 272 C 216 260 232 256 246 260 C 242 268 248 272 244 280 C 236 288 218 290 208 284 C 204 280 210 276 206 272 Z"
          fill="url(#dcSkin)"/>
    <path d="M336 300 C 348 288 366 286 378 292 C 372 300 380 304 374 312 C 364 320 346 320 338 312 C 334 308 340 304 336 300 Z"
          fill="url(#dcSkin)"/>
    <path d="M268 276 C 280 266 296 264 306 270 C 302 278 308 282 302 288 C 292 296 276 296 268 290 C 264 286 272 282 268 276 Z"
          fill="url(#dcSkin)"/>
  </g>
  <g fill="none" stroke="#FBE2A0" stroke-width="1.8" stroke-linecap="round" opacity=".85">
    <path d="M214 270 C 224 264 236 263 242 266"/>
    <path d="M346 296 C 356 291 368 291 374 295"/>
    <path d="M276 274 C 286 269 296 269 301 272"/>
  </g>

  <!-- MIẾNG THỊT DÊ có viền da sẫm -->
  <use href="#dcMeat" transform="translate(224 296) rotate(-10)"/>
  <use href="#dcMeat" transform="translate(348 302) rotate(12) scale(.9)"/>
  <use href="#dcMeat" transform="translate(292 322) rotate(-4) scale(.86)"/>

  <!-- KHÚC SẢ nổi mép nồi -->
  <g stroke="#3F6B2C" stroke-width="2" stroke-linecap="round">
    <path d="M150 306 L 200 294" stroke="#7EA24C" stroke-width="7"/>
    <path d="M150 306 L 200 294"/>
    <path d="M192 295 L 204 291 M 193 298 L 205 294" stroke-width="1.6"/>
  </g>

  <!-- RỔ CẢI XANH (đạo cụ trái) — lá to bản, khác hẳn bông súng của lẩu mắm -->
  <g transform="translate(80 356)">
    <ellipse cx="0" cy="48" rx="54" ry="12" fill="rgba(15,26,14,.3)"/>
    <g stroke="#245A1A" stroke-width="2.2">
      <path d="M-38 20 C -46 -6 -30 -30 -6 -34 C -2 -8 -14 12 -32 24 C -36 26 -39 24 -38 20 Z" fill="#4E8A38"/>
      <path d="M-4 14 C -8 -12 8 -36 32 -38 C 34 -12 22 8 4 20 C 0 22 -4 18 -4 14 Z" fill="#5C9E42"/>
      <path d="M26 24 C 24 4 38 -14 56 -16 C 56 4 46 20 32 30 C 28 32 26 28 26 24 Z" fill="#3E7B2C"/>
    </g>
    <!-- cọng cải trắng dày, dấu riêng của cải xanh -->
    <g fill="none" stroke="#EDF3DC" stroke-width="6" stroke-linecap="round">
      <path d="M-30 26 C -22 8 -14 -12 -8 -30"/>
      <path d="M4 20 C 12 2 22 -18 30 -34"/>
      <path d="M32 30 C 38 16 46 0 54 -12"/>
    </g>
    <!-- rổ tre -->
    <path d="M-48 18 C -44 42 -26 52 0 52 C 26 52 44 42 48 18 Z" fill="#C89A56" stroke="#8A6122" stroke-width="2.4"/>
    <path d="M-44 28 C -28 34 28 34 44 28 M -40 38 C -24 44 24 44 40 38"
          fill="none" stroke="#8A6122" stroke-width="1.6" opacity=".8"/>
    <ellipse cx="0" cy="18" rx="48" ry="11" fill="none" stroke="#8A6122" stroke-width="3"/>
  </g>

  <!-- CHÉN CHAO ĐỎ (đạo cụ phải) — sánh đặc, có váng sa tế nổi -->
  <g transform="translate(444 372)">
    <ellipse cx="0" cy="22" rx="38" ry="10" fill="rgba(15,26,14,.3)"/>
    <path d="M-34 -2 C -32 14 -18 22 0 22 C 18 22 32 14 34 -2 Z" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2.2"/>
    <ellipse cx="0" cy="-2" rx="34" ry="9.5" fill="#F6F1E1" stroke="#D8D0B6" stroke-width="2"/>
    <ellipse cx="0" cy="-1" rx="27" ry="7" fill="#B2452A"/>
    <g fill="#E4762E" opacity=".9">
      <ellipse cx="-9" cy="-3" rx="7" ry="2.6"/>
      <ellipse cx="8" cy="1" rx="6" ry="2.2"/>
    </g>
    <!-- lát ớt -->
    <g fill="#D4442A" stroke="#93230F" stroke-width="1.1">
      <ellipse cx="14" cy="-4" rx="4.4" ry="2.2"/>
    </g>
  </g>
</svg>
