---
/* Bánh xèo miền Tây — minh họa riêng: bánh gập bán nguyệt vàng giòn, nhân ló, rau cải */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Bánh xèo vàng giòn gập đôi trên dĩa">
  <defs>
    <linearGradient id="bxCrepe" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#F5C95C"/><stop offset="1" stop-color="#E0A32E"/>
    </linearGradient>
  </defs>
  <circle cx="260" cy="250" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="250" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <g class="steam">
    <path d="M225 216 C 214 192 240 176 229 150 C 222 134 236 122 232 108"/>
    <path d="M295 212 C 285 188 311 174 300 148 C 293 132 307 120 303 104"/>
  </g>
  <ellipse cx="260" cy="400" rx="200" ry="26" fill="rgba(15,26,14,.35)"/>

  <!-- dĩa -->
  <ellipse cx="260" cy="342" rx="204" ry="58" fill="#F6F1E1"/>
  <ellipse cx="260" cy="338" rx="204" ry="58" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2"/>
  <ellipse cx="260" cy="338" rx="204" ry="58" fill="none" stroke="#2C5234" stroke-width="4"/>
  <ellipse cx="260" cy="340" rx="168" ry="44" fill="none" stroke="#E0A32E" stroke-width="2.4" stroke-dasharray="2 11" stroke-linecap="round"/>

  <!-- lá cải xanh lót góc -->
  <path d="M116 328 C 122 306 156 294 196 296 C 172 312 158 330 158 346 C 140 344 122 338 116 328 Z" fill="#6F9C48" stroke="#557E38" stroke-width="2.4"/>
  <path d="M128 326 q22 -16 52 -22" fill="none" stroke="#A8C46E" stroke-width="3.4" stroke-linecap="round"/>

  <!-- bánh xèo gập NỬA HÌNH TRÒN: mép gập thẳng trên, vành cong dưới -->
  <g transform="rotate(-3 268 316)">
    <!-- lớp dưới tạo độ dày -->
    <path d="M132 306 C 200 297 336 297 402 306 C 398 330 372 352 330 364 C 298 372 240 372 208 364 C 166 352 138 330 132 306 Z" fill="#C9812E" stroke="#A96A24" stroke-width="2.5" opacity=".95"/>
    <!-- mặt bánh: nửa hình tròn -->
    <path d="M132 298 C 200 289 336 289 402 298 C 398 322 372 344 330 356 C 298 364 240 364 208 356 C 166 344 138 322 132 298 Z" fill="url(#bxCrepe)" stroke="#C9902D" stroke-width="3"/>
    <!-- mép gập thẳng trên -->
    <path d="M140 297 C 205 289 331 289 394 297" fill="none" stroke="#F9DD8C" stroke-width="4.4" stroke-linecap="round"/>
    <path d="M142 303 C 206 295 330 295 392 303" fill="none" stroke="#C9812E" stroke-width="2.4" stroke-linecap="round" opacity=".75"/>
    <!-- rìa giòn răng cưa ôm vành cong -->
    <g fill="url(#bxCrepe)" stroke="#C9902D" stroke-width="1.8">
      <circle cx="398" cy="305" r="4.6"/><circle cx="390" cy="318" r="4.8"/><circle cx="378" cy="330" r="5"/>
      <circle cx="362" cy="341" r="5"/><circle cx="344" cy="350" r="5"/><circle cx="323" cy="357" r="5"/>
      <circle cx="300" cy="361" r="5"/><circle cx="276" cy="363" r="5"/><circle cx="252" cy="362" r="5"/>
      <circle cx="229" cy="358" r="5"/><circle cx="207" cy="352" r="5"/><circle cx="187" cy="344" r="4.8"/>
      <circle cx="168" cy="333" r="4.8"/><circle cx="152" cy="321" r="4.6"/><circle cx="140" cy="308" r="4.4"/>
    </g>
    <!-- chấm rộp giòn trên mặt bánh -->
    <g fill="#D9A032" opacity=".85">
      <circle cx="200" cy="316" r="4"/><circle cx="252" cy="310" r="3.4"/><circle cx="308" cy="316" r="4"/>
      <circle cx="348" cy="324" r="3.4"/><circle cx="228" cy="332" r="3"/><circle cx="284" cy="338" r="3.4"/>
    </g>
    <g fill="#F9E1A0">
      <circle cx="222" cy="310" r="2.6"/><circle cx="274" cy="306" r="2.4"/><circle cx="328" cy="314" r="2.6"/><circle cx="356" cy="332" r="2.2"/>
      <circle cx="196" cy="330" r="2.4"/><circle cx="252" cy="344" r="2.4"/>
    </g>
    <!-- nhân ló ra khỏi mép cong: giá + tôm + hẹ -->
    <g>
      <path d="M336 352 q18 3 34 10 M360 342 q17 2 32 9 M304 360 q16 2 30 8" fill="none" stroke="#F6EEDC" stroke-width="5" stroke-linecap="round"/>
      <path d="M382 336 a12 8 -18 0 1 22 -3 q-9 11 -22 3Z" fill="#F08A4A" stroke="#D96A2A" stroke-width="2"/>
      <path d="M344 356 a11 7 -10 0 1 20 -2 q-8 10 -20 2Z" fill="#EF7F3E" stroke="#D96A2A" stroke-width="2"/>
      <path d="M372 350 l12 2 M330 364 l11 1" stroke="#6F9C48" stroke-width="3.4" stroke-linecap="round"/>
    </g>
  </g>

  <!-- mâm rau cuốn bên trái -->
  <g transform="translate(96 386)">
    <ellipse cx="0" cy="14" rx="58" ry="14" fill="rgba(15,26,14,.3)"/>
    <ellipse cx="0" cy="8" rx="56" ry="16" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2"/>
    <path d="M-40 2 C -36 -12 -16 -20 4 -18 C -8 -8 -14 2 -12 10 C -24 10 -34 8 -40 2 Z" fill="#6F9C48" stroke="#557E38" stroke-width="2"/>
    <path d="M-2 -2 C 6 -14 24 -18 40 -12 C 30 -4 24 4 24 10 C 14 10 4 6 -2 -2 Z" fill="#86A94F" stroke="#557E38" stroke-width="2"/>
    <path d="M-34 0 q14 -10 32 -14 M6 -4 q14 -8 30 -8" fill="none" stroke="#C4D896" stroke-width="2.6" stroke-linecap="round"/>
    <g fill="#4E7B36"><ellipse cx="34" cy="4" rx="9" ry="4" transform="rotate(-14 34 4)"/><ellipse cx="44" cy="9" rx="7" ry="3.4" transform="rotate(10 44 9)"/></g>
  </g>

  <!-- chén mắm chua ngọt -->
  <g>
    <ellipse cx="424" cy="396" rx="42" ry="13" fill="rgba(15,26,14,.3)"/>
    <path d="M390 380 C 392 399 405 409 424 409 C 443 409 456 399 458 380 Z" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2"/>
    <ellipse cx="424" cy="380" rx="34" ry="10" fill="#D98A3A"/>
    <path d="M410 382 q8 3 16 1" stroke="#EF9440" stroke-width="3" stroke-linecap="round" fill="none" opacity=".8"/>
    <circle cx="434" cy="378" r="2.6" fill="#C0392B"/><circle cx="416" cy="377" r="2" fill="#C0392B"/>
  </g>

  <!-- đũa gác -->
  <g transform="rotate(-16 428 250)">
    <rect x="338" y="222" width="170" height="8" rx="4" fill="#9A6538"/>
    <rect x="344" y="235" width="170" height="8" rx="4" fill="#8A5730"/>
  </g>

  <!-- ớt + dưa leo lát trên bàn -->
  <g transform="translate(150 428) rotate(-12)">
    <path d="M0 0C13 2 22 -4 26 -13" fill="none" stroke="#C0392B" stroke-width="8" stroke-linecap="round"/>
    <path d="M26 -15c2-4 6-5 9-4" fill="none" stroke="#4E7B36" stroke-width="4" stroke-linecap="round"/>
  </g>
  <g>
    <circle cx="206" cy="424" r="10" fill="#6F9C48" stroke="#4E7B36" stroke-width="2"/>
    <circle cx="206" cy="424" r="6.4" fill="#C9DDA4"/>
  </g>
</svg>
