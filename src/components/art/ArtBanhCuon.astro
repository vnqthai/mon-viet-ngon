---
/* Bánh cuốn nóng — dĩa 3 cuộn trắng ngà mềm oặt hơi dẹt, thấy mờ nhân thịt mộc nhĩ
   bên trong, rắc hành phi vàng + chả quế mặt cam + rau mùi + giá trụng; chén nước
   mắm ấm nổi lát ớt. Khác hẳn chả giò (vàng chiên) và gỏi cuốn (trong lộ tôm) */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Dĩa bánh cuốn nóng cuộn trắng mềm rắc hành phi, kèm chả quế và chén nước mắm ớt">
  <defs>
    <linearGradient id="bcRoll" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#FCF7EA"/><stop offset="1" stop-color="#EDE2C4"/>
    </linearGradient>
    <linearGradient id="bcRollFront" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#FEFAF0"/><stop offset="1" stop-color="#F1E7CC"/>
    </linearGradient>
  </defs>
  <circle cx="260" cy="250" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="250" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <g class="steam">
    <path d="M234 212 C 223 188 249 172 238 146 C 231 130 245 118 241 104"/>
    <path d="M298 208 C 288 184 314 170 303 144 C 296 128 310 116 306 100"/>
  </g>
  <ellipse cx="260" cy="400" rx="200" ry="26" fill="rgba(15,26,14,.35)"/>

  <!-- dĩa -->
  <ellipse cx="260" cy="342" rx="204" ry="58" fill="#F6F1E1"/>
  <ellipse cx="260" cy="338" rx="204" ry="58" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2"/>
  <ellipse cx="260" cy="338" rx="204" ry="58" fill="none" stroke="#2C5234" stroke-width="4"/>
  <ellipse cx="260" cy="340" rx="168" ry="44" fill="none" stroke="#E0A32E" stroke-width="2.4" stroke-dasharray="2 11" stroke-linecap="round"/>

  <!-- bóng cuộn trên dĩa -->
  <ellipse cx="186" cy="326" rx="82" ry="11" fill="rgba(60,48,18,.1)"/>
  <ellipse cx="336" cy="330" rx="80" ry="11" fill="rgba(60,48,18,.1)"/>
  <ellipse cx="212" cy="358" rx="76" ry="10" fill="rgba(60,48,18,.1)"/>

  <!-- cuộn 1 (sau, trái) -->
  <g transform="translate(96 288) rotate(-3)">
    <path d="M 13 12 C 40 4 72 8 94 6 C 122 4 152 6 167 11 C 177 15 178 27 170 32 C 144 40 116 37 92 38 C 64 40 30 39 15 33 C 5 28 4 17 13 12 Z" fill="url(#bcRoll)" stroke="#D9CBA2" stroke-width="2.6"/>
    <!-- nhân mờ dưới lớp bánh -->
    <path d="M 38 22 C 60 15 100 14 126 16 C 142 17 152 19 156 22 C 152 26 140 28 124 28 C 98 30 60 29 38 22 Z" fill="#B08360" opacity=".32"/>
    <g fill="#6E4A33" opacity=".45">
      <circle cx="58" cy="21" r="2"/><circle cx="84" cy="19" r="1.8"/><circle cx="112" cy="19" r="2"/><circle cx="138" cy="22" r="1.8"/><circle cx="96" cy="24" r="1.6"/>
    </g>
    <!-- mép cuộn xoắn ở đầu -->
    <path d="M 17 15 C 10 20 10 27 18 31" fill="none" stroke="#CDBA8C" stroke-width="2.8"/>
    <path d="M 26 18 C 21 21 21 26 27 29" fill="none" stroke="#DECFA8" stroke-width="2"/>
    <!-- nếp gấp mềm -->
    <path d="M 30 14 Q 92 8 158 13" fill="none" stroke="#E8DCBE" stroke-width="2"/>
    <path d="M 34 30 Q 94 35 156 29" fill="none" stroke="#DFD1AE" stroke-width="1.8"/>
    <!-- nếp nhún dọc + vệt bóng thẳng xiên -->
    <path d="M 72 9 C 70 16 70 26 73 34 M 128 8 C 126 15 126 24 129 32" fill="none" stroke="#E4D6B4" stroke-width="1.6" opacity=".8"/>
    <path d="M 58 11 L 49 20 M 118 9 L 109 18" stroke="#FFFFFF" stroke-width="2.8" stroke-linecap="round" opacity=".55"/>
  </g>

  <!-- cuộn 2 (sau, phải) -->
  <g transform="translate(246 292) rotate(3)">
    <path d="M 13 12 C 40 4 72 8 94 6 C 122 4 152 6 167 11 C 177 15 178 27 170 32 C 144 40 116 37 92 38 C 64 40 30 39 15 33 C 5 28 4 17 13 12 Z" fill="url(#bcRoll)" stroke="#D9CBA2" stroke-width="2.6"/>
    <path d="M 34 22 C 56 15 96 14 122 16 C 138 17 148 19 152 22 C 148 26 136 28 120 28 C 94 30 56 29 34 22 Z" fill="#B08360" opacity=".32"/>
    <g fill="#6E4A33" opacity=".45">
      <circle cx="54" cy="21" r="1.9"/><circle cx="82" cy="19" r="2"/><circle cx="110" cy="19" r="1.9"/><circle cx="134" cy="22" r="1.8"/><circle cx="94" cy="24" r="1.6"/>
    </g>
    <path d="M 166 14 C 172 20 172 27 164 31" fill="none" stroke="#CDBA8C" stroke-width="2.8"/>
    <path d="M 157 17 C 162 20 162 25 156 28" fill="none" stroke="#DECFA8" stroke-width="2"/>
    <path d="M 26 14 Q 88 8 154 13" fill="none" stroke="#E8DCBE" stroke-width="2"/>
    <path d="M 30 30 Q 90 35 152 29" fill="none" stroke="#DFD1AE" stroke-width="1.8"/>
    <path d="M 78 9 C 76 16 76 26 79 34 M 134 9 C 132 16 132 25 135 32" fill="none" stroke="#E4D6B4" stroke-width="1.6" opacity=".8"/>
    <path d="M 66 10 L 57 19 M 126 9 L 117 18" stroke="#FFFFFF" stroke-width="2.8" stroke-linecap="round" opacity=".55"/>
  </g>

  <!-- cuộn 3 (trước, giữa) -->
  <g transform="translate(126 324) rotate(-1)">
    <path d="M 12 12 C 38 4 68 8 89 6 C 115 4 143 6 158 11 C 168 15 169 26 161 31 C 137 39 110 36 87 37 C 61 39 28 38 14 32 C 5 27 4 17 12 12 Z" fill="url(#bcRollFront)" stroke="#D9CBA2" stroke-width="2.6"/>
    <path d="M 34 21 C 54 14 92 13 116 15 C 132 16 142 18 146 21 C 142 25 130 27 114 27 C 90 29 54 28 34 21 Z" fill="#B08360" opacity=".3"/>
    <g fill="#6E4A33" opacity=".42">
      <circle cx="52" cy="20" r="1.9"/><circle cx="78" cy="18" r="1.8"/><circle cx="104" cy="18" r="1.9"/><circle cx="128" cy="21" r="1.7"/><circle cx="90" cy="23" r="1.5"/>
    </g>
    <path d="M 16 15 C 9 19 9 26 17 30" fill="none" stroke="#CDBA8C" stroke-width="2.8"/>
    <path d="M 25 18 C 20 21 20 25 26 28" fill="none" stroke="#DECFA8" stroke-width="2"/>
    <path d="M 28 14 Q 86 8 148 13" fill="none" stroke="#E8DCBE" stroke-width="2"/>
    <path d="M 32 29 Q 88 34 146 28" fill="none" stroke="#DFD1AE" stroke-width="1.8"/>
    <path d="M 66 9 C 64 15 64 24 67 32 M 118 8 C 116 14 116 23 119 30" fill="none" stroke="#E4D6B4" stroke-width="1.6" opacity=".8"/>
    <path d="M 52 10 L 43 19 M 112 9 L 103 18" stroke="#FFFFFF" stroke-width="2.8" stroke-linecap="round" opacity=".55"/>
  </g>

  <!-- hành phi vàng rắc mặt -->
  <g fill="#E3A544" stroke="#AE7124" stroke-width="1.2">
    <rect x="140" y="300" width="11" height="5" rx="2.5" transform="rotate(-24 145 302)"/>
    <rect x="158" y="306" width="9.5" height="4.6" rx="2.3" transform="rotate(10 162 308)"/>
    <rect x="196" y="296" width="11" height="5" rx="2.5" transform="rotate(16 201 298)"/>
    <rect x="216" y="303" width="9" height="4.4" rx="2.2" transform="rotate(-12 220 305)"/>
    <rect x="290" y="303" width="11" height="5" rx="2.5" transform="rotate(20 295 305)"/>
    <rect x="310" y="297" width="9.5" height="4.6" rx="2.3" transform="rotate(-16 314 299)"/>
    <rect x="352" y="306" width="11" height="5" rx="2.5" transform="rotate(8 357 308)"/>
    <rect x="371" y="300" width="9" height="4.4" rx="2.2" transform="rotate(-20 375 302)"/>
    <rect x="182" y="336" width="11" height="5" rx="2.5" transform="rotate(-14 187 338)"/>
    <rect x="202" y="343" width="9.5" height="4.6" rx="2.3" transform="rotate(12 206 345)"/>
    <rect x="242" y="334" width="11" height="5" rx="2.5" transform="rotate(-6 247 336)"/>
    <rect x="262" y="341" width="9" height="4.4" rx="2.2" transform="rotate(18 266 343)"/>
  </g>

  <!-- chả quế: 2 lát nửa vầng trăng dựng + 1 lát nằm -->
  <g transform="translate(380 344)">
    <ellipse cx="8" cy="17" rx="28" ry="9.5" fill="#F6D9C2" stroke="#CE8B3F" stroke-width="3.4"/>
    <ellipse cx="8" cy="17" rx="20" ry="6" fill="#FAE4D2"/>
    <g transform="translate(-20 -6) rotate(-9)">
      <path d="M -26 8 A 26 26 0 0 1 26 8 Z" fill="#F7DFC9" stroke="#D8A35F" stroke-width="2.2"/>
      <path d="M -26 8 A 26 26 0 0 1 26 8" fill="none" stroke="#CE8B3F" stroke-width="6" stroke-linecap="round"/>
      <g fill="#E3B695"><circle cx="-10" cy="0" r="1.6"/><circle cx="3" cy="-4" r="1.5"/><circle cx="12" cy="2" r="1.4"/></g>
    </g>
    <g transform="translate(22 2) rotate(12)">
      <path d="M -21 7 A 21 21 0 0 1 21 7 Z" fill="#F7DFC9" stroke="#D8A35F" stroke-width="2.2"/>
      <path d="M -21 7 A 21 21 0 0 1 21 7" fill="none" stroke="#CE8B3F" stroke-width="5" stroke-linecap="round"/>
      <g fill="#E3B695"><circle cx="-6" cy="0" r="1.5"/><circle cx="7" cy="-3" r="1.4"/></g>
    </g>
  </g>

  <!-- dưa leo lát xéo -->
  <g>
    <ellipse cx="310" cy="360" rx="17" ry="8.5" transform="rotate(-18 310 360)" fill="#E9F1D2" stroke="#7BA05B" stroke-width="2.8"/>
    <g fill="#C9DCA0"><ellipse cx="305" cy="358" rx="2.4" ry="1.5"/><ellipse cx="313" cy="360" rx="2.4" ry="1.5"/><ellipse cx="309" cy="363" rx="2" ry="1.3"/></g>
    <ellipse cx="334" cy="368" rx="16" ry="8" transform="rotate(-14 334 368)" fill="#EDF4D8" stroke="#7BA05B" stroke-width="2.6"/>
    <g fill="#C9DCA0"><ellipse cx="330" cy="366" rx="2.2" ry="1.4"/><ellipse cx="338" cy="369" rx="2.2" ry="1.4"/></g>
  </g>

  <!-- rau mùi điểm xanh -->
  <g transform="translate(150 286)">
    <path d="M 0 8 q 4 -7 10 -9" fill="none" stroke="#4E7B36" stroke-width="2.2" stroke-linecap="round"/>
    <g fill="#6F9C48">
      <ellipse cx="11" cy="-3" rx="5.2" ry="3" transform="rotate(-24 11 -3)"/>
      <ellipse cx="4" cy="2" rx="4.4" ry="2.7" transform="rotate(30 4 2)"/>
      <ellipse cx="14" cy="4" rx="4" ry="2.5" transform="rotate(8 14 4)"/>
    </g>
  </g>
  <g transform="translate(300 356)">
    <path d="M 0 6 q 3 -5 8 -7" fill="none" stroke="#4E7B36" stroke-width="2.2" stroke-linecap="round"/>
    <g fill="#6F9C48">
      <ellipse cx="9" cy="-2" rx="4.6" ry="2.8" transform="rotate(-20 9 -2)"/>
      <ellipse cx="2" cy="1" rx="4" ry="2.5" transform="rotate(26 2 1)"/>
    </g>
  </g>

  <!-- đôi đũa gác -->
  <g transform="rotate(-16 428 248)">
    <rect x="338" y="218" width="170" height="8" rx="4" fill="#9A6538"/>
    <rect x="344" y="231" width="170" height="8" rx="4" fill="#8A5730"/>
  </g>

  <!-- chén nước mắm ấm + lát ớt nổi -->
  <g>
    <ellipse cx="90" cy="402" rx="46" ry="14" fill="rgba(15,26,14,.3)"/>
    <path d="M50 383 C 52 405 68 416 90 416 C 112 416 128 405 130 383 Z" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2"/>
    <ellipse cx="90" cy="383" rx="40" ry="11.5" fill="#D89A3C"/>
    <ellipse cx="79" cy="381" rx="16" ry="4.8" fill="#E9B25C" opacity=".9"/>
    <g fill="none" stroke="#C0392B" stroke-width="3.6">
      <circle cx="101" cy="381" r="4.6"/>
      <circle cx="82" cy="386" r="4"/>
    </g>
    <g fill="#E9B25C"><circle cx="101" cy="381" r="1.4"/><circle cx="82" cy="386" r="1.2"/></g>
  </g>

  <!-- nhánh rau mùi trên bàn -->
  <g transform="translate(436 396)">
    <path d="M 0 12 q 6 -12 18 -16" fill="none" stroke="#4E7B36" stroke-width="2.4" stroke-linecap="round"/>
    <g fill="#6F9C48">
      <ellipse cx="20" cy="-6" rx="5.4" ry="3.2" transform="rotate(-24 20 -6)"/>
      <ellipse cx="10" cy="-1" rx="4.6" ry="2.8" transform="rotate(24 10 -1)"/>
      <ellipse cx="24" cy="2" rx="4.2" ry="2.6" transform="rotate(4 24 2)"/>
    </g>
  </g>
</svg>
