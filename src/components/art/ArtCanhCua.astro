---
/* Canh cua rau đay mướp — tảng riêu cua xốp vàng nổi giữa tô, gạch chưng cam óng,
   lá rau đay mồng tơi, khoanh mướp ruột trắng; đạo cụ: trái mướp dài + chén cà pháo */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Tô canh cua rau đay mướp, riêu cua kết tảng vàng, chén cà pháo muối">
  <defs>
    <linearGradient id="ccBroth" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#CBC275"/><stop offset="1" stop-color="#A89A50"/>
    </linearGradient>
    <linearGradient id="ccBowl" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#FDFAF0"/><stop offset="1" stop-color="#E9E2CC"/>
    </linearGradient>
  </defs>
  <circle cx="260" cy="240" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="240" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <g class="steam">
    <path d="M205 236 C 194 210 220 194 209 166 C 202 148 216 136 212 120"/>
    <path d="M262 230 C 252 204 278 190 267 162 C 260 144 274 132 270 114"/>
    <path d="M318 238 C 308 214 332 198 322 172 C 316 156 328 144 324 130"/>
  </g>
  <ellipse cx="255" cy="420" rx="196" ry="24" fill="rgba(15,26,14,.35)"/>

  <!-- tô canh -->
  <path d="M67 296 C 73 370 157 414 255 414 C 353 414 437 370 443 296 Z" fill="url(#ccBowl)"/>
  <ellipse cx="255" cy="412" rx="62" ry="11" fill="#D8D0B6"/>
  <ellipse cx="255" cy="294" rx="188" ry="46" fill="#F6F1E1"/>
  <ellipse cx="255" cy="294" rx="188" ry="46" fill="none" stroke="#2C5234" stroke-width="5"/>
  <ellipse cx="255" cy="295" rx="174" ry="40" fill="none" stroke="#E0A32E" stroke-width="2.5" stroke-dasharray="2 11" stroke-linecap="round"/>

  <!-- nước canh xanh vàng thanh -->
  <ellipse cx="255" cy="297" rx="158" ry="33" fill="url(#ccBroth)"/>
  <ellipse cx="316" cy="288" rx="50" ry="8" fill="#DDD48E" opacity=".55"/>
  <path d="M136 304 q16 -6 32 -3 M348 316 q16 -5 30 -2" fill="none" stroke="#D9CE85" stroke-width="2.6" stroke-linecap="round" opacity=".7"/>

  <!-- TẢNG RIÊU CUA xốp nổi giữa (lệch trái) -->
  <g transform="translate(202 290)">
    <path d="M-64 8
             C -69 -10 -53 -22 -35 -20
             C -28 -34 -5 -37 7 -26
             C 21 -36 44 -31 48 -16
             C 63 -14 69 1 59 10
             C 51 21 33 26 16 21
             C 5 30 -21 30 -33 20
             C -50 24 -60 17 -64 8 Z"
          fill="#CE9A55" stroke="#A8702E" stroke-width="2.6"/>
    <!-- lỗ xốp của riêu -->
    <g fill="none" stroke="#B37E3E" stroke-width="1.7" opacity=".95">
      <circle cx="-42" cy="2" r="4"/>
      <circle cx="-22" cy="12" r="3.4"/>
      <circle cx="-16" cy="-12" r="4.6"/>
      <circle cx="6" cy="8" r="4"/>
      <circle cx="24" cy="-8" r="3.6"/>
      <circle cx="40" cy="4" r="3.2"/>
      <circle cx="4" cy="-18" r="3.2"/>
    </g>
    <!-- gạch cua chưng hành rưới mặt: vệt loang dẹt -->
    <path d="M-46 -8 C -38 -18 -18 -22 -2 -18 C 12 -15 16 -8 8 -3 C 0 2 -14 3 -26 0 C -38 -2 -48 -2 -46 -8 Z" fill="#E0862F" stroke="#C4681F" stroke-width="1.8"/>
    <path d="M12 -14 C 22 -20 40 -18 48 -10 C 52 -5 47 0 38 0 C 27 0 12 -6 12 -14 Z" fill="#DD7E2A" stroke="#C4681F" stroke-width="1.6"/>
    <path d="M-18 4 C -10 0 2 0 8 4 C 12 7 8 11 0 11 C -8 11 -20 8 -18 4 Z" fill="#E0862F" opacity=".85"/>
    <path d="M30 6 q10 -2 16 3" fill="none" stroke="#DD7E2A" stroke-width="3.4" stroke-linecap="round" opacity=".9"/>
    <!-- hành phi lấm tấm -->
    <g fill="#B3762A">
      <circle cx="-26" cy="-16" r="2.2"/><circle cx="20" cy="10" r="2.2"/><circle cx="-4" cy="16" r="2"/><circle cx="34" cy="-14" r="2"/>
    </g>
    <g fill="#F2CD8C">
      <circle cx="-30" cy="8" r="2"/><circle cx="30" cy="12" r="2"/><circle cx="-8" cy="-24" r="2"/>
    </g>
  </g>

  <!-- khoanh mướp: viền xanh nhạt mỏng, ruột trắng kem vân tia -->
  <g>
    <circle cx="326" cy="290" r="16" fill="#EDF2CE" stroke="#B7CB86" stroke-width="2.6"/>
    <circle cx="326" cy="290" r="10.5" fill="#F7F5E2"/>
    <path d="M326 281 L 326 299 M318 285 L 334 295 M334 285 L 318 295" stroke="#E3E4BC" stroke-width="1.6" stroke-linecap="round"/>
    <g fill="#DDE2B4"><circle cx="322" cy="287" r="1.5"/><circle cx="330" cy="287" r="1.5"/><circle cx="326" cy="294" r="1.5"/></g>
  </g>
  <g>
    <circle cx="356" cy="308" r="12.5" fill="#EDF2CE" stroke="#B7CB86" stroke-width="2.3"/>
    <circle cx="356" cy="308" r="8" fill="#F7F5E2"/>
    <path d="M356 301 L 356 315 M350 304 L 362 312" stroke="#E3E4BC" stroke-width="1.4" stroke-linecap="round"/>
  </g>
  <g>
    <circle cx="290" cy="318" r="11" fill="#EDF2CE" stroke="#B7CB86" stroke-width="2.2"/>
    <circle cx="290" cy="318" r="7" fill="#F7F5E2"/>
    <path d="M290 312 L 290 324 M285 315 L 295 321" stroke="#E3E4BC" stroke-width="1.3" stroke-linecap="round"/>
  </g>

  <!-- lá rau đay + mồng tơi -->
  <g transform="translate(142 298) rotate(-16)">
    <path d="M0 0 C -9 -10 -7 -24 4 -29 C 15 -24 17 -10 8 0 C 5 4 2 4 0 0 Z" fill="#4A8B3E" stroke="#2C5E2E" stroke-width="1.8"/>
    <path d="M4 -25 L 4 0" stroke="#2C5E2E" stroke-width="1.4"/>
  </g>
  <g transform="translate(252 322) rotate(10)">
    <path d="M0 0 C -8 -9 -6 -21 3 -25 C 13 -21 15 -9 7 0 C 4 3 2 3 0 0 Z" fill="#3E7B3A" stroke="#2C5E2E" stroke-width="1.6"/>
    <path d="M3 -21 L 3 0" stroke="#2C5E2E" stroke-width="1.3"/>
  </g>
  <g transform="translate(382 288) rotate(-4)">
    <path d="M0 0 C -3 -10 3 -19 11 -19 C 18 -19 22 -12 19 -5 C 16 2 6 5 0 0 Z" fill="#3E7B3A" stroke="#2C5E2E" stroke-width="1.6"/>
    <path d="M10 -15 L 6 -1" stroke="#2C5E2E" stroke-width="1.3"/>
  </g>
  <path d="M124 288 l10 -3 M300 282 l9 -2 M226 314 l9 -2" fill="none" stroke="#6F9C48" stroke-width="3" stroke-linecap="round"/>

  <!-- trái mướp hương dài thon hơi cong, gờ dọc suốt trái -->
  <g transform="translate(10 392) rotate(-7)">
    <path d="M6 2
             C 20 -8 62 -13 104 -12
             C 142 -11 172 -6 182 0
             C 186 3 185 7 178 8
             C 158 12 116 13 78 12
             C 44 11 12 8 6 5
             C 4 4 4 3 6 2 Z"
          fill="#96B564" stroke="#4E7B36" stroke-width="2.4"/>
    <path d="M18 0 C 58 -7 140 -7 172 1 M24 6 C 64 1 132 1 164 6 M34 -7 C 72 -11 130 -10 158 -6"
          fill="none" stroke="#3E6B2A" stroke-width="2" stroke-linecap="round" opacity=".9"/>
    <path d="M182 3 q8 -3 11 -10 q2 6 -2 11" fill="none" stroke="#4E7B36" stroke-width="3.2" stroke-linecap="round"/>
    <circle cx="7" cy="4" r="2.6" fill="#4E7B36"/>
  </g>

  <!-- chén cà pháo muối: trái trắng ngà có đài xanh -->
  <g>
    <ellipse cx="428" cy="392" rx="40" ry="12" fill="rgba(15,26,14,.3)"/>
    <path d="M394 374 C 396 394 409 404 428 404 C 447 404 460 394 462 374 Z" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2"/>
    <ellipse cx="428" cy="374" rx="34" ry="10" fill="#E9E2CC"/>
    <g>
      <circle cx="414" cy="369" r="9" fill="#F3EFDC" stroke="#D6CBA8" stroke-width="1.8"/>
      <path d="M414 361 l-6 -5 M414 361 l0 -7 M414 361 l6 -5" stroke="#5E8B3A" stroke-width="2.6" stroke-linecap="round"/>
      <circle cx="436" cy="367" r="8" fill="#F6F2E0" stroke="#D6CBA8" stroke-width="1.8"/>
      <path d="M436 360 l-5 -5 M436 360 l0 -6 M436 360 l5 -5" stroke="#5E8B3A" stroke-width="2.4" stroke-linecap="round"/>
      <circle cx="427" cy="377" r="7.5" fill="#EFEAD2" stroke="#D6CBA8" stroke-width="1.6"/>
    </g>
  </g>
  <g transform="translate(376 416)">
    <circle cx="0" cy="0" r="8" fill="#F3EFDC" stroke="#D6CBA8" stroke-width="1.8"/>
    <path d="M0 -7 l-5 -5 M0 -7 l0 -7 M0 -7 l5 -5" stroke="#5E8B3A" stroke-width="2.4" stroke-linecap="round"/>
  </g>
</svg>
