---
/* Phở gà Hà Nội — tô nước vàng nhạt trong ánh mỡ gà; cụm lát gà chặt xếp lớp
   chồng nhau, mép da vàng óng, thịt trắng ngà, lá chanh thái chỉ xanh rắc trên;
   bánh phở trắng + hành chẻ lấp ló; KHÔNG đũa, không quế hồi (khác phở bò);
   đạo cụ: dĩa chanh ớt + nhúm lá chanh */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Tô phở gà nước trong vàng nhẹ, lát gà da vàng óng rắc lá chanh thái chỉ, kèm dĩa chanh ớt">
  <defs>
    <linearGradient id="pgBroth" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#F5DFA6"/><stop offset="1" stop-color="#E3B45E"/>
    </linearGradient>
    <linearGradient id="pgBowl" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#FDFAF0"/><stop offset="1" stop-color="#E9E2CC"/>
    </linearGradient>
    <linearGradient id="pgGa" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#FCF7EA"/><stop offset="1" stop-color="#F0E2C0"/>
    </linearGradient>
  </defs>
  <circle cx="260" cy="240" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="240" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <g class="steam">
    <path d="M192 228 C 181 204 207 188 196 162 C 189 146 203 134 199 118"/>
    <path d="M258 222 C 248 198 274 184 263 158 C 256 142 270 130 266 114"/>
    <path d="M322 230 C 312 206 338 192 327 166 C 320 150 334 138 330 122"/>
  </g>
  <ellipse cx="258" cy="420" rx="196" ry="24" fill="rgba(15,26,14,.35)"/>

  <!-- tô -->
  <path d="M70 296 C 76 370 160 414 258 414 C 356 414 440 370 446 296 Z" fill="url(#pgBowl)"/>
  <ellipse cx="258" cy="412" rx="62" ry="11" fill="#D8D0B6"/>
  <ellipse cx="258" cy="294" rx="188" ry="46" fill="#F6F1E1"/>
  <ellipse cx="258" cy="294" rx="188" ry="46" fill="none" stroke="#2C5234" stroke-width="5"/>
  <ellipse cx="258" cy="295" rx="174" ry="40" fill="none" stroke="#E0A32E" stroke-width="2.5" stroke-dasharray="2 11" stroke-linecap="round"/>

  <!-- nước dùng vàng nhạt trong, lấm tấm mỡ gà -->
  <ellipse cx="258" cy="297" rx="158" ry="33" fill="url(#pgBroth)"/>
  <ellipse cx="188" cy="286" rx="52" ry="9" fill="#F8E7BC" opacity=".6"/>
  <g fill="#F8DF9A" opacity=".95">
    <circle cx="116" cy="294" r="3.4"/><circle cx="152" cy="318" r="2.8"/><circle cx="284" cy="322" r="3"/>
    <circle cx="396" cy="288" r="3"/><circle cx="378" cy="318" r="2.6"/><circle cx="338" cy="272" r="2.4"/>
    <circle cx="204" cy="330" r="2.6"/>
  </g>

  <!-- bánh phở trắng lấp ló -->
  <g fill="none" stroke="#FBF5E3" stroke-width="9" stroke-linecap="round">
    <path d="M116 292 C 146 281 182 281 210 289"/>
    <path d="M132 306 C 162 297 196 297 224 304"/>
    <path d="M344 288 C 368 282 392 283 408 290"/>
    <path d="M196 322 C 224 315 254 315 280 321"/>
    <path d="M296 328 C 318 323 342 323 360 319"/>
  </g>
  <g fill="none" stroke="#E8DDBE" stroke-width="2.4" stroke-linecap="round" opacity=".8">
    <path d="M126 298 C 154 289 186 288 212 295"/>
    <path d="M352 292 C 372 287 392 288 404 292"/>
  </g>

  <!-- LÁT GÀ xếp lợp chồng mí: thịt trắng ngà, dải da vàng óng ôm mép trên -->
  <g transform="rotate(-7 195 295)">
    <rect x="152" y="286" width="88" height="21" rx="4.5" fill="url(#pgGa)" stroke="#B8935A" stroke-width="2"/>
    <path d="M155 286 C 168 280 182 278 196 278 C 210 278 224 280 237 286 L 237 290 C 224 285 210 283 196 283 C 182 283 168 285 155 290 Z" fill="#E29438" stroke="#B07A28" stroke-width="1.5" stroke-linejoin="round"/>
    <path d="M168 296 L 188 300" stroke="#FFF9EC" stroke-width="2.3" stroke-linecap="round"/>
  </g>
  <g transform="rotate(3 270 289)">
    <rect x="218" y="278" width="100" height="23" rx="4.5" fill="url(#pgGa)" stroke="#B8935A" stroke-width="2"/>
    <path d="M221 278 C 236 271.5 252 269.5 268 269.5 C 284 269.5 300 271.5 315 278 L 315 282.5 C 300 277 284 275 268 275 C 252 275 236 277 221 282.5 Z" fill="#E29438" stroke="#B07A28" stroke-width="1.5" stroke-linejoin="round"/>
    <path d="M238 288 L 260 293" stroke="#FFF9EC" stroke-width="2.3" stroke-linecap="round"/>
    <path d="M278 287 L 296 291" stroke="#E7D4A8" stroke-width="1.5" stroke-linecap="round"/>
  </g>
  <g transform="rotate(-8 347 306)">
    <rect x="306" y="296" width="80" height="20" rx="4.5" fill="url(#pgGa)" stroke="#B8935A" stroke-width="2"/>
    <path d="M309 296 C 320 291 332 289 345 289 C 358 289 370 291 381 296 L 381 300 C 370 295.5 358 294 345 294 C 332 294 320 295.5 309 300 Z" fill="#E29438" stroke="#B07A28" stroke-width="1.4" stroke-linejoin="round"/>
    <path d="M322 304 L 340 308" stroke="#FFF9EC" stroke-width="2.1" stroke-linecap="round"/>
  </g>

  <!-- hành chẻ trắng cong lấp ló cạnh gà -->
  <g fill="none" stroke="#F8F1DE" stroke-width="3.2" stroke-linecap="round">
    <path d="M212 318 C 222 309 237 307 246 313"/>
    <path d="M228 326 C 238 317 253 316 262 322"/>
    <path d="M140 318 C 150 310 164 309 172 314"/>
  </g>
  <!-- hành lá xanh (thưa, khác màu lá chanh) -->
  <g stroke="#4E7B36" stroke-width="3.4" stroke-linecap="round" fill="none">
    <path d="M120 284 l11 -3 M398 300 l9 -3"/>
  </g>
  <g fill="#4E7B36">
    <ellipse cx="168" cy="312" rx="6" ry="2.8" transform="rotate(-12 168 312)"/>
  </g>

  <!-- LÁ CHANH THÁI CHỈ: nhúm sợi mảnh xanh đậm rắc TRÊN lát gà -->
  <g stroke="#4F7D18" stroke-width="1.9" stroke-linecap="round" fill="none">
    <g transform="rotate(-12 196 292)">
      <path d="M178 288 l17 -2.5 M180 292.5 l17 -2.5 M183 297 l15 -2 M187 301 l12 -1.5"/>
    </g>
    <g transform="rotate(8 276 286)">
      <path d="M256 283 l19 -3 M258 288 l18 -2.5 M261 293 l16 -2 M265 297.5 l13 -2 M270 301.5 l10 -1.5"/>
    </g>
    <g transform="rotate(-6 348 302)">
      <path d="M334 299 l15 -2 M336 303.5 l14 -2 M339 308 l11 -1.5"/>
    </g>
    <g transform="rotate(10 258 324)">
      <path d="M248 321 l13 -2 M250 325.5 l11 -1.5"/>
    </g>
  </g>

  <!-- dĩa chanh ớt bên trái -->
  <g transform="translate(102 400)">
    <ellipse cx="0" cy="12" rx="54" ry="12" fill="rgba(15,26,14,.3)"/>
    <ellipse cx="0" cy="4" rx="50" ry="14" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2"/>
    <ellipse cx="0" cy="3" rx="38" ry="9.5" fill="#F6F1E1"/>
    <g transform="translate(-20 0)">
      <path d="M-14 4 A15 15 0 0 1 14 4 Z" fill="#E4ECB2" stroke="#9CB25C" stroke-width="2"/>
      <path d="M0 4 0 -9 M0 4 -10 -3 M0 4 10 -3" stroke="#9CB25C" stroke-width="1.4"/>
    </g>
    <path d="M8 0 C 18 -4 28 -2 34 -8" fill="none" stroke="#C94434" stroke-width="6" stroke-linecap="round"/>
    <path d="M34 -10 c 3 -3 6 -4 9 -3" fill="none" stroke="#3E6B2A" stroke-width="3" stroke-linecap="round"/>
    <path d="M4 8 C 13 6 22 7 28 3" fill="none" stroke="#D2542E" stroke-width="5" stroke-linecap="round"/>
  </g>

  <!-- nhúm lá chanh bên phải: hai lá eo thắt + sợi thái chỉ rơi -->
  <g transform="translate(424 390)">
    <ellipse cx="0" cy="20" rx="42" ry="10" fill="rgba(15,26,14,.3)"/>
    <g transform="rotate(-22 0 0)">
      <path d="M0 16 C -10 12 -13 1 -7 -6 C -10 -9 -11 -18 -5 -24 C -2 -28 2 -28 5 -24 C 11 -18 10 -9 7 -6 C 13 1 10 12 0 16 Z" fill="#3E7B3A" stroke="#2C5E2E" stroke-width="1.8"/>
      <path d="M0 14 L 0 -23" stroke="#6FA34F" stroke-width="1.4"/>
    </g>
    <g transform="translate(24 6) rotate(24)">
      <path d="M0 12 C -8 9 -10 0 -5 -5 C -8 -8 -8 -14 -4 -19 C -2 -22 2 -22 4 -19 C 8 -14 8 -8 5 -5 C 10 0 8 9 0 12 Z" fill="#4A8B3E" stroke="#2C5E2E" stroke-width="1.6"/>
      <path d="M0 10 L 0 -18" stroke="#7FB35B" stroke-width="1.3"/>
    </g>
    <g stroke="#8FBC3E" stroke-width="2" stroke-linecap="round" fill="none">
      <path d="M-32 14 l11 -3 M-28 19 l10 -2.5"/>
    </g>
  </g>
</svg>
