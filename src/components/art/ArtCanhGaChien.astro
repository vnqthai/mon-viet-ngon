---
/* Cánh gà chiên nước mắm — nền ĐỎ họ "Lửa", đứng cạnh CHẢ GIÒ (cũng vàng, cũng
   một đống trên dĩa) và GÀ NƯỚNG MẮC KHÉN (cũng gà). Tách bằng cả sắc lẫn dáng:

     chả giò   : ống THẲNG ĐỀU NHAU, dài, vàng NHẠT khô, xếp nối đuôi
     gà nướng  : NGUYÊN CON ép dẹt trên mẹt tre tròn, vàng ruộm khô
     cánh gà   : miếng GẤP KHÚC hình chữ V, ngắn và mập, mỗi miếng một góc,
                 màu CARAMEL SẪM BÓNG (đậm hơn hẳn hai món kia), đầu xương lộ ra

   Thêm hai chữ ký không lẫn được: mảng TỎI PHI vàng rơm lấm tấm khắp mặt, và
   vệt SỐT BÓNG đọng dưới đáy dĩa — chả giò thì khô, không có sốt.

   BẢN 2 — vẽ lại. Bản 1 vẽ mỗi miếng là một khối gấp khúc chữ V rồi rải cách
   nhau, nên Thái xem thấy "không có cánh gà, chỉ thấy mấy cục dài dài lẻ tẻ,
   rời rạc, không cảm nhận được sự giòn". Ba lỗi riêng biệt, chữa từng cái:

     1. KHÔNG RA CÁNH GÀ — khối chữ V là hình tự bịa. Cánh gà chặt ra hai kiểu
        miếng có dáng rất riêng: **TỎI GÀ** (khúc trên, y một cái đùi tí hon:
        khối giọt mập + đầu xương tròn chìa ra) và **CÁNH GIỮA** (khúc giữa, dẹp
        hình thang, chìa **HAI** đầu xương song song ở đầu nhỏ). Vẽ đúng hai dáng
        đó thì mắt đọc ra cánh gà ngay.
     2. RỜI RẠC — chữa như ba hình kia của đợt: một PATH KHỐI LIỀN làm nền đống
        trước, miếng nào cũng chồng mép lên miếng khác.
     3. KHÔNG THẤY GIÒN — cái giòn nằm ở **ĐƯỜNG BAO GỒ GHỀ** chứ không ở màu.
        Mép mỗi miếng gắn một chuỗi cục nhỏ lồi ra (vụn bột chiên), cộng đốm kem
        sáng rắc trên mặt và vệt bóng của lớp sốt kẹo. */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Dĩa cánh gà chiên nước mắm màu caramel bóng, rắc tỏi phi vàng, ớt lát và hành lá">
  <defs>
    <linearGradient id="cgcDa" x1="0.1" y1="0" x2="0.8" y2="1">
      <stop offset="0" stop-color="#D98C2E"/><stop offset="0.6" stop-color="#A85614"/><stop offset="1" stop-color="#6E3206"/>
    </linearGradient>
    <linearGradient id="cgcDa2" x1="0.1" y1="0" x2="0.8" y2="1">
      <stop offset="0" stop-color="#C97B22"/><stop offset="1" stop-color="#5E2A04"/>
    </linearGradient>
    <linearGradient id="cgcSot" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#A05715"/><stop offset="1" stop-color="#6B3206"/>
    </linearGradient>
  </defs>
  <circle cx="260" cy="244" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="244" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <g class="steam">
    <path d="M220 236 C 209 212 235 196 224 170 C 217 154 231 142 227 128"/>
    <path d="M292 230 C 282 206 308 192 297 166 C 290 150 304 138 300 124"/>
  </g>
  <ellipse cx="258" cy="410" rx="192" ry="25" fill="rgba(15,26,14,.35)"/>

  <!-- DĨA NÔNG TRẢI RỘNG (món này chất đống là ỉu, nên vẽ đúng cách dọn) -->
  <path d="M66 320 C 72 374 156 400 258 400 C 360 400 444 374 450 320 Z" fill="#EFE9D6"/>
  <ellipse cx="258" cy="318" rx="192" ry="52" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2"/>
  <ellipse cx="258" cy="318" rx="192" ry="52" fill="none" stroke="#2C5234" stroke-width="4.5"/>
  <ellipse cx="258" cy="319" rx="172" ry="44" fill="none" stroke="#E0A32E" stroke-width="2.4" stroke-dasharray="2 11" stroke-linecap="round"/>

  <!-- VỆT SỐT BÓNG đọng dưới đáy dĩa — chả giò không có thứ này -->
  <ellipse cx="258" cy="330" rx="146" ry="30" fill="url(#cgcSot)" opacity=".9" stroke="#5A2A05" stroke-width="1.8"/>
  <ellipse cx="212" cy="322" rx="44" ry="8" fill="#C9803A" opacity=".55"/>
  <ellipse cx="318" cy="340" rx="34" ry="6" fill="#C9803A" opacity=".4"/>

  <!-- ===== ĐỐNG CÁNH GÀ =====
       Nền đống là MỘT khối liền màu caramel, vẽ trước; mọi miếng nằm đè lên nó
       nên không đâu hở mặt dĩa giữa hai miếng. -->
  <path d="M136 320 C 140 296 168 274 210 262 C 248 251 292 251 330 262
           C 372 274 396 296 398 318 C 400 334 378 344 334 348
           C 288 352 216 352 172 348 C 132 344 134 332 136 320 Z"
        fill="#8E4A12" stroke="#3E1C02" stroke-width="2.6"/>

  <g stroke="#3E1C02" stroke-width="2.6" stroke-linejoin="round">
    <!-- lớp sau -->
    <!-- CÁNH GIỮA: dẹp hình thang, HAI đầu xương song song ở đầu nhỏ -->
    <g transform="translate(196 280) rotate(-16) scale(0.96)">
      <path d="M-44 -6 C -44 -22 -30 -30 -8 -29 C 14 -28 30 -20 34 -8
               C 36 0 34 10 30 16 C 18 26 -8 28 -26 22 C -40 17 -44 8 -44 -6 Z"
            fill="url(#cgcDa)"/>
      <g>
        <rect x="26" y="-13" width="48" height="10" rx="5" fill="#F2E7CC" stroke="#3E1C02" stroke-width="2.2"/>
        <rect x="26" y="3" width="48" height="10" rx="5" fill="#F2E7CC" stroke="#3E1C02" stroke-width="2.2"/>
        <circle cx="74" cy="-8" r="7.4" fill="#F2E7CC" stroke="#3E1C02" stroke-width="2.2"/><circle cx="74" cy="8" r="7.4" fill="#F2E7CC" stroke="#3E1C02" stroke-width="2.2"/>
      </g>
      <!-- vụn bột chiên lồi ra mép: đây là chỗ cho ra CẢM GIÁC GIÒN -->
      <g fill="#C4782A" stroke="#3E1C02" stroke-width="1.8">
        <circle cx="-42" cy="-14" r="4.6"/><circle cx="-30" cy="-26" r="5"/><circle cx="-10" cy="-31" r="4.6"/>
        <circle cx="14" cy="-27" r="4.4"/><circle cx="-38" cy="14" r="4.4"/><circle cx="-20" cy="26" r="4.8"/>
        <circle cx="6" cy="27" r="4.4"/><circle cx="26" cy="20" r="4"/>
      </g>
      <path d="M-34 -12 C -20 -22 6 -23 24 -14" fill="none" stroke="#F6C173" stroke-width="5" stroke-linecap="round" opacity=".85"/>
      <g fill="#FBE6BC" opacity=".9"><circle cx="-16" cy="-6" r="2.6"/><circle cx="6" cy="2" r="2.2"/><circle cx="-28" cy="4" r="2"/></g>
    </g>

    <!-- TỎI GÀ: khối giọt mập, đầu xương tròn chìa ra — dáng "đùi tí hon" -->
    <g transform="translate(300 268) rotate(14) scale(0.96)">
      <g fill="#B6691B" stroke="#3E1C02" stroke-width="1.8">
        <circle cx="-38" cy="-16" r="5"/><circle cx="-22" cy="-31" r="5.4"/><circle cx="2" cy="-35" r="5"/>
        <circle cx="26" cy="-28" r="4.6"/><circle cx="-34" cy="14" r="4.8"/><circle cx="-14" cy="29" r="5"/>
        <circle cx="12" cy="29" r="4.6"/><circle cx="34" cy="16" r="4.2"/>
      </g>
      <path d="M-40 -4 C -40 -24 -24 -34 0 -34 C 24 -34 40 -22 40 -2 C 40 18 24 30 0 30 C -24 30 -40 16 -40 -4 Z"
            fill="url(#cgcDa2)"/>
      <g transform="rotate(-28)">
        <rect x="22" y="-8" width="58" height="16" rx="8" fill="#F2E7CC" stroke="#3E1C02" stroke-width="2.2"/>
        <circle cx="80" cy="-8" r="10" fill="#F2E7CC" stroke="#3E1C02" stroke-width="2.2"/><circle cx="80" cy="8" r="10" fill="#F2E7CC" stroke="#3E1C02" stroke-width="2.2"/>
      </g>
      <path d="M-30 -16 C -16 -28 10 -29 30 -18" fill="none" stroke="#F6C173" stroke-width="5.4" stroke-linecap="round" opacity=".8"/>
      <g fill="#FBE6BC" opacity=".9"><circle cx="-12" cy="-8" r="2.8"/><circle cx="10" cy="4" r="2.4"/><circle cx="-24" cy="8" r="2.2"/></g>
    </g>

    <!-- lớp trước: chồng lên chân đống, bịt kín mép -->
    <g transform="translate(206 324) rotate(6)">
      <g fill="#A85614" stroke="#3E1C02" stroke-width="1.8">
        <circle cx="-40" cy="-13" r="4.6"/><circle cx="-28" cy="-25" r="4.8"/><circle cx="-8" cy="-30" r="4.6"/>
        <circle cx="14" cy="-26" r="4.2"/><circle cx="-36" cy="13" r="4.2"/><circle cx="-18" cy="25" r="4.6"/>
        <circle cx="6" cy="26" r="4.2"/>
      </g>
      <path d="M-42 -6 C -42 -21 -28 -29 -7 -28 C 14 -27 29 -19 33 -8
               C 35 0 33 10 29 15 C 17 25 -8 27 -25 21 C -38 16 -42 8 -42 -6 Z"
            fill="#C4782A"/>
      <g transform="rotate(206)">
        <rect x="22" y="-7.4" width="44" height="9" rx="4.5" fill="#F2E7CC" stroke="#3E1C02" stroke-width="2.2"/>
        <rect x="22" y="2" width="44" height="9" rx="4.5" fill="#F2E7CC" stroke="#3E1C02" stroke-width="2.2"/>
        <circle cx="66" cy="-3" r="7" fill="#F2E7CC" stroke="#3E1C02" stroke-width="2.2"/><circle cx="66" cy="7" r="7" fill="#F2E7CC" stroke="#3E1C02" stroke-width="2.2"/>
      </g>
      <path d="M-32 -11 C -18 -21 6 -22 24 -13" fill="none" stroke="#F9CE86" stroke-width="5" stroke-linecap="round" opacity=".9"/>
      <g fill="#FBE6BC" opacity=".95"><circle cx="-14" cy="-4" r="2.6"/><circle cx="8" cy="4" r="2.2"/></g>
    </g>

    <g transform="translate(310 330) rotate(-12) scale(0.94)">
      <g fill="#C4782A" stroke="#3E1C02" stroke-width="1.8">
        <circle cx="-36" cy="-15" r="4.8"/><circle cx="-20" cy="-30" r="5.2"/><circle cx="2" cy="-34" r="4.8"/>
        <circle cx="25" cy="-27" r="4.4"/><circle cx="-32" cy="13" r="4.6"/><circle cx="-13" cy="28" r="4.8"/>
        <circle cx="12" cy="28" r="4.4"/><circle cx="33" cy="15" r="4"/>
      </g>
      <path d="M-38 -4 C -38 -23 -23 -33 0 -33 C 23 -33 38 -21 38 -2 C 38 17 23 29 0 29 C -23 29 -38 15 -38 -4 Z"
            fill="url(#cgcDa)"/>
      <g transform="rotate(28)">
        <rect x="-80" y="-8" width="56" height="16" rx="8" fill="#F2E7CC" stroke="#3E1C02" stroke-width="2.2"/>
        <circle cx="-78" cy="-8" r="10" fill="#F2E7CC" stroke="#3E1C02" stroke-width="2.2"/><circle cx="-78" cy="8" r="10" fill="#F2E7CC" stroke="#3E1C02" stroke-width="2.2"/>
      </g>
      <path d="M-28 -15 C -14 -27 10 -28 28 -17" fill="none" stroke="#F9CE86" stroke-width="5.4" stroke-linecap="round" opacity=".9"/>
      <g fill="#FBE6BC" opacity=".95"><circle cx="-10" cy="-6" r="2.8"/><circle cx="12" cy="6" r="2.4"/><circle cx="-22" cy="9" r="2.2"/></g>
    </g>

    <!-- một tỏi gà nữa gác trên đỉnh đống cho có tầng -->
    <g transform="translate(256 292) rotate(-4) scale(0.86)">
      <g fill="#B6691B" stroke="#3E1C02" stroke-width="1.8">
        <circle cx="-36" cy="-15" r="4.8"/><circle cx="-20" cy="-30" r="5.2"/><circle cx="2" cy="-34" r="4.8"/>
        <circle cx="25" cy="-27" r="4.4"/><circle cx="-32" cy="13" r="4.6"/><circle cx="-13" cy="28" r="4.8"/>
        <circle cx="14" cy="27" r="4.2"/>
      </g>
      <path d="M-38 -4 C -38 -23 -23 -33 0 -33 C 23 -33 38 -21 38 -2 C 38 17 23 29 0 29 C -23 29 -38 15 -38 -4 Z"
            fill="#D98C2E"/>
      <g transform="rotate(-58)">
        <rect x="22" y="-8" width="54" height="16" rx="8" fill="#F2E7CC" stroke="#3E1C02" stroke-width="2.2"/>
        <circle cx="76" cy="-8" r="10" fill="#F2E7CC" stroke="#3E1C02" stroke-width="2.2"/><circle cx="76" cy="8" r="10" fill="#F2E7CC" stroke="#3E1C02" stroke-width="2.2"/>
      </g>
      <path d="M-28 -15 C -14 -27 10 -28 28 -17" fill="none" stroke="#FBD79A" stroke-width="5.4" stroke-linecap="round" opacity=".95"/>
      <g fill="#FFF3D6" opacity=".95"><circle cx="-10" cy="-6" r="3"/><circle cx="12" cy="6" r="2.6"/></g>
    </g>
  </g>

  <!-- TỎI PHI: vụn vàng rơm lấm tấm khắp mặt đống — chữ ký của món -->
  <g fill="#F0C871" stroke="#C99A38" stroke-width="1.1">
    <path d="M196 262 l7 -2 2 5 -7 2 Z"/><path d="M240 284 l6 -3 3 4 -6 4 Z"/>
    <path d="M290 258 l7 -2 2 5 -7 2 Z"/><path d="M336 288 l6 -3 3 5 -6 3 Z"/>
    <path d="M170 306 l7 -2 2 5 -7 2 Z"/><path d="M266 318 l6 -3 3 4 -6 4 Z"/>
    <path d="M356 316 l7 -3 2 5 -7 3 Z"/><path d="M214 296 l6 -2 2 5 -6 2 Z"/>
    <path d="M312 302 l7 -2 2 4 -7 3 Z"/><path d="M152 288 l6 -3 3 4 -6 4 Z"/>
    <path d="M382 300 l6 -2 2 5 -6 2 Z"/><path d="M228 334 l6 -3 3 4 -6 4 Z"/>
  </g>

  <!-- ỚT LÁT: khoanh có lỗ giữa -->
  <g stroke="#A83722">
    <g transform="translate(236 254)">
      <circle cx="0" cy="0" r="8.6" fill="#D64B33" stroke-width="2"/>
      <circle cx="0" cy="0" r="4.2" fill="#F6C4B0"/>
      <g fill="#E8D9A8"><circle cx="-1.4" cy="-1.2" r="1"/><circle cx="1.6" cy="1" r="1"/></g>
    </g>
    <g transform="translate(340 268)">
      <circle cx="0" cy="0" r="7.6" fill="#E0563C" stroke-width="1.8"/>
      <circle cx="0" cy="0" r="3.6" fill="#F6C4B0"/>
    </g>
    <g transform="translate(180 330)">
      <circle cx="0" cy="0" r="7.2" fill="#D64B33" stroke-width="1.8"/>
      <circle cx="0" cy="0" r="3.4" fill="#F6C4B0"/>
    </g>
  </g>

  <!-- HÀNH LÁ thái nhỏ rắc lên -->
  <g fill="#5E9436" stroke="#3B6520" stroke-width="1.2">
    <rect x="202" y="244" width="17" height="7" rx="3.5" transform="rotate(-18 210 247)"/>
    <rect x="296" y="290" width="16" height="7" rx="3.5" transform="rotate(24 304 293)"/>
    <rect x="248" y="332" width="18" height="7" rx="3.5" transform="rotate(-8 257 335)"/>
    <rect x="354" y="252" width="15" height="6.4" rx="3.2" transform="rotate(12 361 255)"/>
    <rect x="164" y="272" width="16" height="6.6" rx="3.3" transform="rotate(32 172 275)"/>
  </g>

  <!-- CHÉN SỐT MẮM ĐƯỜNG + DƯA LEO, đặt lệch một bên -->
  <g transform="translate(102 372)">
    <ellipse cx="0" cy="17" rx="46" ry="12" fill="rgba(15,26,14,.32)"/>
    <path d="M-38 -7 C -36 12 -21 24 0 24 C 21 24 36 12 38 -7 Z" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2.2"/>
    <ellipse cx="0" cy="-7" rx="31" ry="9.4" fill="#8A4A10" stroke="#5A2A05" stroke-width="1.8"/>
    <ellipse cx="-8" cy="-9" rx="12" ry="3" fill="#C9803A" opacity=".75"/>
    <g fill="#F0C871"><circle cx="10" cy="-6" r="2.6"/><circle cx="-16" cy="-5" r="2.2"/><circle cx="0" cy="-3" r="2"/></g>
  </g>
  <g transform="translate(414 356)">
    <ellipse cx="0" cy="20" rx="46" ry="12" fill="rgba(15,26,14,.3)"/>
    <g stroke="#4E7B36" stroke-width="2">
      <g transform="translate(-20 0) rotate(-16)">
        <ellipse cx="0" cy="0" rx="17" ry="19" fill="#CFE3A8"/>
        <ellipse cx="0" cy="0" rx="11" ry="13" fill="#E6F2CC"/>
        <g fill="#A8C46E"><ellipse cx="-3" cy="-3" rx="2.2" ry="3"/><ellipse cx="3" cy="2" rx="2" ry="2.8"/><ellipse cx="0" cy="6" rx="1.8" ry="2.4"/></g>
      </g>
      <g transform="translate(8 8) rotate(12)">
        <ellipse cx="0" cy="0" rx="16" ry="18" fill="#C6DC9C"/>
        <ellipse cx="0" cy="0" rx="10" ry="12" fill="#E6F2CC"/>
        <g fill="#A8C46E"><ellipse cx="-2" cy="-3" rx="2" ry="2.8"/><ellipse cx="3" cy="3" rx="1.8" ry="2.6"/></g>
      </g>
    </g>
  </g>
</svg>
