---
/* Gỏi ngó sen tôm thịt — hình khó nhất đợt 10: nền XANH LÁ họ "Cuốn & trộn"
   đã có sẵn HAI dĩa gỏi khác, mà gỏi nào cũng là một đống sợi trộn.

     gỏi xoài xanh : sợi MẢNH vàng xanh + tôm khô nhỏ màu cam
     gỏi gà bắp cải: sợi MẢNH trắng ngà + thịt gà xé
     gỏi ngó sen   : KHÚC ỐNG mập, cắt ngang thấy LỖ RỖNG — không phải sợi

   Nên chữ ký ở đây là DÁNG chứ không phải màu: vẽ ngó sen thành những khúc ống
   ngắn, mập, đầu cắt quay ra có mấy cái lỗ tròn. Cộng thêm hai thứ không dĩa
   gỏi nào khác có: NỬA CON TÔM chẻ dọc nằm ngửa trên mặt (to, đỏ, cong), và
   đạo cụ BÁNH PHỒNG TÔM — miếng tròn phồng rỗ dựng ở mép dĩa.

   BẢN 2 — sửa bố cục. Bản 1 rải từng khúc ngó sen nằm rời trên mặt dĩa và đặt
   bánh phồng tôm ĐỐI XỨNG hai bên, nên Thái xem thấy "rời rạc, mảnh này mảnh
   kia, không giống một món ăn thống nhất, mà đối xứng hai bên nhìn kỳ".

   Chữa theo đúng cách hai dĩa gỏi kia làm: **một PATH KHỐI LIỀN vun thành gò
   trước, rồi mới vẽ khúc ngó sen ĐÈ LÊN mặt gò** — không đâu hở nền, và cả dĩa
   có một khối duy nhất để mắt bám vào. Bánh phồng tôm còn MỘT miếng, đặt lệch
   một bên. */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Dĩa gỏi ngó sen với khúc ngó sen trắng ngà cắt ngang thấy lỗ rỗng, nửa con tôm chẻ dọc màu đỏ cam, lát thịt ba chỉ, rau răm, đậu phộng và bánh phồng tôm">
  <defs>
    <linearGradient id="gnsTom" x1="0" y1="0" x2="0.4" y2="1">
      <stop offset="0" stop-color="#F4855C"/><stop offset="1" stop-color="#C9462A"/>
    </linearGradient>
    <linearGradient id="gnsOng" x1="0" y1="0" x2="0.3" y2="1">
      <stop offset="0" stop-color="#FBF5E4"/><stop offset="1" stop-color="#E2D8BC"/>
    </linearGradient>
  </defs>
  <circle cx="260" cy="244" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="244" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <ellipse cx="258" cy="408" rx="196" ry="25" fill="rgba(15,26,14,.35)"/>

  <!-- DĨA NÔNG TRẢI RỘNG — gỏi phải bày trải chứ không chất đống -->
  <path d="M64 318 C 70 372 154 398 258 398 C 362 398 446 372 452 318 Z" fill="#EFE9D6"/>
  <ellipse cx="258" cy="316" rx="194" ry="52" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2"/>
  <ellipse cx="258" cy="316" rx="194" ry="52" fill="none" stroke="#2C5234" stroke-width="4.5"/>
  <ellipse cx="258" cy="317" rx="174" ry="44" fill="none" stroke="#E0A32E" stroke-width="2.4" stroke-dasharray="2 11" stroke-linecap="round"/>

  <!-- ===== GÒ GỎI: MỘT KHỐI LIỀN vun cao, vẽ trước mọi thứ khác =====
       Đây là chỗ chữa gốc của bản 2. Khối này lấp kín lòng dĩa nên khúc ngó sen,
       lát thịt và con tôm nằm trên đều dính vào một đống, không miếng nào lơ lửng. -->
  <ellipse cx="256" cy="322" rx="132" ry="24" fill="#8A7A46" opacity=".3"/>
  <path d="M132 320
           C 136 296 156 268 190 250
           C 214 237 236 232 256 232
           C 280 232 306 240 328 258
           C 352 277 366 300 372 318
           C 375 330 362 337 330 340
           C 292 344 210 344 176 340
           C 146 337 130 330 132 320 Z"
        fill="#EEE5C8" stroke="#C6B78C" stroke-width="2.4"/>
  <!-- vệt bóng trong gò cho ra chiều sâu, không phải một mảng phẳng -->
  <path d="M150 318 C 156 296 178 272 206 258 C 186 282 170 306 164 330 C 152 328 148 324 150 318 Z"
        fill="#FBF6E6" opacity=".9"/>
  <path d="M346 316 C 344 296 330 274 310 258 C 332 278 348 302 354 326 C 350 324 346 322 346 316 Z"
        fill="#D6C79C" opacity=".8"/>

  <!-- KHÚC NGÓ SEN đè lên mặt gò: nằm theo sườn gò, khúc nào cũng chạm khúc khác.
       Đầu cắt quay ra ngoài có mấy LỖ TRÒN — chỗ nhận ra ngó sen chứ không phải sợi. -->
  <g stroke="#B9AC85" stroke-width="2" stroke-linejoin="round">
    <!-- hàng chân gò, chìa ra mép -->
    <g transform="translate(158 322) rotate(-14)">
      <rect x="-44" y="-11" width="88" height="22" rx="11" fill="url(#gnsOng)"/>
      <ellipse cx="-44" cy="0" rx="7" ry="11" fill="#EDE4C8" stroke="#B9AC85" stroke-width="1.8"/>
      <g fill="#C4B48A"><circle cx="-44" cy="-4" r="2"/><circle cx="-45" cy="2" r="2.2"/><circle cx="-42" cy="6" r="1.6"/></g>
    </g>
    <g transform="translate(352 324) rotate(11)">
      <rect x="-44" y="-11" width="88" height="22" rx="11" fill="#F6EFDA"/>
      <ellipse cx="44" cy="0" rx="7" ry="11" fill="#EDE4C8" stroke="#B9AC85" stroke-width="1.8"/>
      <g fill="#C4B48A"><circle cx="44" cy="-4" r="2"/><circle cx="45" cy="2" r="2.2"/><circle cx="42" cy="6" r="1.6"/></g>
    </g>
    <g transform="translate(254 334) rotate(-3)">
      <rect x="-48" y="-11" width="96" height="22" rx="11" fill="url(#gnsOng)"/>
      <ellipse cx="48" cy="0" rx="7" ry="11" fill="#EDE4C8" stroke="#B9AC85" stroke-width="1.8"/>
      <g fill="#C4B48A"><circle cx="48" cy="-4" r="2"/><circle cx="49" cy="2" r="2.2"/><circle cx="46" cy="6" r="1.6"/></g>
    </g>
    <!-- hàng giữa, chồng lên hàng chân -->
    <g transform="translate(196 296) rotate(-30)">
      <rect x="-40" y="-10" width="80" height="20" rx="10" fill="#F6EFDA"/>
      <ellipse cx="-40" cy="0" rx="6.4" ry="10" fill="#EDE4C8" stroke="#B9AC85" stroke-width="1.7"/>
      <g fill="#C4B48A"><circle cx="-40" cy="-3.4" r="1.9"/><circle cx="-41" cy="2" r="2"/></g>
    </g>
    <g transform="translate(318 292) rotate(32)">
      <rect x="-38" y="-10" width="76" height="20" rx="10" fill="url(#gnsOng)"/>
      <ellipse cx="38" cy="0" rx="6.4" ry="10" fill="#EDE4C8" stroke="#B9AC85" stroke-width="1.7"/>
      <g fill="#C4B48A"><circle cx="38" cy="-3.4" r="1.9"/><circle cx="39" cy="2" r="2"/></g>
    </g>
    <g transform="translate(258 306) rotate(6)">
      <rect x="-42" y="-10" width="84" height="20" rx="10" fill="#FBF5E4"/>
      <ellipse cx="-42" cy="0" rx="6.4" ry="10" fill="#EDE4C8" stroke="#B9AC85" stroke-width="1.7"/>
      <g fill="#C4B48A"><circle cx="-42" cy="-3.4" r="1.9"/><circle cx="-43" cy="2" r="2"/></g>
    </g>
    <!-- đỉnh gò -->
    <g transform="translate(232 266) rotate(-16)">
      <rect x="-34" y="-9.4" width="68" height="19" rx="9.4" fill="url(#gnsOng)"/>
      <ellipse cx="34" cy="0" rx="6" ry="9.4" fill="#EDE4C8" stroke="#B9AC85" stroke-width="1.6"/>
      <g fill="#C4B48A"><circle cx="34" cy="-3" r="1.8"/><circle cx="35" cy="2" r="1.8"/></g>
    </g>
    <g transform="translate(298 258) rotate(18)">
      <rect x="-32" y="-9" width="64" height="18" rx="9" fill="#F6EFDA"/>
      <ellipse cx="-32" cy="0" rx="5.8" ry="9" fill="#EDE4C8" stroke="#B9AC85" stroke-width="1.6"/>
      <g fill="#C4B48A"><circle cx="-32" cy="-3" r="1.7"/><circle cx="-33" cy="2" r="1.8"/></g>
    </g>
  </g>

  <!-- LÁT THỊT BA CHỈ: nhét vào sườn gò, có vằn nạc mỡ -->
  <g stroke="#9A6448" stroke-width="1.8" stroke-linejoin="round">
    <g transform="translate(198 318) rotate(-18)">
      <path d="M-30 -12 C -12 -16 14 -16 30 -11 C 32 -4 32 5 30 11 C 12 16 -14 16 -30 12 Z" fill="#E7C0A6"/>
      <path d="M-26 -4 C -8 -8 12 -8 26 -4" fill="none" stroke="#FBEDDF" stroke-width="4"/>
      <path d="M-26 5 C -8 2 12 2 26 5" fill="none" stroke="#C98A6C" stroke-width="2.6"/>
    </g>
    <g transform="translate(316 316) rotate(16)">
      <path d="M-28 -11 C -11 -15 13 -15 28 -10 C 30 -4 30 5 28 10 C 11 15 -13 15 -28 11 Z" fill="#E3B99E"/>
      <path d="M-24 -4 C -7 -7 11 -7 24 -4" fill="none" stroke="#FBEDDF" stroke-width="3.6"/>
      <path d="M-24 4 C -7 2 11 2 24 4" fill="none" stroke="#C98A6C" stroke-width="2.4"/>
    </g>
  </g>

  <!-- TÔM LUỘC nằm trên sườn gò. Bản 1 vẽ nửa con tôm thành hình chữ C rỗng
       ruột dựng đứng → đọc ra hai cái MÓC ĐỎ, mà lại đặt cân đối như hai cái
       tai. Vẽ lại thành thân tôm CONG ĐẶC có KHÍA ĐỐT sáng và đuôi xòe — dáng
       này mắt đọc ra "con tôm" ngay — rồi đặt hai con LỆCH HẲN nhau về cả cỡ,
       góc và độ cao. -->
  <g stroke="#8E2E1B" stroke-width="2.2" stroke-linejoin="round">
    <g transform="translate(224 258) rotate(-24)">
      <path d="M-30 -16 C -8 -26 20 -20 30 -2 C 38 14 30 30 14 32 C 0 34 -10 26 -12 14
               C -4 20 6 18 8 8 C 10 -4 0 -12 -14 -10 C -24 -8 -30 -12 -30 -16 Z"
            fill="url(#gnsTom)"/>
      <g stroke="#FBD9C4" stroke-width="3.4" fill="none" stroke-linecap="round" opacity=".95">
        <path d="M-16 -14 C -12 -6 -12 2 -16 8"/>
        <path d="M0 -18 C 6 -8 6 4 0 14"/>
        <path d="M14 -14 C 22 -4 22 10 14 22"/>
        <path d="M26 -2 C 32 6 32 16 26 24"/>
      </g>
      <path d="M-30 -16 C -38 -22 -46 -22 -50 -16 C -44 -12 -36 -12 -30 -16 Z" fill="#E0563C"/>
      <path d="M14 32 L 22 44 L 8 42 L 12 32 Z" fill="#E0563C"/>
    </g>
    <g transform="translate(310 288) rotate(34) scale(0.82)">
      <path d="M-30 -16 C -8 -26 20 -20 30 -2 C 38 14 30 30 14 32 C 0 34 -10 26 -12 14
               C -4 20 6 18 8 8 C 10 -4 0 -12 -14 -10 C -24 -8 -30 -12 -30 -16 Z"
            fill="#EE6E45"/>
      <g stroke="#FBD9C4" stroke-width="3.6" fill="none" stroke-linecap="round" opacity=".95">
        <path d="M-16 -14 C -12 -6 -12 2 -16 8"/>
        <path d="M0 -18 C 6 -8 6 4 0 14"/>
        <path d="M14 -14 C 22 -4 22 10 14 22"/>
      </g>
      <path d="M-30 -16 C -38 -22 -46 -22 -50 -16 C -44 -12 -36 -12 -30 -16 Z" fill="#E0563C"/>
      <path d="M14 32 L 22 44 L 8 42 L 12 32 Z" fill="#E0563C"/>
    </g>
  </g>

  <!-- RAU RĂM rắc trên gò -->
  <g fill="#3F6A28" stroke="#2E5220" stroke-width="1.4">
    <path d="M172 262 C 180 252 194 248 202 252 C 196 262 182 266 172 262 Z" transform="rotate(-26 187 257)"/>
    <path d="M336 268 C 344 258 358 255 366 259 C 360 269 346 272 336 268 Z" transform="rotate(16 351 263)"/>
    <path d="M250 330 C 258 320 272 317 280 321 C 274 331 260 334 250 330 Z" transform="rotate(-8 265 325)"/>
    <path d="M158 300 C 166 290 180 287 188 291 C 182 301 168 304 158 300 Z" transform="rotate(24 173 295)"/>
    <path d="M330 300 C 338 290 352 287 360 291 C 354 301 340 304 330 300 Z" transform="rotate(-18 345 295)"/>
  </g>

  <!-- ĐẬU PHỘNG GIÃ + HÀNH PHI rắc trên cùng: hạt méo mó, cố ý không tròn đều -->
  <g fill="#D8A25A" stroke="#A8763A" stroke-width="1.2">
    <path d="M200 280 l7 -3 4 5 -6 4 Z"/><path d="M254 268 l8 -2 2 6 -7 2 Z"/>
    <path d="M300 282 l6 -4 5 4 -5 5 Z"/><path d="M336 306 l7 -2 3 5 -7 3 Z"/>
    <path d="M186 308 l6 -3 4 4 -6 4 Z"/><path d="M272 314 l7 -3 3 5 -7 3 Z"/>
    <path d="M232 296 l6 -3 4 5 -6 3 Z"/>
  </g>
  <g fill="#E8B96A" opacity=".95">
    <ellipse cx="212" cy="256" rx="7" ry="2.6" transform="rotate(-20 212 256)"/>
    <ellipse cx="288" cy="276" rx="6.4" ry="2.4" transform="rotate(24 288 276)"/>
    <ellipse cx="322" cy="322" rx="6.8" ry="2.5" transform="rotate(-12 322 322)"/>
    <ellipse cx="180" cy="330" rx="6.6" ry="2.4" transform="rotate(14 180 330)"/>
  </g>

  <!-- MỘT miếng BÁNH PHỒNG TÔM, đặt LỆCH một bên (bản 1 kê hai miếng đối xứng
       hai bên, Thái nhận xét "nhìn kỳ"). Miếng tròn cong vênh, mép lượn sóng,
       mặt rỗ lỗ khí. -->
  <g transform="translate(410 300) rotate(20)">
    <path d="M0 -58 C 26 -60 46 -44 50 -20 C 54 4 40 26 18 32 C -4 38 -28 28 -38 8 C -48 -12 -40 -38 -20 -50 C -14 -54 -7 -57 0 -58 Z"
          fill="#FBEEDC" stroke="#DCC49C" stroke-width="2.6"/>
    <path d="M0 -50 C 20 -51 36 -38 39 -19 C 42 0 31 18 14 23" fill="none" stroke="#FFF8EC" stroke-width="3" opacity=".9"/>
    <g fill="#E8D4B4" opacity=".95">
      <circle cx="-14" cy="-30" r="5.4"/><circle cx="8" cy="-36" r="4.2"/><circle cx="22" cy="-16" r="5"/>
      <circle cx="-2" cy="-12" r="6"/><circle cx="-24" cy="-6" r="4.4"/><circle cx="12" cy="8" r="4.8"/>
      <circle cx="-12" cy="16" r="3.6"/><circle cx="30" cy="-32" r="3"/>
    </g>
  </g>
</svg>
