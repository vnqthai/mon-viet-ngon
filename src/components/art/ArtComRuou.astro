---
/* Cơm rượu — VẬT ĐỰNG là HŨ THUỶ TINH MIỆNG RỘNG, dáng thấp và bè. Luật đợt 13
   rút ra từ bộ năm món chè: cùng một kiểu món thì phải khác nhau ở DÁNG VẬT
   ĐỰNG trước đã. Năm hình chè đang có: ly cao thẳng (chè bưởi) · tô rộng nông
   (bà ba) · chén có chân đế (chè Thái) · tô sâu lòng (đậu xanh bột báng) · ly
   miệng loe (đậu đỏ). Cái hũ bè có nắp là dáng thứ SÁU, chưa đụng cái nào.
   Cũng đúng với món: cơm rượu ủ và giữ trong hũ, không dọn sẵn ra ly.

   CHỮ KÝ nhận dạng:
   1) VIÊN NẾP TRÒN TRẮNG NGÀ, mặt lấm tấm hạt nếp.
      BẢN 1 QUẤN MỘT DẢI LÁ CHUỐI XANH quanh mỗi viên — THÁI TRẢ LẠI: "cơm rượu
      đâu có màu xanh lá trong món ăn". Đúng: lá chuối là thứ dùng lúc Ủ, tới
      lúc múc ra ăn thì đã bỏ đi; vẽ nó vào hũ là bịa một màu không có thật.
      Đã bỏ sạch màu xanh khỏi khung. Thứ giữ cho viên trắng khỏi đọc thành
      trứng luộc nay là MẶT LẤM TẤM HẠT NẾP + cái hũ làm ngữ cảnh
   2) NƯỚC trong hũ VÀNG NHẠT TRONG, ngập tới nửa viên — nửa trên viên nhô lên
      khỏi mặt nước, thấy rõ ranh giới
   3) MẶT VIÊN lấm tấm HẠT NẾP nhô ra khỏi đường bao, không nhẵn thín (luật xôi
      xéo đợt 12: gò nhẵn thì đọc ra quả)
   4) đạo cụ: hai viên rời trên MIẾNG LÁ CHUỐI + một VIÊN MEN trắng ngà dẹt —
      viên men nói ra chuyện ủ, thứ không hình chè nào có
   Không vẽ khói, không vẽ muỗng cắm trong hũ: món ăn lạnh, và muỗng cắm đứng
   giữa hũ nhìn ra là giả (Thái đã trả lại chè bưởi vì đúng lỗi này).
   id prefix "cruo" */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Hũ thuỷ tinh miệng rộng đựng cơm rượu: những viên nếp trắng ngà ngâm nửa chừng trong nước vàng nhạt, bên cạnh là hai viên rời trên dĩa nhỏ và một viên men">
  <defs>
    <linearGradient id="cruoGlass" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="rgba(255,255,255,.30)"/>
      <stop offset="0.42" stop-color="rgba(255,255,255,.07)"/>
      <stop offset="1" stop-color="rgba(255,255,255,.24)"/>
    </linearGradient>
    <linearGradient id="cruoNuoc" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#E8D48E"/><stop offset="1" stop-color="#C7A551"/>
    </linearGradient>

    <!-- VIÊN CƠM RƯỢU: khối tròn hơi méo, mặt lấm tấm hạt nếp nhô ra đường bao,
         quấn một dải lá chuối ngang thân -->
    <g id="cruoVien">
      <path d="M-2 -27 C 14 -29 29 -19 31 -5 C 33 10 22 25 4 27 C -14 29 -30 19 -32 4
               C -34 -12 -18 -25 -2 -27 Z" fill="#FBF6E8" stroke="#BCAE8C" stroke-width="2.4" stroke-linejoin="round"/>
      <!-- hạt nếp: chỉ GỢN NHẸ ở đường bao. Bản 1 vẽ hạt to nhô hẳn ra như xôi
           xéo — ở 260px cả viên đọc ra BỎNG NGÔ / bông cải. Viên cơm rượu là
           nắm xôi VO CHẶT, mặt phải gần nhẵn, chỉ lấm tấm hạt. -->
      <g fill="#FDFAF0" stroke="#C4B694" stroke-width="1">
        <ellipse cx="-14" cy="-27" rx="4.4" ry="2.6" transform="rotate(-24 -14 -27)"/>
        <ellipse cx="6" cy="-30" rx="4.6" ry="2.7" transform="rotate(8 6 -30)"/>
        <ellipse cx="25" cy="-15" rx="4.2" ry="2.5" transform="rotate(-52 25 -15)"/>
        <ellipse cx="-30" cy="-7" rx="4.2" ry="2.4" transform="rotate(66 -30 -7)"/>
        <ellipse cx="29" cy="9" rx="4.2" ry="2.4" transform="rotate(56 29 9)"/>
        <ellipse cx="-21" cy="21" rx="4.4" ry="2.6" transform="rotate(30 -21 21)"/>
        <ellipse cx="6" cy="28" rx="4.6" ry="2.6" transform="rotate(-8 6 28)"/>
      </g>
      <!-- VÂN HẠT NẾP: mấy vệt ngắn rời rạc khắp mặt viên. Bản 2 chỉ có ba nét
           cong dài song song nên viên đọc ra TÉP TỎI; vệt ngắn rải lệch thì ra
           nắm nếp vo. -->
      <g fill="none" stroke="#D6C8A2" stroke-width="1.6" stroke-linecap="round">
        <path d="M-18 -12 C -13 -16 -7 -16 -3 -14"/>
        <path d="M4 -18 C 9 -20 14 -19 17 -16"/>
        <path d="M-22 -1 C -17 -4 -11 -4 -7 -2"/>
        <path d="M2 -5 C 8 -8 15 -7 19 -4"/>
        <path d="M-16 11 C -11 8 -5 8 -1 10"/>
        <path d="M6 14 C 11 11 17 12 20 15"/>
        <path d="M-8 3 C -3 0 3 1 6 3"/>
      </g>
      <path d="M-22 -19 C -12 -26 2 -27 14 -22" fill="none" stroke="#FFFFFF" stroke-width="2.4" stroke-linecap="round" opacity=".85"/>
      <!-- vệt bóng ngang thân cho viên khỏi phẳng lì (chỗ trước đây là dải lá chuối) -->
      
    </g>
  </defs>

  <circle cx="260" cy="240" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="240" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>

  <ellipse cx="248" cy="404" rx="184" ry="24" fill="rgba(20,10,28,.42)"/>

  <!-- HŨ THUỶ TINH: miệng rộng, thân thấp và bè, chân hơi thóp -->
  <path d="M120 176 L 122 348 C 122 380 174 398 244 398 C 314 398 366 380 366 348 L 368 176 Z"
        fill="rgba(255,255,255,.10)"/>
  <path d="M120 176 L 122 348 C 122 380 174 398 244 398 C 314 398 366 380 366 348 L 368 176 Z"
        fill="url(#cruoGlass)" stroke="rgba(255,255,255,.5)" stroke-width="3"/>

  <!-- NƯỚC trong hũ, mặt nước ngang giữa thân -->
  <path d="M126 268 L 127 348 C 127 376 176 392 244 392 C 312 392 361 376 361 348 L 362 268 Z" fill="url(#cruoNuoc)"/>
  <ellipse cx="244" cy="268" rx="118" ry="26" fill="#F0DDA0"/>
  <ellipse cx="244" cy="268" rx="118" ry="26" fill="none" stroke="#C7A551" stroke-width="2.4"/>
  <g fill="#FBEFC4" opacity=".75">
    <ellipse cx="186" cy="264" rx="30" ry="6"/>
    <circle cx="300" cy="276" r="3.4"/><circle cx="152" cy="290" r="3"/><circle cx="332" cy="316" r="2.8"/>
  </g>

  <!-- VIÊN CƠM RƯỢU trong hũ: hàng dưới chìm trong nước, hàng trên nhô lên -->
  <use href="#cruoVien" transform="translate(172 320) rotate(-8) scale(.96)"/>
  <use href="#cruoVien" transform="translate(238 336) rotate(6) scale(1.04)"/>
  <use href="#cruoVien" transform="translate(310 318) rotate(-4) scale(.94)"/>
  <use href="#cruoVien" transform="translate(196 268) rotate(11) scale(1.06)"/>
  <use href="#cruoVien" transform="translate(268 276) rotate(-13) scale(1)"/>
  <use href="#cruoVien" transform="translate(324 254) rotate(5) scale(.88)"/>
  <use href="#cruoVien" transform="translate(232 222) rotate(-6) scale(.92)"/>

  <!-- ánh sáng dọc trên mặt kính, vẽ sau cùng để nằm trên đám viên -->
  <path d="M142 190 C 138 250 140 320 150 352" fill="none" stroke="rgba(255,255,255,.45)" stroke-width="8" stroke-linecap="round"/>
  <path d="M348 194 C 352 250 350 316 342 346" fill="none" stroke="rgba(255,255,255,.22)" stroke-width="5" stroke-linecap="round"/>

  <!-- MIỆNG HŨ + NẮP hé: vành dày, nắp gác lệch một bên -->
  <ellipse cx="244" cy="176" rx="124" ry="30" fill="rgba(255,255,255,.16)" stroke="rgba(255,255,255,.55)" stroke-width="3.4"/>
  <ellipse cx="244" cy="176" rx="108" ry="24" fill="none" stroke="rgba(255,255,255,.3)" stroke-width="2.4"/>
  <g transform="translate(352 148) rotate(24)">
    <ellipse cx="0" cy="10" rx="62" ry="16" fill="#8E7A50"/>
    <ellipse cx="0" cy="4" rx="62" ry="16" fill="#D9C7A2" stroke="#8E7A50" stroke-width="2.6"/>
    <ellipse cx="0" cy="2" rx="46" ry="11" fill="#EFE2C4"/>
    <path d="M-34 -2 C -20 -8 18 -8 32 -2" fill="none" stroke="#FFFDF4" stroke-width="2.6" stroke-linecap="round" opacity=".6"/>
  </g>

  <!-- ĐẠO CỤ: hai viên rời trên dĩa sứ nhỏ + một viên men dẹt -->
  <g transform="translate(102 398)">
    <ellipse cx="8" cy="26" rx="70" ry="14" fill="rgba(20,10,28,.36)"/>
    <ellipse cx="8" cy="12" rx="66" ry="18" fill="#FDFAF0" stroke="#CFC3A4" stroke-width="2.4"/>
    <ellipse cx="8" cy="10" rx="50" ry="12" fill="#F2EAD4"/>
    <use href="#cruoVien" transform="translate(-8 0) rotate(-10) scale(.72)"/>
    <use href="#cruoVien" transform="translate(42 6) rotate(14) scale(.62)"/>
  </g>
  <g transform="translate(432 386) rotate(-12)">
    <ellipse cx="0" cy="16" rx="30" ry="8" fill="rgba(20,10,28,.34)"/>
    <ellipse cx="0" cy="0" rx="28" ry="18" fill="#F0E6CE" stroke="#B8A87E" stroke-width="2.4"/>
    <ellipse cx="-2" cy="-3" rx="19" ry="11" fill="#FBF6E8"/>
    <g fill="#D8C9A4">
      <circle cx="-9" cy="-2" r="2.6"/><circle cx="5" cy="-6" r="2.2"/><circle cx="9" cy="3" r="2"/>
    </g>
  </g>
</svg>
