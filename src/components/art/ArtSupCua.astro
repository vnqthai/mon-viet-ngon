---
/* Súp cua — vào họ teal, nơi 18/18 Món nước dùng CHUNG MỘT KHUÔN ("tô trắng vành
   xanh, nhìn chếch từ trên, đạo cụ dưới chân"). Bốn chỗ cố ý phá:
   1) VẬT ĐỰNG: chén súp DÀY CÓ QUAI hình chữ C — không tô nào trên site có quai.
      Quai nằm gọn trong khoảng 20…500 (luật đợt 14 về cán chìa ra khỏi khung)
   2) MẶT MÓN KÍN MÍT: súp sánh phủ kín, KHÔNG nhìn thấy sợi và nước — 18 tô kia
      tô nào cũng khoe sợi bún/phở/miến nổi trong nước trong
   3) MÀU LẠ: mấy múi TRỨNG BẮC THẢO nâu đen — không tô nào có mảng đen
   4) ĐẠO CỤ: dĩa quẩy cắt khoanh + lọ tiêu (tránh dĩa chanh ớt / hũ hành phi)
   Thớ cua vẽ thành DẢI CÓ SỚ dọc, không vẽ thành cục — cua xé ra là có thớ.
   id prefix "scu" */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Chén súp cua sánh đặc có quai, trên mặt là thớ cua trắng, vân trứng và mấy múi trứng bắc thảo, bên cạnh có dĩa quẩy cắt khoanh và lọ tiêu">
  <defs>
    <linearGradient id="scuCup" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#FDFAF0"/><stop offset="1" stop-color="#E4DCC4"/>
    </linearGradient>
    <linearGradient id="scuSoup" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#EBCB84"/><stop offset="1" stop-color="#D5AC57"/>
    </linearGradient>
    <!-- THỚ CUA: bản 1 vẽ nhỏ quá, Thái bảo "nên có miếng cua và làm cho mấy
         miếng cua này bự ra". Bản 2 phóng to gấp rưỡi, dày hơn, sớ dọc rõ,
         một mép ửng hồng cam — đó là dấu của thịt cua chứ không phải thịt gà.
         MÀU: thân trắng ngà #F6EDDA, sớ #E5D2A8, mép ửng #E09A6A -->
    <g id="scuCrab">
      <path d="M0 0 C 8 -8 22 -7 34 -10 C 45 -13 54 -10 57 -5 C 60 1 56 6 48 8
               C 36 11 22 10 11 13 C 4 15 -2 11 -1 5 Z"
            fill="#F6EDDA" stroke="#C9B189" stroke-width="2"/>
      <path d="M6 3 C 18 -1 32 -3 48 -5" fill="none" stroke="#E5D2A8" stroke-width="1.9" stroke-linecap="round"/>
      <path d="M9 8 C 22 4 36 2 50 1" fill="none" stroke="#E09A6A" stroke-width="2.4" stroke-linecap="round"/>
      <path d="M4 -1 C 16 -6 30 -8 44 -9" fill="none" stroke="#FDF8EC" stroke-width="1.7" stroke-linecap="round"/>
    </g>

    <!-- CÀNG CUA đỏ cam: hai ngàm hé mở, thân có đốt -->
    <g id="scuClaw">
      <path d="M0 0 C -6 -10 -2 -22 10 -26 C 24 -31 40 -24 44 -12 C 47 -3 42 6 32 8
               C 20 11 6 8 0 0 Z" fill="#E2603C" stroke="#9E2E14" stroke-width="2.6" stroke-linejoin="round"/>
      <path d="M40 -18 C 52 -26 66 -25 72 -17 C 64 -12 50 -10 40 -14 Z"
            fill="#C94526" stroke="#9E2E14" stroke-width="2.4" stroke-linejoin="round"/>
      <path d="M42 -8 C 54 -6 66 -9 72 -15 C 68 -4 54 2 42 -2 Z"
            fill="#E2603C" stroke="#9E2E14" stroke-width="2.4" stroke-linejoin="round"/>
      <g fill="none" stroke="#F6C0A4" stroke-width="2.2" stroke-linecap="round">
        <path d="M8 -16 C 16 -22 26 -23 34 -19"/>
        <path d="M4 -6 C 12 -10 22 -11 30 -8"/>
      </g>
      <path d="M-2 2 L -14 10 L -8 14 L 2 8 Z" fill="#B33A1E" stroke="#8A2410" stroke-width="1.8"/>
    </g>

    <!-- CON CUA NHỎ làm đạo cụ: mai bầu, hai càng, tám chân -->
    <g id="scuCrabWhole">
      <g fill="none" stroke="#B33A1E" stroke-width="3.4" stroke-linecap="round">
        <path d="M-26 6 L -44 14 M -24 12 L -40 24 M -20 17 L -32 31"/>
        <path d="M26 6 L 44 14 M 24 12 L 40 24 M 20 17 L 32 31"/>
      </g>
      <path d="M-30 -4 C -30 -18 -14 -27 0 -27 C 14 -27 30 -18 30 -4 C 30 10 15 20 0 20 C -15 20 -30 10 -30 -4 Z"
            fill="#D8552C" stroke="#8E2410" stroke-width="2.8"/>
      <path d="M-20 -10 C -12 -17 12 -17 20 -10" fill="none" stroke="#F0906A" stroke-width="2.6" stroke-linecap="round"/>
      <g fill="#3A1206"><circle cx="-9" cy="-3" r="2.6"/><circle cx="9" cy="-3" r="2.6"/></g>
      <path d="M-8 8 C -3 12 3 12 8 8" fill="none" stroke="#8E2410" stroke-width="2" stroke-linecap="round"/>
      <!-- hai càng chìa ra trước -->
      <path d="M-28 -8 C -42 -14 -50 -26 -44 -34 C -36 -38 -26 -30 -24 -18 Z" fill="#E2603C" stroke="#8E2410" stroke-width="2.4"/>
      <path d="M28 -8 C 42 -14 50 -26 44 -34 C 36 -38 26 -30 24 -18 Z" fill="#E2603C" stroke="#8E2410" stroke-width="2.4"/>
    </g>
  </defs>

  <circle cx="260" cy="240" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="240" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <g class="steam">
    <path d="M214 200 C 203 176 229 160 218 134 C 211 118 225 106 221 92"/>
    <path d="M264 192 C 254 168 280 154 269 128 C 262 112 276 100 272 86"/>
    <path d="M312 202 C 302 180 326 166 316 142 C 309 126 322 114 319 100"/>
  </g>
  <ellipse cx="250" cy="420" rx="188" ry="23" fill="rgba(15,26,14,.35)"/>

  <!-- ĐẠO CỤ TRÁI: CON CUA NHỎ — nói ngay ra "đây là món cua" (Thái đề nghị) -->
  <g transform="translate(80 388) rotate(-8)">
    <ellipse cx="0" cy="34" rx="46" ry="11" fill="rgba(15,26,14,.3)"/>
    <use href="#scuCrabWhole" transform="scale(1.06)"/>
  </g>

  <!-- ĐẠO CỤ PHẢI: dĩa quẩy cắt khoanh (rỗ lỗ bên trong mặt cắt) -->
  <g transform="translate(424 392)">
    <ellipse cx="0" cy="18" rx="56" ry="14" fill="rgba(15,26,14,.3)"/>
    <ellipse cx="0" cy="6" rx="52" ry="15" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2"/>
    <ellipse cx="0" cy="5" rx="38" ry="9.5" fill="#F6F1E1"/>
    <g>
      <g transform="translate(-24 0) rotate(-14)">
        <ellipse cx="0" cy="0" rx="15" ry="10" fill="#D9A65C" stroke="#A2712C" stroke-width="2.2"/>
        <g fill="#F2DDAF"><ellipse cx="-4" cy="-2" rx="3.4" ry="2.4"/><ellipse cx="4" cy="1" rx="3" ry="2.2"/><ellipse cx="-1" cy="4" rx="2.4" ry="1.8"/></g>
      </g>
      <g transform="translate(2 6) rotate(10)">
        <ellipse cx="0" cy="0" rx="14" ry="9" fill="#CE9A50" stroke="#976825" stroke-width="2.1"/>
        <g fill="#EFD6A2"><ellipse cx="-3" cy="-1" rx="3.2" ry="2.2"/><ellipse cx="4" cy="2" rx="2.8" ry="2"/></g>
      </g>
      <g transform="translate(26 -4) rotate(-6)">
        <ellipse cx="0" cy="0" rx="12.5" ry="8" fill="#D9A65C" stroke="#A2712C" stroke-width="2"/>
        <g fill="#F2DDAF"><ellipse cx="-2.6" cy="-1" rx="2.8" ry="2"/><ellipse cx="3.4" cy="1.6" rx="2.4" ry="1.8"/></g>
      </g>
    </g>
  </g>

  <!-- CHÉN SÚP DÀY CÓ QUAI — bọc scale để cụm chiếm khung như mấy hình khác -->
  <g transform="translate(252 300) scale(1.14) translate(-252 -300)">
    <!-- quai chữ C bên phải — nhỏ và bám sát thân; bản 1 vẽ quai to vòng rộng
         thì cả cụm đọc ra CÁI TÁCH TRÀ. Vẽ trước thân để thân đè lên gốc quai. -->
    <path d="M372 306 C 404 304 418 318 415 334 C 412 350 396 358 374 356"
          fill="none" stroke="#DCD1B2" stroke-width="17" stroke-linecap="round"/>
    <path d="M374 309 C 401 307 413 319 410 333 C 407 347 393 354 376 352"
          fill="none" stroke="#FDFAF0" stroke-width="7" stroke-linecap="round"/>

    <!-- chân đế -->
    <path d="M198 392 L 196 414 C 195 420 210 424 252 424 C 294 424 309 420 308 414 L 306 392 Z"
          fill="#E4DCC4" stroke="#CBC0A2" stroke-width="2.2"/>
    <!-- thân chén: dày, thành hơi phình -->
    <path d="M120 282 C 122 348 178 396 252 396 C 326 396 382 348 384 282 Z" fill="url(#scuCup)"/>
    <path d="M146 296 C 150 344 176 376 208 390 C 178 372 160 340 156 296 Z" fill="rgba(255,255,255,.55)"/>
    <!-- vành chén dày: hai vành lồng nhau cho ra bề dày -->
    <ellipse cx="252" cy="280" rx="134" ry="36" fill="#F6F1E1"/>
    <ellipse cx="252" cy="276" rx="134" ry="36" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2"/>
    <ellipse cx="252" cy="276" rx="134" ry="36" fill="none" stroke="#2C5234" stroke-width="4.5"/>

    <!-- MẶT SÚP SÁNH KÍN — không hở nước trong, không thấy sợi -->
    <ellipse cx="252" cy="278" rx="116" ry="29" fill="url(#scuSoup)"/>
    <!-- gợn sánh: cung ngắn nổi trên mặt, cho biết đây là thứ ĐẶC -->
    <g fill="none" stroke="#F2DFA8" stroke-width="3" stroke-linecap="round" opacity=".8">
      <path d="M164 276 C 180 270 198 269 212 272"/>
      <path d="M290 286 C 306 280 322 279 334 282"/>
    </g>

    <!-- VÂN TRỨNG: sợi MẢNH DÀI kéo một chiều -->
    <g fill="none" stroke="#F8ECC4" stroke-width="2.4" stroke-linecap="round">
      <path d="M152 282 C 178 272 210 268 238 270"/>
      <path d="M170 292 C 198 283 230 280 256 282"/>
      <path d="M206 264 C 234 256 266 254 292 257"/>
      <path d="M248 294 C 276 286 306 284 330 287"/>
      <path d="M282 268 C 306 261 330 259 350 262"/>
    </g>

    <!-- THỚ CUA: dải có sớ, rải LỆCH về nửa trái-trên -->
    <use href="#scuCrab" transform="translate(150 266) rotate(-11)"/>
    <use href="#scuCrab" transform="translate(196 250) rotate(6) scale(.96)"/>
    <use href="#scuCrab" transform="translate(172 292) rotate(15) scale(.92)"/>
    <use href="#scuCrab" transform="translate(238 276) rotate(-7) scale(1.04)"/>

    <!-- TRỨNG BẮC THẢO: hai múi cau, lòng trắng NÂU TRONG, lòng đỏ XÁM XANH sẫm -->
    <g transform="translate(318 262) rotate(-18)">
      <path d="M-16 8 C -16 -8 -8 -16 0 -16 C 8 -16 16 -8 16 8 Z" fill="#4A3A2E"/>
      <path d="M-16 8 C -16 -8 -8 -16 0 -16 C 8 -16 16 -8 16 8 Z" fill="rgba(120,92,58,.35)"/>
      <path d="M-9 6 C -9 -4 -4 -9 0 -9 C 4 -9 9 -4 9 6 Z" fill="#5C6A52"/>
      <path d="M-6 4 C -6 -3 -3 -6 0 -6" fill="none" stroke="#7E8C6E" stroke-width="1.6" stroke-linecap="round"/>
      <path d="M-16 8 C -16 -8 -8 -16 0 -16 C 8 -16 16 -8 16 8" fill="none" stroke="#2E241B" stroke-width="2"/>
    </g>
    <g transform="translate(292 294) rotate(14) scale(.86)">
      <path d="M-16 8 C -16 -8 -8 -16 0 -16 C 8 -16 16 -8 16 8 Z" fill="#4A3A2E"/>
      <path d="M-16 8 C -16 -8 -8 -16 0 -16 C 8 -16 16 -8 16 8 Z" fill="rgba(120,92,58,.35)"/>
      <path d="M-9 6 C -9 -4 -4 -9 0 -9 C 4 -9 9 -4 9 6 Z" fill="#5C6A52"/>
      <path d="M-16 8 C -16 -8 -8 -16 0 -16 C 8 -16 16 -8 16 8" fill="none" stroke="#2E241B" stroke-width="2"/>
    </g>

    <!-- CÀNG CUA gác lên vành chén, chồng mép lên vành (luật đợt 14: đồ ăn nhô
         lên khỏi vành phải chồng mép, đừng nổi tự do) -->
    <use href="#scuClaw" transform="translate(286 256) rotate(-16) scale(1.15)"/>

    <!-- trứng cút trắng nhỏ, một quả nhô lên -->
    <g>
      <ellipse cx="180" cy="248" rx="13" ry="10.5" fill="#FCF7E9" stroke="#DCD0AE" stroke-width="2"/>
      <ellipse cx="176" cy="244" rx="5" ry="3.4" fill="#FFFDF6"/>
    </g>

    <!-- ngò rí: lá xẻ ba thùy, dồn lệch phải -->
    <g fill="#4C8A3C" stroke="#2A5322" stroke-width="1.2">
      <path d="M334 288 C 340 282 348 282 352 286 C 347 291 339 292 334 288 Z"/>
      <path d="M348 276 C 354 270 362 271 365 275 C 360 280 353 281 348 276 Z"/>
      <path d="M320 300 C 326 295 333 295 337 299 C 332 304 325 304 320 300 Z"/>
    </g>
    <!-- tiêu xay rắc trên mặt -->
    <g fill="#2E2318">
      <circle cx="230" cy="262" r="1.6"/><circle cx="268" cy="284" r="1.5"/>
      <circle cx="196" cy="292" r="1.4"/><circle cx="304" cy="270" r="1.4"/><circle cx="252" cy="296" r="1.3"/>
    </g>

  </g>

  <!-- ĐẠO CỤ: muỗng sứ nằm trên bàn, lòng còn đầy súp -->
  <g transform="translate(120 408) rotate(-10)">
    <ellipse cx="16" cy="12" rx="50" ry="9" fill="rgba(15,26,14,.28)"/>
    <rect x="14" y="-5" width="80" height="11" rx="5.5" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2"/>
    <ellipse cx="0" cy="0" rx="23" ry="14.5" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2.6"/>
    <ellipse cx="-1" cy="0.5" rx="16" ry="9" fill="#E2BE72"/>
    <path d="M-9 -2 C -3 -6 6 -6 11 -2" fill="none" stroke="#F6EDDA" stroke-width="3.2" stroke-linecap="round"/>
    <circle cx="5" cy="3" r="2" fill="#4A3A2E"/>
  </g>
</svg>
