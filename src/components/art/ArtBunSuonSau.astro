---
/* Bún sườn nấu sấu — CHỮ KÝ, vẽ lệch hẳn khỏi mọi tô nước khác trên site:
   1) KHÚC SƯỜN LỘ ĐỐM XƯƠNG tròn trắng nhô hẳn trên mặt nước — không tô nào
      khác của site có xương, đây là dấu nhận diện mạnh nhất ở cỡ thumbnail
   2) NƯỚC DÙNG NHẠT MÀU gần như trong (phở bò, bún bò, bún riêu, bún đỏ đều
      đậm màu) — cố ý để trống nhiều mặt nước cho đọc ra chữ "trong"
   3) QUẢ SẤU tròn xanh nổi lềnh bềnh, một quả bổ đôi lộ ruột trắng ngà
   4) LÁ MÙI TÀU dài răng cưa, khác hẳn hành lá cắt tròn của các tô kia
   5) đạo cụ: dĩa sấu tươi bên trái, chén nước mắm ớt bên phải
   id prefix "bss" */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Tô bún sườn nấu sấu: nước dùng trong, khúc sườn lộ xương, quả sấu xanh và múi cà chua đỏ">
  <defs>
    <linearGradient id="bssBroth" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#F6EBC8"/><stop offset="1" stop-color="#E4D19A"/>
    </linearGradient>
    <linearGradient id="bssBowl" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#FDFAF0"/><stop offset="1" stop-color="#E9E2CC"/>
    </linearGradient>
    <!-- QUẢ SẤU: tròn hơi vẹo, cuống nhỏ, vỏ xanh có đốm sáng -->
    <g id="bssSau">
      <path d="M0 -13 C 8 -13 14 -6 14 2 C 14 10 8 15 0 15 C -8 15 -14 9 -14 1 C -14 -7 -8 -13 0 -13 Z"
            fill="#6F9C3E" stroke="#41611F" stroke-width="2"/>
      <path d="M-8 -6 C -4 -10 3 -10 8 -7" fill="none" stroke="#9DC46A" stroke-width="2.2" stroke-linecap="round"/>
      <g fill="#B4D488" opacity=".8"><circle cx="-5" cy="4" r="1.5"/><circle cx="5" cy="7" r="1.3"/></g>
      <path d="M0 -13 C 0 -17 2 -19 5 -19" fill="none" stroke="#4E7B36" stroke-width="2.2" stroke-linecap="round"/>
    </g>
    <!-- KHÚC SƯỜN: khối thịt + ĐẦU XƯƠNG TRẮNG LÒI HẲN RA trên đỉnh.
         Bản đầu vẽ đốm xương tròn nhỏ trên mặt khối, render 260px ra chỉ thấy
         một ô vuông nâu — không đọc ra sườn. Cho xương lòi ra ngoài đường bao
         thì cái bóng của khúc sườn tự nó nói "có xương", khỏi cần nhìn chi tiết. -->
    <g id="bssSuon">
      <path d="M6 -18 C 6 -26 12 -31 19 -31 C 24 -31 27 -28 27 -24 C 30 -25 34 -23 34 -18
               C 34 -13 30 -10 25 -11 L 20 -4 L 4 -8 Z"
            fill="#FBF4E2" stroke="#A8834A" stroke-width="2.2" stroke-linejoin="round"/>
      <rect x="-24" y="-10" width="46" height="34" rx="8" fill="#CE9153" stroke="#8A5A22" stroke-width="2.5"/>
      <path d="M-22 -4 C -10 -11 10 -12 20 -8 L 20 -2 C 10 -6 -10 -5 -20 1 Z" fill="#F0DDB4"/>
      <path d="M-14 6 L -17 18" stroke="#A96F2E" stroke-width="2.4" stroke-linecap="round"/>
      <path d="M-2 8 L -5 19" stroke="#A96F2E" stroke-width="2" stroke-linecap="round" opacity=".8"/>
      <path d="M10 6 L 8 17" stroke="#A96F2E" stroke-width="2" stroke-linecap="round" opacity=".7"/>
    </g>
    <!-- LÁ MÙI TÀU: dải dài, mép răng cưa hai bên -->
    <g id="bssMuiTau">
      <path d="M0 0 L 26 -3 L 30 0 L 26 3 Z" fill="#3E7B3A" stroke="#26521F" stroke-width="1.2"/>
      <path d="M2 -1.6 L 6 -4 M9 -2.2 L 13 -4.6 M16 -2.6 L 20 -5" stroke="#26521F" stroke-width="1" stroke-linecap="round"/>
      <path d="M2 1.6 L 6 4 M9 2.2 L 13 4.6 M16 2.6 L 20 5" stroke="#26521F" stroke-width="1" stroke-linecap="round"/>
      <path d="M1 0 L 27 -0.4" stroke="#7FB35B" stroke-width="1" stroke-linecap="round"/>
    </g>
  </defs>
  <circle cx="260" cy="240" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="240" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <g class="steam">
    <path d="M204 226 C 193 202 219 186 208 160 C 201 144 215 132 211 116"/>
    <path d="M268 220 C 258 196 284 182 273 156 C 266 140 280 128 276 112"/>
    <path d="M332 228 C 322 204 348 190 337 164 C 330 148 344 136 340 120"/>
  </g>
  <ellipse cx="258" cy="420" rx="196" ry="24" fill="rgba(15,26,14,.35)"/>

  <!-- tô miệng loe -->
  <path d="M78 296 C 84 364 164 408 258 408 C 352 408 432 364 438 296 Z" fill="url(#bssBowl)"/>
  <ellipse cx="258" cy="406" rx="60" ry="10" fill="#D8D0B6"/>
  <ellipse cx="258" cy="294" rx="182" ry="45" fill="#F6F1E1"/>
  <ellipse cx="258" cy="294" rx="182" ry="45" fill="none" stroke="#2C5234" stroke-width="5"/>
  <ellipse cx="258" cy="295" rx="168" ry="39" fill="none" stroke="#E0A32E" stroke-width="2.5" stroke-dasharray="2 11" stroke-linecap="round"/>

  <!-- NƯỚC DÙNG nhạt, gần như trong: để trống nhiều mặt cho đọc ra chữ "trong" -->
  <ellipse cx="258" cy="297" rx="154" ry="33" fill="url(#bssBroth)"/>
  <ellipse cx="204" cy="288" rx="52" ry="9" fill="#FBF4DE" opacity=".85"/>
  <ellipse cx="330" cy="304" rx="34" ry="6" fill="#FBF4DE" opacity=".6"/>

  <!-- SỢI BÚN trắng chìm dưới mặt nước, nhìn thấy vì nước trong -->
  <g stroke="#F7F1E0" stroke-width="3.4" stroke-linecap="round" fill="none" opacity=".9">
    <path d="M158 306 C 182 300 210 300 232 306"/>
    <path d="M166 316 C 192 310 222 310 246 316"/>
    <path d="M286 316 C 310 310 338 310 358 315"/>
    <path d="M296 306 C 318 301 342 301 360 305"/>
    <path d="M214 322 C 238 318 268 318 292 322"/>
  </g>

  <!-- KHÚC SƯỜN LỘ XƯƠNG — dấu nhận diện chính, nhô cao trên mặt nước -->
  <use href="#bssSuon" transform="translate(202 280) rotate(-7)"/>
  <use href="#bssSuon" transform="translate(310 288) rotate(8) scale(.92)"/>

  <!-- MÚI CÀ CHUA đỏ, mặt cắt lộ ruột -->
  <g transform="translate(252 306) rotate(-14)">
    <path d="M-20 -10 C -10 -16 10 -15 19 -7 C 22 -2 17 10 4 13 C -9 15 -21 8 -22 0 Z"
          fill="#D64431" stroke="#98241A" stroke-width="2.2"/>
    <path d="M-14 -5 C -6 -10 8 -9 14 -4" fill="none" stroke="#EE8067" stroke-width="2.2" stroke-linecap="round"/>
    <g fill="#F5D89B" stroke="#C9A45E" stroke-width=".9">
      <ellipse cx="-7" cy="2" rx="2.6" ry="1.7"/><ellipse cx="4" cy="5" rx="2.4" ry="1.6"/>
    </g>
  </g>
  <g transform="translate(352 288) rotate(10)">
    <path d="M-17 -9 C -8 -14 8 -13 16 -6 C 19 -2 14 8 3 11 C -8 13 -18 7 -19 0 Z"
          fill="#CB3E2C" stroke="#98241A" stroke-width="2.1"/>
    <path d="M-12 -4 C -5 -9 7 -8 12 -3" fill="none" stroke="#EE8067" stroke-width="2" stroke-linecap="round"/>
  </g>
  <g transform="translate(160 292) rotate(18)">
    <path d="M-15 -8 C -7 -13 7 -12 14 -6 C 17 -2 12 7 2 10 C -7 12 -16 6 -17 0 Z"
          fill="#D64431" stroke="#98241A" stroke-width="2"/>
  </g>

  <!-- QUẢ SẤU nổi lềnh bềnh, một quả bổ đôi lộ ruột -->
  <use href="#bssSau" transform="translate(232 272) rotate(-12) scale(.95)"/>
  <use href="#bssSau" transform="translate(300 318) rotate(14) scale(.88)"/>
  <use href="#bssSau" transform="translate(146 314) rotate(6) scale(.82)"/>
  <g transform="translate(376 314) rotate(-8) scale(.92)">
    <path d="M0 -13 C 8 -13 14 -6 14 2 C 14 10 8 15 0 15 C -8 15 -14 9 -14 1 C -14 -7 -8 -13 0 -13 Z"
          fill="#6F9C3E" stroke="#41611F" stroke-width="2"/>
    <path d="M0 -13 C 6 -12 10 -6 10 1 C 10 9 5 14 0 14 Z" fill="#EDE3C4" stroke="#B9A87A" stroke-width="1.6"/>
    <circle cx="4" cy="1" r="3" fill="#C9B98C" stroke="#9E8C5E" stroke-width="1.2"/>
  </g>

  <!-- LÁ MÙI TÀU rắc trên mặt -->
  <use href="#bssMuiTau" transform="translate(180 268) rotate(-16)"/>
  <use href="#bssMuiTau" transform="translate(258 258) rotate(8) scale(.9)"/>
  <use href="#bssMuiTau" transform="translate(320 262) rotate(-6) scale(.86)"/>
  <use href="#bssMuiTau" transform="translate(200 330) rotate(14) scale(.8)"/>

  <!-- hành lá cắt khúc + tiêu -->
  <g stroke="#6F9C48" stroke-width="3.4" stroke-linecap="round" fill="none">
    <path d="M280 288 q11 -5 20 -3"/><path d="M170 330 q10 -3 18 -2"/><path d="M340 330 q10 -4 18 -2"/>
  </g>
  <g fill="#2E2318"><circle cx="240" cy="290" r="1.6"/><circle cx="318" cy="298" r="1.5"/></g>

  <!-- ĐẠO CỤ TRÁI: dĩa sấu tươi chưa dùng tới -->
  <g transform="translate(86 400)">
    <ellipse cx="0" cy="20" rx="52" ry="12" fill="rgba(15,26,14,.3)"/>
    <ellipse cx="0" cy="8" rx="48" ry="13" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2.2"/>
    <ellipse cx="0" cy="7" rx="36" ry="9" fill="#F6F1E1"/>
    <use href="#bssSau" transform="translate(-18 -2) rotate(-14) scale(.72)"/>
    <use href="#bssSau" transform="translate(4 2) rotate(8) scale(.68)"/>
    <use href="#bssSau" transform="translate(22 -5) rotate(-6) scale(.62)"/>
  </g>

  <!-- ĐẠO CỤ PHẢI: chén nước mắm ớt để chấm khúc sườn -->
  <g transform="translate(440 398)">
    <ellipse cx="0" cy="20" rx="36" ry="10" fill="rgba(15,26,14,.3)"/>
    <path d="M-32 -4 C -30 11 -17 20 0 20 C 17 20 30 11 32 -4 Z" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2.2"/>
    <ellipse cx="0" cy="-4" rx="32" ry="9" fill="#F6F1E1" stroke="#D8D0B6" stroke-width="2"/>
    <ellipse cx="0" cy="-3" rx="26" ry="6.6" fill="#8A4A16"/>
    <g fill="#D4442A" stroke="#93230F" stroke-width="1">
      <ellipse cx="-9" cy="-2" rx="4" ry="2.2"/><ellipse cx="10" cy="-4" rx="3.6" ry="2"/>
      <ellipse cx="2" cy="1" rx="3.4" ry="1.9"/>
    </g>
  </g>
</svg>
