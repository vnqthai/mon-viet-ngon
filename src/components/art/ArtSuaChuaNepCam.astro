---
/* Sữa chua nếp cẩm — họ tím "Ngọt & mát". VẼ LẠI vòng 3.
   Soi cả họ trước: sáu hình cũ đã chiếm gần hết vốn vật đựng — ly CAO thẳng
   (chè bưởi), ly CAO miệng loe (chè đậu đỏ), ly CAO vuông (chè Thái), hũ thuỷ
   tinh (cơm rượu), tô rộng nông (chè bà ba), tô sâu lòng (chè đậu xanh bột
   báng). Còn đúng dáng CỐC THẤP MIỆNG RỘNG chưa ai dùng.
   Vòng 1: ba hạt nếp cẩm rải đều trên mặt sữa chua trắng → đọc ra CÁI MẶT
   (hai chấm trên thành hai con mắt), cùng họ lỗi với viên mọc của đợt 14.
   Vòng 2: gom hạt thành một vệt lệch trái — hết mặt cười, nhưng lòi ra lỗi
   khác: vành miệng vẽ thành một elip nét dày riêng, cộng thành cốc thẳng đứng
   trơn → đọc ra CỐC ĐONG PHÒNG THÍ NGHIỆM. Lớp sữa chua lại mỏng hơn lớp nếp
   cẩm nên tỉ lệ nhìn lệch.
   Vòng 3: bỏ vành nét dày, cho thành cốc HƠI LOE và có đáy dày; chia hai lớp
   xấp xỉ ĐỀU NHAU (đúng cách quán múc: nếp cẩm chừng nửa cốc rồi chan sữa chua
   đầy); thìa gác hẳn qua vành, cán chìa ra ngoài đủ dài để đọc được ở 260px.
   Vẫn giữ luật: thìa TỰA vào vành chứ không cắm đứng giữa cốc (chè bưởi đã bị
   Thái trả lại vì cắm thìa — ngoài đời không đứng nổi như vậy). */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Cốc sữa chua nếp cẩm: lớp nếp cẩm tím sẫm ở dưới, lớp sữa chua trắng dày ở trên, thìa gác qua vành cốc">
  <circle cx="260" cy="240" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="240" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <ellipse cx="256" cy="396" rx="140" ry="24" fill="rgba(15,26,14,.35)"/>

  <!-- CỐC THẤP MIỆNG RỘNG: hơi loe, đáy dày -->
  <path d="M146 232 L 164 356 C 166 374 204 384 256 384 C 308 384 346 374 348 356 L 366 232 Z"
        fill="rgba(255,255,255,.10)" stroke="#CFC7B0" stroke-width="3.4"/>

  <!-- LỚP NẾP CẨM: nửa dưới, hạt nứt vỏ nổi rõ -->
  <path d="M160 308 L 164 356 C 166 374 204 384 256 384 C 308 384 346 374 348 356 L 352 308
           C 328 320 296 326 256 326 C 216 326 184 320 160 308 Z"
        fill="#3A2140" stroke="#241129" stroke-width="2.6"/>
  <g fill="#5C3468">
    <ellipse cx="186" cy="330" rx="9.6" ry="6" transform="rotate(-16 186 330)"/>
    <ellipse cx="226" cy="340" rx="10" ry="6.2" transform="rotate(6 226 340)"/>
    <ellipse cx="270" cy="336" rx="10" ry="6.2" transform="rotate(-8 270 336)"/>
    <ellipse cx="312" cy="338" rx="9.6" ry="6" transform="rotate(12 312 338)"/>
    <ellipse cx="200" cy="356" rx="9.6" ry="6" transform="rotate(10 200 356)"/>
    <ellipse cx="246" cy="362" rx="10" ry="6.2" transform="rotate(-4 246 362)"/>
    <ellipse cx="292" cy="360" rx="10" ry="6.2" transform="rotate(8 292 360)"/>
    <ellipse cx="330" cy="354" rx="9.4" ry="5.8" transform="rotate(-14 330 354)"/>
    <ellipse cx="174" cy="348" rx="9" ry="5.6" transform="rotate(20 174 348)"/>
    <ellipse cx="222" cy="374" rx="9.4" ry="5.8" transform="rotate(2 222 374)"/>
    <ellipse cx="296" cy="376" rx="9.4" ry="5.8" transform="rotate(-6 296 376)"/>
  </g>
  <g fill="#7A4A88">
    <ellipse cx="208" cy="326" rx="7.4" ry="4.6" transform="rotate(-10 208 326)"/>
    <ellipse cx="290" cy="324" rx="7.4" ry="4.6" transform="rotate(8 290 324)"/>
    <ellipse cx="252" cy="350" rx="7.2" ry="4.4" transform="rotate(4 252 350)"/>
    <ellipse cx="318" cy="368" rx="7.2" ry="4.4" transform="rotate(-8 318 368)"/>
  </g>

  <!-- LỚP SỮA CHUA: dày xấp xỉ bằng lớp nếp cẩm, mịn lì -->
  <path d="M150 250 L 160 308 C 184 320 216 326 256 326 C 296 326 328 320 352 308 L 362 250
           C 332 264 300 270 256 270 C 212 270 180 264 150 250 Z"
        fill="#F7F2E6" stroke="#C6BCA2" stroke-width="2.6"/>
  <ellipse cx="256" cy="252" rx="106" ry="22" fill="#FDFAF2" stroke="#C6BCA2" stroke-width="2.6"/>
  <ellipse cx="252" cy="252" rx="84" ry="14" fill="#FFFFFF" opacity=".5"/>

  <!-- VỆT NẾP CẨM tràn từ mép trái xuống: dồn LỆCH hẳn một phía, không rải đều
       (rải đều là ra cái mặt — lỗi vòng 1) -->
  <path d="M166 250 C 190 244 216 246 232 254 C 216 266 188 268 168 262 Z"
        fill="#4A2A54" stroke="#2C1533" stroke-width="2.2"/>
  <g fill="#6B3E7A">
    <ellipse cx="184" cy="253" rx="7" ry="4.4" transform="rotate(-10 184 253)"/>
    <ellipse cx="206" cy="256" rx="6.4" ry="4" transform="rotate(6 206 256)"/>
    <ellipse cx="222" cy="257" rx="5.4" ry="3.4" transform="rotate(-4 222 257)"/>
  </g>

  <!-- THÌA gác qua vành cốc, cán chìa hẳn ra ngoài bên phải -->
  <g transform="rotate(28 344 244)">
    <path d="M330 240 L 348 240 L 356 176 L 322 176 Z" fill="#C9C4B4" stroke="#7C7566" stroke-width="2.6"/>
    <ellipse cx="339" cy="252" rx="30" ry="20" fill="#DDD8C8" stroke="#7C7566" stroke-width="2.6"/>
    <ellipse cx="339" cy="253" rx="21" ry="12" fill="#B7B1A0"/>
    <path d="M326 246 C 332 240 348 240 353 246" fill="none" stroke="#EFEBDE" stroke-width="3" stroke-linecap="round"/>
  </g>

  <!-- ánh sáng dọc thân cốc cho ra chất thuỷ tinh -->
  <path d="M172 258 L 182 356" fill="none" stroke="#FFFFFF" stroke-width="7" stroke-linecap="round" opacity=".28"/>
  <path d="M336 262 L 328 350" fill="none" stroke="#FFFFFF" stroke-width="4" stroke-linecap="round" opacity=".16"/>
</svg>
