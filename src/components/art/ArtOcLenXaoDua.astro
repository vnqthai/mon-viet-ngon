---
/* Ốc len xào dừa — VỎ ỐC XOẮN HÌNH CHÓP, dáng không món nào khác trên site có:
   nón thon 4–5 vòng xoắn, nâu sẫm có VÂN TRẮNG, vài con đã chặt cụt đuôi.
   Né tôm rim nước cốt dừa (nồi ĐẤT + tôm cong CAM) bằng cả sắc lẫn dáng:
   đây là dĩa sâu lòng sứ + đống vỏ NÂU SẪM. Sốt dừa trắng ngà, sả đập dập,
   ớt lát, rau răm; đạo cụ: chén vỏ ốc đã ăn */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Dĩa ốc len xào dừa vỏ ốc xoắn hình chóp nâu vân trắng trong sốt nước cốt dừa, sả đập dập, ớt lát và rau răm">
  <defs>
    <linearGradient id="olVo" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#7A5630"/><stop offset="1" stop-color="#40290F"/>
    </linearGradient>
    <!-- Sốt phải ĐỦ ĐẬM để tách khỏi lòng dĩa kem. Bản đầu lấy #F7EFDA→#E2D2AE,
         gần như trùng sắc với dĩa nên cả món "xào dừa" mà không thấy nước dừa đâu. -->
    <linearGradient id="olSot" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#F0DFB4"/><stop offset="1" stop-color="#D2B47C"/>
    </linearGradient>
  </defs>
  <circle cx="260" cy="244" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="244" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <g class="steam">
    <path d="M216 246 C 205 222 231 206 220 180 C 213 164 227 152 223 138"/>
    <path d="M284 240 C 274 216 300 202 289 176 C 282 160 296 148 292 134"/>
  </g>
  <ellipse cx="258" cy="410" rx="198" ry="25" fill="rgba(15,26,14,.35)"/>

  <!-- dĩa SÂU LÒNG: vành rộng, lòng trũng đựng sốt -->
  <path d="M62 320 C 68 378 152 404 258 404 C 364 404 448 378 454 320 Z" fill="#F0E9D4"/>
  <ellipse cx="258" cy="318" rx="196" ry="52" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2"/>
  <ellipse cx="258" cy="318" rx="196" ry="52" fill="none" stroke="#2C5234" stroke-width="4.5"/>
  <ellipse cx="258" cy="319" rx="176" ry="44" fill="none" stroke="#E0A32E" stroke-width="2.4" stroke-dasharray="2 11" stroke-linecap="round"/>

  <!-- SỐT NƯỚC CỐT DỪA sánh, đọng quanh đống ốc — có viền rõ để đọc ra "vũng sốt" -->
  <ellipse cx="258" cy="322" rx="160" ry="35" fill="url(#olSot)" stroke="#BC9C60" stroke-width="2"/>
  <ellipse cx="206" cy="312" rx="54" ry="10" fill="#FBF0D2" opacity=".85"/>
  <ellipse cx="330" cy="336" rx="40" ry="8" fill="#FBF0D2" opacity=".6"/>
  <g fill="#FFFCEE" opacity=".95">
    <circle cx="150" cy="330" r="4.4"/><circle cx="360" cy="328" r="4"/><circle cx="296" cy="346" r="3.4"/>
  </g>
  <g fill="#B99A62" opacity=".8">
    <circle cx="184" cy="342" r="2.8"/><circle cx="336" cy="314" r="2.6"/><circle cx="242" cy="348" r="2.6"/>
  </g>

  <!-- ĐỐNG ỐC LEN: mỗi con là một chóp xoắn thon, vòng xoắn + vân trắng.
       Vẽ từ sau ra trước, xoay mỗi con một góc cho khỏi thành hàng lối. -->
  <g stroke="#2C1B08" stroke-width="2.2" stroke-linejoin="round">
    <!-- hàng sau -->
    <g transform="translate(168 296) rotate(-28)">
      <path d="M0 -34 C 9 -26 15 -10 15 4 C 15 15 8 22 0 22 C -8 22 -15 15 -15 4 C -15 -10 -9 -26 0 -34 Z" fill="url(#olVo)"/>
      <g fill="none" stroke="#E4D3AE" stroke-width="2.4" opacity=".9">
        <path d="M-13 -2 C -6 3 6 3 13 -2"/><path d="M-11 -11 C -5 -7 5 -7 11 -11"/><path d="M-7 -20 C -3 -17 3 -17 7 -20"/>
      </g>
      <ellipse cx="0" cy="18" rx="8" ry="4.4" fill="#D9C49B" stroke="#2C1B08" stroke-width="1.8"/>
    </g>
    <g transform="translate(232 288) rotate(14)">
      <path d="M0 -36 C 10 -27 16 -10 16 5 C 16 16 9 24 0 24 C -9 24 -16 16 -16 5 C -16 -10 -10 -27 0 -36 Z" fill="#6B4A28"/>
      <g fill="none" stroke="#E4D3AE" stroke-width="2.4" opacity=".9">
        <path d="M-14 -1 C -6 4 6 4 14 -1"/><path d="M-12 -11 C -5 -7 5 -7 12 -11"/><path d="M-8 -21 C -3 -18 3 -18 8 -21"/>
      </g>
      <ellipse cx="0" cy="20" rx="8.4" ry="4.6" fill="#D9C49B" stroke="#2C1B08" stroke-width="1.8"/>
    </g>
    <g transform="translate(300 294) rotate(-10)">
      <path d="M0 -33 C 9 -25 15 -9 15 4 C 15 15 8 22 0 22 C -8 22 -15 15 -15 4 C -15 -9 -9 -25 0 -33 Z" fill="url(#olVo)"/>
      <g fill="none" stroke="#E4D3AE" stroke-width="2.3" opacity=".9">
        <path d="M-13 -2 C -6 3 6 3 13 -2"/><path d="M-11 -11 C -5 -7 5 -7 11 -11"/>
      </g>
      <ellipse cx="0" cy="18" rx="8" ry="4.4" fill="#D9C49B" stroke="#2C1B08" stroke-width="1.8"/>
    </g>
    <g transform="translate(356 306) rotate(32)">
      <path d="M0 -30 C 8 -22 14 -8 14 4 C 14 14 7 20 0 20 C -7 20 -14 14 -14 4 C -14 -8 -8 -22 0 -30 Z" fill="#6B4A28"/>
      <g fill="none" stroke="#E4D3AE" stroke-width="2.2" opacity=".9">
        <path d="M-12 -2 C -6 2 6 2 12 -2"/><path d="M-10 -10 C -4 -7 4 -7 10 -10"/>
      </g>
      <!-- con này đã CHẶT CỤT ĐUÔI: chóp cắt phẳng -->
      <path d="M-5 -26 L 5 -26" stroke="#2C1B08" stroke-width="2.6" stroke-linecap="round"/>
      <ellipse cx="0" cy="-26" rx="5" ry="2.2" fill="#33200B"/>
    </g>
    <!-- hàng trước -->
    <g transform="translate(196 332) rotate(-52)">
      <path d="M0 -32 C 9 -24 15 -9 15 4 C 15 14 8 21 0 21 C -8 21 -15 14 -15 4 C -15 -9 -9 -24 0 -32 Z" fill="#7A5630"/>
      <g fill="none" stroke="#EFE0BE" stroke-width="2.4" opacity=".95">
        <path d="M-13 -2 C -6 3 6 3 13 -2"/><path d="M-11 -11 C -5 -7 5 -7 11 -11"/><path d="M-7 -20 C -3 -17 3 -17 7 -20"/>
      </g>
      <ellipse cx="0" cy="17" rx="8" ry="4.4" fill="#E4D0A6" stroke="#2C1B08" stroke-width="1.8"/>
      <ellipse cx="0" cy="17" rx="4" ry="2.2" fill="#B99A6A"/>
    </g>
    <g transform="translate(266 340) rotate(66)">
      <path d="M0 -34 C 9 -25 15 -9 15 5 C 15 15 8 22 0 22 C -8 22 -15 15 -15 5 C -15 -9 -9 -25 0 -34 Z" fill="url(#olVo)"/>
      <g fill="none" stroke="#EFE0BE" stroke-width="2.4" opacity=".95">
        <path d="M-13 -1 C -6 4 6 4 13 -1"/><path d="M-11 -10 C -5 -6 5 -6 11 -10"/><path d="M-7 -19 C -3 -16 3 -16 7 -19"/>
      </g>
      <ellipse cx="0" cy="18" rx="8" ry="4.4" fill="#E4D0A6" stroke="#2C1B08" stroke-width="1.8"/>
      <ellipse cx="0" cy="18" rx="4" ry="2.2" fill="#B99A6A"/>
    </g>
    <g transform="translate(330 344) rotate(-70)">
      <path d="M0 -30 C 8 -22 14 -8 14 4 C 14 14 7 20 0 20 C -7 20 -14 14 -14 4 C -14 -8 -8 -22 0 -30 Z" fill="#6B4A28"/>
      <g fill="none" stroke="#EFE0BE" stroke-width="2.2" opacity=".95">
        <path d="M-12 -2 C -6 2 6 2 12 -2"/><path d="M-10 -10 C -4 -7 4 -7 10 -10"/>
      </g>
      <path d="M-5 -26 L 5 -26" stroke="#2C1B08" stroke-width="2.4" stroke-linecap="round"/>
      <ellipse cx="0" cy="-26" rx="4.6" ry="2" fill="#33200B"/>
      <ellipse cx="0" cy="16" rx="7.4" ry="4" fill="#E4D0A6" stroke="#2C1B08" stroke-width="1.7"/>
    </g>
    <g transform="translate(140 340) rotate(84)">
      <path d="M0 -27 C 7 -20 12 -7 12 3 C 12 12 6 18 0 18 C -6 18 -12 12 -12 3 C -12 -7 -7 -20 0 -27 Z" fill="#7A5630"/>
      <g fill="none" stroke="#EFE0BE" stroke-width="2" opacity=".95">
        <path d="M-10 -1 C -5 2 5 2 10 -1"/><path d="M-9 -9 C -4 -6 4 -6 9 -9"/>
      </g>
      <ellipse cx="0" cy="15" rx="6.6" ry="3.6" fill="#E4D0A6" stroke="#2C1B08" stroke-width="1.6"/>
    </g>
  </g>

  <!-- SẢ ĐẬP DẬP: khúc MẢNH và DÀI, đầu tướp xơ, nằm lẫn trong đống ốc.
       Bản đầu vẽ khúc mập bo tròn nằm vắt mép dĩa → đọc ra QUẢ ĐẬU / khúc dưa leo. -->
  <g transform="rotate(-16 200 346)">
    <path d="M136 342 C 176 338 224 337 264 340 C 266 343 266 350 264 353 C 224 356 176 355 136 351 Z"
          fill="#DDE4B4" stroke="#A0B45E" stroke-width="1.8"/>
    <path d="M150 342 C 190 339 226 339 256 342" fill="none" stroke="#F2F5DC" stroke-width="1.8" opacity=".95"/>
    <path d="M152 350 C 192 348 226 348 254 350" fill="none" stroke="#B8C87C" stroke-width="1.2" opacity=".8"/>
    <g stroke="#A0B45E" stroke-width="1.7" stroke-linecap="round" fill="none">
      <path d="M136 343 l-14 -6 M136 347 l-17 -1 M136 351 l-14 6"/>
    </g>
  </g>
  <g transform="rotate(11 318 352)">
    <path d="M262 348 C 300 344 344 343 382 346 C 384 349 384 356 382 359 C 344 362 300 361 262 357 Z"
          fill="#DDE4B4" stroke="#A0B45E" stroke-width="1.8"/>
    <path d="M276 348 C 312 345 348 345 374 348" fill="none" stroke="#F2F5DC" stroke-width="1.8" opacity=".95"/>
    <g stroke="#A0B45E" stroke-width="1.7" stroke-linecap="round" fill="none">
      <path d="M382 347 l14 -6 M382 352 l17 0 M382 357 l14 6"/>
    </g>
  </g>

  <!-- RAU RĂM: lá thon nhọn hai đầu, có sống lá -->
  <g fill="#3F6A28" stroke="#2E5220" stroke-width="1.4">
    <path d="M232 268 C 240 258 254 254 262 258 C 256 268 242 272 232 268 Z" transform="rotate(-18 247 263)"/>
    <path d="M312 264 C 320 254 334 251 342 255 C 336 265 322 268 312 264 Z" transform="rotate(12 327 259)"/>
    <path d="M180 356 C 188 346 202 343 210 347 C 204 357 190 360 180 356 Z" transform="rotate(24 195 351)"/>
    <path d="M296 366 C 304 356 318 353 326 357 C 320 367 306 370 296 366 Z" transform="rotate(-14 311 361)"/>
  </g>
  <g stroke="#7FB44E" stroke-width="1.2" fill="none" opacity=".9">
    <path d="M236 265 L 258 259" transform="rotate(-18 247 263)"/>
    <path d="M316 261 L 338 256" transform="rotate(12 327 259)"/>
  </g>

  <!-- ỚT LÁT: khoanh có LỖ GIỮA và hạt, đủ to để không đọc ra quả mọng đỏ -->
  <g stroke="#A83722">
    <g transform="translate(216 310)">
      <circle cx="0" cy="0" r="9.4" fill="#D64B33" stroke-width="2"/>
      <circle cx="0" cy="0" r="4.6" fill="#F6C4B0"/>
      <g fill="#E8D9A8"><circle cx="-1.6" cy="-1.4" r="1.1"/><circle cx="1.8" cy="1.2" r="1.1"/></g>
    </g>
    <g transform="translate(292 304)">
      <circle cx="0" cy="0" r="8.4" fill="#D64B33" stroke-width="1.9"/>
      <circle cx="0" cy="0" r="4" fill="#F6C4B0"/>
      <g fill="#E8D9A8"><circle cx="1.4" cy="-1.2" r="1"/></g>
    </g>
    <g transform="translate(354 330)">
      <circle cx="0" cy="0" r="7.8" fill="#E0563C" stroke-width="1.8"/>
      <circle cx="0" cy="0" r="3.7" fill="#F6C4B0"/>
    </g>
    <g transform="translate(158 318)">
      <circle cx="0" cy="0" r="7.4" fill="#E0563C" stroke-width="1.8"/>
      <circle cx="0" cy="0" r="3.5" fill="#F6C4B0"/>
    </g>
  </g>

  <!-- CHÉN VỎ ỐC ĐÃ ĂN (góc trái dưới) — chi tiết chỉ món ốc mới có -->
  <g transform="translate(94 400)">
    <ellipse cx="0" cy="14" rx="42" ry="12" fill="rgba(15,26,14,.3)"/>
    <path d="M-34 -2 C -32 14 -18 24 0 24 C 18 24 32 14 34 -2 Z" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2"/>
    <ellipse cx="0" cy="-2" rx="28" ry="8.4" fill="#EDE6CE"/>
    <g stroke="#2C1B08" stroke-width="1.6">
      <g transform="translate(-13 -6) rotate(-40) scale(.5)">
        <path d="M0 -28 C 8 -20 13 -7 13 4 C 13 13 7 19 0 19 C -7 19 -13 13 -13 4 C -13 -7 -8 -20 0 -28 Z" fill="#6B4A28"/>
      </g>
      <g transform="translate(6 -8) rotate(28) scale(.46)">
        <path d="M0 -28 C 8 -20 13 -7 13 4 C 13 13 7 19 0 19 C -7 19 -13 13 -13 4 C -13 -7 -8 -20 0 -28 Z" fill="#7A5630"/>
      </g>
      <g transform="translate(18 -3) rotate(-64) scale(.42)">
        <path d="M0 -28 C 8 -20 13 -7 13 4 C 13 13 7 19 0 19 C -7 19 -13 13 -13 4 C -13 -7 -8 -20 0 -28 Z" fill="#6B4A28"/>
      </g>
    </g>
  </g>

  <!-- nhánh rau răm tươi để bàn (góc phải dưới) -->
  <g transform="translate(408 402) rotate(-10)">
    <path d="M-34 6 C -10 0 20 -2 44 2" fill="none" stroke="#4E7B36" stroke-width="3" stroke-linecap="round"/>
    <g fill="#3F6A28" stroke="#2E5220" stroke-width="1.3">
      <path d="M-24 2 C -18 -8 -6 -11 0 -7 C -6 3 -16 6 -24 2 Z"/>
      <path d="M2 -2 C 8 -12 20 -15 26 -11 C 20 -1 10 2 2 -2 Z"/>
      <path d="M-12 12 C -6 4 4 2 10 6 C 4 14 -4 16 -12 12 Z"/>
    </g>
  </g>
</svg>
