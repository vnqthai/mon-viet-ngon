---
/* Mắm chưng thịt trứng — VÒNG 2, sửa theo Thái: "món này có màu VÀNG chứ không
   phải màu nâu".

   BẢNG MÀU THẬT CỦA MÓN (tra 2026-08-01, ghi lại để đợt sau khỏi vẽ mò):
   · MẶT TRÊN — VÀNG ÓNG BÓNG (#E8B33E → #D0912A). Màu này KHÔNG phải màu mắm,
     mà là lớp LÒNG ĐỎ TRỨNG phết lên rồi hấp thêm 5 phút cho se lại. Mọi công
     thức đều tả là "vàng óng", "vàng bóng"
   · LẤM TẤM TRÊN MẶT — thịt băm nâu (#7A4A22) và mảnh mắm cá nâu đỏ (#8E4A1E)
     nhô lên khỏi lớp trứng, nên mặt GỒ GHỀ chứ không phẳng lì
   · MÉP KHỐI — chỗ tiếp giáp thành chén sẫm hơn (#B07C1E), vì đó là phần ăn
     nhiệt nhiều nhất
   · TRÊN CÙNG — lát ớt đỏ tươi (#C3372B) + gừng thái sợi vàng (#E2B451) + hành
     lá xanh; ba màu này là thứ làm tô mắm nhìn ngon
   Bản 1 tô cả khối màu nâu sậm — sai, đó là màu mắm sống chưa chưng.

   TÁCH KHỎI TRỨNG CHƯNG THỊT NẤM MÈO (cùng nhóm Hấp, giờ lại cùng màu vàng):
   1) VẬT ĐỰNG — chén sâu lòng CÓ CHÂN ĐẾ, đường bao đứng; trứng chưng là dĩa
      bầu dục DẸT nằm ngang
   2) MẶT MÓN — gồ ghề, lấm tấm thịt và mắm nhô lên; trứng chưng phẳng mịn
   3) TRÊN MẶT — lát ớt đỏ + gừng sợi; trứng chưng không có gì đỏ
   4) ĐẠO CỤ — bó rau sống + hũ mắm; trứng chưng dùng chén cơm + đũa
   id prefix "mcg" */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Chén sành men xanh ngọc đựng mắm chưng thịt trứng mặt vàng óng bóng lấm tấm thịt băm, trên xếp lát ớt đỏ và gừng thái sợi, bên cạnh là bó rau sống và hũ mắm">
  <defs>
    <linearGradient id="mcgBowl" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#7FB6AA"/><stop offset="1" stop-color="#3E6E66"/>
    </linearGradient>
    <linearGradient id="mcgTop" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#EFBE4C"/><stop offset="1" stop-color="#CE8E24"/>
    </linearGradient>
    <linearGradient id="mcgJar" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="rgba(255,255,255,.34)"/>
      <stop offset="0.5" stop-color="rgba(255,255,255,.12)"/>
      <stop offset="1" stop-color="rgba(255,255,255,.26)"/>
    </linearGradient>
    <g id="mcgMince">
      <path d="M0 0 L 8 -4 L 14 1 L 7 6 Z" fill="#7A4A22"/>
      <path d="M2 0 L 8 -2 L 11 1" fill="none" stroke="#966130" stroke-width="1.2" opacity=".55" stroke-linecap="round"/>
    </g>
    <g id="mcgMam">
      <path d="M0 0 L 9 -3 L 13 3 L 4 6 Z" fill="#8E4A1E"/>
    </g>
  </defs>

  <circle cx="260" cy="240" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="240" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <g class="steam">
    <path d="M212 186 C 201 162 227 146 216 120 C 209 104 223 92 219 78"/>
    <path d="M262 178 C 252 154 278 140 267 114 C 260 98 274 86 270 72"/>
    <path d="M310 188 C 300 166 324 152 314 128 C 307 112 320 100 317 86"/>
  </g>
  <ellipse cx="256" cy="424" rx="192" ry="24" fill="rgba(15,26,14,.35)"/>

  <!-- ĐẠO CỤ TRÁI: bó rau sống + lát dưa leo dày -->
  <g transform="translate(88 384)">
    <ellipse cx="0" cy="22" rx="60" ry="14" fill="rgba(15,26,14,.3)"/>
    <path d="M-52 16 C -44 -2 -18 -12 4 -12 C 28 -12 50 -2 54 16 C 32 26 -30 26 -52 16 Z" fill="#2F5E2B"/>
    <g fill="#4C8A3C" stroke="#2A5322" stroke-width="1.6">
      <path d="M-44 8 C -34 -6 -14 -12 0 -8 C -10 4 -28 12 -44 8 Z"/>
      <path d="M-6 -4 C 6 -18 26 -20 38 -12 C 26 -2 6 6 -6 -4 Z"/>
      <path d="M6 14 C 18 2 38 0 48 8 C 36 18 18 22 6 14 Z"/>
    </g>
    <g fill="none" stroke="#8CC06A" stroke-width="1.5" stroke-linecap="round">
      <path d="M-40 7 C -28 1 -14 -5 -3 -7"/>
      <path d="M-2 -3 C 10 -10 24 -15 35 -12"/>
      <path d="M10 13 C 22 6 36 4 45 8"/>
    </g>
    <g transform="translate(-62 8) rotate(-18)">
      <ellipse cx="0" cy="0" rx="16" ry="8.4" fill="#E4EFCC" stroke="#6E9750" stroke-width="3"/>
      <ellipse cx="0" cy="0" rx="8.4" ry="4.2" fill="#F4F8E6"/>
      <g fill="#BCD293"><ellipse cx="-3" cy="-1" rx="2.1" ry="1.4"/><ellipse cx="3" cy="1" rx="2.1" ry="1.4"/></g>
    </g>
  </g>

  <!-- ĐẠO CỤ PHẢI: hũ mắm nhỏ có nắp -->
  <g transform="translate(436 378) rotate(6)">
    <ellipse cx="0" cy="42" rx="36" ry="10" fill="rgba(15,26,14,.3)"/>
    <path d="M-25 -10 L 25 -10 L 21 34 C 20.6 37.6 17.6 39 13 39 L -13 39 C -17.6 39 -20.6 37.6 -21 34 Z"
          fill="url(#mcgJar)" stroke="rgba(255,255,255,.5)" stroke-width="2.4"/>
    <path d="M-19 6 L 19 6 L 16.4 32 C 16.2 34.6 14.4 35.6 11 35.6 L -11 35.6 C -14.4 35.6 -16.2 34.6 -16.4 32 Z"
          fill="#8E4A1E"/>
    <g fill="#5E3010"><circle cx="-8" cy="16" r="2.6"/><circle cx="6" cy="22" r="2.2"/><circle cx="-3" cy="28" r="2"/></g>
    <rect x="-28" y="-19" width="56" height="11" rx="4" fill="#C6924A" stroke="#96682C" stroke-width="2"/>
    <path d="M-18 -2 C -6 -5 8 -5 18 -2" fill="none" stroke="rgba(255,255,255,.55)" stroke-width="2.4" stroke-linecap="round"/>
  </g>

  <!-- CHÉN SÂU LÒNG CÓ CHÂN ĐẾ -->
  <g transform="translate(254 268) scale(1.16) translate(-254 -268)">
    <path d="M212 400 L 208 424 C 207 430 216 434 254 434 C 292 434 301 430 300 424 L 296 400 Z"
          fill="#3E6E66" stroke="#2A514B" stroke-width="2.4"/>
    <ellipse cx="254" cy="400" rx="46" ry="11" fill="#4E8279"/>
    <path d="M112 288 C 118 356 176 402 254 402 C 332 402 390 356 396 288 Z" fill="url(#mcgBowl)"/>
    <path d="M136 300 C 146 348 176 378 212 390 C 178 372 156 340 148 300 Z" fill="rgba(255,255,255,.28)"/>
    <ellipse cx="254" cy="286" rx="142" ry="38" fill="#8FC4BB"/>
    <ellipse cx="254" cy="286" rx="142" ry="38" fill="none" stroke="#2A514B" stroke-width="4.5"/>
    <ellipse cx="254" cy="287" rx="128" ry="32" fill="none" stroke="#E0A32E" stroke-width="2.4" stroke-dasharray="2 11" stroke-linecap="round"/>

    <!-- KHỐI MẮM CHƯNG: mặt VÀNG ÓNG, mép sẫm hơn, mặt GỒ GHỀ -->
    <ellipse cx="254" cy="284" rx="120" ry="30" fill="#B07C1E"/>
    <path d="M134 282 C 142 250 190 238 254 238 C 318 238 366 250 374 282 C 336 300 172 300 134 282 Z"
          fill="url(#mcgTop)"/>
    <!-- gờ gồ ghề trên mặt: cung ngắn nhô lên, không phẳng lì như trứng chưng -->
    <g fill="none" stroke="#C4901F" stroke-width="2.6" stroke-linecap="round" opacity=".85">
      <path d="M166 272 C 184 264 204 262 220 265"/>
      <path d="M236 250 C 256 245 278 246 294 251"/>
      <path d="M290 286 C 308 280 326 277 342 279"/>
      <path d="M196 288 C 212 283 228 281 240 283"/>
    </g>
    <!-- vệt bóng thẳng xiên (lòng đỏ phết lên nên mặt bóng) -->
    <path d="M 174 266 L 216 253 M 192 279 L 230 267" stroke="#F7DC94" stroke-width="4.8" stroke-linecap="round" opacity=".8"/>

    <!-- LẤM TẤM THỊT BĂM + MẢNH MẮM nhô lên khỏi lớp trứng, rải LỆCH nửa phải -->
    <use href="#mcgMince" transform="translate(228 260) rotate(-18)"/>
    <use href="#mcgMince" transform="translate(272 250) rotate(24) scale(1.15)"/>
    <use href="#mcgMince" transform="translate(304 266) rotate(-8) scale(.85)"/>
    <use href="#mcgMince" transform="translate(256 278) rotate(36) scale(1.05)"/>
    <use href="#mcgMince" transform="translate(318 282) rotate(12) scale(.92)"/>
    <use href="#mcgMince" transform="translate(202 276) rotate(16) scale(.75)"/>
    <use href="#mcgMam" transform="translate(288 290) rotate(-28) scale(1.1)"/>
    <use href="#mcgMam" transform="translate(338 262) rotate(6) scale(.9)"/>
    <use href="#mcgMam" transform="translate(238 292) rotate(14) scale(.85)"/>

    <!-- GỪNG THÁI SỢI vàng nhạt, sợi DÀI, dồn lệch trái -->
    <g fill="none" stroke="#F0D07E" stroke-width="3.4" stroke-linecap="round">
      <path d="M154 256 C 176 248 200 246 220 250"/>
      <path d="M162 268 C 184 260 208 258 226 261"/>
      <path d="M174 248 C 194 241 214 240 230 243"/>
      <path d="M148 264 C 164 259 180 257 192 258"/>
    </g>
    <g fill="none" stroke="#FBEFC4" stroke-width="1.5" stroke-linecap="round" opacity=".9">
      <path d="M158 255 C 178 248 198 246 216 249"/>
      <path d="M166 267 C 186 260 206 258 222 260"/>
    </g>

    <!-- LÁT ỚT ĐỎ trên mặt -->
    <g>
      <g transform="translate(300 244) rotate(-16)">
        <ellipse cx="0" cy="0" rx="16" ry="7.4" fill="#C3372B" stroke="#8B2018" stroke-width="2.2"/>
        <ellipse cx="0" cy="0" rx="9" ry="3.6" fill="#E5705E"/>
        <g fill="#F6E3B4"><circle cx="-3" cy="0" r="1.5"/><circle cx="3" cy="0.6" r="1.4"/></g>
      </g>
      <g transform="translate(334 272) rotate(12)">
        <ellipse cx="0" cy="0" rx="13" ry="6.2" fill="#B92F24" stroke="#801C15" stroke-width="2"/>
        <ellipse cx="0" cy="0" rx="7" ry="3" fill="#DE6553"/>
        <g fill="#F6E3B4"><circle cx="-2.4" cy="0" r="1.3"/><circle cx="2.6" cy="0.5" r="1.2"/></g>
      </g>
      <g transform="translate(258 296) rotate(-6)">
        <ellipse cx="0" cy="0" rx="11" ry="5.4" fill="#C3372B" stroke="#8B2018" stroke-width="1.9"/>
        <ellipse cx="0" cy="0" rx="6" ry="2.6" fill="#E5705E"/>
      </g>
    </g>

    <!-- hành lá xắt + tiêu -->
    <g fill="#4E7B36">
      <ellipse cx="214" cy="290" rx="5.6" ry="2.4" transform="rotate(-14 214 290)"/>
      <ellipse cx="288" cy="256" rx="5" ry="2.2" transform="rotate(10 288 256)"/>
      <ellipse cx="348" cy="290" rx="4.6" ry="2" transform="rotate(-6 348 290)"/>
    </g>
    <g fill="#2E2318">
      <circle cx="240" cy="268" r="1.5"/><circle cx="278" cy="284" r="1.4"/>
      <circle cx="322" cy="252" r="1.4"/><circle cx="196" cy="288" r="1.3"/>
    </g>
  </g>
</svg>
