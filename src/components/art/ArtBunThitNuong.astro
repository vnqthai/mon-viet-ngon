---
/* Bún thịt nướng — MỘT TÔ đầy đủ (khác bún chả: không chén chấm to, thịt LÁT không viên):
   bún trắng cuộn sợi, NHIỀU lát thịt nướng bản dẹt rẻ quạt XẾP LỚP, vệt nướng chéo màu mật ong,
   đồ chua sợi, dưa leo, mỡ hành, đậu phộng; món nguội không khói; đạo cụ: chén mắm ớt + đũa + chanh */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Tô bún thịt nướng: bún tươi, nhiều lát thịt nướng xém cạnh xếp lớp, đồ chua, dưa leo, mỡ hành, đậu phộng, kèm chén nước mắm ớt và đũa">
  <defs>
    <linearGradient id="btnThitG" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#D98A42"/><stop offset="1" stop-color="#A85320"/>
    </linearGradient>
    <linearGradient id="btnBowl" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#FDFAF0"/><stop offset="1" stop-color="#E9E2CC"/>
    </linearGradient>
    <!-- một lát thịt nướng: bản dẹt PHẲNG mép thẳng (68x26), vành mỡ chạy suốt mép trên,
         3 vệt nướng chéo, xém 2 đầu — tránh dáng oval hai đầu tròn -->
    <g id="btnThit">
      <path d="M -33 -10 L 28 -13 C 31.5 -13.2 34 -10.5 33.4 -7 L 31 8
               C 30.4 11.4 27.8 13.4 24 13.6 L -28 15.4
               C -31.8 15.5 -34.4 12.8 -34 9 Z"
            fill="url(#btnThitG)" stroke="#8A4517" stroke-width="2.2" stroke-linejoin="round"/>
      <path d="M -33 -10 L 28 -13 C 31.5 -13.2 34 -10.5 33.4 -7 L 33 -4.6 L -33.4 -5.4 Z" fill="#EFD3A4"/>
      <g stroke="#5E2C0C" stroke-width="2.8" stroke-linecap="round" fill="none">
        <path d="M -16 -8 L -21 11"/>
        <path d="M 1 -9 L -4 12"/>
        <path d="M 18 -9 L 13 11"/>
      </g>
      <path d="M 33.4 -7 L 31 8 C 30.4 11.4 27.8 13.4 24 13.6 C 27 8 28.8 0 29.4 -8 Z" fill="#5E2C0C" opacity=".55"/>
      <path d="M -34 9 C -34.6 4 -34.3 -3 -33 -10 C -31.4 -4 -31.6 4 -31 10 Z" fill="#5E2C0C" opacity=".4"/>
      <g stroke="#F2B063" stroke-width="2.2" stroke-linecap="round" fill="none" opacity=".95">
        <path d="M -8 -5 L -11 8"/>
        <path d="M 10 -6 L 7 7"/>
      </g>
    </g>
  </defs>
  <circle cx="260" cy="250" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="250" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <ellipse cx="260" cy="404" rx="196" ry="25" fill="rgba(15,26,14,.35)"/>

  <!-- TÔ bún -->
  <path d="M 100 270 C 108 348 172 392 260 392 C 348 392 412 348 420 270 Z" fill="url(#btnBowl)"/>
  <ellipse cx="260" cy="390" rx="58" ry="10" fill="#D8D0B6"/>
  <ellipse cx="260" cy="268" rx="160" ry="44" fill="#F6F1E1"/>
  <ellipse cx="260" cy="268" rx="160" ry="44" fill="none" stroke="#2C5234" stroke-width="5"/>
  <ellipse cx="260" cy="269" rx="146" ry="38" fill="none" stroke="#E0A32E" stroke-width="2.4" stroke-dasharray="2 11" stroke-linecap="round"/>

  <!-- dưa leo lát mép trái -->
  <g>
    <circle cx="132" cy="272" r="13" fill="#6F9C48" stroke="#4E7B36" stroke-width="2"/>
    <circle cx="132" cy="272" r="8.6" fill="#D6E8B4"/>
    <g fill="#9CB25C"><circle cx="129" cy="269" r="1.2"/><circle cx="136" cy="272" r="1.2"/><circle cx="131" cy="276" r="1.2"/></g>
    <circle cx="146" cy="294" r="11.5" fill="#6F9C48" stroke="#4E7B36" stroke-width="2"/>
    <circle cx="146" cy="294" r="7.4" fill="#D6E8B4"/>
    <g fill="#9CB25C"><circle cx="143" cy="292" r="1.1"/><circle cx="149" cy="296" r="1.1"/></g>
  </g>

  <!-- bún trắng cuộn sợi phủ nửa trái -->
  <g transform="translate(174 256) rotate(-6)">
    <ellipse cx="0" cy="0" rx="34" ry="13" fill="#FBF5E3" stroke="#D2C494" stroke-width="2"/>
    <path d="M-27 -3 a 27 9 0 0 1 50 -2 M -20 4 a 22 8 0 0 1 40 -1 M -12 -8 a 14 5 0 0 1 26 -1 M -15 9 a 16 6 0 0 1 30 -1" fill="none" stroke="#D2C494" stroke-width="2.2" stroke-linecap="round"/>
  </g>
  <g transform="translate(222 242) rotate(3)">
    <ellipse cx="0" cy="0" rx="36" ry="13.5" fill="#FDFAF0" stroke="#D2C494" stroke-width="2"/>
    <path d="M-29 -3 a 29 10 0 0 1 54 -2 M -21 4 a 23 8 0 0 1 42 -1 M -12 -8 a 15 5 0 0 1 28 -1 M -16 9 a 17 6 0 0 1 32 -1" fill="none" stroke="#D2C494" stroke-width="2.2" stroke-linecap="round"/>
    <path d="M30 5 q7 6 3 13" fill="none" stroke="#EFE6CB" stroke-width="4" stroke-linecap="round"/>
  </g>
  <g transform="translate(194 286) rotate(-3)">
    <ellipse cx="0" cy="0" rx="39" ry="14.5" fill="#FFFDF6" stroke="#D2C494" stroke-width="2"/>
    <path d="M-31 -3 a 31 10 0 0 1 58 -2 M -23 4 a 25 9 0 0 1 46 -1 M -13 -8 a 16 5 0 0 1 30 -1 M -17 9 a 18 6 0 0 1 34 -1" fill="none" stroke="#D2C494" stroke-width="2.2" stroke-linecap="round"/>
    <path d="M-33 6 q-6 6 -2 12" fill="none" stroke="#EFE6CB" stroke-width="4" stroke-linecap="round"/>
  </g>
  <!-- vài sợi bún ló ra phía trước -->
  <g fill="none" stroke="#FBF5E3" stroke-width="5" stroke-linecap="round">
    <path d="M244 302 C 262 296 284 295 302 300"/>
    <path d="M254 309 C 270 304 288 303 302 307"/>
  </g>

  <!-- rau thơm ló giữa bún và thịt -->
  <g transform="translate(258 236)">
    <path d="M0 4 L 2 -6" stroke="#2C5E2E" stroke-width="1.6"/>
    <path d="M0 -2 C -5 -10 -2 -20 6 -22 C 12 -15 10 -5 3 0 C 1 1 0 0 0 -2 Z" fill="#3E7B3A" stroke="#2C5E2E" stroke-width="1.5"/>
    <path d="M-4 2 C -10 -3 -10 -12 -4 -16 C 2 -12 3 -4 -1 2 C -2 3 -3 3 -4 2 Z" fill="#4A8B3E" stroke="#2C5E2E" stroke-width="1.4"/>
  </g>

  <!-- bóng ấm dưới cụm thịt -->
  <ellipse cx="308" cy="282" rx="80" ry="15" fill="#A85320" opacity=".16"/>

  <!-- NHIỀU lát thịt nướng bản dẹt XẾP LỚP chồng nhau như xấp lát vừa thái -->
  <use href="#btnThit" transform="translate(300 238) rotate(-8)"/>
  <use href="#btnThit" transform="translate(338 248) rotate(-6)"/>
  <use href="#btnThit" transform="translate(268 262) rotate(-10) scale(1.2)"/>
  <use href="#btnThit" transform="translate(307 276) rotate(-8) scale(1.2)"/>
  <use href="#btnThit" transform="translate(344 287) rotate(-5) scale(1.1)"/>

  <!-- mỡ hành rưới trên thịt -->
  <g stroke="#6F9C48" stroke-width="3.2" stroke-linecap="round" fill="none">
    <path d="M294 232 l11 -2 M338 244 l10 -2 M258 258 l10 -2 M300 270 l11 -2 M340 282 l9 -2"/>
  </g>
  <g fill="#F6C888">
    <circle cx="316" cy="240" r="2.2"/><circle cx="282" cy="270" r="2"/><circle cx="326" cy="284" r="2"/>
  </g>

  <!-- đồ chua sợi cam + trắng trước giữa -->
  <g stroke-linecap="round" fill="none">
    <path d="M198 296 q15 -6 30 -2 M210 304 q15 -5 29 -1 M188 306 q13 -5 25 -1" stroke="#EF9440" stroke-width="5"/>
    <path d="M206 289 q14 -5 27 -1 M226 298 q13 -4 25 0" stroke="#F6F1E1" stroke-width="4.6"/>
  </g>

  <!-- đậu phộng rang giã dối rắc khắp mặt -->
  <g fill="#C9862B" stroke="#9A611C" stroke-width="1.2">
    <circle cx="184" cy="266" r="2.6"/><circle cx="218" cy="258" r="2.4"/><circle cx="250" cy="264" r="2.5"/>
    <circle cx="172" cy="286" r="2.3"/><circle cx="238" cy="290" r="2.5"/><circle cx="206" cy="240" r="2.2"/>
    <circle cx="298" cy="256" r="2.4"/><circle cx="336" cy="270" r="2.2"/><circle cx="376" cy="252" r="2.2"/>
  </g>
  <g fill="#E0A32E">
    <circle cx="196" cy="252" r="1.6"/><circle cx="244" cy="248" r="1.6"/><circle cx="222" cy="298" r="1.6"/><circle cx="320" cy="262" r="1.5"/><circle cx="386" cy="262" r="1.5"/>
  </g>
  <path d="M370 262 l9 -2" fill="none" stroke="#6F9C48" stroke-width="3" stroke-linecap="round"/>

  <!-- chén nước mắm ớt nhỏ -->
  <g transform="translate(96 400)">
    <ellipse cx="0" cy="14" rx="42" ry="12" fill="rgba(15,26,14,.3)"/>
    <path d="M-34 -2 C -32 14 -18 23 0 23 C 18 23 32 14 34 -2 Z" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2"/>
    <ellipse cx="0" cy="-2" rx="28" ry="8.5" fill="#C08128"/>
    <ellipse cx="-7" cy="-3" rx="10" ry="3" fill="#E8B45C" opacity=".9"/>
    <circle cx="6" cy="-2" r="2.6" fill="#C0392B"/><circle cx="-14" cy="-1" r="2.2" fill="#C0392B"/>
    <rect x="14" y="-4" width="5" height="4" rx="1" fill="#F6ECD0" transform="rotate(12 16 -2)"/>
  </g>
  <!-- chanh cạnh chén -->
  <g transform="translate(160 424)">
    <path d="M-16 5 A17 17 0 0 1 16 5 Z" fill="#E4ECB2" stroke="#9CB25C" stroke-width="2.2"/>
    <path d="M0 5 0 -10 M0 5 -11 -3 M0 5 11 -3" stroke="#9CB25C" stroke-width="1.5"/>
  </g>

  <!-- đũa gác góc bàn phải -->
  <g transform="translate(354 420) rotate(-9)">
    <rect x="0" y="0" width="118" height="6.5" rx="3.2" fill="#D9B36A" stroke="#B08A45" stroke-width="1.4"/>
    <rect x="6" y="11" width="118" height="6.5" rx="3.2" fill="#D9B36A" stroke="#B08A45" stroke-width="1.4"/>
    <rect x="0" y="0" width="26" height="6.5" rx="3.2" fill="#C49A52"/>
    <rect x="6" y="11" width="26" height="6.5" rx="3.2" fill="#C49A52"/>
  </g>
</svg>
