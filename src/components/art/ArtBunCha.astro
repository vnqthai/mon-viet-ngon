---
/* Bún chả Hà Nội — bát nước chấm ấm là nhân vật chính: chả viên rẻ quạt dẹt nửa chìm,
   chả miếng ba chỉ, đu đủ ngâm nổi; đĩa bún cuộn ổ + rau thơm; đũa gác bên */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Bát nước chấm bún chả nổi chả viên chả miếng, kèm đĩa bún tươi và rau thơm">
  <defs>
    <linearGradient id="bcCham" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#E8B45C"/><stop offset="1" stop-color="#C08128"/>
    </linearGradient>
    <linearGradient id="bcCha" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#D07B35"/><stop offset="1" stop-color="#A04C1B"/>
    </linearGradient>
    <linearGradient id="bcBowl" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#FDFAF0"/><stop offset="1" stop-color="#E9E2CC"/>
    </linearGradient>
  </defs>
  <circle cx="260" cy="240" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="240" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <g class="steam">
    <path d="M266 232 C 255 208 281 192 270 166 C 263 150 277 138 273 122"/>
    <path d="M326 228 C 316 204 342 190 331 164 C 324 148 338 136 334 120"/>
  </g>
  <ellipse cx="262" cy="420" rx="196" ry="24" fill="rgba(15,26,14,.35)"/>

  <!-- đĩa bún trắng phía sau bên trái -->
  <ellipse cx="118" cy="324" rx="100" ry="28" fill="#F6F1E1"/>
  <ellipse cx="118" cy="320" rx="100" ry="28" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2"/>
  <ellipse cx="118" cy="321" rx="84" ry="22" fill="none" stroke="#E0A32E" stroke-width="2" stroke-dasharray="2 10" stroke-linecap="round"/>
  <!-- vắt bún cuộn dẹt gối lên nhau trên đĩa -->
  <g transform="translate(74 308) rotate(-4)">
    <ellipse cx="0" cy="0" rx="31" ry="12" fill="#FBF5E3" stroke="#D9CCA0" stroke-width="2"/>
    <path d="M-24 -3 a 24 8 0 0 1 44 -2 M -18 3 a 19 7 0 0 1 34 -1 M -10 -7 a 12 5 0 0 1 22 -1" fill="none" stroke="#D9CCA0" stroke-width="2.2" stroke-linecap="round"/>
    <path d="M-28 6 q-6 6 -1 12" fill="none" stroke="#F3EBD3" stroke-width="4" stroke-linecap="round"/>
  </g>
  <g transform="translate(142 302) rotate(3)">
    <ellipse cx="0" cy="0" rx="33" ry="13" fill="#FDFAF0" stroke="#D9CCA0" stroke-width="2"/>
    <path d="M-26 -3 a 26 9 0 0 1 48 -2 M -19 4 a 21 8 0 0 1 38 -1 M -11 -8 a 13 5 0 0 1 24 -1" fill="none" stroke="#D9CCA0" stroke-width="2.2" stroke-linecap="round"/>
  </g>
  <g transform="translate(104 320) rotate(-2)">
    <ellipse cx="0" cy="0" rx="36" ry="13.5" fill="#FFFDF6" stroke="#D9CCA0" stroke-width="2"/>
    <path d="M-28 -3 a 28 9 0 0 1 52 -2 M -21 4 a 23 8 0 0 1 42 -1 M -12 -8 a 14 5 0 0 1 26 -1" fill="none" stroke="#D9CCA0" stroke-width="2.2" stroke-linecap="round"/>
    <path d="M30 7 q7 7 3 14" fill="none" stroke="#F3EBD3" stroke-width="4" stroke-linecap="round"/>
  </g>
  <!-- rau thơm trước đĩa bún -->
  <g transform="translate(40 348) rotate(-14)">
    <path d="M0 0 C -9 -11 -5 -26 7 -30 C 19 -26 22 -11 13 0 C 9 5 3 5 0 0 Z" fill="#6F9C48" stroke="#4E7B36" stroke-width="2"/>
    <path d="M7 -26 L 7 0" stroke="#4E7B36" stroke-width="1.6"/>
  </g>
  <g transform="translate(60 356) rotate(12)">
    <path d="M0 0 C -7 -9 -4 -20 6 -23 C 15 -20 18 -9 11 0 C 8 4 2 4 0 0 Z" fill="#8FBF4D" stroke="#5E8B3A" stroke-width="1.8"/>
    <path d="M6 -19 L 6 0" stroke="#5E8B3A" stroke-width="1.4"/>
  </g>

  <!-- BÁT NƯỚC CHẤM — nhân vật chính -->
  <path d="M164 302 C 170 366 232 402 310 402 C 388 402 450 366 456 302 Z" fill="url(#bcBowl)"/>
  <ellipse cx="310" cy="400" rx="52" ry="10" fill="#D8D0B6"/>
  <ellipse cx="310" cy="300" rx="148" ry="38" fill="#F6F1E1"/>
  <ellipse cx="310" cy="300" rx="148" ry="38" fill="none" stroke="#2C5234" stroke-width="5"/>
  <ellipse cx="310" cy="301" rx="134" ry="32" fill="none" stroke="#E0A32E" stroke-width="2.4" stroke-dasharray="2 11" stroke-linecap="round"/>
  <!-- nước mắm pha ấm màu hổ phách -->
  <ellipse cx="310" cy="302" rx="122" ry="26" fill="url(#bcCham)"/>

  <!-- chả miếng ba chỉ (sau) -->
  <g transform="rotate(7 384 290)">
    <rect x="352" y="280" width="64" height="20" rx="7" fill="#C9803E" stroke="#8A4517" stroke-width="2.4"/>
    <rect x="355" y="284" width="58" height="4.6" rx="2.3" fill="#EFD3A4"/>
    <rect x="355" y="292" width="58" height="3.6" rx="1.8" fill="#EFD3A4" opacity=".85"/>
    <path d="M360 299 h13 M384 300 h15" stroke="#5E2C0C" stroke-width="2.6" stroke-linecap="round"/>
  </g>

  <!-- chả viên 1: rẻ quạt dẹt to bản, vệt nướng chéo -->
  <g transform="rotate(-4 256 302)">
    <path d="M220 300
             C 222 284 240 274 262 274
             C 284 274 300 283 302 297
             C 304 311 290 321 266 322
             C 242 323 218 315 220 300 Z"
          fill="url(#bcCha)" stroke="#7A3A10" stroke-width="2.8"/>
    <path d="M228 288 C 238 279 250 275 263 275 C 277 275 289 279 296 288 L 289 293 C 282 285 273 281 262 281 C 249 281 237 285 234 293 Z" fill="#EFD3A4"/>
    <g stroke="#5E2C0C" stroke-width="5.4" stroke-linecap="round" fill="none">
      <path d="M240 281 L 234 315"/>
      <path d="M262 278 L 257 320"/>
      <path d="M284 281 L 279 315"/>
    </g>
    <path d="M296 306 C 290 313 281 318 270 320 C 282 320 293 314 299 306 Z" fill="#5E2C0C" opacity=".7"/>
    <path d="M222 306 C 220 298 222 291 227 285 C 224 292 223 299 226 307 Z" fill="#5E2C0C" opacity=".6"/>
    <g stroke="#F2B063" stroke-width="2.6" stroke-linecap="round" fill="none" opacity=".95">
      <path d="M250 288 L 246 304"/>
      <path d="M272 286 L 268 305"/>
    </g>
  </g>

  <!-- chả viên 2 nhỏ hơn -->
  <g transform="rotate(8 344 310)">
    <path d="M318 308
             C 319 296 333 288 350 288
             C 367 288 379 295 380 306
             C 381 317 370 325 351 326
             C 332 327 317 320 318 308 Z"
          fill="url(#bcCha)" stroke="#7A3A10" stroke-width="2.6"/>
    <path d="M324 298 C 332 291 341 288 350 288 C 360 289 369 292 374 299 L 368 303 C 363 296 356 293 349 293 C 340 293 331 296 329 302 Z" fill="#EFD3A4"/>
    <g stroke="#5E2C0C" stroke-width="4.6" stroke-linecap="round" fill="none">
      <path d="M334 294 L 330 321"/>
      <path d="M352 291 L 348 324"/>
      <path d="M368 296 L 365 318"/>
    </g>
    <path d="M320 314 C 319 306 321 299 326 294 C 322 300 321 307 323 315 Z" fill="#5E2C0C" opacity=".6"/>
  </g>

  <!-- mặt nước phủ chân chả (nửa chìm trong bát) -->
  <path d="M196 310 C 220 328 268 337 310 337 C 352 337 400 328 424 310 C 400 322 356 328 310 328 C 264 328 220 322 196 310 Z" fill="#C08128" opacity=".45"/>
  <ellipse cx="310" cy="322" rx="112" ry="9" fill="#C08128" opacity=".32"/>
  <path d="M226 306 q16 6 34 6 M366 310 q18 -1 32 -7" fill="none" stroke="#F2C27E" stroke-width="2.6" stroke-linecap="round" opacity=".8"/>
  <ellipse cx="258" cy="290" rx="34" ry="6" fill="#F2C27E" opacity=".45"/>

  <!-- đu đủ + cà rốt ngâm nổi trên mặt -->
  <g transform="rotate(-9 224 318)">
    <rect x="206" y="313" width="36" height="10" rx="4" fill="#F2ECC9" stroke="#B9C77E" stroke-width="1.8"/>
  </g>
  <g transform="rotate(12 398 302)">
    <rect x="382" y="297" width="30" height="9" rx="3.8" fill="#F2ECC9" stroke="#B9C77E" stroke-width="1.8"/>
  </g>
  <g transform="rotate(-6 340 330)">
    <rect x="326" y="326" width="28" height="8" rx="3.4" fill="#F6F0D2" stroke="#B9C77E" stroke-width="1.6"/>
  </g>
  <circle cx="374" cy="322" r="7" fill="#EF9440" stroke="#C86F28" stroke-width="1.8"/>
  <circle cx="374" cy="322" r="3" fill="#F6B879"/>
  <!-- tỏi ớt lấm tấm -->
  <g fill="#C0392B">
    <circle cx="288" cy="330" r="2.4"/><circle cx="330" cy="296" r="2.2"/><circle cx="242" cy="326" r="2.2"/>
  </g>
  <g fill="#F6ECD0">
    <rect x="300" y="324" width="5" height="4" rx="1" transform="rotate(14 302 326)"/>
    <rect x="352" y="333" width="5" height="4" rx="1" transform="rotate(-10 354 335)"/>
  </g>

  <!-- đũa gác góc bàn -->
  <g transform="translate(360 424) rotate(-9)">
    <rect x="0" y="0" width="118" height="6.5" rx="3.2" fill="#D9B36A" stroke="#B08A45" stroke-width="1.4"/>
    <rect x="6" y="11" width="118" height="6.5" rx="3.2" fill="#D9B36A" stroke="#B08A45" stroke-width="1.4"/>
    <rect x="0" y="0" width="26" height="6.5" rx="3.2" fill="#C49A52"/>
    <rect x="6" y="11" width="26" height="6.5" rx="3.2" fill="#C49A52"/>
  </g>

  <!-- ớt + tép tỏi trên bàn trái -->
  <g transform="translate(126 424) rotate(-14)">
    <path d="M0 0C13 2 22 -4 26 -13" fill="none" stroke="#C0392B" stroke-width="8" stroke-linecap="round"/>
    <path d="M26 -15c2-4 6-5 9-4" fill="none" stroke="#4E7B36" stroke-width="4" stroke-linecap="round"/>
  </g>
  <g transform="translate(82 414)">
    <path d="M-9 10 C -15 2 -13 -8 -6 -13 C -4 -15 -1 -14 0 -11 C 1 -14 4 -15 6 -13 C 13 -8 15 2 9 10 C 4 14 -4 14 -9 10 Z" fill="#F3EFE2" stroke="#D8D0B6" stroke-width="1.8"/>
    <path d="M0 -11 L 0 11" stroke="#E3D9BB" stroke-width="1.4"/>
    <path d="M-3 -14 q3 -4 6 0" fill="none" stroke="#C9BC96" stroke-width="1.6" stroke-linecap="round"/>
  </g>
</svg>
