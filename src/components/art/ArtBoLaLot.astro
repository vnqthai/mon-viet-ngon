---
/* Bò nướng lá lốt — họ Lửa (đỏ), nơi nguy nhất là CHẢ GIÒ (cũng là mấy cuốn nằm
   ngang trên dĩa trắng). Ba chỗ cố ý cho lệch hẳn:
   1) VẬT ĐỰNG: VỈ NƯỚNG TRÊN THAN HỒNG — chả giò nằm dĩa sứ trắng bầu dục, gà
      nướng mắc khén nằm mẹt tre, cá lóc nướng trui nằm lá chuối. Vỉ than là vật
      đựng chưa ai dùng trong họ này
   2) MÀU: cuốn XANH SẪM GẦN ĐEN (lá lốt gặp lửa) trên nền đỏ, ngược hẳn với mấy
      cuốn vàng ruộm của chả giò
   3) MỘT CUỐN BUNG HÉ lộ nhân thịt nâu bên trong — luật đợt 15: hình khối lạ thì
      phải cho thấy cấu tạo bên trong, không thì đọc ra đồ vật
   Cuốn xếp CHÉO và so le, không thành hàng ngay ngắn như chả giò.
   id prefix "blo" */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Vỉ nướng trên than hồng xếp mấy cuốn bò lá lốt xanh sẫm sém cạnh, một cuốn bung hé lộ nhân thịt bên trong, cạnh vỉ có chén mắm nêm và lá lốt tươi">
  <defs>
    <linearGradient id="bloEmber" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#E8622A"/><stop offset="1" stop-color="#8E2410"/>
    </linearGradient>
    <g id="bloRoll">
      <path d="M-42 0 C -42 -13 -33 -20 -16 -21 C 2 -22 20 -21 34 -18 C 43 -16 46 -9 44 -1 C 42 8 34 14 20 16 C 4 18 -14 18 -28 15 C -38 13 -42 8 -42 0 Z"
            fill="#2A4A22" stroke="#16300F" stroke-width="2.4" stroke-linejoin="round"/>
      <g fill="none" stroke="#4C7A38" stroke-width="2.2" stroke-linecap="round">
        <path d="M-30 -10 C -22 -2 -18 6 -20 13"/>
        <path d="M-8 -16 C 0 -7 4 2 2 15"/>
        <path d="M16 -18 C 24 -9 28 -1 26 12"/>
      </g>
      <g fill="#101F0B">
        <path d="M-24 -12 L -14 -15 L -10 -9 L -20 -6 Z"/>
        <path d="M8 8 L 18 5 L 22 11 L 12 14 Z"/>
        <path d="M28 -12 L 36 -14 L 39 -9 L 31 -7 Z"/>
      </g>
      <path d="M-40 -4 C -34 -14 -18 -19 -2 -20" fill="none" stroke="#6C9A4E" stroke-width="2.4" stroke-linecap="round"/>
    </g>
  </defs>

  <circle cx="260" cy="240" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="240" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <g class="steam">
    <path d="M212 190 C 201 166 227 150 216 124 C 209 108 223 96 219 82"/>
    <path d="M304 196 C 294 172 320 158 309 132 C 302 116 316 104 312 90"/>
  </g>
  <ellipse cx="256" cy="416" rx="200" ry="25" fill="rgba(15,26,14,.35)"/>

  <!-- ĐẠO CỤ TRÁI: lá lốt tươi còn cuống, mặt gân nổi -->
  <g transform="translate(78 368)">
    <ellipse cx="6" cy="34" rx="56" ry="13" fill="rgba(15,26,14,.3)"/>
    <g transform="rotate(-16)">
      <path d="M0 0 C 6 -26 30 -40 54 -34 C 50 -8 26 6 0 0 Z" fill="#3E7B3A" stroke="#26521F" stroke-width="2.4"/>
      <path d="M2 -2 C 16 -10 34 -20 50 -30" fill="none" stroke="#7FB35B" stroke-width="2.2" stroke-linecap="round"/>
      <g fill="none" stroke="#5E9440" stroke-width="1.5" stroke-linecap="round">
        <path d="M12 -8 C 16 -16 22 -22 30 -26"/>
        <path d="M26 -14 C 30 -21 36 -26 44 -29"/>
      </g>
      <path d="M0 0 C -8 6 -16 10 -24 11" fill="none" stroke="#4E7B36" stroke-width="3.4" stroke-linecap="round"/>
    </g>
    <g transform="translate(26 16) rotate(12) scale(.82)">
      <path d="M0 0 C 6 -26 30 -40 54 -34 C 50 -8 26 6 0 0 Z" fill="#4C8A3C" stroke="#26521F" stroke-width="2.6"/>
      <path d="M2 -2 C 16 -10 34 -20 50 -30" fill="none" stroke="#8CC06A" stroke-width="2.4" stroke-linecap="round"/>
    </g>
  </g>

  <!-- ĐẠO CỤ PHẢI: chén mắm nêm có thơm băm -->
  <g transform="translate(444 380)">
    <ellipse cx="0" cy="20" rx="40" ry="11" fill="rgba(15,26,14,.3)"/>
    <path d="M-32 -4 C -30 11 -17 21 0 21 C 17 21 30 11 32 -4 Z" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2"/>
    <ellipse cx="0" cy="-5" rx="32" ry="9.6" fill="#F6F1E1" stroke="#D8D0B6" stroke-width="2"/>
    <ellipse cx="0" cy="-4" rx="24" ry="6.6" fill="#8A5A2C"/>
    <g fill="#E0B45E"><ellipse cx="-8" cy="-5" rx="3.6" ry="2"/><ellipse cx="6" cy="-3" rx="3.2" ry="1.8"/><ellipse cx="14" cy="-6" rx="2.6" ry="1.5"/></g>
    <g fill="#C3372B"><circle cx="-2" cy="-7" r="1.8"/><circle cx="11" cy="-2" r="1.6"/></g>
  </g>

  <!-- BẾP THAN: lòng bếp + than hồng lấp ló dưới vỉ -->
  <path d="M92 326 C 98 378 168 404 256 404 C 344 404 414 378 420 326 Z" fill="#4A2418" stroke="#2C120A" stroke-width="3"/>
  <ellipse cx="256" cy="326" rx="164" ry="42" fill="#3A1B10"/>
  <g>
    <path d="M158 326 L 186 316 L 200 332 L 172 342 Z" fill="url(#bloEmber)"/>
    <path d="M216 336 L 248 324 L 262 340 L 230 352 Z" fill="url(#bloEmber)"/>
    <path d="M288 324 L 316 314 L 328 330 L 300 340 Z" fill="url(#bloEmber)"/>
    <path d="M340 338 L 364 330 L 374 344 L 350 352 Z" fill="url(#bloEmber)"/>
    <path d="M126 340 L 148 332 L 158 346 L 136 354 Z" fill="url(#bloEmber)"/>
  </g>
  <g fill="#F7B05A" opacity=".85">
    <path d="M170 326 L 182 322 L 188 330 L 176 334 Z"/>
    <path d="M232 338 L 246 332 L 252 340 L 238 346 Z"/>
    <path d="M300 326 L 312 322 L 318 330 L 306 334 Z"/>
  </g>
  <!-- tro trắng phủ mép than -->
  <g fill="#C9B9A4" opacity=".55">
    <path d="M144 348 L 160 342 L 166 350 L 150 356 Z"/>
    <path d="M356 346 L 370 340 L 376 348 L 362 354 Z"/>
  </g>

  <!-- VỈ NƯỚNG: mấy thanh ngang, vẽ trước để cuốn đè lên -->
  <g fill="none" stroke="#6E645A" stroke-width="7" stroke-linecap="round">
    <path d="M112 288 C 156 274 356 274 400 288"/>
    <path d="M104 310 C 152 294 360 294 408 310"/>
    <path d="M100 332 C 150 314 362 314 412 332"/>
  </g>
  <g fill="none" stroke="#9A9086" stroke-width="2.6" stroke-linecap="round">
    <path d="M112 286 C 156 272 356 272 400 286"/>
    <path d="M104 308 C 152 292 360 292 408 308"/>
  </g>
  <!-- khung vỉ hai bên -->
  <g fill="none" stroke="#574F46" stroke-width="6" stroke-linecap="round">
    <path d="M104 276 C 100 296 100 316 104 336"/>
    <path d="M408 276 C 412 296 412 316 408 336"/>
  </g>

  <!-- CUỐN BÒ LÁ LỐT: xếp chéo, so le, cỡ khác nhau, chồng mép lên nhau -->
  <use href="#bloRoll" transform="translate(178 262) rotate(-13)"/>
  <use href="#bloRoll" transform="translate(272 246) rotate(7) scale(.96)"/>
  <use href="#bloRoll" transform="translate(352 274) rotate(-6) scale(.92)"/>
  <use href="#bloRoll" transform="translate(148 306) rotate(11) scale(.9)"/>
  <use href="#bloRoll" transform="translate(322 314) rotate(16) scale(.88)"/>

  <!-- CUỐN BUNG HÉ ở giữa trước: lộ nhân thịt bò băm nâu bên trong -->
  <g transform="translate(238 306) rotate(-4)">
    <path d="M-46 2 C -46 -14 -36 -22 -18 -23 C 2 -24 22 -23 38 -20 C 47 -18 50 -10 48 -1 C 46 9 37 15 22 17 C 4 19 -16 19 -30 16 C -41 14 -46 9 -46 2 Z"
          fill="#2A4A22" stroke="#16300F" stroke-width="2.6" stroke-linejoin="round"/>
    <!-- mép lá bung ra, lộ nhân -->
    <path d="M-14 -18 C 6 -22 26 -20 40 -15 C 34 -4 12 0 -8 -4 C -16 -6 -18 -13 -14 -18 Z"
          fill="#8A4E22" stroke="#5C2E0F" stroke-width="2.2"/>
    <g fill="#B06A2E">
      <path d="M-6 -14 L 4 -17 L 9 -12 L -1 -9 Z"/>
      <path d="M14 -16 L 24 -18 L 28 -13 L 18 -11 Z"/>
      <path d="M2 -7 L 12 -10 L 16 -5 L 6 -3 Z"/>
    </g>
    <g fill="#E0B45E">
      <ellipse cx="20" cy="-8" rx="3.4" ry="2" transform="rotate(-14 20 -8)"/>
      <ellipse cx="-4" cy="-18" rx="3" ry="1.8" transform="rotate(10 -4 -18)"/>
    </g>
    <g fill="none" stroke="#4C7A38" stroke-width="2.2" stroke-linecap="round">
      <path d="M-34 -6 C -26 2 -22 10 -24 16"/>
      <path d="M28 6 C 34 10 40 12 44 10"/>
    </g>
    <g fill="#101F0B">
      <path d="M-30 -12 L -20 -15 L -16 -9 L -26 -6 Z"/>
      <path d="M10 10 L 20 7 L 24 13 L 14 16 Z"/>
    </g>
  </g>

  <!-- đậu phộng rang giã thô rắc quanh -->
  <g fill="#D9A65C" stroke="#A2712C" stroke-width="1.2">
    <ellipse cx="196" cy="342" rx="5" ry="3.4" transform="rotate(-16 196 342)"/>
    <ellipse cx="286" cy="348" rx="4.6" ry="3.2" transform="rotate(12 286 348)"/>
    <ellipse cx="348" cy="340" rx="4.2" ry="2.9" transform="rotate(-8 348 340)"/>
  </g>
</svg>
