    <ellipse cx="222" cy="272" rx="12" ry="6" transform="rotate(12 240 248)" fill="#D9821F" stroke="#A85D14" stroke-width="2"/>
    <ellipse cx="222" cy="272" rx="6.2" ry="2.8" transform="rotate(12 240 248)" fill="#EDA84C"/>
  </g>

  <!-- ngo va tieu -->
  <g fill="#4E7B36">
    <ellipse cx="268" cy="300" rx="5.6" ry="2.4" transform="rotate(-14 276 306)"/>
    <ellipse cx="310" cy="264" rx="5" ry="2.2" transform="rotate(10 322 242)"/>
    <ellipse cx="234" cy="264" rx="4.6" ry="2" transform="rotate(-6 248 272)"/>
  </g>
  <g fill="#2E2318">
    <circle cx="256" cy="278" r="1.6"/><circle cx="300" cy="284" r="1.5"/>
    <circle cx="278" cy="308" r="1.4"/><circle cx="216" cy="290" r="1.4"/>
  </g>
</svg>
