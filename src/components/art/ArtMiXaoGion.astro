    <path d="M158 286 C 194 258 236 246 274 254 C 308 262 340 280 366 300"/>
    <path d="M182 264 C 214 240 250 230 282 240 C 310 249 336 266 356 284"/>
  </g>
  <g fill="none" stroke="#F2CE72" stroke-width="5.4" stroke-linecap="round">
    <path d="M122 334 C 164 306 212 294 262 298 C 308 302 352 318 392 342"/>
    <path d="M134 314 C 174 284 222 272 268 278 C 310 284 350 302 384 326"/>
    <path d="M152 294 C 190 264 234 252 274 260 C 310 268 344 286 372 308"/>
