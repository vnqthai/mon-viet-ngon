    <path d="M258 306 C 274 298 292 296 306 300 C 298 310 276 316 258 306 Z" fill="#4C8A3C" stroke="#2A5322" stroke-width="1.8"/>
    <path d="M262 306 C 276 300 290 299 302 301" fill="none" stroke="#8CC06A" stroke-width="1.6" stroke-linecap="round"/>
    <path d="M320 268 C 336 258 354 256 366 260 C 356 272 336 278 320 268 Z" fill="#3E7B3A" stroke="#26521F" stroke-width="1.8"/>
    <path d="M324 268 C 338 261 352 260 362 262" fill="none" stroke="#8CC06A" stroke-width="1.6" stroke-linecap="round"/>
    <path d="M212 276 C 226 268 242 267 254 270 C 244 280 226 286 212 276 Z" fill="#4C8A3C" stroke="#2A5322" stroke-width="1.7"/>
