      <path d="M-24 6 C -26 -8 -16 -18 -2 -18 C 12 -18 22 -10 24 2 C 18 6 14 2 10 4 C 4 8 -6 10 -14 8 Z"
            fill="#E2603C" stroke="#A8341A" stroke-width="2.2"/>
      <g fill="none" stroke="#F6C0A4" stroke-width="2" stroke-linecap="round">
        <path d="M-14 -4 C -10 -10 -2 -12 4 -10"/>
        <path d="M-4 2 C 2 -4 10 -6 16 -4"/>
      </g>
      <path d="M24 2 L 36 -6 L 34 6 L 24 6 Z" fill="#C94526" stroke="#A8341A" stroke-width="1.8"/>
    </g>
    <g transform="translate(322 292) rotate(14) scale(.9)">
      <path d="M-24 6 C -26 -8 -16 -18 -2 -18 C 12 -18 22 -10 24 2 C 18 6 14 2 10 4 C 4 8 -6 10 -14 8 Z"
            fill="#E2603C" stroke="#A8341A" stroke-width="2.2"/>
      <g fill="none" stroke="#F6C0A4" stroke-width="2" stroke-linecap="round">
        <path d="M-14 -4 C -10 -10 -2 -12 4 -10"/>
        <path d="M-4 2 C 2 -4 10 -6 16 -4"/>
      </g>
      <path d="M24 2 L 36 -6 L 34 6 L 24 6 Z" fill="#C94526" stroke="#A8341A" stroke-width="1.8"/>
    </g>
  </g>

  <!-- MUC KHIA VAY RONG: mieng cuon lai, mat khia carô -->
  <g transform="translate(292 268) rotate(-8)">
    <path d="M-20 8 C -24 -6 -14 -16 0 -16 C 14 -16 24 -6 20 8 C 12 14 -12 14 -20 8 Z"
          fill="#F4EADA" stroke="#C7B594" stroke-width="2.2"/>
    <g fill="none" stroke="#C7B594" stroke-width="1.5" stroke-linecap="round">
