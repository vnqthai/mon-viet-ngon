    <ellipse cx="0" cy="-4" rx="24" ry="6.6" fill="#4A2C14"/>
    <g fill="#B4331F"><circle cx="-8" cy="-5" r="2.2"/><circle cx="6" cy="-2" r="2"/><circle cx="13" cy="-6" r="1.7"/></g>
  </g>

  <!-- DAO CU PHAI: doi dua gac tren ban -->
  <g transform="rotate(-8 428 402)">
    <rect x="360" y="394" width="140" height="7.5" rx="3.75" fill="#9A6538"/>
    <rect x="364" y="405" width="140" height="7.5" rx="3.75" fill="#8A5730"/>
  </g>

  <!-- DIA SAU LONG -->
  <ellipse cx="256" cy="368" rx="188" ry="46" fill="#EFE8D4"/>
  <path d="M68 344 C 76 384 156 408 256 408 C 356 408 436 384 444 344 Z" fill="url(#mxgPlate)"/>
  <ellipse cx="256" cy="344" rx="188" ry="46" fill="url(#mxgPlate)" stroke="#D8D0B6" stroke-width="2"/>
