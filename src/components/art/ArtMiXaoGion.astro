---
/* Mi xao gion — vao nhom Xao cua ho nau, noi SAU hinh da dung chung mot khuon
   ("go do xao nam bep tren dia bau duc trang"): mi xao bo, mien xao cua, muc xao
   thom, rau muong xao toi, bo xao bong thien ly, kho qua xao trung.
   Don bay dung o day la DOI HINH KHOI CUA MON (luat dot 15):
   1) khong phai go det ma la O MI CHIEN PHONG CAO, duong bao GO GHE vi dau soi
      mi chia han ra ngoai — nhin thay ro be day
   2) SOT SANH nau bong phu tu dinh xuong, chay tran xuong chan o mi
   3) dia SAU LONG (phai co, khong thi sot chay ra) chu khong phai dia bau duc det
   Mi xao bo dung ngay canh trong luoi nen phai khac ca DANG lan SAC: ben kia la
   soi mem nau vang nam bep, ben nay la o vang rom phong phu sot nau.
   id prefix "mxg" */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Dia mi xao gion: o mi trung chien vang phong cao, ben tren phu lop sot sanh voi tom, muc va cai ngot, sot chay tran xuong chan o mi">
  <defs>
    <linearGradient id="mxgSauce" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#9A6428"/><stop offset="1" stop-color="#653A13"/>
    </linearGradient>
    <linearGradient id="mxgPlate" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#FDFAF0"/><stop offset="1" stop-color="#E7DFC8"/>
    </linearGradient>
  </defs>

  <circle cx="260" cy="240" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="240" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <g class="steam">
    <path d="M206 168 C 195 144 221 128 210 102 C 203 86 217 74 213 60"/>
    <path d="M262 158 C 252 134 278 120 267 94 C 260 78 274 66 270 52"/>
    <path d="M318 170 C 308 148 332 134 322 110 C 315 94 328 82 325 68"/>
  </g>
  <ellipse cx="256" cy="416" rx="196" ry="24" fill="rgba(15,26,14,.35)"/>

  <!-- DAO CU TRAI: chen nuoc tuong ot -->
