    <path d="M128 330 L 110 324 M 388 336 L 406 330 M 214 240 L 206 226 M 318 234 L 326 218"/>
  </g>
  <!-- Thái: "có phần trống bên dưới đống mì" — thêm hai lớp sợi thấp cho đống mì
       ngồi hẳn xuống mặt dĩa, không còn hở một khoảng nền giữa mì và vành dĩa. -->
  <g fill="none" stroke="#B87A20" stroke-width="6" stroke-linecap="round">
    <path d="M126 344 C 170 322 216 312 262 314 C 308 316 352 328 392 348"/>
    <path d="M136 356 C 180 338 224 330 264 332 C 306 334 346 344 380 358"/>
  </g>
  <g fill="none" stroke="#F2CE72" stroke-width="4.6" stroke-linecap="round">
    <path d="M122 348 C 168 326 216 316 262 318 C 310 320 356 332 396 352"/>
    <path d="M132 360 C 178 342 224 334 264 336 C 308 338 350 348 384 362"/>
  </g>
  <g fill="none" stroke="#F2CE72" stroke-width="4" stroke-linecap="round">
    <path d="M122 348 L 102 346 M 396 352 L 416 350 M 132 360 L 114 360 M 384 362 L 402 362"/>
  </g>

  <!-- SOT SANH: mang LECH HAN sang phai-tren, chi phu MOT PHAN to mi — nua trai
       de tran soi cho thay cai gion. Me sot go ghe, khong tron deu. -->
  <!-- Thái: "có cục bự màu nâu nhìn kỳ ghê luôn á" — bản 3 vẽ sốt thành một khối
       tròn dày nằm đè lên mì. Bản 4: sốt là một LỚP MỎNG BÁM THEO ĐƯỜNG CONG của
       đống mì, mép dưới lượn theo sợi và có mấy nhánh len xuống giữa các sợi. -->
  <path d="M196 300 C 214 268 246 250 282 250 C 320 250 350 268 366 300
           C 350 314 330 322 306 324 C 276 327 232 324 210 316 C 202 312 197 306 196 300 Z"
        fill="url(#mxgSauce)"/>
  <g fill="#7A4A1C">
    <path d="M224 318 C 226 328 232 334 240 336 C 240 328 234 322 232 316 Z"/>
    <path d="M282 324 C 284 336 292 342 300 344 C 300 334 292 328 290 322 Z"/>
    <path d="M334 314 C 338 324 346 328 354 328 C 352 320 344 316 342 310 Z"/>
  </g>
  <path d=" M 232 288 L 270 274 M 250 306 L 284 294" stroke="#C08A3C" stroke-width="4.6" stroke-linecap="round" opacity=".7"/>

  <!-- TOM: than cong khuc, duoi xoe, van ngang -->
  <g>
