---
/* Thịt kho hột vịt — minh họa riêng: cục thịt lớp mỡ, hột vịt nguyên + nửa trái, trái dừa */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Nồi thịt kho hột vịt nước dừa vàng óng">
  <defs>
    <linearGradient id="tkBody" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#B67C45"/><stop offset="1" stop-color="#8A5730"/>
    </linearGradient>
    <linearGradient id="tkSauce" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#D99A45"/><stop offset="1" stop-color="#A86420"/>
    </linearGradient>
  </defs>
  <circle cx="260" cy="240" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="240" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <g class="steam">
    <path d="M225 210 C 214 186 240 170 229 144 C 222 128 236 116 232 102"/>
    <path d="M290 206 C 280 182 306 168 295 142 C 288 126 302 114 298 98"/>
  </g>
  <ellipse cx="260" cy="424" rx="188" ry="24" fill="rgba(15,26,14,.35)"/>

  <!-- nồi đất màu sáng hơn tộ cá -->
  <path d="M92 262 C 96 356 168 416 260 416 C 352 416 424 356 428 262 Z" fill="url(#tkBody)"/>
  <ellipse cx="260" cy="262" rx="168" ry="38" fill="#6E4222"/>
  <ellipse cx="260" cy="258" rx="150" ry="31" fill="url(#tkSauce)"/>
  <path d="M88 258 q-26 -6 -30 -26" fill="none" stroke="#96612F" stroke-width="16" stroke-linecap="round"/>
  <path d="M432 258 q26 -6 30 -26" fill="none" stroke="#96612F" stroke-width="16" stroke-linecap="round"/>
  <path d="M120 320 C 170 342 350 342 400 320" fill="none" stroke="#7E4E27" stroke-width="6" stroke-linecap="round" opacity=".7"/>
  <path d="M108 292 C 165 316 355 316 412 292" fill="none" stroke="#E0A32E" stroke-width="3" stroke-dasharray="2 12" stroke-linecap="round" opacity=".8"/>

  <!-- cục thịt ba rọi: lớp mỡ trắng + nạc nâu -->
  <g transform="rotate(-6 178 248)">
    <rect x="146" y="230" width="64" height="38" rx="9" fill="#A5643A" stroke="#7E4222" stroke-width="2.5"/>
    <path d="M146 242 L 210 242 L 210 234 Q 178 226 146 234 Z" fill="#F3DEB8"/>
    <path d="M148 232 q30 -7 60 0" fill="none" stroke="#8A5730" stroke-width="3.4" stroke-linecap="round"/>
    <path d="M154 254 q12 5 24 1" fill="none" stroke="#C98F5B" stroke-width="2.6" stroke-linecap="round"/>
  </g>
  <g transform="rotate(5 268 252)">
    <rect x="238" y="234" width="60" height="36" rx="9" fill="#B06C3C" stroke="#7E4222" stroke-width="2.5"/>
    <path d="M238 246 L 298 246 L 298 238 Q 268 230 238 238 Z" fill="#F3DEB8"/>
    <path d="M240 236 q28 -7 56 0" fill="none" stroke="#8A5730" stroke-width="3.2" stroke-linecap="round"/>
  </g>

  <!-- hột vịt nguyên (nâu bóng) -->
  <g transform="rotate(-8 344 250)">
    <ellipse cx="344" cy="250" rx="24" ry="29" fill="#D9A050" stroke="#B3762A" stroke-width="2.4"/>
    <path d="M332 234 a20 20 0 0 1 14 -6" fill="none" stroke="#F2CD8C" stroke-width="4" stroke-linecap="round"/>
  </g>
  <g transform="rotate(10 300 268)">
    <ellipse cx="300" cy="268" rx="20" ry="24" fill="#D1964A" stroke="#B3762A" stroke-width="2.2"/>
    <path d="M290 254 a17 17 0 0 1 12 -5" fill="none" stroke="#F2CD8C" stroke-width="3.4" stroke-linecap="round"/>
  </g>
  <!-- hột vịt thứ ba -->
  <g transform="rotate(16 218 266)">
    <ellipse cx="218" cy="266" rx="19" ry="23" fill="#DDA255" stroke="#B3762A" stroke-width="2.2"/>
    <path d="M209 252 a16 16 0 0 1 11 -5" fill="none" stroke="#F2CD8C" stroke-width="3.4" stroke-linecap="round"/>
  </g>

  <!-- bong bóng kho + tiêu + hành -->
  <g fill="#F2CD8C" opacity=".9">
    <circle cx="150" cy="258" r="4"/><circle cx="262" cy="236" r="3.2"/><circle cx="376" cy="266" r="3.6"/>
  </g>
  <g fill="#2E2318">
    <circle cx="196" cy="232" r="2.2"/><circle cx="288" cy="236" r="2"/><circle cx="252" cy="262" r="2.2"/>
  </g>
  <g stroke="#7FA95B" stroke-width="4" stroke-linecap="round" fill="none">
    <path d="M172 228 q10 -6 20 -4"/><path d="M318 232 q10 -5 19 -2"/>
  </g>

  <!-- trái dừa xiêm vạt miệng -->
  <g transform="translate(448 356)">
    <ellipse cx="0" cy="52" rx="50" ry="12" fill="rgba(15,26,14,.35)"/>
    <path d="M-38 10 C -38 -18 -20 -34 0 -34 C 20 -34 38 -18 38 10 C 38 34 22 52 0 52 C -22 52 -38 34 -38 10 Z" fill="#6F9C48" stroke="#4E7B36" stroke-width="2.5"/>
    <path d="M-30 -6 C -24 -22 -12 -30 0 -30" fill="none" stroke="#8FB868" stroke-width="4" stroke-linecap="round"/>
    <ellipse cx="0" cy="-22" rx="19" ry="8" fill="#F3EBD3" stroke="#C9B98E" stroke-width="2"/>
    <ellipse cx="0" cy="-22" rx="8" ry="3.4" fill="#FFFDF6" stroke="#D8C8A8" stroke-width="1.4"/>
  </g>

  <!-- hột vịt sống + ớt trên bàn -->
  <g transform="rotate(-10 84 390)">
    <ellipse cx="84" cy="390" rx="17" ry="21" fill="#F3EFE2" stroke="#D8D0B6" stroke-width="2"/>
    <path d="M76 378 a14 14 0 0 1 10 -4" fill="none" stroke="#FFFDF6" stroke-width="3" stroke-linecap="round"/>
  </g>
  <g transform="translate(112 418) rotate(-14)">
    <path d="M0 0C13 2 22 -4 26 -13" fill="none" stroke="#C0392B" stroke-width="8" stroke-linecap="round"/>
    <path d="M26 -15c2-4 6-5 9-4" fill="none" stroke="#4E7B36" stroke-width="4" stroke-linecap="round"/>
  </g>
</svg>
