---
/* Mì Quảng tôm thịt — tô cạn sợi mì vàng nghệ lộ mặt (nước nhưn xâm xấp), tôm cong chữ C
   có đuôi xòe, trứng cút, đậu phộng; bánh tráng mè nửa vầng trăng cắm sau vành tô */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Tô mì Quảng sợi vàng nghệ với tôm, thịt, trứng cút, bánh tráng mè giòn cắm bên">
  <defs>
    <linearGradient id="mqMi" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#EFC24E"/><stop offset="1" stop-color="#D9982B"/>
    </linearGradient>
    <linearGradient id="mqBowl" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#FDFAF0"/><stop offset="1" stop-color="#E9E2CC"/>
    </linearGradient>
  </defs>
  <circle cx="260" cy="240" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="240" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <g class="steam">
    <path d="M195 240 C 184 214 210 198 199 170 C 192 152 206 140 202 124"/>
    <path d="M258 234 C 248 208 274 194 263 166 C 256 148 270 136 266 118"/>
  </g>
  <ellipse cx="258" cy="416" rx="196" ry="24" fill="rgba(15,26,14,.35)"/>

  <!-- bánh tráng mè nửa vầng trăng cắm sau vành tô -->
  <g transform="rotate(-7 398 264)">
    <path d="M326 268 A 72 72 0 0 1 470 268 Z" fill="#F2DFA9" stroke="#C9935E" stroke-width="3"/>
    <path d="M330 254 A 70 70 0 0 1 466 256" fill="none" stroke="#B3762A" stroke-width="4.5" stroke-linecap="round" opacity=".85"/>
    <path d="M352 240 C 360 230 376 226 386 232 C 392 237 390 246 380 249 C 368 253 354 250 352 240 Z" fill="#D9B36A" opacity=".4"/>
    <path d="M420 228 C 430 224 442 230 443 240 C 443 248 434 252 426 248 C 417 244 414 234 420 228 Z" fill="#D9B36A" opacity=".35"/>
    <g fill="#4A3A20">
      <circle cx="352" cy="256" r="1.8"/><circle cx="366" cy="242" r="1.8"/><circle cx="382" cy="254" r="1.8"/>
      <circle cx="396" cy="238" r="1.8"/><circle cx="412" cy="252" r="1.8"/><circle cx="428" cy="240" r="1.8"/>
      <circle cx="444" cy="254" r="1.8"/><circle cx="374" cy="226" r="1.8"/><circle cx="404" cy="222" r="1.8"/>
      <circle cx="436" cy="226" r="1.8"/><circle cx="358" cy="230" r="1.8"/><circle cx="390" cy="210" r="1.8"/>
      <circle cx="418" cy="210" r="1.8"/><circle cx="404" cy="266" r="1.8"/><circle cx="360" cy="266" r="1.8"/>
      <circle cx="440" cy="266" r="1.8"/>
    </g>
  </g>

  <!-- tô cạn -->
  <path d="M70 302 C 80 356 160 390 260 390 C 360 390 440 356 450 302 Z" fill="url(#mqBowl)"/>
  <ellipse cx="260" cy="388" rx="56" ry="10" fill="#D8D0B6"/>
  <ellipse cx="260" cy="298" rx="192" ry="48" fill="#F6F1E1"/>
  <ellipse cx="260" cy="298" rx="192" ry="48" fill="none" stroke="#2C5234" stroke-width="5"/>
  <ellipse cx="260" cy="299" rx="176" ry="41" fill="none" stroke="#E0A32E" stroke-width="2.5" stroke-dasharray="2 11" stroke-linecap="round"/>

  <!-- sợi mì vàng nghệ lộ mặt, nước nhưn loang nhẹ -->
  <ellipse cx="260" cy="301" rx="160" ry="35" fill="url(#mqMi)"/>
  <ellipse cx="176" cy="312" rx="42" ry="9" fill="#E2703F" opacity=".3"/>
  <ellipse cx="344" cy="314" rx="38" ry="8" fill="#E2703F" opacity=".28"/>
  <g fill="none" stroke="#F6D27A" stroke-width="5" stroke-linecap="round">
    <path d="M112 300 C 146 290 182 300 216 292"/>
    <path d="M136 314 C 172 305 206 315 240 307"/>
    <path d="M246 290 C 280 282 314 291 348 284"/>
    <path d="M262 320 C 296 312 330 320 364 312"/>
    <path d="M310 300 C 340 293 372 300 400 294"/>
    <path d="M170 328 C 200 321 230 328 258 322"/>
  </g>
  <g fill="none" stroke="#C98A20" stroke-width="2.4" stroke-linecap="round" opacity=".85">
    <path d="M128 308 C 158 300 188 308 216 301"/>
    <path d="M258 298 C 288 291 318 298 344 292"/>
    <path d="M204 320 C 232 314 260 320 288 315"/>
    <path d="M318 322 C 344 316 368 321 390 315"/>
  </g>

  <!-- tôm cong chữ C (con lớn) -->
  <g transform="translate(196 292) rotate(-6)">
    <path d="M-16 16 C -30 -2 -14 -24 10 -23 C 27 -22 36 -10 32 3"
          fill="none" stroke="#E86A3E" stroke-width="15" stroke-linecap="round"/>
    <g fill="none" stroke="#C24A22" stroke-width="2.4" stroke-linecap="round">
      <path d="M-16 -8 q7 -7 15 -8"/>
      <path d="M0 -17 q6 -4 13 -3"/>
      <path d="M17 -16 q6 0 10 5"/>
    </g>
    <path d="M-13 11 L -34 3 L -21 17 L -37 20 L -18 23 Z" fill="#D9542E" stroke="#C24A22" stroke-width="1.8" stroke-linejoin="round"/>
    <circle cx="33" cy="6" r="2" fill="#5E2C0C"/>
  </g>
  <!-- tôm nhỏ hơn (lật gương) -->
  <g transform="translate(322 308) rotate(8) scale(-.8 .8)">
    <path d="M-16 16 C -30 -2 -14 -24 10 -23 C 27 -22 36 -10 32 3"
          fill="none" stroke="#E86A3E" stroke-width="15" stroke-linecap="round"/>
    <g fill="none" stroke="#C24A22" stroke-width="2.4" stroke-linecap="round">
      <path d="M-16 -8 q7 -7 15 -8"/>
      <path d="M0 -17 q6 -4 13 -3"/>
      <path d="M17 -16 q6 0 10 5"/>
    </g>
    <path d="M-13 11 L -34 3 L -21 17 L -37 20 L -18 23 Z" fill="#D9542E" stroke="#C24A22" stroke-width="1.8" stroke-linejoin="round"/>
    <circle cx="33" cy="6" r="2" fill="#5E2C0C"/>
  </g>

  <!-- lát ba chỉ: hai vệt mỡ cream -->
  <g transform="rotate(-5 126 308)">
    <rect x="102" y="299" width="48" height="16" rx="5" fill="#C9803E" stroke="#8A4517" stroke-width="2.2"/>
    <path d="M104 301 h44" stroke="#7A3A10" stroke-width="2.6" stroke-linecap="round"/>
    <rect x="104" y="303" width="44" height="4" rx="2" fill="#EFD3A4"/>
    <rect x="104" y="310" width="44" height="3.2" rx="1.6" fill="#EFD3A4" opacity=".85"/>
  </g>
  <g transform="rotate(7 262 322)">
    <rect x="240" y="314" width="44" height="15" rx="4.5" fill="#C4854A" stroke="#8A4517" stroke-width="2.2"/>
    <path d="M242 316 h40" stroke="#7A3A10" stroke-width="2.4" stroke-linecap="round"/>
    <rect x="242" y="318" width="40" height="3.8" rx="1.9" fill="#EFD3A4"/>
    <rect x="242" y="324" width="40" height="3" rx="1.5" fill="#EFD3A4" opacity=".85"/>
  </g>

  <!-- trứng cút -->
  <g transform="rotate(-8 350 290)">
    <ellipse cx="350" cy="290" rx="13" ry="15.5" fill="#FBF3DC" stroke="#D9C79A" stroke-width="2"/>
    <path d="M344 281 a 11 11 0 0 1 8 -3.4" fill="none" stroke="#FFFDF6" stroke-width="3" stroke-linecap="round"/>
  </g>
  <g transform="rotate(10 240 300)">
    <ellipse cx="240" cy="300" rx="11" ry="13" fill="#FBF3DC" stroke="#D9C79A" stroke-width="2"/>
    <path d="M235 292 a 9 9 0 0 1 7 -3" fill="none" stroke="#FFFDF6" stroke-width="2.6" stroke-linecap="round"/>
  </g>

  <!-- đậu phộng rắc + hành ngò -->
  <g fill="#D9A050" stroke="#B3762A" stroke-width="1.5">
    <circle cx="288" cy="292" r="3.6"/><circle cx="182" cy="322" r="3.4"/><circle cx="360" cy="316" r="3.6"/>
    <circle cx="302" cy="330" r="3.2"/><circle cx="222" cy="284" r="3.2"/><circle cx="386" cy="298" r="3.2"/>
  </g>
  <g stroke="#6F9C48" stroke-width="3.4" stroke-linecap="round" fill="none">
    <path d="M158 292 l11 -3 M320 286 l10 -2 M258 334 l10 -2 M398 306 l9 -2"/>
  </g>

  <!-- chén đậu phộng rang -->
  <g>
    <ellipse cx="430" cy="392" rx="38" ry="12" fill="rgba(15,26,14,.3)"/>
    <path d="M398 376 C 400 394 412 404 430 404 C 448 404 460 394 462 376 Z" fill="#FDFAF0" stroke="#D8D0B6" stroke-width="2"/>
    <ellipse cx="430" cy="376" rx="32" ry="9.5" fill="#E9DFC2"/>
    <g fill="#D9A050" stroke="#B3762A" stroke-width="1.4">
      <circle cx="418" cy="374" r="4"/><circle cx="432" cy="371" r="4"/><circle cx="444" cy="375" r="3.8"/>
      <circle cx="425" cy="379" r="3.8"/><circle cx="438" cy="380" r="3.6"/>
    </g>
  </g>

  <!-- ớt xanh nguyên trái + lát chanh trên bàn -->
  <g transform="translate(92 412) rotate(-8)">
    <path d="M0 2 C 18 6 34 0 42 -14" fill="none" stroke="#5E8B3A" stroke-width="10" stroke-linecap="round"/>
    <path d="M42 -17 c 3 -5 8 -7 12 -6" fill="none" stroke="#3E6B2A" stroke-width="4.5" stroke-linecap="round"/>
  </g>
  <g transform="translate(174 430)">
    <path d="M-16 5 A17 17 0 0 1 16 5 Z" fill="#E4ECB2" stroke="#9CB25C" stroke-width="2.2"/>
    <path d="M0 5 0 -10 M0 5 -11 -3 M0 5 11 -3" stroke="#9CB25C" stroke-width="1.5"/>
  </g>
</svg>
