---
/* Tô phở bò — minh họa riêng: đũa gắp bánh phở, nước trong vàng nhạt, quế hồi */
---
<svg viewBox="0 0 520 470" role="img" aria-label="Tô phở bò nóng, đũa gắp bánh phở">
  <defs>
    <linearGradient id="phBroth" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#EFC98A"/><stop offset="1" stop-color="#D9A050"/>
    </linearGradient>
    <linearGradient id="phBowl" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#FDFAF0"/><stop offset="1" stop-color="#E9E2CC"/>
    </linearGradient>
  </defs>
  <circle cx="260" cy="240" r="200" fill="rgba(255,255,255,.055)"/>
  <circle cx="260" cy="240" r="228" fill="none" stroke="rgba(242,214,138,.4)" stroke-width="3" stroke-dasharray="3 16" stroke-linecap="round"/>
  <g class="steam">
    <path d="M160 240 C 149 214 175 198 164 170 C 157 152 171 140 167 124"/>
    <path d="M215 234 C 205 208 231 194 220 166 C 213 148 227 136 223 120"/>
  </g>
  <ellipse cx="255" cy="420" rx="196" ry="24" fill="rgba(15,26,14,.35)"/>

  <!-- tô -->
  <path d="M67 296 C 73 370 157 414 255 414 C 353 414 437 370 443 296 Z" fill="url(#phBowl)"/>
  <ellipse cx="255" cy="412" rx="62" ry="11" fill="#D8D0B6"/>
  <ellipse cx="255" cy="294" rx="188" ry="46" fill="#F6F1E1"/>
  <ellipse cx="255" cy="294" rx="188" ry="46" fill="none" stroke="#2C5234" stroke-width="5"/>
  <ellipse cx="255" cy="295" rx="174" ry="40" fill="none" stroke="#E0A32E" stroke-width="2.5" stroke-dasharray="2 11" stroke-linecap="round"/>

  <!-- nước dùng trong vàng nhạt -->
  <ellipse cx="255" cy="297" rx="158" ry="33" fill="url(#phBroth)"/>
  <ellipse cx="205" cy="290" rx="58" ry="10" fill="#F5D9A4" opacity=".6"/>

  <!-- bánh phở trong tô -->
  <g fill="none" stroke="#FBF5E3" stroke-width="9" stroke-linecap="round">
    <path d="M150 296 C 186 282 232 282 268 294"/>
    <path d="M170 308 C 210 296 258 296 292 306"/>
    <path d="M300 292 C 330 286 356 288 376 296"/>
  </g>
  <g fill="none" stroke="#E8DDBE" stroke-width="2.4" stroke-linecap="round" opacity=".8">
    <path d="M162 300 C 198 288 240 288 272 298"/>
    <path d="M306 296 C 334 290 356 292 372 298"/>
  </g>

  <!-- thịt bò: lát tái hồng mép lượn + lát nạm nâu viền mỡ -->
  <g transform="rotate(-6 192 290)">
    <path d="M164 288 q6 -9 20 -10 q16 -2 30 3 q10 4 8 10 q-4 8 -20 9 q-18 1 -30 -3 q-9 -4 -8 -9Z" fill="#C67C6C" stroke="#A05244" stroke-width="2.2"/>
    <path d="M170 285 q22 -8 46 -1" fill="none" stroke="#EFD9CE" stroke-width="3" stroke-linecap="round"/>
  </g>
  <g transform="rotate(8 258 312)">
    <path d="M234 310 q5 -8 18 -9 q15 -2 27 2 q9 4 7 9 q-3 8 -18 9 q-16 1 -27 -3 q-8 -3 -7 -8Z" fill="#CE8878" stroke="#A05244" stroke-width="2.2"/>
    <path d="M240 307 q19 -7 40 -1" fill="none" stroke="#F0DCD2" stroke-width="2.8" stroke-linecap="round"/>
  </g>
  <g transform="rotate(-4 336 302)">
    <path d="M312 300 q5 -8 17 -9 q15 -2 26 2 q9 4 7 9 q-3 7 -17 8 q-15 1 -26 -3 q-8 -3 -7 -7Z" fill="#A5643A" stroke="#7E4222" stroke-width="2.2"/>
    <path d="M318 297 q18 -6 38 -1" fill="none" stroke="#D9B98A" stroke-width="2.8" stroke-linecap="round"/>
  </g>

  <!-- hành tây lát mỏng + hành lá + ngò -->
  <g fill="none" stroke="#F6EEDC" stroke-width="3.4" stroke-linecap="round" opacity=".95">
    <path d="M226 288 a12 6 0 0 1 20 3 M298 316 a11 6 0 0 1 19 2"/>
  </g>
  <g stroke="#6F9C48" stroke-width="3.6" stroke-linecap="round" fill="none">
    <path d="M180 310 l12 -3 M240 320 l11 -2 M352 292 l11 -3 M310 284 l10 -2"/>
  </g>
  <g fill="#4E7B36">
    <ellipse cx="214" cy="300" rx="6.5" ry="3" transform="rotate(-14 214 300)"/>
    <ellipse cx="286" cy="290" rx="6" ry="2.8" transform="rotate(10 286 290)"/>
  </g>

  <!-- đũa gắp bánh phở lên khỏi tô -->
  <g fill="none" stroke="#FBF5E3" stroke-width="7" stroke-linecap="round">
    <path d="M316 218 C 302 244 300 262 306 282"/>
    <path d="M328 214 C 322 244 322 264 328 284"/>
    <path d="M340 216 C 346 242 348 262 342 282"/>
    <path d="M352 220 C 360 244 360 262 354 278"/>
  </g>
  <g fill="none" stroke="#E8DDBE" stroke-width="2" stroke-linecap="round" opacity=".75">
    <path d="M320 224 C 309 246 307 262 311 278"/>
    <path d="M345 222 C 351 244 352 260 348 276"/>
  </g>
  <g stroke-linecap="round">
    <path d="M436 76 L 318 216" stroke="#9A6538" stroke-width="9"/>
    <path d="M458 92 L 336 222" stroke="#8A5730" stroke-width="9"/>
  </g>

  <!-- quẩy đôi trên bàn -->
  <g transform="translate(70 366) rotate(-12)">
    <rect x="0" y="0" width="104" height="17" rx="8.5" fill="#E8B159" stroke="#B9853F" stroke-width="2"/>
    <rect x="0" y="15" width="104" height="17" rx="8.5" fill="#DDA246" stroke="#B9853F" stroke-width="2"/>
    <path d="M8 8 q44 -6 88 0" fill="none" stroke="#F6E3B2" stroke-width="2.6" stroke-linecap="round"/>
    <path d="M4 16 h96" stroke="#B9853F" stroke-width="1.6"/>
  </g>

  <!-- hoa hồi + quế trên bàn -->
  <g transform="translate(430 380)">
    <g fill="#8A5730" stroke="#6E4222" stroke-width="1.2">
      <ellipse cx="0" cy="-13" rx="4.5" ry="9"/>
      <ellipse cx="12" cy="-5" rx="4.5" ry="9" transform="rotate(70 12 -5)"/>
      <ellipse cx="8" cy="10" rx="4.5" ry="9" transform="rotate(140 8 10)"/>
      <ellipse cx="-8" cy="10" rx="4.5" ry="9" transform="rotate(-140 -8 10)"/>
      <ellipse cx="-12" cy="-5" rx="4.5" ry="9" transform="rotate(-70 -12 -5)"/>
    </g>
    <circle r="4.5" fill="#5E3A1B"/>
  </g>
  <g transform="translate(398 410) rotate(-18)">
    <rect x="0" y="0" width="66" height="13" rx="6" fill="#9A6538" stroke="#6E4222" stroke-width="1.8"/>
    <ellipse cx="2" cy="6.5" rx="4" ry="6.5" fill="#C99668" stroke="#6E4222" stroke-width="1.4"/>
    <ellipse cx="64" cy="6.5" rx="4" ry="6.5" fill="#C99668" stroke="#6E4222" stroke-width="1.4"/>
  </g>
  <!-- chanh + ớt -->
  <g transform="translate(150 414)">
    <path d="M-18 6 A19 19 0 0 1 18 6 Z" fill="#E4ECB2" stroke="#9CB25C" stroke-width="2.2"/>
    <path d="M0 6 0 -11 M0 6 -12 -4 M0 6 12 -4" stroke="#9CB25C" stroke-width="1.6"/>
  </g>
  <circle cx="196" cy="416" r="5.5" fill="none" stroke="#C94434" stroke-width="4"/>
</svg>
