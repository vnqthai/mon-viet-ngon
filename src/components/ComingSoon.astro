import Icon from './Icon.astro';
---
<div class="coming reveal">
  <Icon name="flame" />
  <span><b>Sắp lên mâm:</b> cá nục hấp cuốn bánh tráng, chả ram tôm đất Bình Định,
  bánh canh cá lóc Quảng Trị, xôi ngũ sắc, bún ốc nguội…
  Trang còn thêm món dài dài — ghé lại thường nghen!</span>
  <slot />
