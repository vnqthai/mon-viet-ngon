---
interface Props {
  name: string;        // tên icon, không cần tiền tố "ic-"
  class?: string;
  label?: string;      // nếu có → icon mang nghĩa, có aria-label
}
const { name, class: cls, label } = Astro.props;
---
<svg
  viewBox="0 0 24 24"
  class={cls}
  aria-hidden={label ? undefined : 'true'}
  aria-label={label}
  role={label ? 'img' : undefined}
><use href={`#ic-${name}`} /></svg>
