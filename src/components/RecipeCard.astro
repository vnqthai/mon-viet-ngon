---
import Icon from './Icon.astro';
import RecipeArt from './art/RecipeArt.astro';
import { plain, dishName } from '../utils/rich';
import { familyOf } from '../utils/family';
import { searchText } from '../utils/search';

interface Props { recipe: any }
const { recipe } = Astro.props;
const { id, data } = recipe;

// Nền thẻ mã hóa theo HỌ MÓN — lưới 63 món đọc ra thành từng nhóm ngay từ cái
// liếc đầu. Nhãn vẫn ghi kiểu món cụ thể; màu chỉ báo họ.
const fam = familyOf(data.category);

// Chuỗi tìm kiếm đã bỏ dấu, tính sẵn lúc build để trình duyệt khỏi phải
// chuẩn hóa lại 63 bản ghi mỗi lần gõ phím.
const haystack = searchText(data, plain);
---
<a
  class="rcard reveal"
  href={`/mon/${id}/`}
  data-category={data.category}
  data-region={data.region}
  data-occasions={data.occasions.join('|')}
  data-family={fam}
  data-search={haystack}
>
  <div class="rcard__art" style={`--ground:var(--fam-${fam}); --ground-deep:var(--fam-${fam}-deep)`}>
    <span class="rcard__kind">{data.category}</span>
    <RecipeArt art={data.art} category={data.category} />
    <div class="rcard__wave">
      <svg viewBox="0 0 400 26" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 14 C 60 26 120 2 200 10 C 280 18 340 24 400 12 L 400 26 L 0 26 Z" fill="currentColor"/>
      </svg>
    </div>
  </div>
  <div class="rcard__body">
    <h3>{dishName(data.title)}</h3>
    <p>{plain(data.summary)}</p>
    <div class="rcard__meta">
      <span><Icon name="map" />{data.region}</span>
      <span class="num"><Icon name="clock" />{data.time.total}</span>
      <span><Icon name="level" />{data.difficulty}</span>
      <span class="rcard__go">Vô bếp <Icon name="arrow-right" /></span>
    </div>
  </div>
</a>
