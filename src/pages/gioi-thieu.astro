---
import Base from '../layouts/Base.astro';

/**
 * TRANG GIỚI THIỆU — trả lời ba câu Who/How/Why mà Google nêu trong tài liệu
 * helpful content (SEO.md §6). Mức lộ danh Thái chốt 2026-08-01: THƯƠNG HIỆU,
 * không tên người. Email liên hệ monvietngon.bep@gmail.com (địa chỉ tạo riêng
 * cho site, thêm 2026-08-02 — cố ý KHÔNG đưa vào JSON-LD, chỉ để trên trang:
 * schema email không thêm được gì cho rank mà chỉ thêm mồi cho scraper).
 * Mọi câu trong trang phải ĐÚNG SỰ THẬT — đây là trang cam kết, sai một câu
 * là hỏng cả trang.
 *
 * ⚠️ BẪY XUỐNG DÒNG: compressHTML (Astro bật sẵn) NUỐT khoảng trắng khi thẻ
 * inline (<b>, <a>) đứng ĐẦU DÒNG sau một dòng chữ — "kỹ:\n<b>chính xác" ra
 * thành "kỹ:chính xác". Muốn ngắt dòng thì ngắt GIỮA HAI CHỮ THƯỜNG; thẻ
 * inline phải đứng cùng dòng với chữ liền trước nó.
 */
const crumbs = [
  { name: 'Trang chủ', href: '/' },
  { name: 'Về bếp này', href: null },
];
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.name,
    ...(c.href ? { item: new URL(c.href, Astro.site).href } : {}),
  })),
};
---
<Base
  title="Về bếp Món Việt Ngon — ai nấu và nấu kiểu gì"
  description="Món Việt Ngon là kho công thức món Việt cho bếp nhà — trang này kể bếp làm nội dung ra sao và giữ nguyên tắc gì."
>
<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)} />
<main>
  <section class="section" id="gioi-thieu">
    <div class="wrap">
      <nav class="crumb crumb--page" aria-label="Đường dẫn phân cấp">
        {crumbs.map((c, i) => (
          <>
            {i > 0 && <span class="crumb__sep" aria-hidden="true">›</span>}
            {c.href
              ? <a href={c.href}>{c.name}</a>
              : <span aria-current="page">{c.name}</span>}
          </>
        ))}
      </nav>
      <p class="eyebrow reveal">Người đứng bếp</p>
      <h1 class="reveal">Về <span class="accent">bếp này</span></h1>

      <div class="reveal" style="max-width:68ch">
        <p class="section__lead">
          Món Việt Ngon là kho công thức món Việt cho bếp nhà — mỗi món một
          trang, có bản nấu nhanh cho người bận, bước chi tiết cho người muốn
          cặn kẽ, giỏ đi chợ tự tính theo số người ăn và đồng hồ đếm giờ ngay
          trong trang.
        </p>
        <p>
          Nội dung ở đây được viết theo một nguyên tắc giữ rất
          kỹ: <b>chính xác và trung thực</b> — món ăn ngon vì nó ngon, vậy là đủ.
        </p>
        <p>
          Toàn bộ hình trên site là <b>hình vẽ riêng cho từng món</b>.
        </p>
        <p>
          Bếp đứng tên chung là <b>Món Việt Ngon</b> — cứ
          vào <a href="/mon/">kho món</a> chọn một món mà nấu, đó là lời chào
          quý nhất với một cái bếp. Còn muốn nhắn gì thêm, biên thư
          về <a href="mailto:monvietngon.bep@gmail.com">monvietngon.bep@gmail.com</a>.
        </p>
      </div>
    </div>
  </section>
</main>
</Base>
