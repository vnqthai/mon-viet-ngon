---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import ComingSoon from '../../components/ComingSoon.astro';
import RecipeCard from '../../components/RecipeCard.astro';

const recipes = (await getCollection('recipes')).sort(
  (a, b) => a.data.order - b.data.order
);

// Thứ tự chip cố định, không để phụ thuộc thứ tự món — thêm món mới không làm
// hàng lọc nhảy lung tung.
const CAT_ORDER = ['Món nước', 'Bún trộn', 'Canh', 'Lẩu', 'Cháo',
  'Kho', 'Xào', 'Hấp', 'Cơm', 'Xôi', 'Bánh', 'Bánh mì', 'Chiên', 'Nướng', 'Cuốn', 'Gỏi', 'Chè'];
const OCC_ORDER = ['Cơm nhà', 'Bữa sáng', 'Đãi khách', 'Nhậu lai rai', 'Ăn chơi', 'Cho bé', 'Cỗ Tết'];
const REGION_ORDER = ['Miền Bắc', 'Miền Trung', 'Miền Nam', 'Miền Tây',
  'Tây Bắc', 'Tây Nguyên', 'Cả nước'];

const has = (list: string[], pick: (r: any) => string | string[]) =>
  list.filter((v) => recipes.some((r) => {
    const got = pick(r);
    return Array.isArray(got) ? got.includes(v) : got === v;
  }));

const categories = has(CAT_ORDER, (r) => r.data.category);
const occasions = has(OCC_ORDER, (r) => r.data.occasions);
const regions = has(REGION_ORDER, (r) => r.data.region);
---
<Base
  title="Món ngon — Món Việt Ngon"
  description="Kho công thức món Việt chuẩn vị: canh, kho, xào, cuốn… hướng dẫn từng bước, có bản nấu nhanh cho người bận rộn."
  active="mon"
>
<main>
  <section class="section" id="danh-muc">
    <div class="wrap">
      <p class="eyebrow reveal">Hôm nay nhà mình ăn gì?</p>
      <h2 class="reveal">Kho món ngon <span class="accent">chuẩn vị Việt</span></h2>
      <p class="section__lead reveal">
        Món nào cũng có bản nấu nhanh, giỏ đi chợ tự tính khẩu phần và đồng hồ
        đếm giờ ngay trong trang. Gõ tên món, tên nguyên liệu, hay lọc cho lẹ.
      </p>

      <div class="finder reveal">
        <div class="finder__search">
          <Icon name="search" />
          <input
            type="search" id="q" autocomplete="off" spellcheck="false"
            placeholder="Tìm món hoặc nguyên liệu…"
            aria-label="Tìm món hoặc nguyên liệu"
          />
          <button type="button" id="qClear" class="finder__clear" aria-label="Xóa ô tìm kiếm" hidden>
            <Icon name="close" />
          </button>
        </div>
        <p class="finder__hint">Gõ không dấu cũng ra — “ca kho” tìm thấy “cá kho tộ”.</p>

        <!-- Trên điện thoại, ba hàng chip gộp vào một bảng đóng/mở: kệ cuộn ngang
             thì bộ lọc nằm ngoài màn hình, mà cái gì không thấy thì không ai bấm. -->
        <button type="button" id="filterToggle" class="finder__toggle" aria-expanded="false" aria-controls="finderAxes">
          <span>Lọc món</span>
          <span class="finder__toggle__n num" id="filterCount" hidden></span>
        </button>

        <div class="finder__axes" id="finderAxes">
        <div class="shelf" role="group" aria-label="Lọc theo kiểu món">
          <span class="shelf__label">Kiểu món</span>
          <div class="shelf__rail">
            <button class="chip is-active" data-f="cat" data-v="all" type="button">Tất cả</button>
            {categories.map((c) => <button class="chip" data-f="cat" data-v={c} type="button">{c}</button>)}
          </div>
        </div>
        <div class="shelf" role="group" aria-label="Lọc theo dịp">
          <span class="shelf__label">Theo dịp</span>
          <div class="shelf__rail">
            <button class="chip is-active" data-f="occ" data-v="all" type="button">Tất cả</button>
            {occasions.map((o) => <button class="chip" data-f="occ" data-v={o} type="button">{o}</button>)}
          </div>
        </div>
        <div class="shelf" role="group" aria-label="Lọc theo miền">
          <span class="shelf__label">Miền</span>
          <div class="shelf__rail">
            <button class="chip is-active" data-f="region" data-v="all" type="button">Tất cả</button>
            {regions.map((r) => <button class="chip" data-f="region" data-v={r} type="button">{r}</button>)}
          </div>
        </div>
        </div>

        <p class="finder__count" aria-live="polite">
          <b class="num" id="cnt">{recipes.length}</b> món
          <span id="cntWhy"></span>
          <button type="button" id="reset" class="finder__reset" hidden>bỏ hết lọc</button>
        </p>
      </div>

      <div class="rcard-grid" id="recipeGrid">
        {recipes.map((r) => <RecipeCard recipe={r} search />)}
      </div>
      <button type="button" id="moreBtn" class="finder__more" hidden></button>
      <div class="filter-empty" id="filterEmpty">
        Chưa có món nào khớp — thử nới bớt một tiêu chí, hoặc gõ tên nguyên liệu xem sao.
      </div>

      <ComingSoon />
    </div>
  </section>
</main>

<script>
  // Bỏ dấu + bỏ dấu câu y hệt utils/search.ts. NFD KHÔNG tách được đ/Đ nên phải
  // thay tay. Hai chỗ này phải giống nhau từng nét, lệch một cái là tìm trật.
  const deaccent = (s: string) =>
    s.normalize('NFD').replace(/[̀-ͯ]/g, '')
      .replace(/đ/g, 'd').replace(/Đ/g, 'D').toLowerCase();
  const tidy = (s: string) => deaccent(s).replace(/[^a-z0-9]+/g, ' ').trim();

  const grid = document.getElementById('recipeGrid');
  const cards = [...document.querySelectorAll<HTMLElement>('#recipeGrid .rcard')];
  const empty = document.getElementById('filterEmpty');
  const cnt = document.getElementById('cnt');
  const cntWhy = document.getElementById('cntWhy');
  const reset = document.getElementById('reset') as HTMLButtonElement | null;
  const q = document.getElementById('q') as HTMLInputElement | null;
  const qClear = document.getElementById('qClear') as HTMLButtonElement | null;
  const toggle = document.getElementById('filterToggle');
  const axes = document.getElementById('finderAxes');
  const fCount = document.getElementById('filterCount');
  const moreBtn = document.getElementById('moreBtn') as HTMLButtonElement | null;

  // Cắt sẵn âm tiết một lần lúc vào trang, khỏi cắt lại 64 lần mỗi phím gõ.
  const items = cards.map((el, i) => ({
    i, el,
    name: (el.dataset.n || '').split(' ').filter(Boolean),
    meta: (el.dataset.m || '').split(' ').filter(Boolean),
    ing: (el.dataset.i || '').split(' ').filter(Boolean),
    nameStr: el.dataset.n || '',
    ingStr: el.dataset.i || '',
  }));
  type Item = (typeof items)[number];

  const state: Record<string, string> = { cat: 'all', occ: 'all', region: 'all' };
  let query = '';
  // Mở "xem thêm" là chuyện của riêng một lần tìm — gõ tiếp thì đóng lại.
  let moreOpen = false;
  let lastOrder = '';

  // Bộ lọc phản chiếu vào URL: trang chủ trỏ thẳng vào /mon/?dip=Bữa sáng được,
  // và người dùng lưu / gửi lại đường dẫn thì vẫn ra đúng cái đang xem.
  const PARAM: Record<string, string> = { cat: 'kieu', occ: 'dip', region: 'mien' };

  function syncUrl() {
    const p = new URLSearchParams();
    for (const axis of ['cat', 'occ', 'region']) {
      if (state[axis] !== 'all') p.set(PARAM[axis], state[axis]);
    }
    const raw = q?.value.trim();
    if (raw) p.set('q', raw);
    const qs = p.toString();
    history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
  }

  function readUrl() {
    const p = new URLSearchParams(location.search);
    for (const axis of ['cat', 'occ', 'region']) {
      const v = p.get(PARAM[axis]);
      if (v) state[axis] = v;
    }
    const raw = p.get('q');
    if (raw && q) { q.value = raw; query = tidy(raw); }
    for (const b of document.querySelectorAll<HTMLElement>('[data-f]')) {
      b.classList.toggle('is-active', b.dataset.v === state[b.dataset.f!]);
    }
  }

  /**
   * Chấm điểm THEO TRƯỜNG chứ không dò chuỗi: trúng nguyên âm tiết trong TÊN
   * MÓN (12đ) phải ăn đứt trúng trong nguyên liệu (4đ) — bản cũ gộp một chuỗi
   * rồi includes() nên gõ "ca" ra 58/64 món, "hanh" ra 60/64.
   *
   * Chỉ chữ CUỐI — chữ đang gõ dở — mới được khớp đầu chữ; mấy chữ trước phải
   * khớp trọn âm tiết. Bỏ luật này thì "ca kho" lôi cả "canh khổ qua" về.
   *
   * Thiếu một chữ là loại luôn (AND), không cộng dồn kiểu OR.
   */
  function score(it: Item, toks: string[]): number {
    let total = 0;
    for (let i = 0; i < toks.length; i++) {
      const t = toks[i], last = i === toks.length - 1;
      let best = 0;
      for (const s of it.name) best = Math.max(best, s === t ? 12 : last && s.startsWith(t) ? 9 : 0);
      for (const s of it.meta) best = Math.max(best, s === t ? 6 : last && s.startsWith(t) ? 5 : 0);
      for (const s of it.ing) best = Math.max(best, s === t ? 4 : last && s.startsWith(t) ? 3 : 0);
      if (best === 0) return 0;
      total += best;
    }
    // Trúng nguyên cụm liền mạch mới là thứ người ta thật sự gõ ra: "pho bo"
    // phải bỏ xa món chỉ có "bò" nằm trong nguyên liệu.
    if (it.nameStr.includes(query)) total += 30;
    else if (it.ingStr.includes(query)) total += 6;
    return total;
  }

  /**
   * Mọi chữ đều trúng TÊN MÓN → nhóm trên, hiện ngay; còn lại xuống nhóm dưới,
   * giấu sau nút "xem thêm".
   *
   * Đây là chỗ thay cho một con số ngưỡng: đo trên 64 món thì nhóm trên luôn
   * cao hơn nhóm dưới ít nhất 8 điểm, không món nào ngoại lệ — nên hỏi thẳng
   * "có trúng tên không" vừa gọn vừa khỏi phải chỉnh tay khi thêm món.
   * Luật khớp phải y hệt score(), lệch một chút là chia nhóm sai.
   */
  const inName = (it: Item, toks: string[]) =>
    toks.every((t, i) =>
      it.name.some((s) => s === t || (i === toks.length - 1 && s.startsWith(t))));

  function apply() {
    const toks = query ? query.split(' ') : [];

    // Chip lọc trước, xếp hạng sau — xếp hạng chỉ chạy trên số món còn lại.
    const pass = items.filter(({ el }) => {
      const occs = (el.dataset.occasions || '').split('|');
      return (state.cat === 'all' || el.dataset.category === state.cat) &&
        (state.occ === 'all' || occs.includes(state.occ)) &&
        // Món "Cả nước" là một miền như mọi miền khác — KHÔNG hiện ở mọi bộ lọc
        // nữa, trước đây làm vậy nên lọc "Miền Bắc" lại lẫn cả chục món khác.
        (state.region === 'all' || el.dataset.region === state.region);
    });

    let show = pass;
    let tucked: Item[] = [];
    if (toks.length) {
      const hit = pass.map((it) => ({ it, s: score(it, toks) }))
        .filter((x) => x.s > 0)
        .sort((a, b) => b.s - a.s || a.it.i - b.it.i)
        .map((x) => x.it);
      const named = hit.filter((it) => inName(it, toks));
      // Không món nào trúng tên thì nguyên liệu là tất cả những gì có — hiện
      // thẳng ra, đừng bắt bấm thêm một nút nữa mới thấy.
      tucked = named.length ? hit.filter((it) => !inName(it, toks)) : [];
      show = named.length && !moreOpen ? named : hit;
    }

    const vis = new Set(show.map((it) => it.el));
    for (const it of items) it.el.hidden = !vis.has(it.el);

    // Xếp lại DOM thật, không dùng CSS `order`: thứ tự Tab phải đi đúng thứ tự
    // mắt nhìn thấy. 64 thẻ nên đổi chỗ thoải mái, và chỉ đụng khi thứ tự đổi.
    const seq = toks.length ? show : items;
    const sig = seq.map((it) => it.i).join(',');
    if (sig !== lastOrder) {
      const frag = document.createDocumentFragment();
      for (const it of seq) frag.appendChild(it.el);
      grid?.appendChild(frag);
      lastOrder = sig;
    }

    const nAxis = ['cat', 'occ', 'region'].filter((a) => state[a] !== 'all').length;
    // Thẻ nhảy lên đầu mà chưa từng lọt vào màn hình thì vẫn đang opacity:0 —
    // observer bên site.js chưa kịp bắn. Đang lọc thì cho hiện luôn, khỏi nháy.
    if (toks.length || nAxis) for (const it of show) it.el.classList.add('is-in');

    if (cnt) cnt.textContent = String(show.length);
    const bits: string[] = [];
    if (state.cat !== 'all') bits.push(state.cat);
    if (state.occ !== 'all') bits.push(state.occ);
    if (state.region !== 'all') bits.push(state.region);
    if (query) bits.push(`“${q?.value.trim()}”`);
    if (cntWhy) cntWhy.textContent = bits.length ? ' — ' + bits.join(' · ') : '';
    if (reset) reset.hidden = bits.length === 0;
    // Nút "Lọc món" mang theo số bộ lọc đang bật, để đóng bảng lại vẫn biết
    if (fCount) { fCount.textContent = String(nAxis); fCount.hidden = nAxis === 0; }
    if (moreBtn) {
      moreBtn.hidden = tucked.length === 0;
      moreBtn.textContent = moreOpen
        ? 'Thu gọn — chỉ xem món trúng tên'
        : `Còn ${tucked.length} món có “${q?.value.trim()}” trong nguyên liệu — xem thêm`;
    }
    if (empty) empty.classList.toggle('is-show', show.length === 0);
    if (qClear) qClear.hidden = query === '';
    syncUrl();
  }

  // Bấm lại chip đang chọn = bỏ chọn, quay về "Tất cả"
  for (const btn of document.querySelectorAll<HTMLElement>('[data-f]')) {
    btn.addEventListener('click', () => {
      const axis = btn.dataset.f!, val = btn.dataset.v!;
      state[axis] = state[axis] === val && val !== 'all' ? 'all' : val;
      for (const b of document.querySelectorAll<HTMLElement>(`[data-f="${axis}"]`)) {
        b.classList.toggle('is-active', b.dataset.v === state[axis]);
      }
      apply();
    });
  }

  // Gõ tiếp là một lượt tìm khác — thu "xem thêm" lại, không thì nhóm nguyên
  // liệu của từ khóa cũ còn dính lại ở từ khóa mới.
  q?.addEventListener('input', () => { query = tidy(q.value); moreOpen = false; apply(); });
  qClear?.addEventListener('click', () => {
    if (q) q.value = ''; query = ''; moreOpen = false; apply(); q?.focus();
  });
  moreBtn?.addEventListener('click', () => { moreOpen = !moreOpen; apply(); });
  reset?.addEventListener('click', () => {
    state.cat = state.occ = state.region = 'all';
    query = ''; moreOpen = false; if (q) q.value = '';
    for (const b of document.querySelectorAll<HTMLElement>('[data-f]')) {
      b.classList.toggle('is-active', b.dataset.v === 'all');
    }
    apply();
  });

  toggle?.addEventListener('click', () => {
    const open = axes?.classList.toggle('is-open') ?? false;
    toggle.setAttribute('aria-expanded', String(open));
  });

  readUrl();
  // Vào trang từ liên kết đã lọc sẵn thì mở bảng ra, không thì người dùng
  // thấy danh sách ngắn mà không hiểu vì sao.
  if (['cat', 'occ', 'region'].some((a) => state[a] !== 'all')) {
    axes?.classList.add('is-open');
    toggle?.setAttribute('aria-expanded', 'true');
  }
  apply();
</script>
</Base>
