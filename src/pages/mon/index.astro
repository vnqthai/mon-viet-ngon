---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ComingSoon from '../../components/ComingSoon.astro';
import RecipeCard from '../../components/RecipeCard.astro';

const recipes = (await getCollection('recipes')).sort(
  (a, b) => a.data.order - b.data.order
);
const categories = [...new Set(recipes.map((r) => r.data.category))];
const regions = [...new Set(recipes.map((r) => r.data.region))];
const OCC_ORDER = ['Nhậu lai rai', 'Ăn chơi', 'Đãi khách', 'Cho bé'];
const occasions = OCC_ORDER.filter((o) => recipes.some((r) => r.data.occasions.includes(o as any)));
---
<Base
  title="Món ngon — Món Việt Ngon"
  description="Kho công thức món Việt chuẩn vị: canh, kho, xào, cuốn… hướng dẫn từng bước, có bản nấu nhanh cho người bận rộn."
  active="mon"
>
<main>
  <section class="section" id="danh-muc">
    <div class="wrap">
      <p class="eyebrow reveal">Hôm nay nhà mình ăn gì?</p>
      <h2 class="reveal">Kho món ngon <span class="accent">chuẩn vị Việt</span></h2>
      <p class="section__lead reveal">
        Món nào cũng có bản nấu nhanh, giỏ đi chợ tự tính khẩu phần và đồng hồ
        đếm giờ ngay trong trang. Lọc theo kiểu món hoặc theo miền cho lẹ.
      </p>

      <div class="filter-bar reveal" role="group" aria-label="Lọc theo kiểu món">
        <span class="filter-bar__label">Kiểu món</span>
        <button class="filter-chip is-active" data-filter-cat="all" type="button">Tất cả</button>
        {categories.map((c) => (
          <button class="filter-chip" data-filter-cat={c} type="button">{c}</button>
        ))}
      </div>
      <div class="filter-bar reveal" role="group" aria-label="Lọc theo dịp">
        <span class="filter-bar__label">Theo dịp</span>
        <button class="filter-chip is-active" data-filter-occ="all" type="button">Tất cả</button>
        {occasions.map((o) => (
          <button class="filter-chip" data-filter-occ={o} type="button">{o}</button>
        ))}
      </div>
      <div class="filter-bar filter-bar--last reveal" role="group" aria-label="Lọc theo miền">
        <span class="filter-bar__label">Miền</span>
        <button class="filter-chip is-active" data-filter-region="all" type="button">Cả nước</button>
        {regions.filter((r) => r !== 'Cả nước').map((r) => (
          <button class="filter-chip" data-filter-region={r} type="button">{r}</button>
        ))}
      </div>

      <div class="rcard-grid" id="recipeGrid">
        {recipes.map((r) => <RecipeCard recipe={r} />)}
      </div>
      <div class="filter-empty" id="filterEmpty">
        Chưa có món nào khớp bộ lọc này — thử nới bớt một tiêu chí nghen!
      </div>

      <ComingSoon />
    </div>
  </section>
</main>

<script>
  const catBtns = [...document.querySelectorAll('[data-filter-cat]')];
  const occBtns = [...document.querySelectorAll('[data-filter-occ]')];
  const regionBtns = [...document.querySelectorAll('[data-filter-region]')];
  const cards = [...document.querySelectorAll('#recipeGrid .rcard')];
  const empty = document.getElementById('filterEmpty');
  let cat = 'all';
  let occ = 'all';
  let region = 'all';

  function apply() {
    let shown = 0;
    cards.forEach((card) => {
      const cardOccs = (card.dataset.occasions || '').split('|');
      const ok =
        (cat === 'all' || card.dataset.category === cat) &&
        (occ === 'all' || cardOccs.includes(occ)) &&
        (region === 'all' || card.dataset.region === region || card.dataset.region === 'Cả nước');
      card.style.display = ok ? '' : 'none';
      if (ok) shown++;
    });
    if (empty) empty.classList.toggle('is-show', shown === 0);
  }
  // Bấm chip đang chọn lần nữa = bỏ chọn, quay về "Tất cả"/"Cả nước"
  catBtns.forEach((b) =>
    b.addEventListener('click', () => {
      const next = b.dataset.filterCat;
      cat = cat === next && next !== 'all' ? 'all' : next;
      catBtns.forEach((x) => x.classList.toggle('is-active', x.dataset.filterCat === cat));
      apply();
    })
  );
  occBtns.forEach((b) =>
    b.addEventListener('click', () => {
      const next = b.dataset.filterOcc;
      occ = occ === next && next !== 'all' ? 'all' : next;
      occBtns.forEach((x) => x.classList.toggle('is-active', x.dataset.filterOcc === occ));
      apply();
    })
  );
  regionBtns.forEach((b) =>
    b.addEventListener('click', () => {
      const next = b.dataset.filterRegion;
      region = region === next && next !== 'all' ? 'all' : next;
      regionBtns.forEach((x) => x.classList.toggle('is-active', x.dataset.filterRegion === region));
      apply();
    })
  );
</script>
</Base>
