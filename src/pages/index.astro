---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import RecipeCard from '../components/RecipeCard.astro';
import ComingSoon from '../components/ComingSoon.astro';
import CanhChuaArt from '../components/art/CanhChuaArt.astro';
import { tickerDuration } from '../utils/ticker';

const recipes = (await getCollection('recipes')).sort(
  (a, b) => a.data.order - b.data.order
);
// 12 thẻ ở mốc 47 món (trước là 9). Lý do đổi: đợt 7 toàn món họ "Chan & húp",
// mà 9 ô thì không cùng lúc chứa nổi đủ 5 họ màu + 6 vùng + một món mở màn kiểu
// món mới. 12 cũng chia hết cho 2·3·4 cột nên lưới không còn hàng cụt.
const featured = recipes.filter((r) => r.data.featured).slice(0, 12);
const regionCount = new Set(recipes.map((r) => r.data.region)).size;

// Lối vào theo trục: bấm là sang /mon/ đã lọc sẵn. Kèm số món để người đọc biết
// trước cửa nào rộng cửa nào hẹp, khỏi bấm vào rồi mới thấy có 2 món. Con số đó
// là thứ thanh lọc ở /mon/ KHÔNG có — nên ba nhóm ở đây không phải bản sao của
// nó. Thứ tự nhóm phải khớp /mon/ (Kiểu món → Dịp → Miền): bấm từ đây sang thì
// bên đó tự mở bảng lọc, và trục vừa bấm phải nằm đúng chỗ mắt đang chờ.
const CAT_ORDER = ['Món nước', 'Bún trộn', 'Canh', 'Lẩu', 'Cháo',
  'Kho', 'Xào', 'Hấp', 'Cơm', 'Xôi', 'Bánh', 'Bánh mì', 'Chiên', 'Nướng', 'Cuốn', 'Gỏi', 'Chè'];
const OCC_ORDER = ['Cơm nhà', 'Bữa sáng', 'Đãi khách', 'Nhậu lai rai', 'Ăn chơi', 'Cho bé', 'Cỗ Tết'];
const REGION_ORDER = ['Miền Bắc', 'Miền Trung', 'Miền Nam', 'Miền Tây', 'Tây Bắc', 'Tây Nguyên', 'Cả nước'];

const catGates = CAT_ORDER
  .map((name) => ({ name, n: recipes.filter((r) => r.data.category === name).length }))
  .filter((g) => g.n > 0);
const occGates = OCC_ORDER
  .map((name) => ({ name, n: recipes.filter((r) => r.data.occasions.includes(name as any)).length }))
  .filter((g) => g.n > 0);
const regionGates = REGION_ORDER
  .map((name) => ({ name, n: recipes.filter((r) => r.data.region === name).length }))
  .filter((g) => g.n > 0);

/* Băng chuyền chữ. Mỗi mục `slug` là một món có thật -> bấm vô là sang thẳng
   trang món đó; mục không có `slug` là câu chốt, để trơn không phải liên kết.
   Chữ ở đây CỐ Ý không phải tiêu đề món: tiêu đề đã nằm đầy trong lưới thẻ ngay
   dưới, băng chuyền là chỗ kể thêm một chi tiết khiến người ta thèm. */
const tickerItems = [
  { slug: 'canh-chua-ca-loc', text: 'Canh chua cá lóc miền Tây' },
  { slug: 'pho-bo', text: 'Phở bò quế hồi thơm lựng' },
  { slug: 'pho-ga', text: 'Phở gà lá chanh thái chỉ' },
  { slug: 'bun-cha-ha-noi', text: 'Bún chả Hà Nội chả cháy cạnh' },
  { slug: 'ga-nuong-mac-khen', text: 'Gà nướng mắc khén Tây Bắc' },
  { slug: 'mi-quang-tom-thit', text: 'Mì Quảng nước nhưn đậm đà' },
  { slug: 'bun-bo-hue', text: 'Bún bò Huế cay nồng sả ruốc' },
  { slug: 'bun-rieu-cua', text: 'Bún riêu cua nước chua thanh, riêu nổi tảng' },
  { slug: 'com-tam-suon-nuong', text: 'Cơm tấm sườn nướng khói thơm' },
  { slug: 'com-ga-hoi-an', text: 'Cơm gà Hội An vàng mơ' },
  { slug: 'ca-kho-to', text: 'Cá kho tộ lửa liu riu' },
  { slug: 'banh-xeo-mien-tay', text: 'Bánh xèo giòn nghe xèo là thèm' },
  { slug: 'cha-gio', text: 'Chả giò nổ giòn mâm tiệc' },
  { slug: 'goi-cuon-tom-thit', text: 'Gỏi cuốn tôm thịt thanh mát' },
  { slug: 'hu-tieu-nam-vang', text: 'Hủ tiếu Nam Vang tôm trứng cút' },
  { slug: 'pho-kho-gia-lai', text: 'Phở khô Gia Lai phở hai tô' },
  { slug: 'bun-dau-mam-tom', text: 'Bún đậu mắm tôm dọn cả mẹt' },
  { slug: 'mi-vit-tiem', text: 'Mì vịt tiềm đùi vịt giòn da' },
  { slug: 'mien-ga', text: 'Miến gà sợi dai nước ngọt thanh' },
  { slug: 'mien-xao-cua', text: 'Miến xào cua thớ ngọt nguyên' },
  { slug: 'lau-mam', text: 'Lẩu mắm rổ rau chất núi' },
  { slug: 'lau-ga-la-e', text: 'Lẩu gà lá é thơm the muối ớt xanh' },
  { slug: 'lau-thai', text: 'Lẩu Thái chua cay dậy sả' },
  { slug: 'lau-de-nau-chao', text: 'Lẩu dê nấu chao béo bùi khoai môn' },
  { slug: 'lau-bo-da-lat', text: 'Lẩu bò Đà Lạt chấm bánh mì' },
  { slug: 'che-buoi', text: 'Chè bưởi cùi giòn sần sật' },
  { slug: 'banh-chung', text: 'Bánh chưng vuông lá dong, luộc suốt đêm' },
  { slug: 'xoi-ngu-sac', text: 'Xôi ngũ sắc năm màu nhuộm từ cây lá' },
  { slug: 'xoi-gac', text: 'Xôi gấc đỏ au cho mâm cỗ' },
  { slug: 'banh-da-cua', text: 'Bánh đa cua sợi đỏ nâu đất cảng' },
  { slug: 'che-thai', text: 'Chè Thái sầu riêng mít sợi' },
  { slug: 'che-ba-ba', text: 'Chè bà ba ba thứ khoai một nồi cốt dừa' },
  { slug: 'chao-luon-nghe-an', text: 'Cháo lươn xứ Nghệ hạt gạo nở bung' },
  { slug: 'chao-ga', text: 'Cháo gà gạo rang, gừng thái sợi' },
  { slug: 'chao-long', text: 'Cháo lòng ngọt nước luộc, lòng giòn sựt' },
  { slug: 'banh-beo-hue', text: 'Bánh bèo Huế chén nhỏ lõm giữa, tôm chấy cam ruộm' },
  { slug: 'che-hat-sen-long-nhan', text: 'Chè hạt sen long nhãn — mỗi trái nhãn giấu một hạt sen' },
  { slug: 'kho-quet', text: 'Kho quẹt sệt tới đáy tộ, bẻ rau luộc quẹt một vòng' },
  { slug: 'bo-nuong-la-lot', text: 'Bò nướng lá lốt lá sém thơm, thịt mọng bên trong' },
  { slug: 'che-troi-nuoc', text: 'Chè trôi nước viên dẻo, nước gừng cay ấm' },
  { slug: 'banh-trang-cuon-thit-heo', text: 'Bánh tráng cuốn thịt heo hai đầu da' },
  { slug: 'bun-cha-ca', text: 'Bún chả cá chiên vàng, hấp trắng' },
  { slug: 'com-hen', text: 'Cơm hến Huế — cơm nguội chan nước nóng' },
  { slug: 'banh-khoai-hue', text: 'Bánh khoái Huế nhỏ, dày, giòn rụm' },
  { slug: 'bun-mam-nem', text: 'Bún mắm nêm mít non xé sợi' },
  { slug: 'bun-do-buon-ma-thuot', text: 'Bún đỏ phố núi, nấu thẳng trong nồi cho sợi ăn màu' },
  { slug: 'bo-mot-nang', text: 'Bò một nắng phơi đúng một nắng, xé tay' },
  { slug: 'ca-loc-nuong-trui', text: 'Cá lóc nướng trui để nguyên vảy' },
  { slug: 'pa-pinh-top', text: 'Pa pỉnh tộp — cá nướng gập của người Thái' },
  { slug: 'oc-len-xao-dua', text: 'Ốc len xào dừa, chặt đuôi cho thấm' },
  { slug: 'nem-nuong-nha-trang', text: 'Nem nướng Nha Trang, ống bánh tráng giòn trong cuốn' },
  { slug: 'ca-tai-tuong-chien-xu', text: 'Cá tai tượng chiên xù để nguyên vảy, dựng đứng' },
  { slug: 'oc-hap-la-gung', text: 'Ốc hấp lá gừng gói lại nhét vào vỏ' },
  { slug: 'ga-hap-hanh', text: 'Gà hấp hành, thịt ngọt nguyên không đụng nước' },
  { slug: 'goi-ngo-sen-tom-thit', text: 'Gỏi ngó sen tôm thịt giòn sần sật' },
  { slug: 'canh-ga-chien-nuoc-mam', text: 'Cánh gà chiên nước mắm, tỏi phi rắc sau cùng' },
  { slug: 'suon-xao-chua-ngot', text: 'Sườn xào chua ngọt, thơm vàng với ớt chuông giòn' },
  { slug: 'bun-suon-nau-sau', text: 'Bún sườn nấu sấu — chua thanh mà nước trong veo' },
  { slug: 'oc-om-chuoi-dau', text: 'Ốc om chuối đậu thơm nức tía tô lá lốt' },
  { slug: 'long-heo-luoc', text: 'Lòng heo luộc, vớt ra là thả ngay vào nước đá' },
  { slug: 'canh-suon-khoai-tay-ca-rot', text: 'Canh sườn khoai tây cà rốt ngọt bùi' },
  { slug: 'canh-suon-bi-dao', text: 'Canh sườn bí đao, miếng bí trong như ngọc' },
  { slug: 'ca-tim-nuong-mo-hanh', text: 'Cà tím nướng mỡ hành, đậu phộng giòn rôm rốp' },
  { slug: 'bun-oc', text: 'Bún ốc chua giấm bỗng, một thìa ớt chưng nổi váng đỏ' },
  { slug: 'bun-moc', text: 'Bún mọc — viên giò sống trộn mộc nhĩ nấm hương' },
  { slug: 'bun-mang-vit', text: 'Bún măng vịt măng khô xào mỡ vịt, chấm mắm gừng' },
  { slug: 'bun-sua-nha-trang', text: 'Bún sứa Nha Trang, sứa chân giòn sần sật' },
  { slug: 'com-rang-dua-bo', text: 'Cơm rang dưa bò — hạt cơm săn rời, dưa chua giòn' },
  { slug: 'com-lam', text: 'Cơm lam nướng ống nứa, chấm muối vừng' },
  { text: 'Cơm nhà là ngon nhất' },
];

/* Gõ sai một slug là gãy một liên kết mà nhìn trang không thấy — nên bắt ngay
   lúc build, đừng để link-audit bắt sau. */
const slugSet = new Set(recipes.map((r) => r.id));
const strayTicker = tickerItems.filter((t) => t.slug && !slugSet.has(t.slug));
if (strayTicker.length) {
  throw new Error(
    `Băng chuyền trang chủ trỏ tới món không có: ${strayTicker.map((t) => t.slug).join(', ')}`
  );
}

/* Thời lượng chạy suy ra từ lượng chữ — xem src/utils/ticker.ts. */
const tickerDur = tickerDuration(tickerItems);

/* WebSite + SearchAction. Khai SearchAction chỉ hợp lệ khi trang CÓ tìm kiếm
   thật — site này có: `/mon/?q=…` là form GET thuần, không JS vẫn chạy. */
const siteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Món Việt Ngon',
  alternateName: 'monvietngon.com',
  url: Astro.site?.href,
  inLanguage: 'vi',
  description: 'Kho công thức món Việt ba miền, hướng dẫn cặn kẽ từng bước.',
  publisher: { '@type': 'Organization', name: 'Món Việt Ngon', url: Astro.site?.href },
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: new URL('/mon/?q={search_term_string}', Astro.site).href,
    },
    'query-input': 'required name=search_term_string',
  },
};
---
<Base
  title="Món Việt Ngon — Nấu món Việt chuẩn vị, dễ như cơm nhà"
  description="Công thức món Việt ba miền hướng dẫn cặn kẽ từng bước: bản nấu nhanh, giỏ đi chợ tự tính khẩu phần, đồng hồ đếm giờ, bí quyết của người nấu lâu năm."
  active="home"
>
<script type="application/ld+json" is:inline set:html={JSON.stringify(siteLd)} />
<main>
  <!-- ============ HERO ============ -->
  <section class="home-hero" aria-label="Giới thiệu Món Việt Ngon">
    <div class="float-bit float-bit--1" aria-hidden="true"><Icon name="flower" /></div>
    <div class="float-bit float-bit--2" aria-hidden="true"><Icon name="chili" /></div>
    <div class="float-bit float-bit--3" aria-hidden="true"><Icon name="herb" /></div>

    <div class="home-hero__inner">
      <div>
        <p class="home-hero__eyebrow">Thương nhau mời về ăn cơm…</p>
        <h1>Món <span class="gold">Việt</span> Ngon</h1>
        {/* Hai dòng, không phải bốn. Đoạn cũ nói lại đúng những gì lưới món và
            trang món tự chứng minh ở dưới, mà lại đẩy thẻ món đầu tiên xuống
            sâu thêm — xem ROADMAP phần 5, mục "Rút ngắn hero trang chủ". */}
        <p class="home-hero__sub">
          Công thức món Việt <b>chuẩn vị nhà nấu</b> — có <b>bản nấu nhanh</b> cho
          bữa vội, giỏ đi chợ tự tính khẩu phần và đồng hồ đếm giờ ngay trong trang.
        </p>
        <!-- Form GET thuần, không cần JS: submit là sang /mon/?q=… rồi trang đó
             tự đọc tham số và lọc sẵn. -->
        <form class="home-hero__find" action="/mon/" method="get" role="search">
          <Icon name="search" />
          <input
            type="search" name="q" autocomplete="off" spellcheck="false"
            placeholder="Tìm món hoặc nguyên liệu…" aria-label="Tìm món hoặc nguyên liệu"
          />
          <button type="submit">Tìm</button>
        </form>
        {/* Số món nằm NGAY TRONG nút, không chỉ ở dòng thống kê dưới: máy
            390×844 chỉ hở ~745px cho trang, mà dòng "126 món" bắt đầu ở 775 —
            tức màn hình đầu của điện thoại vốn không có con số nào. Nút thì ở
            624. Đo ra thêm chữ số vào đây tốn 0px (nút 210 → 241, vẫn một dòng). */}
        <div class="home-hero__cta">
          <a class="btn btn--gold" href="/mon/">
            <Icon name="rice" />
            Xem hết {recipes.length} món ngon
          </a>
          <a class="btn btn--ghost" href="/bi-quyet/">
            <Icon name="bulb" />
            Bí quyết bếp Việt
          </a>
        </div>
        <ul class="home-hero__stats">
          <li><Icon name="bowl" /><span class="num">{recipes.length} món</span> và đang thêm hoài</li>
          <li><Icon name="map" /><span class="num">{regionCount}</span> vùng miền</li>
          <li><Icon name="check" />Từng bước đã nấu thử</li>
        </ul>
      </div>
      <div class="home-hero__art" aria-hidden="true">
        <CanhChuaArt />
      </div>
    </div>

    <div class="home-hero__wave" aria-hidden="true">
      <svg viewBox="0 0 1440 54" preserveAspectRatio="none">
        <path d="M0 30 C 180 54 360 6 540 22 C 720 38 900 54 1080 38 C 1260 22 1350 10 1440 26 L 1440 54 L 0 54 Z" fill="currentColor"/>
      </svg>
    </div>
  </section>

  {/* Dải chạy nhân đôi để nối vòng cho liền. Bản gốc là liên kết thật; BẢN CHÉP
      phải `aria-hidden` + `tabindex="-1"`, nếu không trình đọc màn hình đọc mỗi
      món hai lần và bàn phím phải Tab qua 140 chặng thay vì 70.
      Băng này chạy SANG TRÁI; băng mẹo ở trang món chạy ngược lại — hai chiều
      khác nhau để đừng ai tưởng chỗ nào cũng bấm được. */}
  <nav class="ticker" aria-label="Dạo một vòng các món" style={`--ticker-dur:${tickerDur}s`}>
    <div class="ticker__track">
      {tickerItems.map((t) => (
        t.slug
          ? <a class="ticker__item" href={`/mon/${t.slug}/`}>{t.text}</a>
          : <span class="ticker__item">{t.text}</span>
      ))}
      {tickerItems.map((t) => (
        t.slug
          ? <a class="ticker__item" href={`/mon/${t.slug}/`} aria-hidden="true" tabindex="-1">{t.text}</a>
          : <span class="ticker__item" aria-hidden="true">{t.text}</span>
      ))}
    </div>
  </nav>

  <!-- ============ MÓN NỔI BẬT ============ -->
  <section class="section" id="mon-noi-bat">
    <div class="wrap">
      {/* Liên kết nhét vào dòng eyebrow SẴN CÓ, không thêm hàng mới: nút "Xem
          tất cả" cuối lưới nằm ở 6565px trên điện thoại — 7,8 màn hình cuộn mới
          tới, nên người xem 12 thẻ đầu không biết đây chỉ là một góc. Đã đo 4
          chỗ đặt: cạnh h2 tốn +63px (xuống dòng dưới tiêu đề), chèn vào câu dẫn
          tốn +28/+29, còn ở đây tốn 0 vì câu vẫn gọn một dòng ở khung 390. */}
      <p class="eyebrow reveal">Mới lên mâm — <a href="/mon/">xem cả {recipes.length} món</a></p>
      <h2 class="reveal">Món ngon <span class="accent">cả nhà đều mê</span></h2>
      <p class="section__lead reveal">
        Mỗi món một trang riêng, từng bước có đếm giờ và bí quyết đi kèm.
      </p>
      <div class="rcard-grid">
        {/* Cả 12 thẻ để `lazy`. Đã thử cho 3 thẻ đầu `eager` rồi gỡ ra: đo mới
            biết thẻ đầu bắt đầu ở 1165px, không ô nào nằm trên màn hình đầu —
            xem mục "Đo LCP" trong ROADMAP. */}
        {featured.map((r) => <RecipeCard recipe={r} />)}
      </div>
      <ComingSoon>
        <a class="btn btn--line" href="/mon/" style="margin-left:auto">
          Xem tất cả {recipes.length} món
          <Icon name="arrow-right" />
        </a>
      </ComingSoon>
    </div>
  </section>

  <div class="checker" aria-hidden="true"></div>

  <!-- ============ LỐI VÀO THEO TRỤC ============ -->
  <section class="section section--tint" id="loi-vao">
    <div class="wrap">
      <p class="eyebrow reveal">Đi lối nào cũng tới bếp</p>
      <h2 class="reveal">Tìm món <span class="accent">theo cách của mình</span></h2>
      <p class="section__lead reveal">
        Thèm một tô nước nóng, nấu cho dịp gì, hay nhớ vị vùng nào — bấm một cái
        là sang thẳng danh sách đã lọc sẵn. Con số bên cạnh là số món đang có.
      </p>
      <div class="gates reveal">
        {/* Ba nhóm là ba dải ngang xếp chồng, không chia cột — lý do ở home.css,
            mục "Lối vào theo trục". */}
        <div class="gate-group">
          {/* Không dùng "Thèm…" — trục Miền phía dưới đã là "Thèm vị vùng nào?" */}
          <h3>Muốn ăn kiểu gì?</h3>
          <div class="gate-row">
            {catGates.map((g) => (
              <a class="gate" href={`/mon/?kieu=${encodeURIComponent(g.name)}`}>
                {g.name}<span class="gate__n num">{g.n}</span>
              </a>
            ))}
          </div>
        </div>
        <div class="gate-group">
          <h3>Nấu cho dịp gì?</h3>
          <div class="gate-row">
            {occGates.map((g) => (
              <a class="gate" href={`/mon/?dip=${encodeURIComponent(g.name)}`}>
                {g.name}<span class="gate__n num">{g.n}</span>
              </a>
            ))}
          </div>
        </div>
        <div class="gate-group">
          <h3>Thèm vị vùng nào?</h3>
          <div class="gate-row">
            {regionGates.map((g) => (
              <a class="gate" href={`/mon/?mien=${encodeURIComponent(g.name)}`}>
                <Icon name="map" />{g.name}<span class="gate__n num">{g.n}</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ VỀ TRANG ============ -->
  <section class="section section--tint" id="ve-trang">
    <div class="wrap">
      <div class="home-about">
        <div class="reveal">
          <p class="eyebrow">Chuyện cái bếp này</p>
          <h2>Nấu ăn ngon là <span class="accent">chuyện học được</span></h2>
          <p class="drop">
            Món Việt ngon không nằm ở công thức bí truyền — nằm ở mấy chi tiết nhỏ
            mà người nấu lâu năm coi là hiển nhiên: <b>nước sôi mới thả cá</b>,
            <b>đường nêm trước mắm nêm sau</b>, <b>rau bỏ cuối tắt bếp liền</b>.
            Trang này gom hết mấy điều "hiển nhiên" đó viết ra rõ ràng, để ai lần
            đầu vô bếp cũng nấu được bữa cơm ra hồn.
          </p>
          <p>
            Mỗi công thức đều có <b>bản nấu nhanh</b> đọc trong 30 giây cho bữa vội,
            và bản cặn kẽ từng bước cho cuối tuần thong thả. Khẩu phần tự tính,
            đồng hồ đếm giờ có sẵn, giỏ đi chợ bấm là lưu — nấu tới đâu, trang
            theo tới đó.
          </p>
        </div>
        <aside class="mam-card reveal" aria-label="Trang có gì">
          <h3>Trong mỗi trang món có gì?</h3>
          <p>Đủ đồ nghề cho một bữa nấu suôn sẻ:</p>
          <ul class="mam-list">
            <li><Icon name="flame" /><span><b>Bản nấu nhanh</b> — nguyên liệu + trình tự gói trong 30 giây đọc.</span></li>
            <li><Icon name="basket" /><span><b>Giỏ đi chợ</b> — bấm tick từng món, khẩu phần đổi là lượng đổi theo.</span></li>
            <li><Icon name="clock" /><span><b>Đồng hồ đếm giờ</b> — bấm ngay trong bước, hết giờ có chuông báo.</span></li>
            <li><Icon name="bulb" /><span><b>Bí quyết thiệt tình</b> — mấy mẹo chia đôi nồi "ăn được" và nồi "ăn là nhớ".</span></li>
          </ul>
        </aside>
      </div>
    </div>
  </section>
</main>
</Base>
